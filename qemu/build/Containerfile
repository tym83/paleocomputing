# Build of the RISC5 target for QEMU.
#
# Dependencies live here rather than on the developer's machine: configuring QEMU pulls in
# meson, ninja, glib and pixman, and there is no reason to install them on the host for one target.
# It also makes the build reproducible: the same for everyone.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 python3-venv ninja-build meson pkg-config \
      gcc libc6-dev libglib2.0-dev libpixman-1-dev \
      zlib1g-dev flex bison ca-certificates make \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
ENTRYPOINT ["/bin/bash", "-c"]
