# The air relay for Oberon machines (relay.py): one small process that hands
# every radio frame to the other machines. Pinned by digest like every base.
FROM docker.io/library/python:3.13-alpine@sha256:2d9aefe2fef018a7eb2c13064c89c71929800fd2e5dccdbf52ea5da5bb8d929a
COPY relay.py /relay.py
USER 65534
EXPOSE 7524/udp
ENTRYPOINT ["python3", "-u", "/relay.py"]
