-- RM79 13: representations seen in storage through 'ADDRESS, code, LOW_LEVEL_IO and
-- UNSAFE_CONVERSION; objects at one address overlay
restricted (TEXT_IO, MACHINE_CODE, LOW_LEVEL_IO, UNSAFE_PROGRAMMING)
procedure MAIN is
   use TEXT_IO;
   type REG is record
      A : INTEGER range 0 .. 7;
      B : BOOLEAN;
      C : CHARACTER;
   end record;
   for REG use
      record
         A at 0 range 0 .. 2;
         B at 0 range 3 .. 3;
         C at 1 range 0 .. 7;
      end record;
   function WORD is new UNSAFE_PROGRAMMING.UNSAFE_CONVERSION(S is REG, T is INTEGER);
   function TO_REG is new UNSAFE_PROGRAMMING.UNSAFE_CONVERSION(S is INTEGER, T is REG);
   type FLAGS is array (1 .. 8) of BOOLEAN;
   for FLAGS use packing;
   function BYTE is new UNSAFE_PROGRAMMING.UNSAFE_CONVERSION(S is FLAGS, T is INTEGER);
   R : REG := (5, TRUE, "A");
   F : FLAGS := (TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE);
   N : INTEGER := 0;
   X : INTEGER := 0;
   for X use at 200;
   S : STRING(1 .. 4);
   for S use at 200;
   M : array (1 .. 2, 1 .. 3) of INTEGER;
   for M use at 256;
   Q : REG;

   D : INTEGER;
   type PTR is access REG;
   function ADDRESS_OF is new UNSAFE_PROGRAMMING.UNSAFE_CONVERSION(S is PTR, T is INTEGER);
   function POINTER_TO is new UNSAFE_PROGRAMMING.UNSAFE_CONVERSION(S is INTEGER, T is PTR);
   PR, PS : PTR;
begin
   PR := new PTR((3, TRUE, "p"));
   PS := POINTER_TO(ADDRESS_OF(PR));
   PUT(PS.C); PUT(ADDRESS_OF(PR) = PR.all'ADDRESS); PUT(ADDRESS_OF(PR) >= SYSTEM'MEMORY_SIZE); PUT(NEWLINE);
   PUT(WORD(R)); PUT(BYTE(F)); Q := TO_REG(16#4207); PUT(Q.A); PUT(Q.B); PUT(Q.C); PUT(NEWLINE);
   X := 16#64636261;
   PUT(S); PUT(NEWLINE);
   S(1) := "Z";
   PUT(X mod 256); PUT(NEWLINE);
   for I in 1 .. 2 loop
      for J in 1 .. 3 loop
         M(I, J) := 10 * I + J;
      end loop;
   end loop;
   PUT(M'ADDRESS); PUT(M(2, 1)'ADDRESS); PUT(NEWLINE);
   D := M(2, 1)'ADDRESS;
   LOW_LEVEL_IO.SEND_CONTROL(LOW_LEVEL_IO.MEMORY_ADDRESS, D);
   LOW_LEVEL_IO.RECEIVE_CONTROL(LOW_LEVEL_IO.MEMORY_DATA, N);
   PUT(N); PUT(NEWLINE);
   D := R'ADDRESS;
   LOW_LEVEL_IO.SEND_CONTROL(LOW_LEVEL_IO.MEMORY_ADDRESS, D);
   D := 2;
   LOW_LEVEL_IO.SEND_CONTROL(LOW_LEVEL_IO.MEMORY_DUMP, D);
   PUT(NEWLINE);
   D := R.C'ADDRESS;
   LOW_LEVEL_IO.SEND_CONTROL(LOW_LEVEL_IO.MEMORY_ADDRESS, D);
   D := 66;
   LOW_LEVEL_IO.SEND_CONTROL(LOW_LEVEL_IO.MEMORY_DATA, D);
   PUT(R.C); PUT(R'ADDRESS = R.A'ADDRESS); PUT(N'ADDRESS /= R'ADDRESS); PUT(NEWLINE);
end MAIN;
