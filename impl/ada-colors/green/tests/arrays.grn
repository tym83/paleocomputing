-- arrays (RM79 3.6): n dimensions as arrays of subarrays (RM79 4.1.1),
-- unconstrained types, slices, aggregates (RM79 3.6.2), STRING with bounds
-- other than 1 (RM79 3.6.3), catenation (RM79 4.5.3), conversions (RM79 4.6)
restricted (TEXT_IO)
procedure MAIN is
   use TEXT_IO;
   type CUBE is array (1 .. 2, 1 .. 3, 1 .. 4) of INTEGER;
   type MATRIX is array (INTEGER, INTEGER) of FLOAT;
   type DAY is (MON, TUE, WED, THU, FRI);
   type WORK is array (DAY range MON .. WED) of INTEGER;
   type VEC is array (INTEGER) of INTEGER;
   type BITS is array (1 .. 4) of BOOLEAN;
   type CHARS is array (1 .. 3) of CHARACTER;
   type V3 is array (1 .. 3) of INTEGER;
   type W3 is array (1 .. 3) of INTEGER;
   C : CUBE;
   M : MATRIX(1 .. 3, 0 .. 1) := (others => (others => 0.5));
   G : array (1 .. 2, 1 .. 2) of INTEGER := ((1, 2), (3, 4));
   W : WORK := (MON => 1, TUE | WED => 2);
   S : STRING(5 .. 7) := "abc";
   BLANKS : STRING(1 .. 4) := (1 .. 4 => " ");
   V : VEC(1 .. 5) := (1, 2, others => 0);
   CH : CHARS := "xyz";
   A : V3 := (7, 8, 9);
   B : W3;
   function SUM(X : VEC) return INTEGER is
      T : INTEGER := 0;
   begin
      for I in X'FIRST .. X'LAST loop
         T := T + X(I);
      end loop;
      return T;
   end SUM;
begin
   C(2, 3, 4) := 5;
   C(1)(2)(3) := 6;
   PUT(C(2)(3)(4) + C(1, 2, 3)); PUT(C'LAST(3)); PUT(NEWLINE);
   PUT(M(3, 1) + M(1, 0)); PUT(M'FIRST(2)); PUT(M'LENGTH); PUT(NEWLINE);
   PUT(G(2)(1)); G(1) := G(2); PUT(G(1, 2)); PUT(NEWLINE);
   PUT(W(WED)); PUT(WORK'LENGTH);
   for D in DAY range TUE .. WED loop
      PUT(DAY'ORD(D));
   end loop;
   PUT(NEWLINE);
   PUT(S); PUT(S'FIRST); PUT(S(6)); PUT("[" & BLANKS & "]"); PUT(NEWLINE);
   PUT(SUM(V)); PUT(SUM(V(2 .. 3) & V(1) & 10)); PUT(NEWLINE);
   V(2 .. 4) := (4, 5, 6);
   PUT(V(4)); PUT(CH(2)); PUT(NEWLINE);
   B := W3(A);
   PUT(B(3)); PUT(BITS(TRUE, FALSE, TRUE, TRUE) = (TRUE, FALSE, others => TRUE)); PUT(NEWLINE);
   begin
      V(1 .. 3) := V(2 .. 4);
   exception
      when OVERLAP_ERROR => PUT("OVERLAP_ERROR");
   end;
   begin
      V := (1, 2, 3);
   exception
      when INDEX_ERROR => PUT(" INDEX_ERROR");
   end;
   PUT(NEWLINE);
end MAIN;
