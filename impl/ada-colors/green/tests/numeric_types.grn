-- every type definition is a distinct type (RM79 3.3); integer, floating and
-- fixed point types (RM79 3.5.4, 3.5.5); derived types (RM79 3.4)
restricted (TEXT_IO)
procedure MAIN is
   use TEXT_IO;
   type PAGE_NUM is range 1 .. 2_000;
   type LINE_SIZE is new INTEGER range 1 .. 132;
   subtype COLUMN is LINE_SIZE range 1 .. 10;
   type REAL is digits 7;
   type PROB is digits 5 range 0.0 .. 1.0;
   type VOLT is delta 0.125 range 0.0 .. 10.0;
   type COLOR is (RED, GREEN, BLUE);
   type HUE is new COLOR;
   type POINT is record
      X, Y : INTEGER;
   end record;
   type PLACE is new POINT;
   function TWICE(N : INTEGER) return INTEGER is
   begin
      return 2 * N;
   end TWICE;
   type COUNT is new INTEGER;   -- derives TWICE(N : COUNT) return COUNT
   P : PAGE_NUM := 10;
   L : LINE_SIZE := 5;
   C : COLUMN := 3;
   R : REAL := 2.5;
   Q : PROB := 0.5;
   V, W : VOLT := 1.3;
   H : HUE := GREEN;
   K : COLOR := BLUE;
   PL : PLACE := (1, 2);
   PT : POINT;
   N : COUNT := 21;
   I : INTEGER := 4;
   S : SHORT_INTEGER := 2_000_000_000;
   A, B : (ON, OFF);
begin
   P := P + 5;
   PUT(INTEGER(P)); PUT(INTEGER(L + C)); PUT(INTEGER(P) + I); PUT(NEWLINE);
   R := R * 2.0 + 1.0;
   PUT(R); PUT(FLOAT(Q) * 2.0); PUT(NEWLINE);
   PUT(FLOAT(V)); PUT(FLOAT(V * 2)); PUT(FLOAT(V / 2)); PUT(FLOAT(VOLT(V * W)));
   PUT(NEWLINE);
   PUT(HUE'ORD(H)); PUT(COLOR(H) = GREEN); PUT(HUE(K) = BLUE); PUT(NEWLINE);
   PT := POINT(PL);
   PUT(PT.X + PT.Y); PUT(INTEGER(TWICE(N))); PUT(TWICE(I)); PUT(NEWLINE);
   A := OFF; B := A;
   PUT(B = OFF); PUT(NEWLINE);
   begin
      Q := Q * 4.0;
      PUT("no check");
   exception
      when RANGE_ERROR => PUT("RANGE_ERROR");
   end;
   begin
      S := S + S;
      PUT(" no check");
   exception
      when OVERFLOW => PUT(" OVERFLOW");
   end;
   begin
      C := C + 9;
   exception
      when RANGE_ERROR => PUT(" RANGE_ERROR");
   end;
   PUT(NEWLINE);
end MAIN;
