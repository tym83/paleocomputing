package Q is
   function F (A, B : INTEGER) return INTEGER;
end Q;
package body Q is
   function F (A, B : INTEGER) return INTEGER is
   begin
      return A * 10 + B;
   end F;
end Q;
restricted(Q, TEXT_IO)
procedure MAIN is
   use TEXT_IO;
   N : INTEGER := 3;
begin
   if N /= 2 and Q.F(1, N) > 0 then
      PUT(Q.F(1, N));
   end if;
   PUT(NEWLINE);
end MAIN;
