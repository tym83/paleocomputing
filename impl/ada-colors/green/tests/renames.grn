-- object renaming (RM79 8.5), as GREEN 1979 problem 8 uses it
restricted(TEXT_IO)
procedure MAIN is
   use TEXT_IO;
   type STATUS is
      record
         START, PERIOD : INTEGER;
      end record;
   TABLE : array (1 .. 3) of STATUS := (1 .. 3 => (0, 0));

   procedure SET(I : INTEGER; S : INTEGER) is
      THIS : STATUS renames TABLE(I);
   begin
      THIS.START := S;
      THIS.PERIOD := THIS.START * 2;
   end SET;

   FIRST : STATUS renames TABLE(1);
begin
   SET(2, 5);
   FIRST.START := 7;
   PUT(TABLE(1).START); PUT(TABLE(2).START); PUT(TABLE(2).PERIOD);
   PUT(NEWLINE);
end MAIN;
