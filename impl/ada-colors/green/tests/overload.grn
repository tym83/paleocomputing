-- overloading (RM79 6.6): by parameter types, by result type, operators
restricted (TEXT_IO)
procedure MAIN is
   use TEXT_IO;
   type VECTOR is array (1 .. 3) of INTEGER;
   type COLOR is (RED, GREEN, BLUE);
   type LIGHT is (RED, AMBER, GREEN);
   V, W : VECTOR;
   C : COLOR;
   L : LIGHT;

   function "+" (A, B : VECTOR) return VECTOR is
      R : VECTOR;
   begin
      for I in 1 .. 3 loop
         R(I) := A(I) + B(I);
      end loop;
      return R;
   end "+";

   function "*" (K : INTEGER; A : VECTOR) return VECTOR is
      R : VECTOR;
   begin
      for I in 1 .. 3 loop
         R(I) := K * A(I);
      end loop;
      return R;
   end "*";

   procedure SHOW(X : INTEGER) is
   begin
      PUT("int"); PUT(X); PUT(NEWLINE);
   end SHOW;

   procedure SHOW(X : STRING) is
   begin
      PUT("string " & X); PUT(NEWLINE);
   end SHOW;

   procedure SHOW(X : VECTOR) is
   begin
      PUT("vector");
      for I in 1 .. 3 loop
         PUT(X(I));
      end loop;
      PUT(NEWLINE);
   end SHOW;

   function ZERO return INTEGER is
   begin
      return 0;
   end ZERO;

   function ZERO return STRING is
   begin
      return "zero";
   end ZERO;

   procedure MOVE(FROM : INTEGER; TO_POS : INTEGER := 10) is
   begin
      PUT("move from"); PUT(FROM); PUT(" to"); PUT(TO_POS); PUT(NEWLINE);
   end MOVE;
begin
   V := (1, 2, 3);
   W := (10, 20, 30);
   SHOW(V + W);
   SHOW(2 * V);
   SHOW(42);
   SHOW("hello");
   SHOW(STRING(ZERO));
   declare
      S : STRING(1 .. 4) := ZERO;
   begin
      SHOW(S);
   end;
   C := GREEN;
   L := GREEN;
   if C = BLUE then PUT("?"); end if;
   PUT(COLOR'ORD(C)); PUT(LIGHT'ORD(L)); PUT(NEWLINE);
   MOVE(1);
   MOVE(FROM := 2, TO_POS := 5);
   MOVE(TO_POS := 7, FROM := 3);
   if V /= W then PUT("different"); PUT(NEWLINE); end if;
end MAIN;
