-- expressions (RM79 4): expanded names, membership, boolean arrays,
-- conditions, attributes, NO_VALUE_ERROR
restricted (TEXT_IO)
procedure MAIN is
   use TEXT_IO;
   package OUTER is
      package INNER is
         X : INTEGER := 3;
         type MODE is (ON, OFF);
      end INNER;
   end OUTER;
   type DAY is (MON, TUE, WED, THU, FRI, SAT, SUN);
   type BITS is array (1 .. 4) of BOOLEAN;
   type REAL is digits 6;
   type VOLT is delta 0.125 range 0.0 .. 10.0;
   type REC is record
      A : INTEGER;
      B : CHARACTER;
   end record;
   X : INTEGER := 1;
   TODAY : DAY := TUE;
   F : FLOAT := 0.7;
   P, Q : BITS := (TRUE, FALSE, TRUE, FALSE);
   R : REC;
   procedure SHOW is
      X : INTEGER := 2;
   begin
      PUT(MAIN.X); PUT(X); PUT(OUTER.INNER.X);
      PUT(OUTER.INNER.MODE'ORD(OUTER.INNER.OFF)); PUT(NEWLINE);
   end SHOW;
begin
   SHOW;
   PUT(TODAY in DAY range MON .. FRI); PUT(SAT in DAY range MON .. FRI); PUT(X in NATURAL);
   PUT(F in 0.5 .. 0.9); PUT(F not in 0.71 .. 0.9); PUT(NEWLINE);
   Q := not Q;
   PUT((P and Q) = (FALSE, FALSE, FALSE, FALSE)); PUT((P or Q) = (others => TRUE));
   Q := P xor P; PUT(Q(3)); PUT(NEWLINE);
   if X > 0 and then X < 10 then
      PUT("and then");
   end if;
   if (X > 0 and X < 10) or else X = 100 then
      PUT(" or else");
   end if;
   PUT(NEWLINE);
   PUT(FLOAT'DIGITS); PUT(REAL'DIGITS); PUT(SHORT_FLOAT'BITS); PUT(INTEGER'RADIX);
   PUT(FLOAT(VOLT'DELTA)); PUT(FLOAT(VOLT'SMALL)); PUT(VOLT'BITS); PUT(NEWLINE);
   PUT(INTEGER'SIZE); PUT(SHORT_INTEGER'SIZE); PUT(BITS'SIZE); PUT(R.B'POSITION); PUT(R.A'LAST_BIT);
   PUT(NEWLINE);
   PUT(SYSTEM'NAME); PUT(SYSTEM'STORAGE_UNIT); PUT(SYSTEM'MAX_INT); PUT(INTEGER'FIRST);
   PUT(OPTION'TIME); PUT(NEWLINE);
   begin
      PUT(R.A);
   exception
      when NO_VALUE_ERROR => PUT("NO_VALUE_ERROR");
   end;
   declare
      Y : INTEGER range 1 .. 3;
   begin
      X := Y;
   exception
      when NO_VALUE_ERROR => PUT(" NO_VALUE_ERROR");
   end;
   PUT(NEWLINE);
end MAIN;
