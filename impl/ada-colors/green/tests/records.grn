-- records (RM79 3.7): initial values evaluated with the type definition,
-- constant components, discriminants, discriminant constraints, variant
-- parts and DISCRIMINANT_ERROR (RM79 3.7.1 - 3.7.3, 4.1.2)
restricted (TEXT_IO)
procedure MAIN is
   use TEXT_IO;
   N : INTEGER := 1;
   type R is record
      V : INTEGER := N;
      LEN : constant INTEGER := 3;
   end record;
   type BUFFER is record
      LENGTH : constant INTEGER range 1 .. 100;
      POS : INTEGER range 0 .. 100 := 0;
      IMAGE : array (1 .. LENGTH) of CHARACTER;
   end record;
   type UNIT_KIND is (PRINTER, DISK, DRUM);
   type PERIPHERAL is record
      STATUS : (OPEN, CLOSED);
      UNIT : constant UNIT_KIND;
      case UNIT of
         when PRINTER =>
            LINE_COUNT : INTEGER range 1 .. 60;
         when others =>
            CYLINDER : INTEGER;
            TRACK : INTEGER;
      end case;
   end record;
   subtype DISK_DEVICE is PERIPHERAL(UNIT => DISK);
   X : R;
   CARD : BUFFER(LENGTH => 80);
   LINE : BUFFER(5);
   P : PERIPHERAL := (CLOSED, PRINTER, 10);
   D : DISK_DEVICE := (STATUS => OPEN, UNIT => DISK, CYLINDER => 9, TRACK => 1);
   U : PERIPHERAL := D;
begin
   N := 5;
   declare
      Y : R;
   begin
      PUT(X.V); PUT(Y.V); PUT(Y.LEN); PUT(NEWLINE);
   end;
   PUT(CARD.LENGTH); PUT(CARD.IMAGE'LAST); PUT(LINE.IMAGE'LENGTH); PUT(NEWLINE);
   LINE.IMAGE := "hello";
   PUT(LINE.IMAGE(2)); PUT(LINE.IMAGE(5)); PUT(NEWLINE);
   PUT(P.LINE_COUNT); PUT(D.CYLINDER + D.TRACK); PUT(U.TRACK); PUT(NEWLINE);
   begin
      PUT(P.CYLINDER);
   exception
      when DISCRIMINANT_ERROR => PUT("DISCRIMINANT_ERROR");
   end;
   begin
      D := P;
   exception
      when DISCRIMINANT_ERROR => PUT(" DISCRIMINANT_ERROR");
   end;
   U := P;
   PUT(U.LINE_COUNT); PUT(U = P); PUT(NEWLINE);
end MAIN;
