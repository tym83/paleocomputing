-- RM79 11.1: two exception declarations are two exceptions, whatever their names
restricted (TEXT_IO)
procedure MAIN is
   use TEXT_IO;
   package A is E : exception; end A;
   package B is E : exception; end B;
begin
   begin
      raise A.E;
   exception
      when B.E => PUT("wrong");
      when A.E => PUT("A.E");
   end;
   raise B.E;
exception
   when A.E => PUT(" wrong");
   when B.E => PUT(" B.E");
end MAIN;
