-- RM79 13.1 - 13.5, 13.10: representation specifications on the simulated machine
restricted (TEXT_IO, MACHINE_CODE, LOW_LEVEL_IO, UNSAFE_PROGRAMMING)
procedure MAIN is
   use TEXT_IO;
   type COLOR is (RED, GREEN, BLUE);
   for COLOR use (1, 4, 9);
   function CODE is new UNSAFE_PROGRAMMING.UNSAFE_CONVERSION(S is COLOR, T is INTEGER);
   function FROM is new UNSAFE_PROGRAMMING.UNSAFE_CONVERSION(S is INTEGER, T is COLOR);
   type BITS is array (1 .. 16) of BOOLEAN;
   for BITS use packing;
   type SMALL is range 0 .. 100;
   for SMALL use 7;
   type REG is record
      A : INTEGER range 0 .. 7;
      B : BOOLEAN;
      C : CHARACTER;
   end record;
   for REG use
      record at mod 8;
         A at 0 range 0 .. 2;
         B at 0 range 3 .. 3;
      end record;
   R : REG;
   X : INTEGER := 5;
   for X use at 64;
   V : array (1 .. 3) of INTEGER := (10, 20, 30);
   for V use at 128;
   task T is entry TICK; for TICK use at 8#40; end T;
   task body T is
   begin
      for I in 1 .. 3 loop
         accept TICK;
         PUT("tick");
      end loop;
   end T;
   procedure SHOW is
      use MACHINE_CODE;
   begin
      INSTRUCTION(OP => LD, R => 0, A => 64);
      INSTRUCTION(OP => ADD, R => 0, A => 136);
      INSTRUCTION(OP => OUTN, R => 0, A => 0);
      INSTRUCTION(OP => INTR, R => 0, A => 32);
   end SHOW;
   D : INTEGER := 32;
   type CELL is access STRING;
   for CELL use 64;
   C : CELL;
   task BIG;
   for BIG use 16;
   task body BIG is
      S : STRING(1 .. 100);
   begin
      null;
   end BIG;
begin
   C := new CELL("abcdefgh");
   begin
      C := new CELL("i");
   exception
      when STORAGE_OVERFLOW => PUT("collection full");
   end;
   begin
      initiate BIG;
   exception
      when STORAGE_OVERFLOW => PUT(" activation too big");
   end;
   PUT(NEWLINE);
   PUT(CODE(GREEN)); PUT(COLOR'REP(FROM(9))); PUT(COLOR'ORD(BLUE));
   PUT(BITS'SIZE); PUT(SMALL'SIZE); PUT(REG'SIZE);
   PUT(R.A'FIRST_BIT); PUT(R.B'LAST_BIT); PUT(R.C'POSITION); PUT(R.C'LAST_BIT);
   PUT(X'ADDRESS); PUT(V'ADDRESS); PUT(NEWLINE);
   initiate T;
   SHOW;
   LOW_LEVEL_IO.SEND_CONTROL(LOW_LEVEL_IO.INTERRUPT_CONTROLLER, D);
   LOW_LEVEL_IO.SEND_CONTROL(LOW_LEVEL_IO.INTERRUPT_CONTROLLER, D);
   X := X + 1;
   PUT(V(2)); PUT(X);
   PUT(NEWLINE);
end MAIN;
