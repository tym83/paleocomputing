-- subprograms (RM79 6): result subtypes, defaults evaluated with the
-- specification, overloading by parameter names, exceptions of the
-- declarations handled by the unit's own handlers (RM79 11.2)
restricted (TEXT_IO)
procedure MAIN is
   use TEXT_IO;
   N : INTEGER := 1;
   function F(X : INTEGER) return INTEGER range 1 .. 10 is
   begin
      return X;
   end F;
   procedure P(X : INTEGER := N) is
   begin
      PUT(X);
   end P;
   procedure Q(A : INTEGER) is
   begin
      PUT(" A"); PUT(A);
   end Q;
   procedure Q(B : INTEGER) is
   begin
      PUT(" B"); PUT(B);
   end Q;
   procedure R is
      Z : INTEGER := 0;
      Y : INTEGER := 1 / Z;
   begin
      PUT(" body");
   exception
      when DIVIDE_ERROR => PUT(" own handler");
   end R;
begin
   N := 2;
   P; P(5);
   Q(A := 1); Q(B := 2);
   R;
   PUT(NEWLINE);
   PUT(F(3));
   begin
      PUT(F(100));
   exception
      when RANGE_ERROR => PUT(" RANGE_ERROR");
   end;
   PUT(NEWLINE);
end MAIN;
