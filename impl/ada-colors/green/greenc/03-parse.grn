   -- ---- parser: the syntax of RM79 Appendix E -------------------------------------
   --
   -- Each parsing procedure is a value-returning procedure (it advances TPOS)
   -- and is therefore called only as the right side of an assignment.

   procedure NN(KIND, LINE : INTEGER) return NODE is
   begin
      return new NODE_REC(KIND, LINE, 0, 0, null, null, null, null, null, null, null, null, null);
   end NN;

   procedure APPEND(HEAD, TAIL : in out NODE; X : NODE) is
   begin
      if X = null then
         return;
      end if;
      if HEAD = null then
         HEAD := X;
      else
         TAIL.NEXT := X;
      end if;
      TAIL := X;
      while TAIL.NEXT /= null loop
         TAIL := TAIL.NEXT;
      end loop;
   end APPEND;

   function LIST_LEN(L : NODE) return INTEGER is
      N : INTEGER := 0;
      P : NODE := L;
   begin
      while P /= null loop
         N := N + 1;
         P := P.NEXT;
      end loop;
      return N;
   end LIST_LEN;

   function CUR_LINE return INTEGER is
   begin
      return TOKS(TPOS).LINE;
   end CUR_LINE;

   function AT_KW(W : STRING) return BOOLEAN is
   begin
      return TOKS(TPOS).KIND = K_KW and then TOKS(TPOS).S.all = W;
   end AT_KW;

   function AT_OP(W : STRING) return BOOLEAN is
   begin
      return TOKS(TPOS).KIND = K_OP and then TOKS(TPOS).S.all = W;
   end AT_OP;

   function AT_KIND(K : INTEGER) return BOOLEAN is
   begin
      return TOKS(TPOS).KIND = K;
   end AT_KIND;

   function KIND_AT(K : INTEGER) return INTEGER is
   begin
      if TPOS + K > NTOKS then
         return K_EOF;
      end if;
      return TOKS(TPOS + K).KIND;
   end KIND_AT;

   function TEXT_AT(K : INTEGER) return STRING is
   begin
      if TPOS + K > NTOKS then
         return "";
      end if;
      return TOKS(TPOS + K).S.all;
   end TEXT_AT;

   procedure PERROR(MSG : STRING) is
   begin
      FAIL(TOKS(TPOS).LINE, MSG & " (at " & TOKS(TPOS).S.all & ")");
   end PERROR;

   procedure SKIP is
   begin
      TPOS := TPOS + 1;
   end SKIP;

   procedure EXPECT_KW(W : STRING) is
   begin
      if not AT_KW(W) then
         PERROR("expected " & W);
      end if;
      TPOS := TPOS + 1;
   end EXPECT_KW;

   procedure EXPECT_OP(W : STRING) is
   begin
      if not AT_OP(W) then
         PERROR("expected " & W);
      end if;
      TPOS := TPOS + 1;
   end EXPECT_OP;

   procedure EXPECT_ID(RES : out TEXT) is
   begin
      if not AT_KIND(K_ID) then
         PERROR("expected an identifier");
      end if;
      TPOS := TPOS + 1;
      RES := TOKS(TPOS - 1).S;
      return;
   end EXPECT_ID;

   procedure NAME_NODE(RES : out NODE) is
      X : NODE;
   begin
      X := NN(N_NAME, CUR_LINE);
      EXPECT_ID(X.NAME);
      RES := X;
      return;
   end NAME_NODE;

   procedure ID_LIST(RES : out NODE) is
      HEAD, TAIL, X : NODE;
   begin
      NAME_NODE(X);
      APPEND(HEAD, TAIL, X);
      while AT_OP(",") loop
         SKIP;
         NAME_NODE(X);
         APPEND(HEAD, TAIL, X);
      end loop;
      RES := HEAD;
      return;
   end ID_LIST;

   -- ---- expressions (RM79 4.4) ---------------------------------------------------

   procedure BINOP(OP : TEXT; L, R : NODE; LINE : INTEGER) return NODE is
      X : NODE;
   begin
      X := NN(N_BINOP, LINE);
      X.NAME := OP;
      X.A := L;
      X.B := R;
      return X;
   end BINOP;

   -- expression ::= relation {and relation} | ... ; and then / or else are the
   -- short-circuit forms of conditions (RM79 5.4.1)
   procedure EXPR(RES : out NODE) is
      L, R : NODE;
      OP : TEXT;
      LINE : INTEGER;
   begin
      RELATION(L);
      while AT_KW("AND") or AT_KW("OR") or AT_KW("XOR") loop
         OP := TOKS(TPOS).S;
         LINE := CUR_LINE;
         SKIP;
         if OP.all = "AND" and AT_KW("THEN") then
            SKIP;
         elsif OP.all = "OR" and AT_KW("ELSE") then
            SKIP;
         end if;
         RELATION(R);
         L := BINOP(OP, L, R, LINE);
      end loop;
      RES := L;
      return;
   end EXPR;

   function IS_REL(S : STRING) return BOOLEAN is
   begin
      return S = "=" or S = "/=" or S = "<" or S = "<=" or S = ">" or S = ">=";
   end IS_REL;

   procedure RELATION(RES : out NODE) is
      L, R, LO, HI, T : NODE;
      OP : TEXT;
      LINE : INTEGER := CUR_LINE;
      NEG : BOOLEAN := FALSE;
   begin
      SIMPLE_EXPR(L);
      if AT_KIND(K_OP) and then IS_REL(TOKS(TPOS).S.all) then
         OP := TOKS(TPOS).S;
         SKIP;
         SIMPLE_EXPR(R);
         L := BINOP(OP, L, R, LINE);
         RES := L;
         return;
      end if;
      if AT_KW("NOT") and KIND_AT(1) = K_KW and TEXT_AT(1) = "IN" then
         SKIP;
         NEG := TRUE;
      end if;
      if AT_KW("IN") then
         -- membership in a range (RM79 4.5.2)
         SKIP;
         SIMPLE_EXPR(LO);
         EXPECT_OP("..");
         SIMPLE_EXPR(HI);
         T := NN(N_RANGE, LINE);
         T.A := LO;
         T.B := HI;
         OP := MK("IN");
         L := BINOP(OP, L, T, LINE);
         if NEG then
            T := NN(N_UNOP, LINE);
            T.NAME := MK("NOT");
            T.A := L;
            RES := T;
            return;
         end if;
      end if;
      RES := L;
      return;
   end RELATION;

   -- simple_expression ::= [unary_operator] term {adding_operator term}
   procedure SIMPLE_EXPR(RES : out NODE) is
      L, R : NODE;
      OP : TEXT;
      LINE : INTEGER := CUR_LINE;
   begin
      if AT_OP("+") or AT_OP("-") or AT_KW("NOT") then
         OP := TOKS(TPOS).S;
         SKIP;
         TERM(R);
         L := NN(N_UNOP, LINE);
         L.NAME := OP;
         L.A := R;
      else
         TERM(L);
      end if;
      while AT_OP("+") or AT_OP("-") or AT_OP("&") loop
         OP := TOKS(TPOS).S;
         SKIP;
         TERM(R);
         L := BINOP(OP, L, R, LINE);
      end loop;
      RES := L;
      return;
   end SIMPLE_EXPR;

   procedure TERM(RES : out NODE) is
      L, R : NODE;
      OP : TEXT;
      LINE : INTEGER := CUR_LINE;
   begin
      FACTOR(L);
      while AT_OP("*") or AT_OP("/") or AT_KW("MOD") loop
         OP := TOKS(TPOS).S;
         SKIP;
         FACTOR(R);
         L := BINOP(OP, L, R, LINE);
      end loop;
      RES := L;
      return;
   end TERM;

   procedure FACTOR(RES : out NODE) is
      L, R : NODE;
      OP : TEXT;
      LINE : INTEGER := CUR_LINE;
   begin
      PRIMARY(L);
      if AT_OP("**") then
         OP := TOKS(TPOS).S;
         SKIP;
         PRIMARY(R);
         L := BINOP(OP, L, R, LINE);
      end if;
      RES := L;
      return;
   end FACTOR;

   procedure PRIMARY(RES : out NODE) is
      X : NODE;
      LINE : INTEGER := CUR_LINE;
   begin
      if AT_KIND(K_INT) then
         X := NN(N_INT, LINE);
         X.IVAL := TOKS(TPOS).IVAL;
         X.NAME := TOKS(TPOS).S;
         SKIP;
         RES := X;
         return;
      end if;
      if AT_KIND(K_FLOAT) then
         X := NN(N_FLOAT, LINE);
         X.NAME := TOKS(TPOS).S;
         SKIP;
         RES := X;
         return;
      end if;
      if AT_KIND(K_STR) then
         X := NN(N_STR, LINE);
         X.NAME := TOKS(TPOS).S;
         SKIP;
         RES := X;
         return;
      end if;
      if AT_KW("NULL") then
         SKIP;
         X := NN(N_NIL, LINE);
         RES := X;
         return;
      end if;
      if AT_KW("NEW") then
         -- allocator ::= new qualified_expression (RM79 4.7)
         SKIP;
         X := NN(N_NEW, LINE);
         EXPECT_ID(X.NAME);
         if AT_OP("(") then
            AGG_OR_PAREN(X.A);
         end if;
         RES := X;
         return;
      end if;
      if AT_OP("(") then
         AGG_OR_PAREN(X);
         RES := X;
         return;
      end if;
      if AT_KIND(K_ID) then
         NAME_P(X);
         RES := X;
         return;
      end if;
      PERROR("expected an expression");
      RES := null;
      return;
   end PRIMARY;

   -- aggregate (RM79 3.6.2) or parenthesized expression
   procedure AGG_OR_PAREN(RES : out NODE) is
      LINE : INTEGER := CUR_LINE;
      ITEMS, ITAIL, IT, FIRST, KEYS, KTAIL, LAB, X : NODE;
      MORE : BOOLEAN := TRUE;
   begin
      EXPECT_OP("(");
      while MORE loop
         IT := NN(N_CITEM, LINE);
         if AT_KW("OTHERS") then
            SKIP;
            EXPECT_OP("=>");
            LAB := NN(N_LABEL, LINE);
            LAB.FLAG := 1;
            IT.A := LAB;
            EXPR(IT.B);
         else
            EXPR(FIRST);
            if AT_OP("..") or AT_OP("|") or AT_OP("=>") then
               KEYS := null;
               KTAIL := null;
               loop
                  LAB := NN(N_LABEL, LINE);
                  LAB.A := FIRST;
                  if AT_OP("..") then
                     SKIP;
                     SIMPLE_EXPR(LAB.B);
                  end if;
                  APPEND(KEYS, KTAIL, LAB);
                  exit when not AT_OP("|");
                  SKIP;
                  SIMPLE_EXPR(FIRST);
               end loop;
               EXPECT_OP("=>");
               IT.A := KEYS;
               EXPR(IT.B);
            else
               IT.B := FIRST;
            end if;
         end if;
         APPEND(ITEMS, ITAIL, IT);
         MORE := AT_OP(",");
         if MORE then
            SKIP;
         end if;
      end loop;
      EXPECT_OP(")");
      if ITEMS.NEXT = null and ITEMS.A = null then
         X := NN(N_PAREN, LINE);
         X.A := ITEMS.B;
         RES := X;
         return;
      end if;
      X := NN(N_AGG, LINE);
      X.A := ITEMS;
      RES := X;
      return;
   end AGG_OR_PAREN;

   -- does the parenthesized list ahead have choices: =>, | or others?
   function AGGREGATE_AHEAD return BOOLEAN is
      D : INTEGER := 0;
      K : INTEGER := 0;
   begin
      loop
         if TPOS + K > NTOKS then
            return FALSE;
         end if;
         declare
            T : TOKEN := TOKS(TPOS + K);
         begin
            if T.KIND = K_OP and then T.S.all = "(" then
               D := D + 1;
            elsif T.KIND = K_OP and then T.S.all = ")" then
               D := D - 1;
               if D = 0 then
                  return FALSE;
               end if;
            elsif D = 1 and then ((T.KIND = K_OP and then (T.S.all = "=>" or T.S.all = "|"))
               or (T.KIND = K_KW and then T.S.all = "OTHERS")) then
               return TRUE;
            elsif T.KIND = K_OP and then T.S.all = ";" then
               return FALSE;
            end if;
         end;
         K := K + 1;
      end loop;
   end AGGREGATE_AHEAD;

   -- name (RM79 4.1): identifier, indexed or selected component, attribute
   procedure NAME_P(RES : out NODE) is
      P, X, ARGS, ATAIL, LO, R : NODE;
      LINE : INTEGER := CUR_LINE;
      MORE : BOOLEAN;
   begin
      NAME_NODE(P);
      loop
         if AT_OP("(") and then AGGREGATE_AHEAD then
            -- T(others => V), T(A | B => V, ...): a qualified aggregate (RM79 4.6)
            X := NN(N_APPLY, LINE);
            X.A := P;
            AGG_OR_PAREN(X.B);
            X.FLAG := 9;
            P := X;
         elsif AT_OP("(") then
            SKIP;
            ARGS := null;
            ATAIL := null;
            if not AT_OP(")") then
               MORE := TRUE;
               while MORE loop
                  declare
                     FORMAL : TEXT;
                     MARK : INTEGER := 0;
                  begin
                     -- named association, the mode written at the call (RM79 5.2.1)
                     if AT_KIND(K_ID) and KIND_AT(1) = K_OP and (TEXT_AT(1) = ":=" or
                        TEXT_AT(1) = "=:" or TEXT_AT(1) = ":=:" or TEXT_AT(1) = "=>") then
                        FORMAL := TOKS(TPOS).S;
                        if TEXT_AT(1) = ":=" then
                           MARK := 1;
                        elsif TEXT_AT(1) = "=:" then
                           MARK := M_OUT;
                        elsif TEXT_AT(1) = ":=:" then
                           MARK := M_INOUT;
                        else
                           MARK := 4;
                        end if;
                        SKIP;
                        SKIP;
                     end if;
                     EXPR(LO);
                     if AT_OP("..") then
                        SKIP;
                        R := NN(N_RANGE, LINE);
                        R.A := LO;
                        SIMPLE_EXPR(R.B);
                        LO := R;
                     end if;
                     LO.FORMAL := FORMAL;
                     LO.FLAG := MARK;
                     APPEND(ARGS, ATAIL, LO);
                  end;
                  MORE := AT_OP(",");
                  if MORE then
                     SKIP;
                  end if;
               end loop;
            end if;
            EXPECT_OP(")");
            X := NN(N_APPLY, LINE);
            X.A := P;
            X.B := ARGS;
            P := X;
         elsif AT_OP(".") then
            SKIP;
            X := NN(N_SELECT, LINE);
            X.A := P;
            if AT_KW("ALL") then
               SKIP;
               X.NAME := MK("ALL");
            else
               EXPECT_ID(X.NAME);
            end if;
            P := X;
         elsif AT_OP("'") then
            -- attributes are not reserved words; they follow ' (RAT79 2.1)
            SKIP;
            X := NN(N_ATTR, LINE);
            X.A := P;
            X.NAME := TOKS(TPOS).S;
            SKIP;
            if AT_OP("(") then
               SKIP;
               EXPR(X.B);
               EXPECT_OP(")");
            end if;
            P := X;
         else
            RES := P;
            return;
         end if;
      end loop;
   end NAME_P;

   -- component_list ::= {object_declaration} [variant_part] | null; a
   -- variant part is an N_CASE whose B holds the alternatives, N_ARMs with
   -- their choices in A (FLAG 1: others) and their components in B (RM79 3.7)
   procedure COMPONENT_LIST(RES : out NODE) is
      COMPS, CTAIL, NAMES, ST, DEF, CM, V, ARM, ATAIL, LABS, LTAIL, L : NODE;
      IS_C : BOOLEAN;
   begin
      loop
         if AT_KW("NULL") then
            SKIP;
            EXPECT_OP(";");
         elsif AT_KW("CASE") then
            V := NN(N_CASE, CUR_LINE);
            SKIP;
            NAME_NODE(V.A);
            EXPECT_KW("OF");
            ATAIL := null;
            while AT_KW("WHEN") loop
               SKIP;
               ARM := NN(N_ARM, CUR_LINE);
               LABS := null;
               LTAIL := null;
               loop
                  if AT_KW("OTHERS") then
                     SKIP;
                     ARM.FLAG := 1;
                  else
                     L := NN(N_LABEL, CUR_LINE);
                     SIMPLE_EXPR(L.A);
                     if AT_OP("..") then
                        SKIP;
                        SIMPLE_EXPR(L.B);
                     end if;
                     APPEND(LABS, LTAIL, L);
                  end if;
                  exit when not AT_OP("|");
                  SKIP;
               end loop;
               EXPECT_OP("=>");
               ARM.A := LABS;
               COMPONENT_LIST(ARM.B);
               APPEND(V.B, ATAIL, ARM);
            end loop;
            EXPECT_KW("END");
            EXPECT_KW("CASE");
            EXPECT_OP(";");
            APPEND(COMPS, CTAIL, V);
         elsif AT_KIND(K_ID) then
            ID_LIST(NAMES);
            EXPECT_OP(":");
            IS_C := FALSE;
            if AT_KW("CONSTANT") then
               SKIP;
               IS_C := TRUE;
            end if;
            TYPE_SPEC(ST);
            DEF := null;
            if AT_OP(":=") then
               SKIP;
               EXPR(DEF);
            end if;
            EXPECT_OP(";");
            while NAMES /= null loop
               CM := NN(N_COMP, NAMES.LINE);
               CM.NAME := NAMES.NAME;
               CM.A := ST;
               CM.B := DEF;
               if IS_C then
                  CM.FLAG := 1;
               end if;
               APPEND(COMPS, CTAIL, CM);
               NAMES := NAMES.NEXT;
            end loop;
         else
            RES := COMPS;
            return;
         end if;
      end loop;
   end COMPONENT_LIST;

   -- discrete_range ::= [type_mark range] range; a type mark alone also
   -- names its range (RM79 3.6): an S_MARK, an N_RANGE or an expression
   procedure DISCRETE_RANGE_P(RES : out NODE) is
      LO, R : NODE;
      LINE : INTEGER := CUR_LINE;
   begin
      if AT_KIND(K_ID) and KIND_AT(1) = K_KW and TEXT_AT(1) = "RANGE" then
         SUBTYPE_IND(RES);
         return;
      end if;
      if AT_KIND(K_ID) and KIND_AT(1) = K_OP and TEXT_AT(1) = "." and KIND_AT(2) = K_ID
         and KIND_AT(3) = K_KW and TEXT_AT(3) = "RANGE" then
         SUBTYPE_IND(RES);
         return;
      end if;
      SIMPLE_EXPR(LO);
      if AT_OP("..") then
         SKIP;
         R := NN(N_RANGE, LINE);
         R.A := LO;
         SIMPLE_EXPR(R.B);
         RES := R;
         return;
      end if;
      RES := LO;
      return;
   end DISCRETE_RANGE_P;

   -- ---- types and subtypes (RM79 3) ------------------------------------------------

   -- type_mark [constraint]
   procedure SUBTYPE_IND(RES : out NODE) is
      F : TEXT;
      X, R, ARGS, ATAIL, LO : NODE;
      LINE : INTEGER := CUR_LINE;
      MORE : BOOLEAN := TRUE;
   begin
      X := NN(S_MARK, LINE);
      EXPECT_ID(X.NAME);
      while AT_OP(".") loop
         SKIP;
         X.TAG := X.NAME;
         EXPECT_ID(X.NAME);
      end loop;
      if AT_KW("RANGE") then
         SKIP;
         R := NN(N_RANGE, LINE);
         SIMPLE_EXPR(R.A);
         EXPECT_OP("..");
         SIMPLE_EXPR(R.B);
         X.A := R;
         X.FLAG := 1;
      elsif AT_OP("(") then
         -- an index constraint or a discriminant constraint, whose named
         -- associations are D => value (RM79 3.6, 3.7.3)
         SKIP;
         while MORE loop
            if AT_KIND(K_ID) and KIND_AT(1) = K_OP and TEXT_AT(1) = "=>" then
               EXPECT_ID(F);
               SKIP;
               EXPR(LO);
               LO.FORMAL := F;
            else
               DISCRETE_RANGE_P(LO);
            end if;
            APPEND(ARGS, ATAIL, LO);
            MORE := AT_OP(",");
            if MORE then
               SKIP;
            end if;
         end loop;
         EXPECT_OP(")");
         X.A := ARGS;
         X.FLAG := 2;
      elsif AT_KW("DIGITS") or AT_KW("DELTA") then
         -- an accuracy constraint (RM79 3.5.5): B the digits or delta, A the range
         SKIP;
         SIMPLE_EXPR(X.B);
         X.FLAG := 3;
         if AT_KW("RANGE") then
            SKIP;
            R := NN(N_RANGE, LINE);
            SIMPLE_EXPR(R.A);
            EXPECT_OP("..");
            SIMPLE_EXPR(R.B);
            X.A := R;
         end if;
      end if;
      RES := X;
      return;
   end SUBTYPE_IND;

   -- a type in an object declaration: a subtype indication or an anonymous
   -- type definition (RM79 3.3)
   procedure TYPE_SPEC(RES : out NODE) is
      X : NODE;
   begin
      if AT_OP("(") or AT_KW("ARRAY") or AT_KW("RECORD") or AT_KW("ACCESS") or AT_KW("RANGE")
         or AT_KW("DIGITS") or AT_KW("DELTA") or AT_KW("NEW") then
         TYPE_DEF(X);
      else
         SUBTYPE_IND(X);
      end if;
      RES := X;
      return;
   end TYPE_SPEC;

   procedure TYPE_DEF(RES : out NODE) is
      X, LITS, LTAIL, L, IDX, ITAIL, R, COMPS, CTAIL, NAMES, ST, DEF, CM : NODE;
      LINE : INTEGER := CUR_LINE;
      MORE : BOOLEAN := TRUE;
   begin
      if AT_OP("(") then
         -- enumeration (RM79 3.5.1): identifiers and character literals
         SKIP;
         X := NN(D_ENUM, LINE);
         while MORE loop
            if AT_KIND(K_STR) then
               L := NN(N_STR, LINE);
               L.NAME := TOKS(TPOS).S;
               SKIP;
            else
               NAME_NODE(L);
            end if;
            APPEND(LITS, LTAIL, L);
            MORE := AT_OP(",");
            if MORE then
               SKIP;
            end if;
         end loop;
         EXPECT_OP(")");
         X.A := LITS;
         RES := X;
         return;
      end if;
      if AT_KW("RANGE") then
         SKIP;
         X := NN(D_RANGE, LINE);
         SIMPLE_EXPR(X.A);
         EXPECT_OP("..");
         SIMPLE_EXPR(X.B);
         RES := X;
         return;
      end if;
      if AT_KW("DIGITS") or AT_KW("DELTA") then
         -- real types (RM79 3.5.5): FLAG 1 digits, 2 delta; A the accuracy, B the range
         X := NN(D_FLOAT, LINE);
         X.FLAG := 1;
         if AT_KW("DELTA") then
            X.FLAG := 2;
         end if;
         SKIP;
         SIMPLE_EXPR(X.A);
         if AT_KW("RANGE") then
            SKIP;
            R := NN(N_RANGE, LINE);
            SIMPLE_EXPR(R.A);
            EXPECT_OP("..");
            SIMPLE_EXPR(R.B);
            X.B := R;
         end if;
         RES := X;
         return;
      end if;
      if AT_KW("ARRAY") then
         -- RM79 3.6: every index a discrete range, or every index a type mark
         SKIP;
         X := NN(D_ARRAY, LINE);
         EXPECT_OP("(");
         while MORE loop
            if AT_KIND(K_ID) and KIND_AT(1) = K_OP and (TEXT_AT(1) = "," or TEXT_AT(1) = ")") then
               L := NN(S_MARK, LINE);
               EXPECT_ID(L.NAME);
               X.FLAG := 1;
            else
               DISCRETE_RANGE_P(L);
               if L.KIND /= N_RANGE and L.KIND /= S_MARK then
                  PERROR("an index is a discrete range or a type mark (RM79 3.6)");
               end if;
            end if;
            APPEND(IDX, ITAIL, L);
            MORE := AT_OP(",");
            if MORE then
               SKIP;
            end if;
         end loop;
         EXPECT_OP(")");
         EXPECT_KW("OF");
         X.A := IDX;
         TYPE_SPEC(X.B);
         RES := X;
         return;
      end if;
      if AT_KW("RECORD") then
         -- RM79 3.7; a deferred constant component is a discriminant
         SKIP;
         X := NN(D_RECORD, LINE);
         COMPONENT_LIST(X.A);
         EXPECT_KW("END");
         EXPECT_KW("RECORD");
         RES := X;
         return;
      end if;
      if AT_KW("ACCESS") then
         SKIP;
         X := NN(D_ACCESS, LINE);
         TYPE_SPEC(X.A);
         RES := X;
         return;
      end if;
      if AT_KW("NEW") then
         SKIP;
         X := NN(D_DERIVED, LINE);
         SUBTYPE_IND(X.A);
         RES := X;
         return;
      end if;
      PERROR("expected a type definition");
      RES := null;
      return;
   end TYPE_DEF;
