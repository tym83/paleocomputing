   -- ---- declarative parts (RM79 6.1) -------------------------------------------------

   -- where a declared object lives: a global at library level, otherwise a
   -- field of the frame of the subprogram at the current level
   procedure STORAGE(NAME : STRING; T : TYP; ACCESS_CODE : out TEXT) is
      CT, G : TEXT;
   begin
      CTYPE(T, CT);
      if not IN_FUNC then
         NEW_NAME("g_" & LOWER_S(NAME) & "_", G);
         PUT_TO(OUT_GLOBALS, "static " & CT.all & " " & G.all & ";");
         ST_FIELD := G;
         ACCESS_CODE := G;
      else
         NEW_NAME(LOWER_S(NAME) & "_", G);
         PUT_TO(FIELDS_BUF, " " & CT.all & " " & G.all & ";");
         ST_FIELD := G;
         ACCESS_CODE := MK("F->" & G.all);
      end if;
   end STORAGE;

   procedure BIND(Y : SYM; ACCESS_CODE : TEXT) is
   begin
      if IN_FUNC then
         Y.LEVEL := CUR_LEVEL;
         Y.ACCESS_PATH := ST_FIELD;
      else
         Y.LEVEL := 0;
         Y.ACCESS_PATH := ACCESS_CODE;
      end if;
   end BIND;

   -- the subprograms of a declarative part may be called before their bodies:
   -- their specifications are declared when the first body is reached
   procedure DECLARE_SUBPROGRAMS(FROM : NODE) is
      E : NODE := FROM;
   begin
      while E /= null loop
         if (E.KIND = N_PROC or E.KIND = N_FUNC) and (E.IVAL = 0 or E.IVAL = 3) then
            if not GENERIC_BEFORE(FROM, E) then
               DECLARE_ONE(E);
            end if;
         end if;
         E := E.NEXT;
      end loop;
   end DECLARE_SUBPROGRAMS;

   -- the body of a generic subprogram declared in the same list
   function GENERIC_BEFORE(FROM, E : NODE) return BOOLEAN is
      P : NODE := FROM;
   begin
      while P /= null and P /= E loop
         if P.KIND = N_GENERIC and then P.NAME.all = E.NAME.all then
            return TRUE;
         end if;
         P := P.NEXT;
      end loop;
      return FALSE;
   end GENERIC_BEFORE;

   -- a body completes an earlier declaration of the same subprogram, if there
   -- is one (RM79 6.4); otherwise it declares the subprogram
   procedure DECLARE_ONE(E : NODE) is
      Y, Z : SYM;
   begin
      if IS_GENERIC_NAME(E.NAME.all) then
         return;
      end if;
      BUILD_SUBPROGRAM(E, Y);
      Z := TABLE(HASH(Y.NAME.all));
      while Z /= null loop
         if Z.NAME.all = Y.NAME.all and then (Z.KIND = Y_FUNC or Z.KIND = Y_PROC)
            and then Z.DECL /= null and then Z.DECL.IVAL = 1 and then Z.DEPTH = DEPTH
            and then SAME_SIGNATURE(Z.PARAMS, Y.PARAMS) and then SAME(Z.RESULT, Y.RESULT) then
            Z.DECL := E;
            return;
         end if;
         Z := Z.CHAIN;
      end loop;
      -- the body of a subprogram of the visible part of the task being compiled
      if CUR_TASK /= null then
         Z := CUR_TASK.MEMBERS;
         while Z /= null loop
            if Z.NAME.all = Y.NAME.all and then (Z.KIND = Y_FUNC or Z.KIND = Y_PROC)
               and then Z.DECL /= null and then Z.DECL.IVAL = 1
               and then SAME_SIGNATURE(Z.PARAMS, Y.PARAMS) and then SAME(Z.RESULT, Y.RESULT) then
               Y.CNAME := Z.CNAME;
               Z.DECL := E;
               exit;
            end if;
            Z := Z.MNEXT;
         end loop;
      end if;
      DEFINE(Y, E.LINE);
      ELABORATE_DEFAULTS(Y);
   end DECLARE_ONE;

   -- the defaults of the in parameters of Y are evaluated where its
   -- specification is elaborated (RM79 6.3); only in parameters take one
   -- (RM79 5.2.2)
   procedure ELABORATE_DEFAULTS(Y : SYM) is
      PM : PARM := Y.PARAMS;
      VT : TYP;
      V, ACC, X : TEXT;
      Z : SYM;
   begin
      while PM /= null loop
         if PM.DFLT /= null then
            if PM.MODE /= M_IN then
               FAIL(PM.DFLT.LINE, "only an in parameter takes a default (RM79 6.3)");
            end if;
            GEXPR(PM.DFLT, PM.T, VT, V);
            CHECK_TYPE(VT, PM.T, PM.DFLT.LINE);
            Z := NEW_SYM(Y_CONST, MK("dflt"));
            STORAGE("dflt", PM.T, ACC);
            Z.T := PM.T;
            Z.C := PM.C;
            BIND(Z, ACC);
            COPY_CODE(PM.T, V.all, X);
            EMIT(ACC.all & " = " & X.all & ";");
            PM.DSYM := Z;
         end if;
         PM := PM.NEXT;
      end loop;
   end ELABORATE_DEFAULTS;

   procedure BUILD_SUBPROGRAM(D : NODE; Y : out SYM) is
      P : NODE := D.A;
      PM, TAIL : PARM;
      RC : CONS;
      K : INTEGER := Y_PROC;
   begin
      if D.KIND = N_FUNC then
         K := Y_FUNC;
      end if;
      Y := NEW_SYM(K, D.NAME);
      while P /= null loop
         PM := new PARM_REC(P.NAME, P.IVAL, null, null, null, P.B, null, null);
         RESOLVE(P.A, PM.T, PM.C);
         NEW_NAME(LOWER_S(P.NAME.all) & "_", PM.CFIELD);
         if D.KIND = N_FUNC and PM.MODE /= M_IN then
            FAIL(P.LINE, "a function can only have in parameters (RM79 6.5)");
         end if;
         if D.FLAG = 1 and PM.MODE /= M_IN then
            FAIL(P.LINE, "a value-returning procedure can only have in parameters (RM79 6.5)");
         end if;
         if TAIL = null then
            Y.PARAMS := PM;
         else
            TAIL.NEXT := PM;
         end if;
         TAIL := PM;
         P := P.NEXT;
      end loop;
      Y.RESULT := TY_VOID;
      if D.B /= null then
         RESOLVE(D.B, Y.RESULT, RC);
         -- the result subtype constrains the value returned (RM79 6.5)
         Y.C := RC;
      end if;
      if IS_REL(D.NAME.all) and then Y.RESULT /= TY_BOOL then
         -- a relational operator returns BOOLEAN (RM79 6.6.1)
         FAIL(D.LINE, "the relational operator " & D.NAME.all & " returns BOOLEAN (RM79 6.6.1)");
      end if;
      Y.VRP := D.FLAG = 1;
      NEW_NAME("f_" & C_IDENT(D.NAME.all) & "_", Y.CNAME);
      Y.DECL := D;
      Y.LEVEL := CUR_LEVEL;
   end BUILD_SUBPROGRAM;

   procedure DECL_ELEMENTS(DECLS : NODE) is
      E : NODE := DECLS;
      DECLARED : BOOLEAN := FALSE;
   begin
      ANON_NODE := null;
      PENDING_ADDRESSES(DECLS);
      while E /= null loop
         if (E.KIND /= N_VAR and E.KIND /= N_CONST) or else E.A /= ANON_NODE then
            ANON_NODE := null;
         end if;
         -- a specification given before its body is declared in place, and
         -- the body completes it (RM79 6.2, 6.4)
         if (E.KIND = N_PROC or E.KIND = N_FUNC) and E.IVAL /= 1 and not DECLARED then
            DECLARE_SUBPROGRAMS(E);
            DECLARED := TRUE;
         end if;
         DECL_ELEMENT(E);
         E := E.NEXT;
      end loop;
   end DECL_ELEMENTS;

   procedure DECL_ELEMENT(E : NODE) is
      SAVED : BARRIER := BARRIERS;
   begin
      if E.FORMAL /= null and then (E.KIND = N_PROC or E.KIND = N_FUNC or E.KIND = N_PKGSPEC
         or E.KIND = N_PKGBODY or E.KIND = N_TASKSPEC or E.KIND = N_TASKBODY or E.KIND = N_GENERIC) then
         PUSH_BARRIER(E, DEPTH);
         DECL_ELEMENT_1(E);
         BARRIERS := SAVED;
         return;
      end if;
      DECL_ELEMENT_1(E);
   end DECL_ELEMENT;

   procedure DECL_ELEMENT_1(E : NODE) is
      PD : NODE;
      Y, Z : SYM;
      T, VT : TYP;
      C : CONS;
      ACC, V, X : TEXT;
      OK : BOOLEAN;
      PA : ADDR;
   begin
      case E.KIND of
         when 42 =>
            -- type declaration (RM79 3.3); the full declaration of a private
            -- type completes the type declared in the visible part (RM79 7.4)
            Y := LOOKUP(E.NAME.all);
            if Y /= null and then Y.KIND = Y_TYPE and then Y.DEPTH = DEPTH and then Y.T /= null
               and then Y.T.PRIV and then Y.T.KIND = T_VOID and then E.A.KIND /= D_PRIVATE then
               COMPLETING := Y.T;
               X := Y.T.NAME;
               PD := Y.T.DECL;
               OK := Y.T.IS_RESTRICTED;
               TYPE_DEFINITION(E.A, E.NAME, T, C);
               COMPLETING := null;
               if T /= Y.T then
                  Y.T.all := T.all;
               end if;
               Y.T.NAME := X;
               Y.T.PRIV := TRUE;
               Y.T.DECL := PD;
               Y.T.IS_RESTRICTED := OK;
               Y.C := C;
            else
               Y := NEW_SYM(Y_TYPE, E.NAME);
               Y.DECL := E;
               DEFINE(Y, E.LINE);
               if E.A.KIND = D_PRIVATE then
                  Y.T := NEW_TYP(T_VOID);
                  Y.T.NAME := E.NAME;
                  Y.T.PRIV := TRUE;
                  Y.T.DECL := CUR_PKG;
                  Y.T.IS_RESTRICTED := E.FLAG = 9;
               else
                  TYPE_DEFINITION(E.A, E.NAME, Y.T, Y.C);
               end if;
            end if;
         when 43 =>
            Y := NEW_SYM(Y_TYPE, E.NAME);
            RESOLVE(E.A, Y.T, Y.C);
            DEFINE(Y, E.LINE);
         when 40 =>
            -- object declaration (RM79 3.2)
            RESOLVE_OBJECT_TYPE(E.A, T, C);
            Y := NEW_SYM(Y_VAR, E.NAME);
            if E.FLAG = 2 then
               -- a renaming holds the address of the object it renames (RM79 8.5)
               LVALUE(E.B, V, VT, C, Y.RO);
               CHECK_TYPE(VT, T, E.LINE);
               CTYPE(T, ACC);
               NEW_NAME(LOWER_S(E.NAME.all) & "_", X);
               if IN_FUNC then
                  PUT_TO(FIELDS_BUF, " " & ACC.all & " *" & X.all & ";");
                  EMIT("F->" & X.all & " = &(" & V.all & ");");
                  Y.BYREF := TRUE;
                  Y.LEVEL := CUR_LEVEL;
                  Y.ACCESS_PATH := X;
               else
                  PUT_TO(OUT_GLOBALS, "static " & ACC.all & " *g_" & X.all & ";");
                  EMIT("g_" & X.all & " = &(" & V.all & ");");
                  Y.LEVEL := 0;
                  Y.ACCESS_PATH := MK("(*g_" & X.all & ")");
               end if;
               Y.T := VT;
               Y.C := C;
               DEFINE(Y, E.LINE);
               return;
            end if;
            if (T.KIND = T_ARRAY and not BOUNDED(C)) and E.B /= null then
               -- the bounds come from the initial value (RM79 3.6)
               VRP_OK := TRUE;
               GEXPR(E.B, T, VT, V);
               VRP_OK := FALSE;
               CHECK_TYPE(VT, T, E.LINE);
               STORAGE(E.NAME.all, T, ACC);
               COPY_CODE(T, V.all, X);
               EMIT(ACC.all & " = " & X.all & ";");
               PA := PENDING_ADDRESS(E.NAME.all);
               if PA /= null then
                  PLACE_OBJECT(PA, Y, T, ACC);
                  PLACE_COMPONENTS(PA, T, ACC.all, E.LINE);
               end if;
            else
               PA := PENDING_ADDRESS(E.NAME.all);
               if PA /= null and T.KIND /= T_ARRAY then
                  -- the object is a place of the memory of the machine (RM79 13.5)
                  PLACE_OBJECT(PA, Y, T, ACC);
               else
                  STORAGE(E.NAME.all, T, ACC);
               end if;
               INIT_STORAGE(ACC.all, T, C);
               if E.B /= null then
                  if RESTRICTED_HERE(T) then
                     FAIL(E.LINE, "a restricted type has no assignment: no initial value (RM79 7.4)");
                  end if;
                  if IS_CONST_ACCESS(E.B) then
                     FAIL(E.LINE, "a constant of an access type cannot be assigned to a variable (RM79 3.8)");
                  end if;
                  VRP_OK := TRUE;
                  if T.KIND = T_ARRAY and E.B.KIND = N_AGG then
                     AGG_BOUNDS := ACC;
                  end if;
                  GEXPR(E.B, T, VT, V);
                  AGG_BOUNDS := null;
                  VRP_OK := FALSE;
                  CHECK_TYPE(VT, T, E.LINE);
                  ASSIGN_CODE(ACC.all, T, V.all, C, X);
                  EMIT(X.all);
               end if;
               if PA /= null and T.KIND = T_ARRAY then
                  PLACE_OBJECT(PA, Y, T, ACC);
                  PLACE_COMPONENTS(PA, T, ACC.all, E.LINE);
               end if;
            end if;
            Y.T := T;
            Y.C := C;
            if PA = null or T.KIND = T_ARRAY then
               BIND(Y, ACC);
            end if;
            DEFINE(Y, E.LINE);
         when 41 =>
            RESOLVE_OBJECT_TYPE(E.A, T, C);
            Z := LOOKUP(E.NAME.all);
            if E.B = null then
               -- a deferred constant of a private type, completed in the
               -- private part (RM79 7.4)
               if CUR_PKG = null or else not (T.PRIV and T.KIND = T_VOID) then
                  FAIL(E.LINE, "a constant needs a value; only a constant of a private type is deferred (RM79 7.4)");
               end if;
               Y := NEW_SYM(Y_CONST, E.NAME);
               Y.T := T;
               Y.C := C;
               Y.RO := TRUE;
               Y.FLAGS := F_CONST_OBJ + F_DEFERRED;
               DEFINE(Y, E.LINE);
               return;
            end if;
            if Z /= null and then Z.DEPTH = DEPTH and then Z.KIND = Y_CONST and then Z.FLAGS = F_CONST_OBJ + F_DEFERRED then
               -- the full declaration of a deferred constant (RM79 7.4)
               CHECK_TYPE(T, Z.T, E.LINE);
               GEXPR(E.B, T, VT, V);
               CHECK_TYPE(VT, T, E.LINE);
               STORAGE(E.NAME.all, T, ACC);
               BIND(Z, ACC);
               COPY_CODE(T, V.all, X);
               EMIT(ACC.all & " = " & X.all & ";");
               Z.FLAGS := F_CONST_OBJ;
               return;
            end if;
            Y := NEW_SYM(Y_CONST, E.NAME);
            Y.FLAGS := F_CONST_OBJ;
            VRP_OK := TRUE;
            GEXPR(E.B, T, VT, V);
            VRP_OK := FALSE;
            CHECK_TYPE(VT, T, E.LINE);
            if T.KIND = T_INT then
               MANIFEST(E.B, Y.MVALUE, OK);
               Y.HASMV := OK;
            end if;
            STORAGE(E.NAME.all, T, ACC);
            COPY_CODE(T, V.all, X);
            EMIT(ACC.all & " = " & X.all & ";");
            Y.T := T;
            Y.C := C;
            Y.RO := TRUE;
            BIND(Y, ACC);
            DEFINE(Y, E.LINE);
         when 46 =>
            if E.A /= null then
               -- a renaming is the same exception under another name (RM79 8.5)
               if E.A.KIND = N_SELECT and then IS_PACKAGE(E.A.A) then
                  Y := MEMBER_OF(PATH_OF(E.A.A), E.A.NAME.all, E.LINE);
               elsif E.A.KIND = N_NAME then
                  Y := LOOKUP(E.A.NAME.all);
               else
                  Y := null;
               end if;
               if Y = null or else Y.KIND /= Y_EXC then
                  FAIL(E.LINE, "an exception is renamed only as an exception");
               end if;
               COPY_SYM(Y, Z);
               Z.NAME := E.NAME;
               DEFINE(Z, E.LINE);
               return;
            end if;
            -- an exception declaration is one exception, even in a recursive
            -- procedure (RM79 11.1)
            Y := NEW_SYM(Y_EXC, E.NAME);
            NEW_NAME("ex_" & LOWER_S(E.NAME.all) & "_", Y.CNAME);
            PUT_TO(OUT_GLOBALS, "static int " & Y.CNAME.all & ";");
            PUT_TO(OUT_EXCS, "  " & Y.CNAME.all & " = rt_exc(" & Q & E.NAME.all & Q & ");");
            DEFINE(Y, E.LINE);
         when 44 | 45 =>
            if E.IVAL = 0 and then IS_GENERIC_NAME(E.NAME.all) then
               ATTACH_GENERIC_BODY(E);
            elsif E.IVAL = 2 then
               RENAME_SUBPROGRAM(E);
            elsif E.IVAL = 3 then
               STUB(E);
            elsif E.IVAL = 1 then
               BUILD_SUBPROGRAM(E, Y);
               DEFINE(Y, E.LINE);
               ELABORATE_DEFAULTS(Y);
            else
               SUBPROGRAM_BODY(E, LOOKUP_DECL(E));
            end if;
         when 55 =>
            USE_CLAUSE(E);
         when 56 =>
            PRAGMA_DECL(E);
         when 38 =>
            REPRESENTATION(E);
         when others =>
            OTHER_DECL(E);
      end case;
   end DECL_ELEMENT_1;

   -- a pragma among the declarations (RM79 2.7, App. B)
   -- pragma SUPPRESS names exceptions; it permits the omission of checks
   -- and does not oblige it (RM79 11.8): the checks stay
   procedure PRAGMA_DECL(E : NODE) is
      A : NODE := E.A;
      Y : SYM;
   begin
      if E.NAME.all = "SUPPRESS" then
         while A /= null loop
            Y := LOOKUP(A.NAME.all);
            if Y = null or else Y.KIND /= Y_EXC then
               FAIL(E.LINE, "pragma SUPPRESS names exceptions: " & A.NAME.all & " is not one (RM79 11.8)");
            end if;
            A := A.NEXT;
         end loop;
      end if;
   end PRAGMA_DECL;

   -- the type of an object declaration; C, D : (WHITE, GREY, BLACK); gives
   -- C and D one type (RM79 3.3)
   procedure RESOLVE_OBJECT_TYPE(ST : NODE; T : out TYP; C : out CONS) is
   begin
      if ST.KIND /= S_MARK and ST = ANON_NODE then
         T := ANON_TYP;
         C := ANON_CONS;
         return;
      end if;
      RESOLVE(ST, T, C);
      if ST.KIND /= S_MARK then
         ANON_NODE := ST;
         ANON_TYP := T;
         ANON_CONS := C;
      end if;
   end RESOLVE_OBJECT_TYPE;

   -- packages are in 09-units, tasks and generics in 10-tasks and 11-generics
   -- the subunit for the stub E, in this compilation (RM79 10.2)
   procedure FIND_SUBUNIT(E : NODE; R : out NODE) is
      U : NODE := UNITS;
      K : INTEGER;
   begin
      R := null;
      while U /= null loop
         if U.FORMAL /= null and then U.FORMAL.all(1) = "!" and then U.NAME.all = E.NAME.all then
            if U.KIND = E.KIND or ((U.KIND = N_PROC or U.KIND = N_FUNC) and (E.KIND = N_PROC or E.KIND = N_FUNC)) then
               R := U;
               return;
            end if;
         end if;
         U := U.NEXT;
      end loop;
   end FIND_SUBUNIT;

   -- a body stub: its subunit is translated here, seeing what an enclosing
   -- unit sees, that unit being named first in its visibility list (RM79 10.2)
   procedure STUB(E : NODE) is
      SUB : NODE;
      SAVED : BARRIER := BARRIERS;
      K, D : INTEGER;
      FIRST_NAME, LIST : TEXT;
      Y : SYM;
   begin
      FIND_SUBUNIT(E, SUB);
      if SUB = null then
         -- the subunit may be in the program library (RM79 10.4)
         for I in reverse 1 .. NUNITS loop
            if SUB = null then
               LIB_LOAD(UNIT_NAMES(I).all & "." & E.NAME.all & ".sub", SUB);
            end if;
         end loop;
         if SUB = null then
            LIB_LOAD(CUR_COMP_UNIT.all & "." & E.NAME.all & ".sub", SUB);
         end if;
         if SUB /= null then
            SUB.NEXT := UNITS;
            UNITS := SUB;
         end if;
      end if;
      if SUB = null then
         FAIL(E.LINE, "the subunit of " & E.NAME.all & " is neither in this compilation nor in the "
              & "program library (RM79 10.2)");
      end if;
      LIST := MK(SUB.FORMAL.all(2 .. SUB.FORMAL.all'LENGTH));
      SUB.FORMAL := MK("#" & LIST.all);
      K := 2;
      while K <= LIST.all'LENGTH and then LIST.all(K) /= "," loop
         K := K + 1;
      end loop;
      FIRST_NAME := MK(LIST.all(2 .. K - 1));
      D := ENCLOSING_DEPTH(FIRST_NAME.all);
      if D < 0 then
         FAIL(SUB.LINE, "the first name in the visibility list of subunit " & SUB.NAME.all
              & " is an enclosing unit (RM79 10.2)");
      end if;
      -- the subunit's own restriction supersedes those around the stub
      BARRIERS := new BARRIER_REC(D - 1, -1, MK(LIST.all & SUB.NAME.all & ","), null);
      if E.KIND = N_PROC or E.KIND = N_FUNC then
         Y := LOOKUP_DECL(E);
         SUBPROGRAM_BODY(SUB, Y);
      elsif E.KIND = N_PKGBODY then
         PACKAGE_BODY(SUB);
      else
         TASK_BODY(SUB);
      end if;
      BARRIERS := SAVED;
   end STUB;

   -- procedure P(...) renames Q; function F(...) return T renames P.G;
   -- procedure P(...) renames T.E (an entry): the other name has the
   -- parameter names and defaults of the renaming (RM79 8.5)
   procedure RENAME_SUBPROGRAM(E : NODE) is
      NEWY, Y, Z, CAND : SYM;
      IX : NODE;
      P, Q, TAIL : PARM;
   begin
      BUILD_SUBPROGRAM(E, NEWY);
      Y := null;
      if E.C.KIND = N_NAME or else (E.C.KIND = N_SELECT and IS_PACKAGE(E.C.A)) then
         if E.C.KIND = N_NAME then
            CAND := TABLE(HASH(E.C.NAME.all));
            while CAND /= null loop
               if CAND.NAME.all = E.C.NAME.all and then (CAND.KIND = Y_FUNC or CAND.KIND = Y_PROC
                  or CAND.KIND = Y_ENTRY) and then VISIBLE_SYM(CAND) then
                  if SAME_TYPES(CAND.PARAMS, NEWY.PARAMS) and SAME(CAND.RESULT, NEWY.RESULT) and Y = null then
                     Y := CAND;
                  end if;
               end if;
               CAND := CAND.CHAIN;
            end loop;
         else
            CAND := LOOKUP_PATH(PATH_OF(E.C.A)).MEMBERS;
            while CAND /= null loop
               if CAND.NAME.all = E.C.NAME.all and then (CAND.KIND = Y_FUNC or CAND.KIND = Y_PROC
                  or CAND.KIND = Y_ENTRY) and then not CAND.HIDDEN then
                  if SAME_TYPES(CAND.PARAMS, NEWY.PARAMS) and SAME(CAND.RESULT, NEWY.RESULT) and Y = null then
                     Y := CAND;
                  end if;
               end if;
               CAND := CAND.MNEXT;
            end loop;
         end if;
      end if;
      if Y = null and E.C.KIND = N_SELECT then
         ENTRY_SYM(E.C, Y, IX);
         if IX /= null or Y.C /= null then
            FAIL(E.LINE, "a renamed entry is an entry of a single task (RM79 8.5)");
         end if;
         if not SAME_TYPES(Y.PARAMS, NEWY.PARAMS) or E.KIND /= N_PROC then
            FAIL(E.LINE, "an entry is renamed as a procedure with the same parameters (RM79 8.5)");
         end if;
      end if;
      if Y = null then
         FAIL(E.LINE, "no subprogram " & E.C.NAME.all & " with this profile to rename (RM79 8.5)");
      end if;
      COPY_SYM(Y, Z);
      Z.NAME := E.NAME;
      Z.DECL := Y.DECL;
      Z.PARAMS := null;
      P := Y.PARAMS;
      Q := NEWY.PARAMS;
      while P /= null loop
         if TAIL = null then
            Z.PARAMS := new PARM_REC(Q.NAME, P.MODE, P.T, P.C, P.CFIELD, Q.DFLT, null, null);
            TAIL := Z.PARAMS;
         else
            TAIL.NEXT := new PARM_REC(Q.NAME, P.MODE, P.T, P.C, P.CFIELD, Q.DFLT, null, null);
            TAIL := TAIL.NEXT;
         end if;
         P := P.NEXT;
         Q := Q.NEXT;
      end loop;
      DEFINE(Z, E.LINE);
      ELABORATE_DEFAULTS(Z);
   end RENAME_SUBPROGRAM;

   -- package L renames P; task T renames U; task LC renames F(6) (RM79 8.5)
   procedure RENAME_MODULE(E : NODE; TARGET : NODE) is
      Y, Z : SYM;
   begin
      if TARGET.KIND = N_APPLY then
         -- a member of a task family: a name for F(I)
         Y := LOOKUP(TARGET.A.NAME.all);
         if Y = null or else Y.KIND /= Y_TASK or else Y.C = null then
            FAIL(E.LINE, TARGET.A.NAME.all & " is not a task family (RM79 8.5)");
         end if;
         COPY_SYM(Y, Z);
         Z.NAME := E.NAME;
         Z.FLAGS := 4;
         Z.DECL := TARGET;
         DEFINE(Z, E.LINE);
         return;
      end if;
      if TARGET.KIND = N_NAME then
         Y := LOOKUP(TARGET.NAME.all);
      elsif TARGET.KIND = N_SELECT then
         Y := LOOKUP_PATH(PATH_OF(TARGET));
      end if;
      if Y = null or else (Y.KIND /= Y_PACKAGE and Y.KIND /= Y_TASK) then
         FAIL(E.LINE, "a module is renamed as a module of the same kind (RM79 8.5)");
      end if;
      if (Y.KIND = Y_TASK) /= (E.KIND = N_TASKSPEC) then
         FAIL(E.LINE, "a package is renamed as a package, a task as a task (RM79 8.5)");
      end if;
      COPY_SYM(Y, Z);
      Z.NAME := E.NAME;
      DEFINE(Z, E.LINE);
   end RENAME_MODULE;

   -- the visibility restriction of a unit, if it has one (RM79 8.3); the
   -- first name may be an enclosing unit, whose declarations stay visible
   procedure PUSH_BARRIER(E : NODE; LIMIT : INTEGER) is
      B : BARRIER;
      FIRST_NAME : TEXT;
      K : INTEGER;
   begin
      B := new BARRIER_REC(LIMIT, -1, MK(E.FORMAL.all & E.NAME.all & ","), BARRIERS);
      K := 2;
      while K <= E.FORMAL.all'LENGTH and then E.FORMAL.all(K) /= "," loop
         K := K + 1;
      end loop;
      if K > 2 then
         FIRST_NAME := MK(E.FORMAL.all(2 .. K - 1));
         B.KEEP := ENCLOSING_DEPTH(FIRST_NAME.all);
      end if;
      BARRIERS := B;
   end PUSH_BARRIER;

   procedure OTHER_DECL(E : NODE) is
   begin
      if E.KIND = N_PKGSPEC and E.FLAG = 3 then
         RENAME_MODULE(E, E.A);
      elsif E.KIND = N_TASKSPEC and E.FLAG = 3 then
         RENAME_MODULE(E, E.B);
      elsif E.KIND = N_PKGSPEC then
         PACKAGE_SPEC(E);
      elsif E.KIND = N_PKGBODY then
         PACKAGE_BODY(E);
      else
         TASK_DECL(E);
      end if;
   end OTHER_DECL;

   -- ---- subprogram bodies (RM79 6.4) ------------------------------------------------

   -- the labels and gotos of a body: labels are distinct (RM79 5); a goto
   -- does not enter a compound statement and does not leave a handler or an
   -- accept statement (RM79 5.8). PATH names the compound statements around
   -- a statement: g a guarded sequence, h a handler, a an accept body.
   procedure SCAN_LABELS(STMTS : NODE; PATH : STRING) is
      S : NODE := STMTS;
      A : NODE;
      L : LABEL_LIST;
      C : TEXT;
   begin
      while S /= null loop
         if S.KIND = N_SLABEL then
            L := BODY_LABELS;
            while L /= null loop
               if L.NAME.all = S.NAME.all then
                  FAIL(S.LINE, "label " & S.NAME.all & " is already used in this body (RM79 5)");
               end if;
               L := L.NEXT;
            end loop;
            NEW_NAME("lbl_" & LOWER_S(S.NAME.all) & "_", C);
            BODY_LABELS := new LABEL_REC(S.NAME, C, MK(PATH), 0, S.LINE, BODY_LABELS);
         elsif S.KIND = N_GOTO then
            BODY_GOTOS := new LABEL_REC(S.NAME, null, MK(PATH), 0, S.LINE, BODY_GOTOS);
         elsif S.KIND = N_IF then
            A := S.A;
            while A /= null loop
               SEGMENTS := SEGMENTS + 1;
               SCAN_LABELS(A.B, PATH & "c" & INTEGER'REP(SEGMENTS) & "/");
               A := A.NEXT;
            end loop;
            SEGMENTS := SEGMENTS + 1;
            SCAN_LABELS(S.B, PATH & "c" & INTEGER'REP(SEGMENTS) & "/");
         elsif S.KIND = N_CASE then
            A := S.B;
            while A /= null loop
               SEGMENTS := SEGMENTS + 1;
               SCAN_LABELS(A.B, PATH & "c" & INTEGER'REP(SEGMENTS) & "/");
               A := A.NEXT;
            end loop;
            SEGMENTS := SEGMENTS + 1;
            SCAN_LABELS(S.C, PATH & "c" & INTEGER'REP(SEGMENTS) & "/");
         elsif S.KIND = N_LOOP then
            SEGMENTS := SEGMENTS + 1;
            SCAN_LABELS(S.B, PATH & "c" & INTEGER'REP(SEGMENTS) & "/");
         elsif S.KIND = N_BLOCK then
            SCAN_GUARDED(S.B, S.C, PATH);
         elsif S.KIND = N_ACCEPT then
            SEGMENTS := SEGMENTS + 1;
            SCAN_LABELS(S.B, PATH & "a" & INTEGER'REP(SEGMENTS) & "/");
         elsif S.KIND = N_SELECTS then
            A := S.A;
            while A /= null loop
               SEGMENTS := SEGMENTS + 1;
               if A.B.KIND = N_ACCEPT then
                  SCAN_LABELS(A.B.B, PATH & "c" & INTEGER'REP(SEGMENTS) & "/a" & INTEGER'REP(SEGMENTS) & "/");
               end if;
               SCAN_LABELS(A.C, PATH & "c" & INTEGER'REP(SEGMENTS) & "/");
               A := A.NEXT;
            end loop;
            SEGMENTS := SEGMENTS + 1;
            SCAN_LABELS(S.B, PATH & "c" & INTEGER'REP(SEGMENTS) & "/");
         end if;
         S := S.NEXT;
      end loop;
   end SCAN_LABELS;

   procedure SCAN_GUARDED(STMTS, HS : NODE; PATH : STRING) is
      H : NODE := HS;
   begin
      SEGMENTS := SEGMENTS + 1;
      if HS = null then
         SCAN_LABELS(STMTS, PATH & "c" & INTEGER'REP(SEGMENTS) & "/");
      else
         SCAN_LABELS(STMTS, PATH & "g" & INTEGER'REP(SEGMENTS) & "/");
      end if;
      while H /= null loop
         SEGMENTS := SEGMENTS + 1;
         SCAN_LABELS(H.B, PATH & "h" & INTEGER'REP(SEGMENTS) & "/");
         H := H.NEXT;
      end loop;
   end SCAN_GUARDED;

   function COUNT_G(P : STRING) return INTEGER is
      N : INTEGER := 0;
   begin
      for I in P'FIRST .. P'LAST loop
         if P(I) = "g" then
            N := N + 1;
         end if;
      end loop;
      return N;
   end COUNT_G;

   -- the labels of a body whose statements are STMTS and handlers HS, the
   -- exception frames FRAMES open outside it
   procedure LABEL_BODY(STMTS, HS : NODE) is
      L, G : LABEL_LIST;
      GP, LP : TEXT;
   begin
      BODY_LABELS := null;
      BODY_GOTOS := null;
      SEGMENTS := 0;
      SCAN_GUARDED(STMTS, HS, "/");
      L := BODY_LABELS;
      while L /= null loop
         L.FRAMES := FRAMES + COUNT_G(L.PATH.all);
         L := L.NEXT;
      end loop;
      G := BODY_GOTOS;
      while G /= null loop
         L := BODY_LABELS;
         while L /= null and then L.NAME.all /= G.NAME.all loop
            L := L.NEXT;
         end loop;
         if L = null then
            FAIL(G.LINE, "goto " & G.NAME.all & ": no such label in this body (RM79 5.8)");
         end if;
         GP := G.PATH;
         LP := L.PATH;
         if LP.all'LENGTH > GP.all'LENGTH then
            FAIL(G.LINE, "a goto cannot transfer control into a compound statement (RM79 5.8)");
         elsif GP.all(1 .. LP.all'LENGTH) /= LP.all then
            FAIL(G.LINE, "a goto cannot transfer control into a compound statement (RM79 5.8)");
         end if;
         for I in LP.all'LENGTH + 1 .. GP.all'LENGTH loop
            if GP.all(I) = "h" or GP.all(I) = "a" then
               FAIL(G.LINE, "a goto cannot leave an exception handler or an accept statement (RM79 5.8)");
            end if;
         end loop;
         G := G.NEXT;
      end loop;
   end LABEL_BODY;

   procedure GEN_LABEL(S : NODE; GOTO_IT : BOOLEAN) is
      L : LABEL_LIST := BODY_LABELS;
   begin
      while L /= null and then L.NAME.all /= S.NAME.all loop
         L := L.NEXT;
      end loop;
      if L = null then
         FAIL(S.LINE, "label " & S.NAME.all & " is not in this body (RM79 5.8)");
      end if;
      if GOTO_IT then
         POP_FRAMES(L.FRAMES);
         EMIT("goto " & L.CNAME.all & ";");
      else
         EMIT(L.CNAME.all & ": ;");
      end if;
   end GEN_LABEL;

   -- a body whose statements are only pragma INTERFACE (RM79 13.9)
   function IS_FOREIGN(D : NODE) return BOOLEAN is
   begin
      if D.TAG = null then
         return FALSE;
      elsif D.TAG.all'LENGTH < 10 then
         return FALSE;
      end if;
      return D.TAG.all(1 .. 10) = "INTERFACE ";
   end IS_FOREIGN;

   -- the call of the foreign body of Y: a routine of the runtime for C, a
   -- routine of the host's mathematical library for FORTRAN (RM79 13.9)
   procedure FOREIGN_CALL(D : NODE; Y : SYM; R : out TEXT) is
      LANG : STRING := D.TAG.all(11 .. D.TAG.all'LENGTH);
      N : STRING := D.NAME.all;
      PM : PARM := Y.PARAMS;
      X, CT : TEXT;
      ALL_REAL : BOOLEAN := Y.RESULT.KIND = T_FLOAT;
   begin
      X := MK("");
      while PM /= null loop
         if X'LENGTH > 0 then
            X := MK(X.all & ", ");
         end if;
         if PM.T.KIND /= T_FLOAT or PM.MODE /= M_IN then
            ALL_REAL := FALSE;
         end if;
         if IS_STRING(PM.T) and PM.MODE = M_IN then
            X := MK(X.all & "rt_g_g2s(F->" & PM.CFIELD.all & ")");
         else
            X := MK(X.all & "F->" & PM.CFIELD.all);
         end if;
         PM := PM.NEXT;
      end loop;
      if LANG = "UNSAFE_CONVERSION" and then (Y.PARAMS /= null and Y.RESULT.KIND /= T_VOID) then
         -- the body of UNSAFE_PROGRAMMING.UNSAFE_CONVERSION: the bits of the
         -- value, seen as a value of the other type (RM79 13.10)
         CTYPE(Y.RESULT, CT);
         UNSAFE_BITS(Y.PARAMS.T, Y.RESULT, "F->" & Y.PARAMS.CFIELD.all, CT.all, R);
      elsif LANG = "C" then
         R := MK("rt_g_" & LOWER_S(N) & "(" & X.all & ")");
      elsif LANG = "FORTRAN" then
         if not ALL_REAL then
            FAIL(D.LINE, "the FORTRAN routines of this implementation take and return real values (RM79 13.9)");
         elsif N = "SQRT" or N = "SIN" or N = "COS" or N = "TAN" or N = "ASIN" or N = "ACOS" or N = "ATAN"
            or N = "EXP" or N = "SINH" or N = "COSH" or N = "TANH" or N = "ATAN2" then
            R := MK(LOWER_S(N) & "(" & X.all & ")");
         elsif N = "ALOG" or N = "LOG" then
            R := MK("log(" & X.all & ")");
         elsif N = "ALOG10" or N = "LOG10" then
            R := MK("log10(" & X.all & ")");
         elsif N = "ABS" or N = "FABS" then
            R := MK("fabs(" & X.all & ")");
         else
            FAIL(D.LINE, "the FORTRAN library of this implementation has no routine " & N
                 & "; it has SQRT, SIN, COS, TAN, ASIN, ACOS, ATAN, ATAN2, EXP, ALOG, ALOG10, SINH, COSH, "
                 & "TANH and ABS (RM79 13.9)");
         end if;
      else
         FAIL(D.LINE, "pragma INTERFACE(" & LANG & "): this implementation calls C and FORTRAN (RM79 13.9)");
      end if;
   end FOREIGN_CALL;

   -- UNSAFE_CONVERSION (RM79 13.10): the storage of a value of type S read
   -- as a value of type T; the bits that T has more than S are zero
   procedure UNSAFE_BITS(S, T : TYP; V, CT : STRING; R : out TEXT) is
      PS : REP := REP_OF(S);
      PT : REP := REP_OF(T);
      SRC, DECODE : TEXT;
   begin
      -- the codes of an enumeration type are its storage (RM79 13.3)
      SRC := MK("__typeof__(" & V & ") s_ = " & V & ";");
      if PS /= null and then PS.CODES /= null then
         SRC := MK("static const rt_int sc_[] = {" & PS.CODES.all & "}; rt_int s_ = sc_[" & V & "];");
      end if;
      DECODE := MK("");
      if PT /= null and then PT.CODES /= null then
         DECODE := MK(" { static const rt_int tc_[] = {" & PT.CODES.all & "}; rt_int b_ = 0; memcpy(&b_, &r_, "
                      & "sizeof r_); for (int k_ = 0; k_ < (int)(sizeof tc_ / sizeof tc_[0]); k_++) if (tc_[k_] == b_) "
                      & "r_ = (" & CT & ")k_; }");
      end if;
      R := MK("({ " & CT & " r_; memset(&r_, 0, sizeof r_); " & SRC.all
              & " memcpy(&r_, &s_, sizeof r_ < sizeof s_ ? sizeof r_ : sizeof s_);" & DECODE.all & " r_; })");
   end UNSAFE_BITS;

   -- the type a statement T(...) names, if T is a type: a code statement
   -- (RM79 13.8); null otherwise
   function CODE_TYPE(S : NODE) return SYM is
      C : NODE;
      Y : SYM;
   begin
      if S.KIND /= N_CALL then
         return null;
      end if;
      C := S.A;
      if C.KIND /= N_APPLY then
         return null;
      end if;
      C := C.A;
      if C.KIND = N_NAME then
         Y := LOOKUP(C.NAME.all);
      elsif C.KIND = N_SELECT and then C.A.KIND = N_NAME then
         Y := MEMBER_OF(C.A.NAME.all, C.NAME.all, 0);
      end if;
      if Y /= null and then Y.KIND = Y_TYPE then
         return Y;
      end if;
      return null;
   end CODE_TYPE;

   -- a procedure that contains a code statement contains only code
   -- statements (RM79 13.8)
   procedure CHECK_CODE_BODY(D : NODE; Y : SYM) is
      S : NODE := D.D;
      N, K : INTEGER := 0;
   begin
      while S /= null loop
         N := N + 1;
         if CODE_TYPE(S) /= null then
            K := K + 1;
         end if;
         S := S.NEXT;
      end loop;
      if K > 0 and (K /= N or D.E /= null or Y.KIND /= Y_PROC) then
         FAIL(D.LINE, "a procedure that contains a code statement contains only code statements (RM79 13.8)");
      end if;
   end CHECK_CODE_BODY;

   procedure SUBPROGRAM_BODY(D : NODE; Y : SYM) is
      SAVED_BODY : NODE := CUR_BODY;
      SAVED_CODE : BUFFER := CODE;
      SAVED_FIELDS : BUFFER := FIELDS_BUF;
      SAVED_IN : BOOLEAN := IN_FUNC;
      SAVED_SYM : SYM := FUNC_SYM;
      SAVED_EXITS : EXITS_T := EXITS;
      SAVED_FRAMES : INTEGER := FRAMES;
      SAVED_HANDLERS : LINES := HANDLERS;
      SAVED_CLEANUPS : LINES := CLEANUPS;
      SAVED_LABELS : LABEL_LIST := BODY_LABELS;
      SAVED_HX : EXITS_T := HANDLER_EXITS;
      SAVED_HD : INTEGER := HANDLER_DEPTH;
      SAVED_PURE : SYM := PURE_SYM;
      AW : TEXT;
      SAVED_PDEPTH : INTEGER := PURE_DEPTH;
      ARGS, HEAD, FRAME, PARENT, CT, X : TEXT;
      PM : PARM := Y.PARAMS;
      P : SYM;
   begin
      FRAME := MK(Y.CNAME.all & "fr");
      if IN_FUNC then
         PARENT := MK(FUNC_SYM.CNAME.all & "fr");
      end if;
      CODE := NEW_BUFFER;
      FIELDS_BUF := NEW_BUFFER;
      IN_FUNC := TRUE;
      FUNC_SYM := Y;
      EXITS := null;
      FRAMES := 0;
      HANDLERS := null;
      CLEANUPS := null;
      HANDLER_EXITS := null;
      HANDLER_DEPTH := 0;
      CUR_LEVEL := CUR_LEVEL + 1;
      ARGS := MK("");
      OPEN_SCOPE;
      PUSH_UNIT(D.NAME);
      if Y.KIND = Y_FUNC and not Y.VRP then
         -- a function has no side effects (RM79 6.5)
         PURE_SYM := Y;
         PURE_DEPTH := DEPTH;
      end if;
      if PARENT /= null then
         PUT_TO(FIELDS_BUF, " struct " & PARENT.all & " *up;");
         ARGS := MK("struct " & PARENT.all & " *up_");
         EMIT("F->up = up_;");
      end if;
      while PM /= null loop
         CTYPE(PM.T, CT);
         if ARGS'LENGTH > 0 then
            ARGS := MK(ARGS.all & ", ");
         end if;
         if PM.MODE = M_IN then
            -- an in parameter acts as a local constant (RM79 6.3)
            P := NEW_SYM(Y_CONST, PM.NAME);
            P.RO := TRUE;
            PUT_TO(FIELDS_BUF, " " & CT.all & " " & PM.CFIELD.all & ";");
            ARGS := MK(ARGS.all & CT.all & " " & PM.CFIELD.all);
            COPY_CODE(PM.T, PM.CFIELD.all, X);
            EMIT("F->" & PM.CFIELD.all & " = " & X.all & ";");
         else
            P := NEW_SYM(Y_VAR, PM.NAME);
            P.BYREF := TRUE;
            PUT_TO(FIELDS_BUF, " " & CT.all & " *" & PM.CFIELD.all & ";");
            ARGS := MK(ARGS.all & CT.all & " *" & PM.CFIELD.all);
            EMIT("F->" & PM.CFIELD.all & " = " & PM.CFIELD.all & ";");
         end if;
         P.ACCESS_PATH := PM.CFIELD;
         P.T := PM.T;
         P.C := PM.C;
         P.LEVEL := CUR_LEVEL;
         DEFINE(P, D.LINE);
         PM := PM.NEXT;
      end loop;
      if Y.RESULT.KIND /= T_VOID then
         CTYPE(Y.RESULT, CT);
         PUT_TO(FIELDS_BUF, " " & CT.all & " result_;");
      end if;
      if IS_FOREIGN(D) then
         DECL_ELEMENTS(D.C);
         FOREIGN_CALL(D, Y, X);
         if Y.RESULT.KIND = T_VOID then
            EMIT(X.all & ";");
         else
            EMIT("F->result_ = " & X.all & ";");
            EMIT("goto ret_;");
         end if;
      else
         CUR_BODY := D;
         LABEL_BODY(D.D, D.E);
         GUARDED(D.C, D.D, D.E, D.LINE);
      end if;
      TASK_AWAITS(D.C, AW);
      NUNITS := NUNITS - 1;
      CLOSE_SCOPE;
      CUR_LEVEL := CUR_LEVEL - 1;
      if ARGS'LENGTH = 0 then
         ARGS := MK("void");
      end if;
      CTYPE(Y.RESULT, CT);
      HEAD := MK("static " & CT.all & " " & Y.CNAME.all & "(" & ARGS.all & ")");
      PUT_TO(OUT_PROTOS, HEAD.all & ";");
      PUT_TO(OUT_FRAMES, "struct " & FRAME.all & " { int dummy;");
      SPLICE(OUT_FRAMES, FIELDS_BUF);
      PUT_TO(OUT_FRAMES, "};");
      PUT_TO(OUT_FUNCS, HEAD.all & " {");
      PUT_TO(OUT_FUNCS, "  struct " & FRAME.all & " *F = rt_alloc(sizeof *F);");
      if Y.KIND = Y_PROC and then Y.ACCESS_PATH /= null then
         -- a task body whose visible subprograms need its frame
         PUT_TO(OUT_FUNCS, "  " & Y.ACCESS_PATH.all);
      end if;
      SPLICE(OUT_FUNCS, CODE);
      if Y.RESULT.KIND /= T_VOID then
         -- leaving a function other than by return (RM79 6.5)
         PUT_TO(OUT_FUNCS, "  rt_raise(RT_X_INIT);");
         PUT_TO(OUT_FUNCS, "ret_:");
         PUT_TO(OUT_FUNCS, AW.all);
         PUT_TO(OUT_FUNCS, "  return F->result_;");
      else
         PUT_TO(OUT_FUNCS, "ret_:");
         -- a unit with local tasks is left only when they have terminated (RM79 9.4)
         PUT_TO(OUT_FUNCS, AW.all);
         PUT_TO(OUT_FUNCS, "  return;");
      end if;
      PUT_TO(OUT_FUNCS, "}");
      PUT_TO(OUT_FUNCS, "");
      CODE := SAVED_CODE;
      FIELDS_BUF := SAVED_FIELDS;
      IN_FUNC := SAVED_IN;
      FUNC_SYM := SAVED_SYM;
      EXITS := SAVED_EXITS;
      FRAMES := SAVED_FRAMES;
      HANDLERS := SAVED_HANDLERS;
      CLEANUPS := SAVED_CLEANUPS;
      PURE_SYM := SAVED_PURE;
      PURE_DEPTH := SAVED_PDEPTH;
      BODY_LABELS := SAVED_LABELS;
      HANDLER_EXITS := SAVED_HX;
      HANDLER_DEPTH := SAVED_HD;
      CUR_BODY := SAVED_BODY;
   end SUBPROGRAM_BODY;

   -- ---- statements (RM79 5) -----------------------------------------------------------

   procedure GEN_STATEMENTS(STMTS : NODE) is
      S : NODE := STMTS;
   begin
      while S /= null loop
         GEN_STATEMENT(S);
         S := S.NEXT;
      end loop;
   end GEN_STATEMENTS;

   -- leaving open frames by exit or return: pop exception frames, and run
   -- whatever else was pushed
   procedure POP_FRAMES(UPTO : INTEGER) is
      I : INTEGER := FRAMES;
      C : LINES := CLEANUPS;
   begin
      while I > UPTO loop
         EMIT(C.S.all);
         C := C.NEXT;
         I := I - 1;
      end loop;
   end POP_FRAMES;

   procedure PUSH_CLEANUP(S : STRING) is
   begin
      CLEANUPS := new LINES_REC(null, CLEANUPS);
      CLEANUPS.S := MK(S);
      FRAMES := FRAMES + 1;
   end PUSH_CLEANUP;

   procedure POP_CLEANUP is
   begin
      CLEANUPS := CLEANUPS.NEXT;
      FRAMES := FRAMES - 1;
   end POP_CLEANUP;

   -- statements with exception handlers (RM79 11.2)
   -- exceptions raised by the elaboration of the declarations DECLS go to
   -- the handlers of the unit too (RM79 11.2)
   procedure GUARDED(DECLS, STMTS, HS : NODE; LINE : INTEGER) is
      SAVED_HX : EXITS_T;
      F, X : TEXT;
      H, N : NODE;
      FIRST : BOOLEAN := TRUE;
      HAS_OTHERS : BOOLEAN := FALSE;
      CONDS : TEXT;
   begin
      if HS = null then
         DECL_ELEMENTS(DECLS);
         GEN_STATEMENTS(STMTS);
         return;
      end if;
      NEW_NAME("xf", F);
      NEW_NAME("x", X);
      PUSH_CLEANUP("RT_POP(" & F.all & ");");
      EMIT("{ rt_frame " & F.all & ";");
      EMIT("if (RT_TRY(" & F.all & ")) {");
      DECL_ELEMENTS(DECLS);
      GEN_STATEMENTS(STMTS);
      EMIT("RT_POP(" & F.all & ");");
      EMIT("} else {");
      POP_CLEANUP;
      EMIT("RT_POP(" & F.all & ");");
      EMIT("int " & X.all & " = rt_xcur;");
      -- an aborted task is not stopped by its handlers (RM79 9.10)
      EMIT("if (rt_g_aborted()) rt_raise(" & X.all & ");");
      HANDLERS := new LINES_REC(X, HANDLERS);
      H := HS;
      while H /= null loop
         N := H.A;
         CONDS := MK("0");
         while N /= null loop
            if N.NAME.all = "OTHERS" then
               HAS_OTHERS := TRUE;
               CONDS := MK("1");
            else
               PREFIX_HINT := N.TAG;
               EXC_ID(N.NAME.all, H.LINE, F);
               CONDS := MK(CONDS.all & " || " & X.all & " == " & F.all);
            end if;
            N := N.NEXT;
         end loop;
         if FIRST then
            EMIT("if (" & CONDS.all & ") {");
         else
            EMIT("} else if (" & CONDS.all & ") {");
         end if;
         FIRST := FALSE;
         SAVED_HX := HANDLER_EXITS;
         HANDLER_EXITS := EXITS;
         HANDLER_DEPTH := HANDLER_DEPTH + 1;
         GEN_STATEMENTS(H.B);
         HANDLER_DEPTH := HANDLER_DEPTH - 1;
         HANDLER_EXITS := SAVED_HX;
         H := H.NEXT;
      end loop;
      if not HAS_OTHERS then
         EMIT("} else {");
         EMIT("rt_raise(" & X.all & ");");
      end if;
      EMIT("}");
      HANDLERS := HANDLERS.NEXT;
      EMIT("}");
      EMIT("}");
   end GUARDED;

   procedure EXC_ID(NAME : STRING; LINE : INTEGER; R : out TEXT) is
      Y : SYM := LOOKUP(NAME);
   begin
      if PREFIX_HINT /= null then
         Y := MEMBER_OF(PREFIX_HINT.all, NAME, LINE);
         PREFIX_HINT := null;
      end if;
      if Y = null or else Y.KIND /= Y_EXC then
         FAIL(LINE, NAME & " is not an exception");
      end if;
      R := Y.CNAME;
   end EXC_ID;

   procedure GEN_STATEMENT(S : NODE) is
      T, VT : TYP;
      C : CONS;
      LV, V, X : TEXT;
      RO : BOOLEAN;
   begin
      case S.KIND of
         when 20 =>
            if S.A.KIND = N_APPLY and then S.A.B /= null and then (S.A.B.KIND = N_RANGE or S.A.B.KIND = S_MARK) then
               SLICE_ASSIGN(S);
               return;
            end if;
            IN_LV_PATH := TRUE;
            LAST_DEREF := FALSE;
            LVALUE(S.A, LV, T, C, RO);
            IN_LV_PATH := FALSE;
            if RO then
               FAIL(S.LINE, "assignment to a constant or an in parameter");
            end if;
            CHECK_PURE_TARGET(S.A, S.LINE);
            if RESTRICTED_HERE(T) then
               FAIL(S.LINE, "a restricted type has no assignment (RM79 7.4)");
            end if;
            if IS_CONST_ACCESS(S.B) then
               FAIL(S.LINE, "a constant of an access type cannot be assigned to a variable (RM79 3.8)");
            end if;
            VRP_OK := TRUE;
            if T.KIND = T_ARRAY and S.B.KIND = N_AGG then
               AGG_BOUNDS := LV;
            end if;
            GEXPR(S.B, T, VT, V);
            AGG_BOUNDS := null;
            VRP_OK := FALSE;
            CHECK_TYPE(VT, T, S.LINE);
            ASSIGN_CODE(LV.all, T, V.all, C, X);
            EMIT(X.all);
         when 21 =>
            VRP_OK := TRUE;
            GEN_CALL(S);
            VRP_OK := FALSE;
         when 22 =>
            GEN_IF(S);
         when 23 =>
            GEN_CASE(S);
         when 24 =>
            GEN_LOOP(S);
         when 25 =>
            GEN_BLOCK(S);
         when 26 =>
            GEN_EXIT(S);
         when 27 =>
            GEN_RETURN(S);
         when 28 =>
            if S.TAG /= null and then IS_TASK_NAME(S.TAG.all) and then S.NAME.all = "FAILURE" then
               -- raise T.FAILURE: the only exception raised in another task (RM79 11.5)
               TASK_FAILURE(S);
            else
               PREFIX_HINT := S.TAG;
               EXC_ID(S.NAME.all, S.LINE, X);
               EMIT("rt_raise(" & X.all & ");");
            end if;
         when 29 =>
            -- raise; re-raises, only in a handler (RM79 11.3)
            if HANDLERS = null then
               FAIL(S.LINE, "raise; outside an exception handler");
            end if;
            EMIT("rt_raise(" & HANDLERS.S.all & ");");
         when 30 =>
            -- assert raises ASSERT_ERROR (RM79 5.9)
            CONDITION(S.A, TY_BOOL, VT, V);
            CHECK_TYPE(VT, TY_BOOL, S.LINE);
            EMIT("if (!(" & V.all & ")) rt_raise(RT_X_ASSERT);");
         when 31 =>
            null;
         when 57 =>
            GEN_LABEL(S, FALSE);
         when 58 =>
            GEN_LABEL(S, TRUE);
         when others =>
            TASK_STATEMENT_GEN(S);
      end case;
   end GEN_STATEMENT;


   -- assignment to a slice of a string (RM79 5.1.1): the lengths must agree
   procedure SLICE_ASSIGN(S : NODE) is
      LV, V, SL, X : TEXT;
      T, ST, VT : TYP;
      C : CONS;
      RO : BOOLEAN;
   begin
      IN_LV_PATH := TRUE;
      LAST_DEREF := FALSE;
      LVALUE(S.A.A, LV, T, C, RO);
      IN_LV_PATH := FALSE;
      if RO then
         FAIL(S.LINE, "assignment to a constant or an in parameter");
      end if;
      CHECK_PURE_TARGET(S.A, S.LINE);
      RO := FALSE;
      INDEX_ON(LV.all, T, S.A, RO, FALSE, SL, ST, C);
      VRP_OK := TRUE;
      GEXPR(S.B, ST, VT, V);
      VRP_OK := FALSE;
      CHECK_TYPE(VT, ST, S.LINE);
      CTYPE(ST, X);
      EMIT("{ " & X.all & " sl_ = " & SL.all & "; as_" & X.all & "(&sl_, " & V.all & "); }");
   end SLICE_ASSIGN;

   procedure GEN_CALL(S : NODE) is
      C : NODE := S.A;
      T : TYP;
      V : TEXT;
   begin
      if C.KIND = N_NAME or C.KIND = N_SELECT then
         C := NN(N_APPLY, S.LINE);
         C.A := S.A;
      end if;
      if C.KIND /= N_APPLY then
         FAIL(S.LINE, "not a procedure call");
      end if;
      POST_CHECKS := null;
      GCALL(C, TRUE, T, V);
      EMIT(V.all & ";");
      if POST_CHECKS /= null then
         EMIT(POST_CHECKS.all);
         POST_CHECKS := null;
      end if;
   end GEN_CALL;

   procedure GEN_IF(S : NODE) is
      A : NODE := S.A;
      FIRST : BOOLEAN := TRUE;
      T : TYP;
      V : TEXT;
   begin
      while A /= null loop
         CONDITION(A.A, TY_BOOL, T, V);
         CHECK_TYPE(T, TY_BOOL, S.LINE);
         if FIRST then
            EMIT("if (" & V.all & ") {");
         else
            EMIT("} else if (" & V.all & ") {");
         end if;
         FIRST := FALSE;
         GEN_STATEMENTS(A.B);
         A := A.NEXT;
      end loop;
      if S.FLAG = 1 then
         EMIT("} else {");
         GEN_STATEMENTS(S.B);
      end if;
      EMIT("}");
   end GEN_IF;

   -- the case statement (RM79 5.5): the choices are static, of the type of
   -- the expression, and cover each of its values exactly once unless others
   -- is given last
   procedure GEN_CASE(S : NODE) is
      ST, VT : TYP;
      FIRST : BOOLEAN := TRUE;
      A : NODE := S.B;
      LAB : NODE;
      SEL, TMP, CT, CONDS, V, LO, HI : TEXT;
      CLO, CHI : array (1 .. 2000) of INTEGER;
      NC : INTEGER := 0;
      VLO, VHI, TOTAL : INTEGER;
      OK, OK2 : BOOLEAN;
      Y : SYM;
   begin
      GEXPR(S.A, null, ST, SEL);
      if not IS_DISCRETE(ST) then
         FAIL(S.LINE, "the expression of a case statement is of a discrete type (RM79 5.5)");
      end if;
      NEW_NAME("sel", TMP);
      CTYPE(ST, CT);
      EMIT("{ " & CT.all & " " & TMP.all & " = " & SEL.all & ";");
      while A /= null loop
         LAB := A.A;
         CONDS := MK("0");
         while LAB /= null loop
            Y := null;
            if LAB.B = null and LAB.A.KIND = N_NAME then
               Y := LOOKUP(LAB.A.NAME.all);
               if Y /= null and then Y.KIND /= Y_TYPE then
                  Y := null;
               end if;
            end if;
            if Y /= null then
               -- a subtype as a choice: its range
               CHECK_TYPE(Y.T, ST, S.LINE);
               if not STATIC_BOUNDS(Y.C) then
                  FAIL(S.LINE, "a choice is static: " & LAB.A.NAME.all & " has no static range (RM79 5.5)");
               end if;
               VLO := Y.C.MLO;
               VHI := Y.C.MHI;
               CONDS := MK(CONDS.all & " || (" & TMP.all & " >= " & Y.C.LO.all & " && " & TMP.all
                           & " <= " & Y.C.HI.all & ")");
            elsif LAB.B = null then
               GEXPR(LAB.A, ST, VT, V);
               CHECK_TYPE(VT, ST, S.LINE);
               STATIC_CHOICE(LAB.A, VLO, OK);
               if not OK then
                  FAIL(S.LINE, "a choice of a case statement is static (RM79 5.5)");
               end if;
               VHI := VLO;
               CONDS := MK(CONDS.all & " || " & TMP.all & " == " & V.all);
            else
               GEXPR(LAB.A, ST, VT, LO);
               CHECK_TYPE(VT, ST, S.LINE);
               GEXPR(LAB.B, ST, VT, HI);
               CHECK_TYPE(VT, ST, S.LINE);
               STATIC_CHOICE(LAB.A, VLO, OK);
               STATIC_CHOICE(LAB.B, VHI, OK2);
               if not (OK and OK2) then
                  FAIL(S.LINE, "a choice of a case statement is static (RM79 5.5)");
               end if;
               CONDS := MK(CONDS.all & " || (" & TMP.all & " >= " & LO.all & " && " & TMP.all
                           & " <= " & HI.all & ")");
            end if;
            if VLO <= VHI then
               for K in 1 .. NC loop
                  if VLO <= CHI(K) and CLO(K) <= VHI then
                     FAIL(S.LINE, "a value is covered by two choices of a case statement (RM79 5.5)");
                  end if;
               end loop;
               if NC < 2000 then
                  NC := NC + 1;
                  CLO(NC) := VLO;
                  CHI(NC) := VHI;
               end if;
            end if;
            LAB := LAB.NEXT;
         end loop;
         if FIRST then
            EMIT("if (" & CONDS.all & ") {");
         else
            EMIT("} else if (" & CONDS.all & ") {");
         end if;
         FIRST := FALSE;
         GEN_STATEMENTS(A.B);
         A := A.NEXT;
      end loop;
      if S.FLAG /= 1 then
         -- without others the choices cover every value of the type
         SELECTOR_RANGE(S.A, ST, VLO, VHI, OK);
         if not OK then
            FAIL(S.LINE, "a case statement on " & KIND_NAME(ST) & " needs others: its values are not static "
                 & "(RM79 5.5)");
         end if;
         TOTAL := 0;
         for K in 1 .. NC loop
            if CLO(K) < VLO or CHI(K) > VHI then
               FAIL(S.LINE, "a choice of the case statement is outside the values of " & KIND_NAME(ST)
                    & " (RM79 5.5)");
            end if;
            TOTAL := TOTAL + (CHI(K) - CLO(K) + 1);
         end loop;
         if TOTAL /= VHI - VLO + 1 then
            FAIL(S.LINE, "the choices of the case statement do not cover every value of " & KIND_NAME(ST)
                 & " (RM79 5.5)");
         end if;
      end if;
      if FIRST then
         EMIT("{");
      else
         EMIT("} else {");
      end if;
      if S.FLAG = 1 then
         GEN_STATEMENTS(S.C);
      else
         EMIT("rt_raise(RT_X_CASE);");
      end if;
      EMIT("}");
      EMIT("}");
   end GEN_CASE;

   -- the static values a case expression can take: those of the subtype of
   -- the variable named, else those of its type
   procedure SELECTOR_RANGE(E : NODE; T : TYP; LO, HI : out INTEGER; OK : out BOOLEAN) is
      Y : SYM;
   begin
      OK := FALSE;
      LO := 0;
      HI := 0;
      if E.KIND = N_NAME then
         Y := LOOKUP(E.NAME.all);
         if Y /= null and then (Y.KIND = Y_VAR or Y.KIND = Y_CONST) and then STATIC_BOUNDS(Y.C) then
            LO := Y.C.MLO;
            HI := Y.C.MHI;
            OK := TRUE;
            return;
         end if;
      end if;
      if T.KIND = T_BOOL then
         HI := 1;
         OK := TRUE;
      elsif T.KIND = T_CHAR and then T.TCONS = null then
         HI := 127;
         OK := TRUE;
      elsif T.KIND = T_ENUM then
         HI := LIST_LEN(T.LITS) - 1;
         OK := TRUE;
      elsif STATIC_BOUNDS(T.TCONS) then
         LO := T.TCONS.MLO;
         HI := T.TCONS.MHI;
         OK := TRUE;
      end if;
   end SELECTOR_RANGE;

   procedure PUSH_EXIT(MATCH : TEXT; IS_LOOP : BOOLEAN; LABEL : out TEXT) is
   begin
      NEW_NAME("L_end_", LABEL);
      EXITS := new EXIT_REC(MATCH, LABEL, FRAMES, IS_LOOP, EXITS);
   end PUSH_EXIT;

   -- loops (RM79 5.6): the loop parameter is a constant; the range is
   -- evaluated once
   procedure GEN_LOOP(S : NODE) is
      T, VT : TYP;
      C : CONS;
      LABEL, COND, ACC, LOV, HIV, IT : TEXT;
      Y : SYM;
      R : NODE;
   begin
      PUSH_EXIT(S.TAG, TRUE, LABEL);
      if S.FLAG = 0 then
         EMIT("for (;;) {");
         GEN_STATEMENTS(S.B);
         EMIT("}");
      elsif S.FLAG = 1 then
         CONDITION(S.A, TY_BOOL, VT, COND);
         CHECK_TYPE(VT, TY_BOOL, S.LINE);
         EMIT("while (" & COND.all & ") {");
         GEN_STATEMENTS(S.B);
         EMIT("}");
      else
         R := S.A;
         C := NEW_CONS;
         if R.KIND = N_RANGE then
            RANGE_BOUNDS(R.A, R.B, null, S.LINE, T, C.LO, C.HI);
         else
            RESOLVE(R, T, C);
            if C.LO = null then
               FAIL(S.LINE, "a FOR loop needs a discrete range");
            end if;
         end if;
         if T.KIND /= T_INT and T.KIND /= T_ENUM and T.KIND /= T_CHAR and T.KIND /= T_BOOL then
            FAIL(S.LINE, "a FOR loop needs a discrete range (RM79 5.6)");
         end if;
         STORAGE(S.NAME.all, T, ACC);
         NEW_NAME("lo", LOV);
         NEW_NAME("hi", HIV);
         NEW_NAME("it", IT);
         EMIT("{ rt_int " & LOV.all & " = " & C.LO.all & ", " & HIV.all & " = " & C.HI.all & ";");
         if S.IVAL = 1 then
            EMIT("for (rt_int " & IT.all & " = " & HIV.all & "; " & IT.all & " >= " & LOV.all & "; "
                 & IT.all & "--) {");
         else
            EMIT("for (rt_int " & IT.all & " = " & LOV.all & "; " & IT.all & " <= " & HIV.all & "; "
                 & IT.all & "++) {");
         end if;
         EMIT(ACC.all & " = " & IT.all & ";");
         OPEN_SCOPE;
         Y := NEW_SYM(Y_CONST, S.NAME);
         Y.T := T;
         Y.RO := TRUE;
         BIND(Y, ACC);
         DEFINE(Y, S.LINE);
         GEN_STATEMENTS(S.B);
         CLOSE_SCOPE;
         EMIT("}");
         EMIT("}");
      end if;
      EXITS := EXITS.NEXT;
      EMIT(LABEL.all & ": ;");
   end GEN_LOOP;

   -- blocks (RM79 6.7): a declarative part, statements, handlers
   procedure GEN_BLOCK(S : NODE) is
      LABEL, AW : TEXT;
   begin
      PUSH_EXIT(S.TAG, FALSE, LABEL);
      EMIT("{");
      OPEN_SCOPE;
      if S.TAG /= null then
         PUSH_UNIT(S.TAG);
      end if;
      GUARDED(S.A, S.B, S.C, S.LINE);
      TASK_AWAITS(S.A, AW);
      EMIT(AW.all);
      if S.TAG /= null then
         NUNITS := NUNITS - 1;
      end if;
      CLOSE_SCOPE;
      EMIT("}");
      EXITS := EXITS.NEXT;
      EMIT(LABEL.all & ": ;");
   end GEN_BLOCK;

   function EXIT_MATCHES(S : NODE; X : EXITS_T) return BOOLEAN is
   begin
      if S.NAME = null then
         return X.IS_LOOP;
      elsif X.MATCH = null then
         return FALSE;
      end if;
      return X.MATCH.all = S.NAME.all;
   end EXIT_MATCHES;


   -- exit [loop name] [when condition] (RM79 5.7)
   procedure GEN_EXIT(S : NODE) is
      X : EXITS_T := EXITS;
      T : TYP;
      V : TEXT;
   begin
      while X /= null loop
         if ACCEPT_DEPTH > 0 and X = ACCEPT_EXITS then
            FAIL(S.LINE, "an exit statement cannot leave an accept statement (RM79 5.7)");
         end if;
         if HANDLER_DEPTH > 0 and X = HANDLER_EXITS then
            FAIL(S.LINE, "an exit statement cannot leave an exception handler (RM79 5.7)");
         end if;
         if EXIT_MATCHES(S, X) then
            if not X.IS_LOOP then
               FAIL(S.LINE, "exit " & S.NAME.all & ": an exit names a loop, not a block (RM79 5.7)");
            end if;
            if S.A /= null then
               CONDITION(S.A, TY_BOOL, T, V);
               CHECK_TYPE(T, TY_BOOL, S.LINE);
               EMIT("if (" & V.all & ") {");
            end if;
            POP_FRAMES(X.DEPTH);
            EMIT("goto " & X.LABEL.all & ";");
            if S.A /= null then
               EMIT("}");
            end if;
            return;
         end if;
         X := X.NEXT;
      end loop;
      if S.NAME = null then
         FAIL(S.LINE, "exit outside a loop");
      end if;
      FAIL(S.LINE, "exit " & S.NAME.all & " names no enclosing loop");
   end GEN_EXIT;

   procedure GEN_RETURN(S : NODE) is
      VT : TYP;
      V, X : TEXT;
   begin
      if not IN_FUNC then
         FAIL(S.LINE, "return outside a subprogram");
      end if;
      if ACCEPT_DEPTH > 0 then
         FAIL(S.LINE, "a return statement cannot appear in an accept statement (RM79 5.3)");
      end if;
      if FUNC_SYM.RESULT.KIND = T_VOID then
         if S.A /= null then
            FAIL(S.LINE, "a procedure returns no value");
         end if;
         POP_FRAMES(0);
         EMIT("goto ret_;");
         return;
      end if;
      if S.A = null then
         FAIL(S.LINE, "return needs a value here");
      end if;
      GEXPR(S.A, FUNC_SYM.RESULT, VT, V);
      CHECK_TYPE(VT, FUNC_SYM.RESULT, S.LINE);
      if (IS_NUMERIC(VT) or IS_DISCRETE(VT)) and BOUNDED(FUNC_SYM.C) then
         ASSIGN_CODE("F->result_", VT, V.all, FUNC_SYM.C, X);
         EMIT(X.all);
      else
         EMIT("F->result_ = " & V.all & ";");
      end if;
      POP_FRAMES(0);
      EMIT("goto ret_;");
   end GEN_RETURN;
