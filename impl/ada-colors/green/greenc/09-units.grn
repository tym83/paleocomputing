   -- ---- packages (RM79 7) -------------------------------------------------------------

   -- the module named by P or P.Q.R (RM79 4.1.2)
   function LOOKUP_PATH(P : STRING) return SYM is
      Y, M : SYM;
   begin
      for I in reverse P'FIRST .. P'LAST loop
         if P(I) = "." then
            Y := LOOKUP_PATH(P(P'FIRST .. I - 1));
            if Y = null then
               return null;
            elsif Y.KIND /= Y_PACKAGE and Y.KIND /= Y_TASK then
               return null;
            end if;
            M := Y.MEMBERS;
            while M /= null loop
               if M.NAME.all = P(I + 1 .. P'LAST) and not M.HIDDEN then
                  return M;
               end if;
               M := M.MNEXT;
            end loop;
            return null;
         end if;
      end loop;
      return LOOKUP(P);
   end LOOKUP_PATH;

   function IS_PACKAGE(E : NODE) return BOOLEAN is
      Y : SYM;
   begin
      if E.KIND /= N_NAME and E.KIND /= N_SELECT then
         return FALSE;
      elsif E.KIND = N_SELECT then
         if E.A.KIND /= N_NAME and E.A.KIND /= N_SELECT then
            return FALSE;
         end if;
      end if;
      Y := LOOKUP_PATH(PATH_OF(E));
      if not (Y /= null) then
         return FALSE;
      end if;
      return (Y.KIND = Y_PACKAGE or Y.KIND = Y_TASK);
   end IS_PACKAGE;

   -- a declaration of the visible part of package P
   function MEMBER_OF(P, NAME : STRING; LINE : INTEGER) return SYM is
      Y : SYM := LOOKUP_PATH(P);
      M : SYM;
   begin
      if Y = null or else (Y.KIND /= Y_PACKAGE and Y.KIND /= Y_TASK) then
         return null;
      end if;
      M := Y.MEMBERS;
      while M /= null loop
         if M.NAME.all = NAME and not M.HIDDEN then
            return M;
         end if;
         M := M.MNEXT;
      end loop;
      -- inside a task body, T.E also names a local entry of T (RM79 9.5)
      if Y.KIND = Y_TASK then
         M := LOOKUP_ENTRY(NAME, Y);
         if M /= null and then M.KIND = Y_ENTRY and then SAME_TASK(M.MEMBERS, Y) then
            return M;
         end if;
      end if;
      return null;
   end MEMBER_OF;

   function INSIDE_PACKAGE(P : NODE) return BOOLEAN is
      L : LINES := PKG_STACK;
   begin
      if P = null then
         return TRUE;
      end if;
      while L /= null loop
         if L.S.all = P.NAME.all then
            return TRUE;
         end if;
         L := L.NEXT;
      end loop;
      return FALSE;
   end INSIDE_PACKAGE;

   procedure COPY_SYM(Y : SYM; Z : out SYM) is
   begin
      Z := new SYM_REC(Y.KIND, Y.NAME, Y.T, Y.C, Y.ACCESS_PATH, Y.CNAME, Y.RO, Y.MVALUE, Y.HASMV,
                       Y.DECL, Y.PARAMS, Y.RESULT, 0, Y.LEVEL, Y.BYREF, Y.VRP, Y.HIDDEN,
                       FALSE, Y.MEMBERS, null, null, null, Y.FLAGS);
   end COPY_SYM;

   -- the full declaration of a private type is copied into the type object
   -- that clients already hold (RM79 7.4)
   procedure COMPLETE_PRIVATE(PH, FULL : TYP) is
      N : TEXT := PH.NAME;
      P : NODE := PH.DECL;
   begin
      PH.all := FULL.all;
      PH.NAME := N;
      PH.PRIV := TRUE;
      PH.DECL := P;
   end COMPLETE_PRIVATE;

   -- package P is <visible part> [private <private part>] end P; (RM79 7.1)
   procedure PACKAGE_SPEC(E : NODE) is
      Y, M, Z : SYM;
      SAVED : NODE := CUR_PKG;
      FIRST_PRIVATE : SYM;
   begin
      Y := NEW_SYM(Y_PACKAGE, E.NAME);
      Y.DECL := E;
      PKG_STACK := new LINES_REC(E.NAME, PKG_STACK);
      CUR_PKG := E;
      OPEN_SCOPE;
      DECL_ELEMENTS(E.C);
      FIRST_PRIVATE := SCOPE_STACK;
      DECL_ELEMENTS(E.D);
      -- every declaration of the spec; those of the private part are hidden
      M := SCOPE_STACK;
      while M /= null and then M.DEPTH = DEPTH loop
         if M.KIND = Y_CONST and M.FLAGS = F_CONST_OBJ + F_DEFERRED then
            FAIL(E.LINE, "deferred constant " & M.NAME.all & " has no full declaration in the private part (RM79 7.4)");
         end if;
         -- what a use clause of the specification made visible stays visible
         -- in the body, but is not offered to the clients
         COPY_SYM(M, Z);
         Z.HIDDEN := HIDDEN_FROM(M, FIRST_PRIVATE) or M.FROM_USE;
         Z.MNEXT := Y.MEMBERS;
         Y.MEMBERS := Z;
         M := M.STACK;
      end loop;
      CLOSE_SCOPE;
      PKG_STACK := PKG_STACK.NEXT;
      CUR_PKG := SAVED;
      DEFINE(Y, E.LINE);
   end PACKAGE_SPEC;

   -- is M declared after the first declaration of the private part? The
   -- scope stack is newest first, so M is private if FIRST_PRIVATE is not
   -- reached walking down from the top before meeting M... i.e. M is above it
   function HIDDEN_FROM(M, FIRST_PRIVATE : SYM) return BOOLEAN is
      P : SYM := SCOPE_STACK;
   begin
      while P /= null loop
         if P = FIRST_PRIVATE then
            return FALSE;
         end if;
         if P = M then
            return TRUE;
         end if;
         P := P.STACK;
      end loop;
      return FALSE;
   end HIDDEN_FROM;

   -- package body P is ... [begin ...] [exception ...] end P; its statements
   -- run when the body is elaborated (RM79 7.3)
   procedure PACKAGE_BODY(E : NODE) is
      SAVED_LABELS : LABEL_LIST;
      Y : SYM := LOOKUP(E.NAME.all);
      M, Z : SYM;
      SAVED : NODE := CUR_PKG;
   begin
      if E.FLAG = 4 then
         STUB(E);
         return;
      end if;
      if IS_GENERIC_NAME(E.NAME.all) then
         ATTACH_GENERIC_BODY(E);
         return;
      end if;
      if Y = null or else Y.KIND /= Y_PACKAGE then
         FAIL(E.LINE, "package body " & E.NAME.all & " has no specification");
      end if;
      PKG_STACK := new LINES_REC(E.NAME, PKG_STACK);
      CUR_PKG := Y.DECL;
      OPEN_SCOPE;
      PUSH_UNIT(E.NAME);
      M := Y.MEMBERS;
      while M /= null loop
         COPY_SYM(M, Z);
         Z.HIDDEN := FALSE;
         DEFINE(Z, E.LINE);
         M := M.MNEXT;
      end loop;
      DECL_ELEMENTS(E.C);
      -- the bodies completed the specs held in the package's member list
      M := Y.MEMBERS;
      while M /= null loop
         if (M.KIND = Y_FUNC or M.KIND = Y_PROC) and then M.DECL.IVAL = 1 then
            Z := TABLE(HASH(M.NAME.all));
            while Z /= null loop
               if Z.CNAME = M.CNAME then
                  M.DECL := Z.DECL;
               end if;
               Z := Z.CHAIN;
            end loop;
            if M.DECL.IVAL = 1 then
               FAIL(E.LINE, "no body for " & M.NAME.all & " in package body " & E.NAME.all);
            end if;
         end if;
         M := M.MNEXT;
      end loop;
      SAVED_LABELS := BODY_LABELS;
      LABEL_BODY(E.D, E.E);
      GUARDED(null, E.D, E.E, E.LINE);
      BODY_LABELS := SAVED_LABELS;
      NUNITS := NUNITS - 1;
      CLOSE_SCOPE;
      PKG_STACK := PKG_STACK.NEXT;
      CUR_PKG := SAVED;
   end PACKAGE_BODY;

   function USE_VISIBLE(OLD : SYM) return BOOLEAN is
   begin
      if OLD = null then
         return TRUE;
      end if;
      return OLD.DEPTH < DEPTH and OLD.KIND /= Y_VAR and OLD.KIND /= Y_CONST;
   end USE_VISIBLE;

   -- use M; the visible declarations of module M become directly visible, but
   -- never hide another declaration; a name that two used modules declare is
   -- not visible at all (RM79 8.4)
   procedure USE_CLAUSE(E : NODE) is
      N : NODE := E.A;
      Y, M, Z, OLD : SYM;
      CLASH : BOOLEAN;
   begin
      while N /= null loop
         Y := LOOKUP(N.NAME.all);
         if Y = null then
            FAIL(N.LINE, N.NAME.all & " is not a visible module (RM79 8.3, 8.4)");
         elsif Y.KIND /= Y_PACKAGE and Y.KIND /= Y_TASK then
            -- a use clause names modules: packages and tasks (RM79 8.4)
            FAIL(N.LINE, N.NAME.all & " is not a package or a task");
         elsif Y.NAME.all = "TEXT_IO" and Y.MEMBERS = null then
            -- TEXT_IO's operations are the predefined ones
            Z := NEW_SYM(Y_CONST, MK("$TEXT_IO"));
            Z.T := TY_VOID;
            DEFINE(Z, N.LINE);
         else
            M := Y.MEMBERS;
            while M /= null loop
               if not M.HIDDEN then
                  OLD := LOOKUP(M.NAME.all);
                  if not OVERLOADABLE(M) then
                     if OLD = null then
                        COPY_SYM(M, Z);
                        Z.FROM_USE := TRUE;
                        DEFINE(Z, N.LINE);
                     elsif OLD.FROM_USE and OLD.DEPTH = DEPTH and not SAME_ENTITY(OLD, M) then
                        OLD.KIND := Y_CONFLICT;
                     end if;
                  else
                     -- an overloadable name is used unless a visible
                     -- declaration has the same profile
                     CLASH := FALSE;
                     Z := TABLE(HASH(M.NAME.all));
                     while Z /= null loop
                        if Z.NAME.all = M.NAME.all and then OVERLOADABLE(Z) and then VISIBLE_SYM(Z) then
                           if SAME_ENTITY(Z, M) then
                              CLASH := TRUE;
                           elsif not Z.FROM_USE and then SAME_TYPES(Z.PARAMS, M.PARAMS) and then SAME(Z.RESULT, M.RESULT)
                              and then (Z.KIND /= Y_ENUMLIT or SAME(Z.T, M.T)) then
                              CLASH := TRUE;
                           end if;
                        end if;
                        Z := Z.CHAIN;
                     end loop;
                     if not CLASH and then USABLE_OVER(OLD) then
                        COPY_SYM(M, Z);
                        Z.FROM_USE := TRUE;
                        DEFINE(Z, N.LINE);
                     end if;
                  end if;
               end if;
               M := M.MNEXT;
            end loop;
         end if;
         N := N.NEXT;
      end loop;
   end USE_CLAUSE;

   -- an overloadable name made visible by use does not hide a visible
   -- declaration that is not overloadable (RM79 8.4)
   function USABLE_OVER(OLD : SYM) return BOOLEAN is
   begin
      if OLD = null then
         return TRUE;
      end if;
      return OVERLOADABLE(OLD) or OLD.FROM_USE;
   end USABLE_OVER;

   -- two symbols for one declaration
   function SAME_ENTITY(A, B : SYM) return BOOLEAN is
   begin
      if A.KIND /= B.KIND then
         return FALSE;
      elsif A.CNAME /= null and B.CNAME /= null then
         return A.CNAME.all = B.CNAME.all;
      elsif A.ACCESS_PATH /= null and B.ACCESS_PATH /= null then
         return A.ACCESS_PATH.all = B.ACCESS_PATH.all;
      end if;
      return A.T = B.T and A.DECL = B.DECL;
   end SAME_ENTITY;

