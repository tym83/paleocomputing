   -- ---- declarative parts (RM79 6.1) ------------------------------------------------

   -- pragma identifier [(argument {, argument})]; an argument is an
   -- identifier, a string or a number (RM79 2.7)
   procedure PRAGMA_P(RES : out NODE) is
      X, A, HEAD, TAIL : NODE;
   begin
      X := NN(N_PRAGMA, CUR_LINE);
      EXPECT_KW("PRAGMA");
      EXPECT_ID(X.NAME);
      if AT_OP("(") then
         SKIP;
         loop
            if AT_KIND(K_ID) then
               NAME_NODE(A);
            elsif AT_KIND(K_STR) or AT_KIND(K_INT) or AT_KIND(K_FLOAT) then
               PRIMARY(A);
            else
               PERROR("a pragma argument is an identifier, a string or a number (RM79 2.7)");
            end if;
            APPEND(HEAD, TAIL, A);
            exit when not AT_OP(",");
            SKIP;
         end loop;
         EXPECT_OP(")");
      end if;
      EXPECT_OP(";");
      X.A := HEAD;
      CHECK_PRAGMA(X);
      RES := X;
   end PRAGMA_P;

   -- the pragmas of RM79 App. B have their arguments checked; the
   -- configuration pragmas take effect at once (RM79 13.7); a pragma not
   -- known here has no effect
   -- a change of the listing at a line of the source: N (on), F (off), P (page)
   procedure LISTING_MARK(LINE : INTEGER; WHAT : CHARACTER) is
   begin
      if COMPILING_SOURCE and NLISTING < 10000 then
         NLISTING := NLISTING + 1;
         LISTING_LINES(NLISTING) := LINE;
         LISTING_WHAT(NLISTING) := WHAT;
      end if;
   end LISTING_MARK;

   procedure CHECK_PRAGMA(X : NODE) is
      P : STRING := X.NAME.all;
      N : INTEGER := LIST_LEN(X.A);
      A : NODE := X.A;
   begin
      if P = "PAGE" or P = "INLINE" then
         if N /= 0 then
            FAIL(X.LINE, "pragma " & P & " takes no argument (RM79 App. B)");
         end if;
         if P = "PAGE" then
            LISTING_MARK(X.LINE, "P");
         end if;
      elsif P = "LIST" or P = "OPTIMIZE" or P = "CREATION" or P = "INTERFACE" or P = "SYSTEM" then
         if N /= 1 or else A.KIND /= N_NAME then
            FAIL(X.LINE, "pragma " & P & " takes one identifier (RM79 App. B)");
         end if;
         if P = "LIST" and then A.NAME.all /= "ON" and then A.NAME.all /= "OFF" then
            FAIL(X.LINE, "pragma LIST(ON) or LIST(OFF) (RM79 App. B)");
         elsif P = "OPTIMIZE" and then A.NAME.all /= "TIME" and then A.NAME.all /= "SPACE" then
            FAIL(X.LINE, "pragma OPTIMIZE(TIME) or OPTIMIZE(SPACE) (RM79 App. B)");
         elsif P = "CREATION" and then A.NAME.all /= "STATIC" and then A.NAME.all /= "DYNAMIC" then
            FAIL(X.LINE, "pragma CREATION(STATIC) or CREATION(DYNAMIC) (RM79 9.2)");
         end if;
         if P = "LIST" then
            LISTING_MARK(X.LINE, A.NAME.all(2));
         end if;
         if P = "OPTIMIZE" then
            CONF_OPTIMIZE := A.NAME;
         elsif P = "SYSTEM" then
            CONF_SYSTEM := A.NAME;
         end if;
      elsif P = "STORAGE_UNIT" or P = "MEMORY_SIZE" then
         if N /= 1 or else A.KIND /= N_INT then
            FAIL(X.LINE, "pragma " & P & " takes a number (RM79 13.7)");
         end if;
         if P = "STORAGE_UNIT" then
            CONF_STORAGE_UNIT := A.IVAL;
         else
            CONF_MEMORY_SIZE := A.IVAL;
         end if;
      elsif P = "SUPPRESS" or P = "ENVIRONMENT" then
         if N = 0 then
            FAIL(X.LINE, "pragma " & P & " names at least one " & "unit or exception (RM79 App. B)");
         end if;
         while A /= null loop
            if A.KIND /= N_NAME then
               FAIL(X.LINE, "pragma " & P & " takes names (RM79 App. B)");
            end if;
            A := A.NEXT;
         end loop;
      elsif P = "INCLUDE" then
         if N /= 1 or else A.KIND /= N_STR then
            FAIL(X.LINE, "pragma INCLUDE takes the name of a file (RM79 App. B)");
         end if;
      end if;
   end CHECK_PRAGMA;

   -- restricted [(unit {, unit})] (RM79 8.3): the names, as ",A,B,"
   procedure VISIBILITY_P(RES : out TEXT) is
      NAMES : NODE;
      V : TEXT := MK(",");
   begin
      EXPECT_KW("RESTRICTED");
      if AT_OP("(") then
         SKIP;
         ID_LIST(NAMES);
         EXPECT_OP(")");
         while NAMES /= null loop
            V := MK(V.all & NAMES.NAME.all & ",");
            NAMES := NAMES.NEXT;
         end loop;
      end if;
      RES := V;
   end VISIBILITY_P;

   -- a module or subprogram, possibly under a visibility restriction
   procedure UNIT_P(RES : out NODE) is
      V : TEXT;
      X : NODE;
   begin
      if AT_KW("RESTRICTED") then
         VISIBILITY_P(V);
      end if;
      if AT_KW("SEPARATE") then
         -- a subunit: the body of a stub of an enclosing unit, named first in
         -- its visibility list (RM79 10.2)
         SKIP;
         if V = null or else V.all'LENGTH < 2 then
            PERROR("a subunit names its enclosing unit first in its visibility list (RM79 10.2)");
         end if;
         UNIT_P(X);
         if X.KIND /= N_PROC and X.KIND /= N_FUNC and X.KIND /= N_PKGBODY and X.KIND /= N_TASKBODY then
            PERROR("a subunit is a subprogram body or a module body (RM79 10.2)");
         end if;
         X.FORMAL := MK("!" & V.all);
         RES := X;
         return;
      end if;
      if AT_KW("PROCEDURE") or AT_KW("FUNCTION") then
         SUBPROGRAM(X);
      elsif AT_KW("PACKAGE") then
         PACKAGE_P(X);
      elsif AT_KW("TASK") then
         TASK_P(X);
      elsif AT_KW("GENERIC") then
         GENERIC_P(X);
      else
         PERROR("a restricted unit is a subprogram, a package or a task (RM79 8.3)");
      end if;
      if X /= null then
         X.FORMAL := V;
      end if;
      RES := X;
   end UNIT_P;

   -- representation specifications (RM79 13) do not change the meaning of a
   -- program here: they are read and ignored
   -- representation specifications (RM79 13.1 - 13.5):
   --    for T use packing;                  FLAG 1
   --    for N use static_expression;        FLAG 2, the length in B
   --    for T use aggregate;                FLAG 3, the codes in B
   --    for T use record [at mod N;]        FLAG 4, the alignment in C,
   --       C at U range L .. H; ...                 the components in D
   --    end record;
   --    for N use at static_expression;     FLAG 5, the address in B
   procedure REP_SPEC(RES : out NODE) is
      X, P, TAIL : NODE;
   begin
      X := NN(N_REP, CUR_LINE);
      EXPECT_KW("FOR");
      EXPECT_ID(X.NAME);
      EXPECT_KW("USE");
      if AT_KW("PACKING") then
         SKIP;
         X.FLAG := 1;
      elsif AT_KW("AT") then
         SKIP;
         X.FLAG := 5;
         EXPR(X.B);
      elsif AT_KW("RECORD") then
         SKIP;
         X.FLAG := 4;
         if AT_KW("AT") then
            SKIP;
            EXPECT_KW("MOD");
            EXPR(X.C);
            EXPECT_OP(";");
         end if;
         while not AT_KW("END") loop
            P := NN(N_COMP, CUR_LINE);
            EXPECT_ID(P.NAME);
            EXPECT_KW("AT");
            EXPR(P.A);
            EXPECT_KW("RANGE");
            SIMPLE_EXPR(P.B);
            EXPECT_OP("..");
            SIMPLE_EXPR(P.C);
            EXPECT_OP(";");
            if TAIL = null then
               X.D := P;
            else
               TAIL.NEXT := P;
            end if;
            TAIL := P;
         end loop;
         EXPECT_KW("END");
         EXPECT_KW("RECORD");
      elsif AT_OP("(") then
         X.FLAG := 3;
         PRIMARY(X.B);
      else
         X.FLAG := 2;
         EXPR(X.B);
      end if;
      EXPECT_OP(";");
      RES := X;
   end REP_SPEC;

   procedure DECL_PART(RES : out NODE) is
      HEAD, TAIL, X, NAMES : NODE;
   begin
      loop
         if AT_KW("PRAGMA") then
            PRAGMA_P(X);
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("USE") then
            SKIP;
            X := NN(N_USE, CUR_LINE);
            ID_LIST(X.A);
            EXPECT_OP(";");
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("RESTRICTED") and KIND_AT(1) = K_KW and TEXT_AT(1) = "TYPE" then
            -- restricted type T is private: no assignment, no equality (RM79 7.4)
            SKIP;
            TYPE_DECL(X);
            if X = null or else X.A.KIND /= D_PRIVATE then
               PERROR("only a private type is restricted (RM79 7.4)");
            end if;
            X.FLAG := 9;
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("RESTRICTED") then
            UNIT_P(X);
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("FOR") then
            REP_SPEC(X);
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("TYPE") or AT_KW("SUBTYPE") then
            TYPE_DECL(X);
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("PROCEDURE") or AT_KW("FUNCTION") then
            SUBPROGRAM(X);
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("PACKAGE") then
            PACKAGE_P(X);
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("TASK") then
            TASK_P(X);
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("GENERIC") then
            GENERIC_P(X);
            APPEND(HEAD, TAIL, X);
         elsif AT_KW("ENTRY") then
            ENTRY_P(X);
            APPEND(HEAD, TAIL, X);
         elsif AT_KIND(K_ID) and KIND_AT(1) = K_OP and (TEXT_AT(1) = ":" or TEXT_AT(1) = ",") then
            OBJECT_DECL(X);
            APPEND(HEAD, TAIL, X);
         else
            RES := HEAD;
            return;
         end if;
      end loop;
   end DECL_PART;

   -- object declarations (RM79 3.2) and exception declarations (RM79 11.1):
   -- one node per declared name
   procedure OBJECT_DECL(RES : out NODE) is
      HEAD, TAIL, NAMES, ST, INIT, X : NODE;
      LINE : INTEGER := CUR_LINE;
      IS_CONST : BOOLEAN := FALSE;
   begin
      ID_LIST(NAMES);
      EXPECT_OP(":");
      if AT_KW("EXCEPTION") then
         SKIP;
         if AT_KW("RENAMES") then
            -- E : exception renames NAME; (RM79 8.5)
            SKIP;
            X := NN(N_EXC, LINE);
            X.NAME := NAMES.NAME;
            NAME_P(X.A);
            EXPECT_OP(";");
            RES := X;
            return;
         end if;
         EXPECT_OP(";");
         while NAMES /= null loop
            X := NN(N_EXC, LINE);
            X.NAME := NAMES.NAME;
            APPEND(HEAD, TAIL, X);
            NAMES := NAMES.NEXT;
         end loop;
         RES := HEAD;
         return;
      end if;
      if AT_KW("CONSTANT") then
         SKIP;
         IS_CONST := TRUE;
      end if;
      TYPE_SPEC(ST);
      if AT_KW("RENAMES") and not IS_CONST then
         -- X : T renames NAME; another name for an existing object (RM79 8.5)
         SKIP;
         X := NN(N_VAR, LINE);
         X.NAME := NAMES.NAME;
         X.A := ST;
         X.FLAG := 2;
         EXPR(X.B);
         EXPECT_OP(";");
         RES := X;
         return;
      end if;
      if AT_OP(":=") then
         SKIP;
         EXPR(INIT);
      end if;
      EXPECT_OP(";");
      while NAMES /= null loop
         if IS_CONST then
            X := NN(N_CONST, LINE);
         else
            X := NN(N_VAR, LINE);
         end if;
         X.NAME := NAMES.NAME;
         X.A := ST;
         X.B := INIT;
         APPEND(HEAD, TAIL, X);
         NAMES := NAMES.NEXT;
      end loop;
      RES := HEAD;
      return;
   end OBJECT_DECL;

   -- type and subtype declarations (RM79 3.3); type T; is an incomplete one
   procedure TYPE_DECL(RES : out NODE) is
      X : NODE;
      LINE : INTEGER := CUR_LINE;
   begin
      if AT_KW("SUBTYPE") then
         SKIP;
         X := NN(N_SUBTYPE, LINE);
         EXPECT_ID(X.NAME);
         EXPECT_KW("IS");
         SUBTYPE_IND(X.A);
         EXPECT_OP(";");
         RES := X;
         return;
      end if;
      EXPECT_KW("TYPE");
      X := NN(N_TYPE, LINE);
      EXPECT_ID(X.NAME);
      if AT_OP(";") then
         SKIP;
         RES := null;
         return;
      end if;
      EXPECT_KW("IS");
      if AT_KW("PRIVATE") then
         SKIP;
         X.A := NN(D_PRIVATE, LINE);
      else
         TYPE_DEF(X.A);
      end if;
      EXPECT_OP(";");
      RES := X;
      return;
   end TYPE_DECL;

   -- formal_part ::= ( parameter_declaration { ; parameter_declaration } ) (RM79 6.2)
   procedure FORMAL_PART(RES : out NODE) is
      HEAD, TAIL, NAMES, ST, DEF, P : NODE;
      MODE : INTEGER;
      MORE : BOOLEAN := TRUE;
   begin
      EXPECT_OP("(");
      while MORE loop
         ID_LIST(NAMES);
         EXPECT_OP(":");
         MODE := M_IN;
         if AT_KW("IN") then
            SKIP;
            if AT_KW("OUT") then
               SKIP;
               MODE := M_INOUT;
            end if;
         elsif AT_KW("OUT") then
            SKIP;
            MODE := M_OUT;
         end if;
         SUBTYPE_IND(ST);
         DEF := null;
         if AT_OP(":=") then
            SKIP;
            EXPR(DEF);
         end if;
         while NAMES /= null loop
            P := NN(N_PARAM, NAMES.LINE);
            P.NAME := NAMES.NAME;
            P.IVAL := MODE;
            P.A := ST;
            P.B := DEF;
            APPEND(HEAD, TAIL, P);
            NAMES := NAMES.NEXT;
         end loop;
         MORE := AT_OP(";");
         if MORE then
            SKIP;
         end if;
      end loop;
      EXPECT_OP(")");
      RES := HEAD;
      return;
   end FORMAL_PART;

   procedure DESIGNATOR(RES : out TEXT) is
   begin
      if AT_KIND(K_STR) then
         -- an operator designator such as "*" (RM79 6.6.1); "/=" follows "="
         -- and cannot be declared
         SKIP;
         RES := MK(UPPER_S(TOKS(TPOS - 1).S.all));
         if RES.all = "/=" then
            PERROR("""/="" cannot be declared: it follows the declaration of ""="" (RM79 6.6.1)");
         end if;
         if not IS_OPERATOR(RES.all) then
            PERROR(RES.all & " is not an operator symbol (RM79 6.6.1)");
         end if;
         return;
      end if;
      EXPECT_ID(RES);
      return;
   end DESIGNATOR;

   -- subprogram bodies (RM79 6.4): A params, B result, C declarations,
   -- D statements, E handlers; FLAG 1 marks a value-returning procedure.
   -- A declaration without a body gives no node.
   procedure SUBPROGRAM(RES : out NODE) is
      X : NODE;
      LINE : INTEGER := CUR_LINE;
      IS_PROC : BOOLEAN := AT_KW("PROCEDURE");
   begin
      SKIP;
      if IS_PROC then
         X := NN(N_PROC, LINE);
      else
         X := NN(N_FUNC, LINE);
      end if;
      DESIGNATOR(X.NAME);
      if AT_KW("IS") and KIND_AT(1) = K_KW and TEXT_AT(1) = "NEW" then
         -- an instantiation (RM79 12.2)
         INSTANTIATION(X, RES);
         return;
      end if;
      if AT_OP("(") then
         FORMAL_PART(X.A);
      end if;
      if AT_KW("RETURN") then
         SKIP;
         SUBTYPE_IND(X.B);
         if IS_PROC then
            X.FLAG := 1;
         end if;
      elsif not IS_PROC then
         PERROR("a function needs a RETURN clause");
      end if;
      if AT_KW("RENAMES") then
         -- another name for a subprogram, or for an entry (RM79 8.5)
         SKIP;
         X.IVAL := 2;
         NAME_P(X.C);
         EXPECT_OP(";");
         RES := X;
         return;
      end if;
      if AT_OP(";") then
         -- a subprogram declaration (RM79 6.2), completed by a body later
         SKIP;
         X.IVAL := 1;
         RES := X;
         return;
      end if;
      EXPECT_KW("IS");
      if AT_KW("SEPARATE") then
         -- a body stub: the body is a subunit (RM79 10.2)
         SKIP;
         EXPECT_OP(";");
         X.IVAL := 3;
         RES := X;
         return;
      end if;
      BODY_PART(X);
      if AT_KIND(K_ID) or AT_KIND(K_STR) then
         if TOKS(TPOS).S.all /= X.NAME.all then
            PERROR("the name after END does not match " & X.NAME.all);
         end if;
         SKIP;
      end if;
      EXPECT_OP(";");
      RES := X;
      return;
   end SUBPROGRAM;

   -- declarative part, begin statements, exception handlers, end (RM79 6.4)
   procedure BODY_PART(X : NODE) is
   begin
      DECL_PART(X.C);
      if AT_KW("BEGIN") then
         SKIP;
         SAW_INTERFACE := FALSE;
         STATEMENTS(X.D);
         if SAW_INTERFACE and X.D = null then
            -- a body written in another language: only pragma INTERFACE (RM79 13.9)
            X.TAG := MK("INTERFACE " & SAW_LANG.all);
         end if;
         SAW_INTERFACE := FALSE;
      end if;
      if AT_KW("EXCEPTION") then
         PARSE_HANDLERS(X.E);
      end if;
      EXPECT_KW("END");
   end BODY_PART;

   -- exception handlers (RM79 11.2); OTHERS becomes a name OTHERS
   procedure PARSE_HANDLERS(RES : out NODE) is
      HEAD, TAIL, H, NAMES, NTAIL, N : NODE;
   begin
      EXPECT_KW("EXCEPTION");
      while AT_KW("WHEN") loop
         SKIP;
         H := NN(N_HANDLER, CUR_LINE);
         NAMES := null;
         NTAIL := null;
         loop
            if AT_KW("OTHERS") then
               SKIP;
               N := NN(N_NAME, CUR_LINE);
               N.NAME := MK("OTHERS");
            else
               NAME_NODE(N);
               while AT_OP(".") loop
                  SKIP;
                  if N.TAG = null then
                     N.TAG := N.NAME;
                  else
                     N.TAG := MK(N.TAG.all & "." & N.NAME.all);
                  end if;
                  EXPECT_ID(N.NAME);
               end loop;
            end if;
            APPEND(NAMES, NTAIL, N);
            exit when not AT_OP("|");
            SKIP;
         end loop;
         EXPECT_OP("=>");
         H.A := NAMES;
         STATEMENTS(H.B);
         APPEND(HEAD, TAIL, H);
      end loop;
      RES := HEAD;
      return;
   end PARSE_HANDLERS;

   -- packages (RM79 7.1): a specification has its visible part in C and its
   -- private part in D; a body is like a subprogram body
   procedure PACKAGE_P(RES : out NODE) is
      X : NODE;
      LINE : INTEGER := CUR_LINE;
   begin
      EXPECT_KW("PACKAGE");
      if AT_KW("BODY") then
         SKIP;
         X := NN(N_PKGBODY, LINE);
         EXPECT_ID(X.NAME);
         EXPECT_KW("IS");
         if AT_KW("SEPARATE") then
            -- package body D is separate; (RM79 10.2)
            SKIP;
            EXPECT_OP(";");
            X.FLAG := 4;
            RES := X;
            return;
         end if;
         BODY_PART(X);
      else
         X := NN(N_PKGSPEC, LINE);
         EXPECT_ID(X.NAME);
         if AT_KW("IS") and KIND_AT(1) = K_KW and TEXT_AT(1) = "NEW" then
            INSTANTIATION(X, RES);
            return;
         end if;
         if AT_KW("RENAMES") then
            -- package L renames P; (RM79 8.5)
            SKIP;
            X.FLAG := 3;
            NAME_P(X.A);
            EXPECT_OP(";");
            RES := X;
            return;
         end if;
         EXPECT_KW("IS");
         DECL_PART(X.C);
         if AT_KW("PRIVATE") then
            SKIP;
            DECL_PART(X.D);
         end if;
         EXPECT_KW("END");
      end if;
      if AT_KIND(K_ID) then
         SKIP;
      end if;
      EXPECT_OP(";");
      RES := X;
      return;
   end PACKAGE_P;

   -- ---- statements (RM79 5) ------------------------------------------------------------

   function AT_STATEMENTS_END return BOOLEAN is
   begin
      return AT_KW("END") or AT_KW("ELSE") or AT_KW("ELSIF") or AT_KW("WHEN")
         or AT_KW("EXCEPTION") or AT_KW("OR") or AT_KIND(K_EOF);
   end AT_STATEMENTS_END;

   procedure STATEMENTS(RES : out NODE) is
      HEAD, TAIL, X : NODE;
   begin
      while not AT_STATEMENTS_END loop
         if AT_KW("PRAGMA") then
            PRAGMA_P(X);
            if X.NAME.all = "SUPPRESS" then
               FAIL(X.LINE, "pragma SUPPRESS stands in a declarative part (RM79 11.8, App. B)");
            elsif X.NAME.all = "INTERFACE" then
               SAW_INTERFACE := TRUE;
               SAW_LANG := X.A.NAME;
            end if;
         else
            STATEMENT(X);
            APPEND(HEAD, TAIL, X);
         end if;
      end loop;
      RES := HEAD;
      return;
   end STATEMENTS;

   -- << identifier >> statement: a label serves both goto and exit (RM79 5);
   -- the label is an N_SLABEL before the statement
   procedure STATEMENT(RES : out NODE) is
      L, X : NODE;
      LABEL : TEXT;
   begin
      if AT_OP("<<") then
         L := NN(N_SLABEL, CUR_LINE);
         SKIP;
         EXPECT_ID(LABEL);
         EXPECT_OP(">>");
         L.NAME := LABEL;
         if AT_OP("<<") then
            STATEMENT(X);
         else
            LABELLED_STATEMENT(LABEL, X);
         end if;
         L.NEXT := X;
         RES := L;
         return;
      end if;
      LABELLED_STATEMENT(null, RES);
   end STATEMENT;

   procedure LABELLED_STATEMENT(LABEL : TEXT; RES : out NODE) is
      X, T : NODE;
      LINE : INTEGER := CUR_LINE;
   begin
      if AT_KW("NULL") then
         SKIP;
         EXPECT_OP(";");
         X := NN(N_NULL, LINE);
         RES := X;
         return;
      elsif AT_KW("IF") then
         IF_STMT(X);
         RES := X;
         return;
      elsif AT_KW("CASE") then
         CASE_STMT(X);
         RES := X;
         return;
      elsif AT_KW("FOR") or AT_KW("WHILE") or AT_KW("LOOP") then
         LOOP_STMT(X);
         X.TAG := LABEL;
         if AT_KIND(K_ID) then
            if LABEL = null or else TOKS(TPOS).S.all /= LABEL.all then
               PERROR("the name after END LOOP does not match the label");
            end if;
            SKIP;
         elsif LABEL /= null then
            -- a labelled loop repeats its label after end loop (RM79 5.6)
            PERROR("the loop labelled " & LABEL.all & " ends with end loop " & LABEL.all & " (RM79 5.6)");
         end if;
         EXPECT_OP(";");
         RES := X;
         return;
      elsif AT_KW("DECLARE") or AT_KW("BEGIN") then
         X := NN(N_BLOCK, LINE);
         X.TAG := LABEL;
         if AT_KW("DECLARE") then
            SKIP;
            DECL_PART(X.A);
         end if;
         EXPECT_KW("BEGIN");
         STATEMENTS(X.B);
         if AT_KW("EXCEPTION") then
            PARSE_HANDLERS(X.C);
         end if;
         EXPECT_KW("END");
         if AT_KIND(K_ID) then
            if LABEL = null or else TOKS(TPOS).S.all /= LABEL.all then
               PERROR("the name after END does not match the label of the block (RM79 6.7)");
            end if;
            SKIP;
         elsif LABEL /= null then
            -- a labelled block repeats its label after end (RM79 6.7)
            PERROR("the block labelled " & LABEL.all & " ends with end " & LABEL.all & " (RM79 6.7)");
         end if;
         EXPECT_OP(";");
         RES := X;
         return;
      elsif AT_KW("EXIT") then
         SKIP;
         X := NN(N_EXIT, LINE);
         if AT_KIND(K_ID) then
            EXPECT_ID(X.NAME);
         end if;
         if AT_KW("WHEN") then
            SKIP;
            EXPR(X.A);
         end if;
         EXPECT_OP(";");
         RES := X;
         return;
      elsif AT_KW("RETURN") then
         SKIP;
         X := NN(N_RETURN, LINE);
         if not AT_OP(";") then
            EXPR(X.A);
         end if;
         EXPECT_OP(";");
         RES := X;
         return;
      elsif AT_KW("RAISE") then
         SKIP;
         if AT_OP(";") then
            SKIP;
            X := NN(N_RERAISE, LINE);
            RES := X;
            return;
         end if;
         X := NN(N_RAISE, LINE);
         EXPECT_ID(X.NAME);
         if AT_OP("(") then
            -- raise F(I).FAILURE: a member of a task family (RM79 11.5)
            SKIP;
            EXPR(X.A);
            EXPECT_OP(")");
         end if;
         while AT_OP(".") loop
            SKIP;
            X.TAG := X.NAME;
            EXPECT_ID(X.NAME);
         end loop;
         EXPECT_OP(";");
         RES := X;
         return;
      elsif AT_KW("ASSERT") then
         SKIP;
         X := NN(N_ASSERT, LINE);
         EXPR(X.A);
         EXPECT_OP(";");
         RES := X;
         return;
      elsif AT_KW("GOTO") then
         -- goto identifier; (RM79 5.8)
         SKIP;
         X := NN(N_GOTO, LINE);
         EXPECT_ID(X.NAME);
         EXPECT_OP(";");
         RES := X;
         return;
      end if;
      TASK_STATEMENT(X);
      if X /= null then
         RES := X;
         return;
      end if;
      NAME_P(T);
      if AT_OP(":=") then
         SKIP;
         X := NN(N_ASSIGN, LINE);
         X.A := T;
         EXPR(X.B);
      else
         X := NN(N_CALL, LINE);
         X.A := T;
      end if;
      EXPECT_OP(";");
      RES := X;
      return;
   end LABELLED_STATEMENT;

   -- initiate, accept, select, delay, abort: in 10-tasks
   procedure TASK_STATEMENT(RES : out NODE) is
   begin
      PARSE_TASK_STATEMENT(RES);
   end TASK_STATEMENT;

   -- IF (RM79 5.4); FLAG 1 = has ELSE
   procedure IF_STMT(RES : out NODE) is
      X, ARM, HEAD, TAIL : NODE;
      GO : BOOLEAN := TRUE;
   begin
      X := NN(N_IF, CUR_LINE);
      SKIP;
      ARM := NN(N_ARM, CUR_LINE);
      EXPR(ARM.A);
      EXPECT_KW("THEN");
      STATEMENTS(ARM.B);
      APPEND(HEAD, TAIL, ARM);
      while GO loop
         if AT_KW("ELSIF") then
            SKIP;
            ARM := NN(N_ARM, CUR_LINE);
            EXPR(ARM.A);
            EXPECT_KW("THEN");
            STATEMENTS(ARM.B);
            APPEND(HEAD, TAIL, ARM);
         elsif AT_KW("ELSE") then
            SKIP;
            X.FLAG := 1;
            STATEMENTS(X.B);
         else
            GO := FALSE;
         end if;
      end loop;
      EXPECT_KW("END");
      EXPECT_KW("IF");
      EXPECT_OP(";");
      X.A := HEAD;
      RES := X;
      return;
   end IF_STMT;

   -- CASE expression OF (RM79 5.5); FLAG 1 = has OTHERS
   procedure CASE_STMT(RES : out NODE) is
      X, ARM, HEAD, TAIL, LABS, LTAIL, L : NODE;
      OTHERS_ARM : BOOLEAN;
   begin
      X := NN(N_CASE, CUR_LINE);
      SKIP;
      EXPR(X.A);
      EXPECT_KW("OF");
      while AT_KW("WHEN") loop
         SKIP;
         LABS := null;
         LTAIL := null;
         OTHERS_ARM := FALSE;
         loop
            if AT_KW("OTHERS") then
               SKIP;
               OTHERS_ARM := TRUE;
            else
               L := NN(N_LABEL, CUR_LINE);
               SIMPLE_EXPR(L.A);
               if AT_OP("..") then
                  SKIP;
                  SIMPLE_EXPR(L.B);
               end if;
               APPEND(LABS, LTAIL, L);
            end if;
            exit when not AT_OP("|");
            SKIP;
         end loop;
         EXPECT_OP("=>");
         if OTHERS_ARM then
            X.FLAG := 1;
            STATEMENTS(X.C);
            if not AT_KW("END") then
               PERROR("others is the last choice of a case statement (RM79 5.5)");
            end if;
         else
            ARM := NN(N_ARM, CUR_LINE);
            ARM.A := LABS;
            STATEMENTS(ARM.B);
            APPEND(HEAD, TAIL, ARM);
         end if;
      end loop;
      EXPECT_KW("END");
      EXPECT_KW("CASE");
      EXPECT_OP(";");
      X.B := HEAD;
      RES := X;
      return;
   end CASE_STMT;

   -- loop statement (RM79 5.6): FLAG 0 plain, 1 while, 2 for; IVAL 1 = reverse
   procedure LOOP_STMT(RES : out NODE) is
      X, R : NODE;
      LINE : INTEGER := CUR_LINE;
   begin
      X := NN(N_LOOP, LINE);
      if AT_KW("FOR") then
         SKIP;
         X.FLAG := 2;
         EXPECT_ID(X.NAME);
         EXPECT_KW("IN");
         if AT_KW("REVERSE") then
            SKIP;
            X.IVAL := 1;
         end if;
         if AT_KIND(K_ID) and KIND_AT(1) = K_KW and TEXT_AT(1) = "LOOP" then
            SUBTYPE_IND(X.A);
         else
            DISCRETE_RANGE_P(X.A);
         end if;
      elsif AT_KW("WHILE") then
         SKIP;
         X.FLAG := 1;
         EXPR(X.A);
      end if;
      EXPECT_KW("LOOP");
      STATEMENTS(X.B);
      EXPECT_KW("END");
      EXPECT_KW("LOOP");
      RES := X;
      return;
   end LOOP_STMT;

   -- ---- compilation (RM79 10.1) ------------------------------------------------------

   procedure COMPILATION(RES : out NODE) is
      FIRST : INTEGER;
      HEAD, TAIL, X : NODE;
   begin
      while not AT_KIND(K_EOF) loop
         if AT_KW("PRAGMA") then
            PRAGMA_P(X);
            if X.NAME.all = "ENVIRONMENT" then
               -- the modules named join the default environment (RM79 8.6)
               X := X.A;
               while X /= null loop
                  ENV_NAMES := MK(ENV_NAMES.all & X.NAME.all & ",");
                  X := X.NEXT;
               end loop;
            end if;
         else
            if not (AT_KW("PROCEDURE") or AT_KW("FUNCTION") or AT_KW("PACKAGE") or AT_KW("TASK")
               or AT_KW("GENERIC") or AT_KW("RESTRICTED")) then
               PERROR("a compilation unit is a subprogram, a package or a task");
            end if;
            FIRST := TOKS(TPOS).LINE;
            UNIT_P(X);
            if X.FORMAL = null then
               -- a compilation unit is restricted, with an empty list by default (RM79 10.1)
               X.FORMAL := MK(",");
            end if;
            if COMPILING_SOURCE then
               SPANS := new SPAN_REC(X, FIRST, TOKS(TPOS - 1).LINE, ENV_NAMES, SPANS);
            end if;
            -- the environment named so far by pragma ENVIRONMENT
            X.FORMAL := MK(X.FORMAL.all & ENV_NAMES.all);
            APPEND(HEAD, TAIL, X);
         end if;
      end loop;
      RES := HEAD;
      return;
   end COMPILATION;
