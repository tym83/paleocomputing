MAIN SEGMENT RACE
   USES (TERMINAL);
% Lab B7: a timeout as a race of two paths (4.6.3). REQUEST has no timeout, so
% the consumer waits for "an item or 30 ms" by starting two paths: GET takes an
% item, TIMER waits; whichever finishes first TERMINATEs the other. The producer
% is a device driver at a higher priority; it sends an item at 30 ms, exactly
% when the first wait runs out, and another at 50 ms. Every item sent must be
% received in order, and an item left in the box must still be receivable.
VAR BOX: MAILBOX (INTEGER, 4);
VAR X: INTEGER;
VAR GOT: BOOLEAN;
VAR RECEIVED: INTEGER := 0;
CONST TIMEOUT: INTEGER := 5;
OPEN (# BOX);
PAR_BLOCK
   PATH PRODUCER PRIORITY 2 IMPORTS (DATA: (# BOX));
      PAUSE (30);
      SEND (1 # BOX);
      PAUSE (20);
      SEND (2 # BOX);
   END PATH PRODUCER;
   PATH CONSUMER IMPORTS (DATA: (# BOX, X, GOT, RECEIVED));
      LOOP FOR ROUND IN [1:3] DO
         GOT := FALSE;
         PAR_BLOCK
            PATH GET PRIORITY 1 IMPORTS (DATA: (# BOX, X, GOT));
               RECEIVE (# BOX # X);
               GOT := TRUE;
               TERMINATE (TIMER);
            END PATH GET;
            PATH TIMER;
               PAUSE (TIMEOUT);
               TERMINATE (GET);
            END PATH TIMER;
         END PAR_BLOCK;
         EXCEPT
            TERMINATED --> END;
         END EXCEPT;
         IF GOT THEN
            RECEIVED := RECEIVED + 1;
            LOG ('got item ' !! TO_CHAR (X));
         ELSE
            LOG ('no item for ' !! TO_CHAR (TIMEOUT) !! ' ms');
         END IF;
      END LOOP ROUND;
   END PATH CONSUMER;
END PAR_BLOCK;
LOG ('2 sent, ' !! TO_CHAR (RECEIVED) !! ' received, ' !! TO_CHAR (WAITING (BOX))
     !! ' still in the box');

FUNCTION NOW () RETURNS (INTEGER);
   RETURN TO_FIXED (REAL_TIME * 1000, 0, ROUNDED);
END FUNCTION NOW;

PROCEDURE PAUSE (MS: INTEGER);
   CONST S: FIXED (30, 2, STD) := MS !//30! 1000;
   WAIT (S);
END PROCEDURE PAUSE;

PROCEDURE LOG (S: ASCII_STR (?L));
   PUT_LINE ('[' !! TO_CHAR (NOW ()) !! ' ms] ' !! S);
END PROCEDURE LOG;

MODULE MAILBOXES EXPORTS (MAILBOX);
   TYPE MAILBOX (ELEMENT: TYPE, LENGTH: INTEGER [1:1000]) =
      RECORD
         VAR ITEMS: ARRAY [1 : LENGTH] OF ELEMENT;
         VAR HEAD, COUNT: INTEGER;
         VAR LOCK: SEMAPHORE (REGION);
         VAR FULL, EMPTY: SEMAPHORE (SYNCH);
      END RECORD;
   PROCEDURE MAILBOX$OPEN (# B: MAILBOX (?T, ?LENGTH));
      B.HEAD := 1;
      B.COUNT := 0;
      B.LOCK := NEW (1);
      B.FULL := NEW (0);
      B.EMPTY := NEW (LENGTH);
   END PROCEDURE MAILBOX$OPEN;
   PROCEDURE MAILBOX$SEND (X: ?T # B: MAILBOX (?T, ?LENGTH))
         WHERE T NEEDS (STORE_ (T ## T));
      REQUEST (# B.EMPTY);
      REQUEST (# B.LOCK);
      B.ITEMS ((B.HEAD + B.COUNT - 1) MOD LENGTH + 1) := X;
      B.COUNT := B.COUNT + 1;
      RELEASE (# B.LOCK);
      RELEASE (# B.FULL);
   END PROCEDURE MAILBOX$SEND;
   PROCEDURE MAILBOX$RECEIVE (# B: MAILBOX (?T, ?LENGTH) # X: ?T)
         WHERE T NEEDS (STORE_ (T ## T));
      REQUEST (# B.FULL);
      REQUEST (# B.LOCK);
      X := B.ITEMS (B.HEAD);
      B.HEAD := B.HEAD MOD LENGTH + 1;
      B.COUNT := B.COUNT - 1;
      RELEASE (# B.LOCK);
      RELEASE (# B.EMPTY);
   END PROCEDURE MAILBOX$RECEIVE;
   FUNCTION MAILBOX$WAITING (B: MAILBOX (?T, ?LENGTH)) RETURNS (INTEGER);
      RETURN B.COUNT;
   END FUNCTION MAILBOX$WAITING;
END MODULE MAILBOXES;
END SEGMENT RACE;
