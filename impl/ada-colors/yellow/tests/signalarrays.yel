(* arrays of signals in a monitor (VI.A.1.d, X.E.4): each component is tied *)
(* to the monitor, so a WAIT on one lets the monitor go; a mailbox per port *)
MODULE SignalArrays
  IMPORT TextIO, StandardImplementationPrelude;

  MONITOR Ports
    IMPORT INTEGER64, Write, WriteLn;
    EXPORT Receive, Deliver, Waiting;
    VAR arrived: ARRAY (INTEGER [1..3] OF SIGNAL);
        grid: ARRAY (INTEGER [1..2], INTEGER [1..2] OF SIGNAL);
        slot: ARRAY (INTEGER [1..3] OF INTEGER64);
    PROCEDURE Receive RETURNS INTEGER64 (CONST p: INTEGER64)
      WAIT(arrived[p]);
      RETURN slot[p]
    ENDPROCEDURE Receive;
    PROCEDURE Deliver (CONST p, v: INTEGER64)
      slot[p] := v;
      SEND(arrived[p]);
      Write("delivered to "); Write(p); WriteLn();
      RETURN
    ENDPROCEDURE Deliver;
    PROCEDURE Waiting RETURNS BOOLEAN (CONST p: INTEGER64)
      RETURN AWAITED(arrived[p]) AND NOT AWAITED(grid[2, 1])
    ENDPROCEDURE Waiting
  ENDMONITOR Ports;

  BEGIN
    PROCESS Port (CONST p: INTEGER64) INSTANCES 3
      VAR v: INTEGER64;
      v := Receive(p);
      Write("port "); Write(p); Write(" got "); Write(v); WriteLn();
      TERMINATE_PROCESS
    ENDPROCESS Port;
    Port(1); Port(2); Port(3);
    DELAY(1);
    Write(Waiting(1)); Write(" "); Write(Waiting(2)); WriteLn();
    Deliver(3, 30);
    Deliver(1, 10);
    Deliver(2, 20)
  END
ENDMODULE SignalArrays
