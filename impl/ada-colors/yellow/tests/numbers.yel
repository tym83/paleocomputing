(* FLOATING and FIXED representations and the conversions of XI *)
MODULE Numbers
  IMPORT TextIO, MathLibrary, StandardImplementationPrelude;
  REPRESENTATION
    FLOAT = FLOATING [-1.0E3..1.0E3] PRECISION 7;
    DOLLARS_AND_CENTS = FIXED [0.0P..10P5] SCALE 0.01P;
    Angle = FLOATING [-4.0..4.0] PRECISION 7;
  CONST Pi: FLOATING [0.0..4.0] PRECISION 7 = 3.14159265;
  VAR x, y: FLOAT;
      a: Angle;
      price, total: DOLLARS_AND_CENTS := 0.0P;

  x := 3.0;
  y := Sqrt(x * x + 16.0);
  WriteFloat(y, 3); WriteLn();
  WriteFloat(7 / 2, 2); Write(" "); WriteFloat(1.0 / 3.0, 4); WriteLn();
  Write(FLOOR(2.7)); Write(" "); Write(CEILING(2.2)); Write(" "); Write(NEAR_INTEGER(2.5));
  Write(" "); Write(NEAR_INTEGER(-2.5)); WriteLn();
  price := 19.99P;
  FOR i: INTEGER [1..3] DO total := total + price ENDFOR;
  WriteFixed(total, 2); Write(" "); WriteFixed(FIXED_DIV(total, 7.0P, 0.01P), 2); WriteLn();
  a := Pi / 4.0;
  WriteFloat(Sin(a) * Sin(a) + Cos(a) * Cos(a), 6); WriteLn();
  BEGIN
    EXCEPTION CASE OUT_OF_RANGE => Write("out of range"); WriteLn()
    ENDEXCEPTION;
    x := 2000.0
  END;
  BEGIN
    EXCEPTION CASE FIXED_NOT_REPRESENTABLE => Write("not a multiple of the scale"); WriteLn()
    ENDEXCEPTION;
    price := 0.005P
  END;
  WriteFloat(EXPT(2.0, 10), 1); WriteLn()
ENDMODULE Numbers
