(* modules: importation, exportation and its attributes (X.B) *)
MODULE Modules
  IMPORT TextIO, StandardImplementationPrelude;

  (* a counter whose state is visible but cannot be changed outside *)
  MODULE Counter
    IMPORT INTEGER64;
    EXPORT READONLY count;
    EXPORT Bump;
    VAR count: INTEGER64 := 100;
    PROCEDURE Bump ()
      count := count + 1;
      RETURN
    ENDPROCEDURE Bump;
    count := 0
  ENDMODULE Counter;

  (* an opaque representation with its operations (p.1052) *)
  MODULE Stack
    IMPORT INTEGER64;
    EXPORT OPAQUE S;
    EXPORT Push, Pop, Empty, New;
    REPRESENTATION
      S = RECORD VAR top: INTEGER64; VAR items: ARRAY (INTEGER [1..10] OF INTEGER64) ENDRECORD;
    PROCEDURE New RETURNS S ()
      VAR s: S;
      s.top := 0;
      RETURN s
    ENDPROCEDURE New;
    PROCEDURE Push (VAR s: S; CONST v: INTEGER64)
      s.top := s.top + 1;
      s.items[s.top] := v;
      RETURN
    ENDPROCEDURE Push;
    PROCEDURE Pop RETURNS INTEGER64 (VAR s: S)
      s.top := s.top - 1;
      RETURN s.items[s.top + 1]
    ENDPROCEDURE Pop;
    FUNCTION Empty RETURNS BOOLEAN (CONST s: S)
      RETURN s.top = 0
    ENDFUNCTION Empty;
  ENDMODULE Stack;

  (* two x's told apart by FROM and renamed by AS (p.1052) *)
  MODULE Convert
    EXPORT x FROM M AS Mx, x FROM N AS Nx;
    MODULE M
      EXPORT x;
      CONST x: INTEGER [0..9] = 1
    ENDMODULE M;
    MODULE N
      EXPORT x;
      CONST x: INTEGER [0..9] = 2
    ENDMODULE N
  ENDMODULE Convert;

  MODULE User
    IMPORT Counter, Stack, Mx, Nx AS second, Write, WriteLn, INTEGER64;
    VAR st: S := New();
    Bump(); Bump();
    Write("count "); Write(count); WriteLn();
    FOR i: INTEGER [1..3] DO Push(st, i * i) ENDFOR;
    WHILE NOT Empty(st) DO Write(Pop(st)); Write(" ") ENDWHILE;
    WriteLn();
    Write(Mx); Write(second); WriteLn()
  ENDMODULE User;

  Write("count outside "); Write(count); WriteLn()
ENDMODULE Modules
