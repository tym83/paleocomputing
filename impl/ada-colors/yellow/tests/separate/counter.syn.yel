(* the synopsis of the segment Counter (XIII.B): its interface only *)
MODULE Counter
  IMPORT StandardImplementationPrelude, TextIO;
  EXPORT Bump, Value, Twice, Ticker, Limit, Peek, AddTo, Watch;
  EXPORT VAR total;
  EXPORT READONLY count;
  CONST Limit: INTEGER64 = 100;
  VAR count: INTEGER64;
  VAR total: INTEGER64;
  PROCEDURE Bump (CONST by: INTEGER64) ENDPROCEDURE Bump;
  FUNCTION Value RETURNS INTEGER64 () ENDFUNCTION Value;
  (* an INLINE routine keeps its body in the synopsis (XIII.E) *)
  FUNCTION Twice RETURNS INTEGER64 (CONST x: INTEGER64) INLINE RETURN x + x ENDFUNCTION Twice;
  PROCEDURE Peek RETURNS INTEGER64 () ENDPROCEDURE Peek;
  PROCEDURE AddTo (VAR x: INTEGER64) ENDPROCEDURE AddTo;
  PROCESS Watch (VAR x: INTEGER64) ENDPROCESS Watch;
  PROCESS Ticker (CONST n: INTEGER64) ENDPROCESS Ticker
ENDMODULE Counter
