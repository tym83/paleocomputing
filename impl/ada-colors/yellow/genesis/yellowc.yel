(* yellowc -- a translator for YELLOW (SRI International, 1978), in YELLOW. *)
(* *)
(* It reads a program on the standard input -- a sequence of segments, *)
(* each a module (Language Report XIII.A) -- and writes C that is linked *)
(* with rt/paleo.c. References such as "L-55" or "p.1039" are to the 1978 *)
(* report as reprinted in DTIC ADB950587. The whole translator is one *)
(* module; its text is kept in several files joined in name order. *)
(* *)
(* YELLOW has no character strings beyond fixed arrays, so every piece of *)
(* text lives in one large pool of characters and is named by a number *)
(* (a Txt). Names are interned: two equal names have the same number. *)

MODULE yellowc

  REPRESENTATION
    INT = INTEGER [-4611686018427387904..4611686018427387904];
    Txt = INTEGER [0..4000000];
    Text = FILE (ASCII);

    Node = POINTER (NodeRec);
    Rep = POINTER (RepRec);
    Sym = POINTER (SymRec);
    Line = POINTER (LineRec);
    Field = POINTER (FieldRec);
    Param = POINTER (ParamRec);
    Scope = POINTER (ScopeRec);

    (* the tree the parser builds *)
    NodeRec = RECORD
      VAR kind, line, ival, flag: INT;
      VAR name, text: Txt;
      VAR a, b, c, d, e, next: Node;
      VAR rep: Rep;
      VAR sym: Sym
    ENDRECORD;

    (* a representation (VI): a type with what the C needs to hold it *)
    RepRec = RECORD
      VAR kind: INT;
      VAR tid: Txt;               (* the type: equal for two representations of one type *)
      VAR tname: Txt;             (* how to name it in a message *)
      VAR lo, hi: Txt;            (* C text of the bounds of a discrete representation *)
      VAR mlo, mhi: INT;          (* the bounds when they are manifest *)
      VAR hasm: BOOLEAN;
      VAR scale, prec: Txt;       (* FIXED and FLOATING *)
      VAR elem: Rep;              (* arrays: components; pointers, files, sets: base *)
      VAR idx: Rep;               (* arrays: the index representations, by link *)
      VAR nidx: INT;
      VAR link: Rep;              (* the next index of an array *)
      VAR lits: Node;             (* enumerations and alphabets: the literals *)
      VAR nlits: INT;
      VAR fields: Field;          (* records *)
      VAR selector: Field;        (* variant records: the case-selection component *)
      VAR cname: Txt;             (* records: the C struct *)
      VAR dname: Txt;             (* arrays, records: the run-time descriptor ... *)
      VAR dlevel: INT;            (* ... and the level of the frame that holds it *)
      VAR deep: BOOLEAN;          (* holds array buffers *)
      VAR abstract: BOOLEAN;      (* a TYPE that has no representation yet *)
      VAR opaque: BOOLEAN;        (* exported OPAQUE: no components outside *)
      VAR ordered: BOOLEAN;
      VAR forward: Txt;           (* pointers: the base named before it is declared *)
      VAR fwdscope: INT;
      VAR monitor: Sym;           (* signals: the monitor they belong to *)
      VAR serial: INT
    ENDRECORD;

    FieldRec = RECORD
      VAR name: Txt;
      VAR rep: Rep;
      VAR isconst: BOOLEAN;
      VAR variant: INT;           (* 0 in the common part, else the case it belongs to *)
      VAR labels: Node;           (* the case labels of its variant *)
      VAR next: Field
    ENDRECORD;

    ParamRec = RECORD
      VAR name: Txt;
      VAR cls: INT;               (* CONST OUT VAR *)
      VAR rep: Rep;
      VAR cname: Txt;
      VAR next: Param
    ENDRECORD;

    (* a declared entity *)
    SymRec = RECORD
      VAR kind: INT;
      VAR name: Txt;
      VAR rep: Rep;
      VAR cname: Txt;             (* C name of the storage, or of the routine *)
      VAR level: INT;             (* the frame that holds it: 0 is global *)
      VAR byref: BOOLEAN;         (* the storage holds a pointer to the entity *)
      VAR readonly: BOOLEAN;
      VAR mval: INT;
      VAR hasmv: BOOLEAN;
      VAR params: Param;
      VAR nparams: INT;
      VAR ret: Rep;
      VAR func: BOOLEAN;
      VAR decl: Node;
      VAR depth: INT;             (* the scope it is declared in *)
      VAR target: Sym;            (* imports, exports and renamings *)
      VAR members: Sym;           (* modules: what they export *)
      VAR mnext: Sym;
      VAR chain: Sym;             (* the next with the same hash *)
      VAR stack: Sym;             (* the next declared in the same scope *)
      VAR alt: Sym;               (* overloaded routines: the next definition *)
      VAR monitor: Sym;           (* routines and processes declared in a monitor *)
      VAR serial: INT
    ENDRECORD;

    ScopeRec = RECORD
      VAR syms: Sym;
      VAR closed: BOOLEAN;        (* a module: only imports come in *)
      VAR module: Sym;
      VAR level: INT;
      VAR deferred: Node;         (* routines whose bodies wait for the declarations *)
      VAR up: Scope
    ENDRECORD;

    LineRec = RECORD VAR t: Txt; VAR next: Line ENDRECORD;
    Buf = RECORD VAR head, tail: Line ENDRECORD;

    Chars = ARRAY (INTEGER [1..64000000] OF ASCII);
    TxtTable = ARRAY (INTEGER [1..4000000] OF INT);
    TokTable = ARRAY (INTEGER [1..2000000] OF INT);
    HashTable = ARRAY (INTEGER [0..262143] OF Txt);
    SymTable = ARRAY (INTEGER [0..8191] OF Sym);

  CONST
    (* token kinds *)
    K_EOF: INT = 0; K_ID: INT = 1; K_KW: INT = 2; K_OP: INT = 3;
    K_INT: INT = 4; K_FIXED: INT = 5; K_FLOAT: INT = 6; K_CHAR: INT = 7; K_STR: INT = 8;

    (* the reserved words, numbered as they are interned first (Appendix A) *)
    W_ALIGNMENT: INT = 1; W_ALPHABET: INT = 2; W_AND: INT = 3; W_ARRAY: INT = 4;
    W_AS: INT = 5; W_ASSERT: INT = 6; W_AT: INT = 7; W_BASE2: INT = 8; W_BASE8: INT = 9;
    W_BASE10: INT = 10; W_BASE16: INT = 11; W_BEGIN: INT = 12; W_CASE: INT = 13;
    W_CONST: INT = 14; W_DIMENSIONS: INT = 15; W_DIV: INT = 16; W_DO: INT = 17;
    W_ELSE: INT = 18; W_ELSIF: INT = 19; W_END: INT = 20; W_ENDEXCEPTION: INT = 21;
    W_ENDFOR: INT = 22; W_ENDFUNCTION: INT = 23; W_ENDIF: INT = 24; W_ENDLOOP: INT = 25;
    W_ENDMODULE: INT = 26; W_ENDMONITOR: INT = 27; W_ENDPROCEDURE: INT = 28;
    W_ENDPROCESS: INT = 29; W_ENDRECORD: INT = 30; W_ENDSELECT: INT = 31;
    W_ENDTEMPLATE: INT = 32; W_ENDWHILE: INT = 33; W_EXCEPTION: INT = 34; W_EXIT: INT = 35;
    W_EXPORT: INT = 36; W_EXTENDS: INT = 37; W_FILE: INT = 38; W_FOR: INT = 39;
    W_FUNCTION: INT = 40; W_GOTO: INT = 41; W_IF: INT = 42; W_IMPORT: INT = 43; W_IN: INT = 44;
    W_INLINE: INT = 45; W_INSTANCE: INT = 46; W_INSTANCES: INT = 47; W_LABEL: INT = 48;
    W_LOOP: INT = 49; W_MOD: INT = 50; W_MODULE: INT = 51; W_MONITOR: INT = 52; W_NIL: INT = 53;
    W_NOT: INT = 54; W_OF: INT = 55; W_OPAQUE: INT = 56; W_OR: INT = 57; W_ORDERED: INT = 58;
    W_OUT: INT = 59; W_PACKED: INT = 60; W_POINTER: INT = 61; W_PRECISION: INT = 62;
    W_PRIORITY: INT = 63; W_PROCEDURE: INT = 64; W_PROCESS: INT = 65;
    W_PROPAGATE_EXCEPTION: INT = 66; W_READONLY: INT = 67; W_RECORD: INT = 68;
    W_REPLACES: INT = 69; W_REPRESENTATION: INT = 70; W_RETURN: INT = 71; W_RETURNS: INT = 72;
    W_SCALE: INT = 73; W_SELECT: INT = 74; W_SET: INT = 75; W_SIMULATED_TIME: INT = 76;
    W_SIZE: INT = 77; W_SPACE: INT = 78; W_TEMPLATE: INT = 79; W_TERMINATE_PROCESS: INT = 80;
    W_THEN: INT = 81; W_TRANSPARENT: INT = 82; W_TYPE: INT = 83; W_UNORDERED: INT = 84;
    W_VAR: INT = 85; W_WHILE: INT = 86; W_XOR: INT = 87;
    NKW: INT = 87;

    (* the punctuation marks, longest first, numbered after the words *)
    P_LE4: INT = 88; P_GE4: INT = 89; P_NE3: INT = 90; P_EQ3: INT = 91; P_LT3: INT = 92;
    P_GT3: INT = 93; P_LE3: INT = 94; P_GE3: INT = 95; P_MUL3: INT = 96; P_DIV3: INT = 97;
    P_SUB3: INT = 98; P_ADD3: INT = 99; P_ASSIGN: INT = 100; P_ARROW: INT = 101;
    P_DOTDOT: INT = 102; P_LE: INT = 103; P_GE: INT = 104; P_NE2: INT = 105; P_EQ2: INT = 106;
    P_LT2: INT = 107; P_GT2: INT = 108; P_MUL2: INT = 109; P_DIV2: INT = 110; P_SUB2: INT = 111;
    P_ADD2: INT = 112; P_NE: INT = 113; P_PLUS: INT = 114; P_MINUS: INT = 115; P_STAR: INT = 116;
    P_SLASH: INT = 117; P_EQ: INT = 118; P_LT: INT = 119; P_GT: INT = 120; P_LPAR: INT = 121;
    P_RPAR: INT = 122; P_LBRACK: INT = 123; P_RBRACK: INT = 124; P_COMMA: INT = 125;
    P_SEMI: INT = 126; P_COLON: INT = 127; P_DOT: INT = 128; P_UP: INT = 129;
    NPUNCT: INT = 129;

    (* nodes: declarations *)
    N_MODULE: INT = 1; N_ITEM: INT = 2; N_BLOCK: INT = 3; N_HANDLER: INT = 4; N_HCASE: INT = 5;
    N_CONST: INT = 6; N_VAR: INT = 7; N_LABEL: INT = 8; N_TYPE: INT = 9; N_REPDECL: INT = 10;
    N_ROUTINE: INT = 11; N_PARAM: INT = 12; N_TEMPLATE: INT = 13; N_INSTANCE: INT = 14;
    N_PROCESS: INT = 15; N_NAMEL: INT = 16;
    (* nodes: representations *)
    N_RNAME: INT = 20; N_RENUM: INT = 21; N_RALPHA: INT = 22; N_RARRAY: INT = 23;
    N_RRECORD: INT = 24; N_RFILE: INT = 25; N_RPOINTER: INT = 26; N_RSET: INT = 27;
    N_RUARRAY: INT = 28; N_RSPACE: INT = 29; N_QUAL: INT = 30; N_FIELD: INT = 31;
    N_VARIANT: INT = 32; N_VCASE: INT = 33;
    (* nodes: statements *)
    N_ASSIGN: INT = 40; N_CALLST: INT = 41; N_ASSERT: INT = 42; N_GOTO: INT = 43;
    N_EXIT: INT = 44; N_RETURN: INT = 45; N_TERMINATE: INT = 46; N_PROPAGATE: INT = 47;
    N_IF: INT = 48; N_SELECT: INT = 49; N_WHILE: INT = 50; N_FOR: INT = 51; N_LOOP: INT = 52;
    N_BEGIN: INT = 53; N_ARM: INT = 54;
    (* nodes: expressions *)
    N_INT: INT = 60; N_FIXED: INT = 61; N_FLOAT: INT = 62; N_CHARLIT: INT = 63;
    N_STRLIT: INT = 64; N_NIL: INT = 65; N_NAME: INT = 66; N_CALL: INT = 67; N_SEL: INT = 68;
    N_INDEX: INT = 69; N_DEREF: INT = 70; N_NOT: INT = 71; N_NEG: INT = 72; N_BIN: INT = 73;
    N_PAREN: INT = 74;

    (* kinds of representation *)
    R_INT: INT = 1; R_FIXED: INT = 2; R_FLOAT: INT = 3; R_BOOL: INT = 4; R_ENUM: INT = 5;
    R_ALPHA: INT = 6; R_ARRAY: INT = 7; R_RECORD: INT = 8; R_PTR: INT = 9; R_FILE: INT = 10;
    R_SET: INT = 11; R_SIGNAL: INT = 12; R_SEM: INT = 13; R_UARRAY: INT = 14; R_STR: INT = 15;
    R_NIL: INT = 16; R_VOID: INT = 17; R_SPACE: INT = 18; R_ANY: INT = 19;

    (* kinds of entity *)
    S_VAR: INT = 1; S_CONST: INT = 2; S_REP: INT = 3; S_TYPE: INT = 4; S_LIT: INT = 5;
    S_ROUTINE: INT = 6; S_MODULE: INT = 7; S_TEMPLATE: INT = 8; S_PROCESS: INT = 9;
    S_LABEL: INT = 10; S_STD: INT = 11; S_EXPORT: INT = 12;

    (* parameter classes *)
    C_CONST: INT = 1; C_OUT: INT = 2; C_VAR: INT = 3;

  VAR
    Input, Output: Text;
    Pool: Chars;
    PoolTop: INT := 0;
    TS, TL: TxtTable;               (* start and length of each Txt *)
    NTxt: INT := 0;
    Hash: HashTable;
    Building: BOOLEAN := FALSE;
    Scratch: ARRAY (INTEGER [1..4000000] OF ASCII);
    ScTop: INT := 0;
    SbStart: ARRAY (INTEGER [1..4000] OF INT);
    SbDepth: INT := 0;
    Serial: INT := 0;
    Code: ARRAY (ASCII OF INT);      (* the position of a character in ASCII *)
    Chr: ARRAY (INTEGER [0..127] OF ASCII);

    (* sections of the C program *)
    OTypes, OStructs, OFrames, OGlobals, OProtos, OFuncs, OInit: Buf;
    Body: Buf;                       (* the routine being written *)
    Locals: Buf;                     (* the fields of its frame *)

    CurLine: INT := 0;               (* for messages *)

  (* ---- characters ------------------------------------------------------ *)

  PROCEDURE InitChars ()
    VAR n: INT := 0;
    FOR c: ASCII DO
      Code[c] := n;
      Chr[n] := c;
      n := n + 1
    ENDFOR;
    RETURN
  ENDPROCEDURE InitChars;

  FUNCTION IsLetter RETURNS BOOLEAN (CONST c: ASCII)
    RETURN ((c >= 'A') AND (c <= 'Z')) OR ((c >= 'a') AND (c <= 'z')) OR (c = '_')
  ENDFUNCTION IsLetter;

  FUNCTION IsDigit RETURNS BOOLEAN (CONST c: ASCII)
    RETURN (c >= '0') AND (c <= '9')
  ENDFUNCTION IsDigit;

  (* ---- the pool of text -------------------------------------------------- *)

  PROCEDURE PoolAdd (CONST c: ASCII)
    PoolTop := PoolTop + 1;
    Pool[PoolTop] := c;
    RETURN
  ENDPROCEDURE PoolAdd;

  (* start building a Txt; SA, SC, ST, SI add to it; SE finishes it. The *)
  (* text is built in a scratch area, so a Txt may be built while another *)
  (* one is being built: the builds nest like calls *)
  PROCEDURE SB ()
    SbDepth := SbDepth + 1;
    SbStart[SbDepth] := ScTop;
    RETURN
  ENDPROCEDURE SB;

  PROCEDURE SC (CONST c: ASCII)
    ScTop := ScTop + 1;
    Scratch[ScTop] := c;
    RETURN
  ENDPROCEDURE SC;

  PROCEDURE SA (CONST s: ARRAY (1 DIMENSIONS OF ASCII))
    FOR i: INTEGER [LOW(s, 1)..HIGH(s, 1)] DO SC(s[i]) ENDFOR;
    RETURN
  ENDPROCEDURE SA;

  PROCEDURE ST (CONST t: Txt)
    VAR i: INT;
    IF t = 0 THEN RETURN ENDIF;
    i := TS[t];
    WHILE i < (TS[t] + TL[t]) DO
      SC(Pool[i]);
      i := i + 1
    ENDWHILE;
    RETURN
  ENDPROCEDURE ST;

  PROCEDURE SI (CONST n: INT)
    VAR digits: ARRAY (INTEGER [1..24] OF ASCII);
        k: INT := 0;
        v: INT := n;
    IF v < 0 THEN SC('-'); v := -v ENDIF;
    LOOP more
      k := k + 1;
      digits[k] := Chr[(v MOD 10) + 48];
      v := v DIV 10;
      IF v = 0 THEN EXIT more ENDIF
    ENDLOOP more;
    WHILE k > 0 DO
      SC(digits[k]);
      k := k - 1
    ENDWHILE;
    RETURN
  ENDPROCEDURE SI;

  PROCEDURE SE RETURNS Txt ()
    VAR start: INT := SbStart[SbDepth];
    SbDepth := SbDepth - 1;
    NTxt := NTxt + 1;
    TS[NTxt] := PoolTop + 1;
    TL[NTxt] := ScTop - start;
    FOR i: INTEGER [start + 1..ScTop] DO PoolAdd(Scratch[i]) ENDFOR;
    ScTop := start;
    RETURN NTxt
  ENDPROCEDURE SE;

  (* a Txt of a literal *)
  PROCEDURE T RETURNS Txt (CONST s: ARRAY (1 DIMENSIONS OF ASCII))
    SB();
    SA(s);
    RETURN SE()
  ENDPROCEDURE T;

  (* the same name gives the same Txt: hashing over the pool *)
  PROCEDURE Intern RETURNS Txt (CONST start, len: INT)
    VAR h: INT := 0;
        k: INT;
        same: BOOLEAN;
    FOR i: INTEGER [start..(start + len) - 1] DO
      h := ((h * 31) + Code[Pool[i]]) MOD 262144
    ENDFOR;
    LOOP probe
      IF Hash[h] = 0 THEN
        NTxt := NTxt + 1;
        TS[NTxt] := start;
        TL[NTxt] := len;
        Hash[h] := NTxt;
        RETURN NTxt
      ENDIF;
      k := Hash[h];
      IF TL[k] = len THEN
        same := TRUE;
        FOR i: INTEGER [0..len - 1] DO
          IF Pool[TS[k] + i] # Pool[start + i] THEN same := FALSE ENDIF
        ENDFOR;
        IF same THEN RETURN k ENDIF
      ENDIF;
      h := (h + 1) MOD 262144
    ENDLOOP probe
  ENDPROCEDURE Intern;

  (* intern the Txt t (made by SB .. SE) *)
  PROCEDURE Name RETURNS Txt (CONST t: Txt)
    RETURN Intern(TS[t], TL[t])
  ENDPROCEDURE Name;

  PROCEDURE N RETURNS Txt (CONST s: ARRAY (1 DIMENSIONS OF ASCII))
    RETURN Name(T(s))
  ENDPROCEDURE N;

  PROCEDURE TEq RETURNS BOOLEAN (CONST a, b: Txt)
    IF a = b THEN RETURN TRUE ENDIF;
    IF TL[a] # TL[b] THEN RETURN FALSE ENDIF;
    FOR i: INTEGER [0..TL[a] - 1] DO
      IF Pool[TS[a] + i] # Pool[TS[b] + i] THEN RETURN FALSE ENDIF
    ENDFOR;
    RETURN TRUE
  ENDPROCEDURE TEq;

  (* does the Txt t start with the literal s *)
  PROCEDURE TStarts RETURNS BOOLEAN (CONST t: Txt; CONST s: ARRAY (1 DIMENSIONS OF ASCII))
    VAR k: INT := 0;
    IF TL[t] < ((HIGH(s, 1) - LOW(s, 1)) + 1) THEN RETURN FALSE ENDIF;
    FOR i: INTEGER [LOW(s, 1)..HIGH(s, 1)] DO
      IF Pool[TS[t] + k] # s[i] THEN RETURN FALSE ENDIF;
      k := k + 1
    ENDFOR;
    RETURN TRUE
  ENDPROCEDURE TStarts;

  PROCEDURE TChar RETURNS ASCII (CONST t: Txt; CONST i: INT)
    RETURN Pool[(TS[t] + i) - 1]
  ENDPROCEDURE TChar;

  (* ---- output ------------------------------------------------------------- *)

  PROCEDURE Put (VAR b: Buf; CONST t: Txt)
    VAR l: Line;
    NEW(l);
    l^ := LineRec(t, Line NIL);
    IF b.head = Line NIL THEN b.head := l ELSE b.tail^.next := l ENDIF;
    b.tail := l;
    RETURN
  ENDPROCEDURE Put;

  PROCEDURE PutS (VAR b: Buf; CONST s: ARRAY (1 DIMENSIONS OF ASCII))
    Put(b, T(s));
    RETURN
  ENDPROCEDURE PutS;

  (* move the lines of b to the end of a, emptying b *)
  PROCEDURE Append (VAR a, b: Buf)
    IF b.head = Line NIL THEN RETURN ENDIF;
    IF a.head = Line NIL THEN a.head := b.head ELSE a.tail^.next := b.head ENDIF;
    a.tail := b.tail;
    b.head := Line NIL;
    b.tail := Line NIL;
    RETURN
  ENDPROCEDURE Append;

  (* a line of the routine being written *)
  PROCEDURE Emit (CONST t: Txt)
    Put(Body, t);
    RETURN
  ENDPROCEDURE Emit;

  PROCEDURE EmitS (CONST s: ARRAY (1 DIMENSIONS OF ASCII))
    Put(Body, T(s));
    RETURN
  ENDPROCEDURE EmitS;

  PROCEDURE WriteTxt (CONST t: Txt)
    VAR i: INT := TS[t];
    WHILE i < (TS[t] + TL[t]) DO
      PUT(Output, Pool[i]);
      i := i + 1
    ENDWHILE;
    RETURN
  ENDPROCEDURE WriteTxt;

  PROCEDURE WriteBuf (CONST b: Buf)
    VAR l: Line := b.head;
    WHILE l # Line NIL DO
      WriteTxt(l^.t);
      PUT(Output, 'LF');
      l := l^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE WriteBuf;

  (* ---- messages -------------------------------------------------------------- *)

  (* a translation error: the message goes to the output, which is then *)
  (* not a C program, and the translation stops *)
  PROCEDURE Fail (CONST line: INT; CONST msg: Txt)
    VAR t: Txt;
    SbDepth := 0;
    ScTop := 0;
    SB();
    SA("line ");
    SI(line);
    SA(": ");
    ST(msg);
    t := SE();
    WriteTxt(t);
    PUT(Output, 'LF');
    CLOSE(Output);
    PROPAGATE_EXCEPTION translation_error
  ENDPROCEDURE Fail;

  PROCEDURE FailS (CONST line: INT; CONST msg: ARRAY (1 DIMENSIONS OF ASCII))
    Fail(line, T(msg));
    RETURN
  ENDPROCEDURE FailS;

  (* "line N: <name> <msg>" *)
  PROCEDURE FailN (CONST line: INT; CONST name: Txt; CONST msg: ARRAY (1 DIMENSIONS OF ASCII))
    VAR t: Txt;
    SB();
    ST(name);
    SA(msg);
    t := SE();
    Fail(line, t);
    RETURN
  ENDPROCEDURE FailN;

  PROCEDURE NewSerial RETURNS INT ()
    Serial := Serial + 1;
    RETURN Serial
  ENDPROCEDURE NewSerial;

  (* a fresh C name: prefix and a number *)
  PROCEDURE Fresh RETURNS Txt (CONST prefix: ARRAY (1 DIMENSIONS OF ASCII))
    VAR n: INT := NewSerial();
    SB();
    SA(prefix);
    SI(n);
    RETURN SE()
  ENDPROCEDURE Fresh;

  (* ---- lexical analysis: Sections III and IV of the Report (pp.992-998) ---- *)
  (* The source is read into the pool, so names are interned in place. *)

  VAR
    TKind, TVal, TLine: TokTable;
    NTok: INT := 0;
    SrcStart, SrcEnd: INT := 0;
    Pos: INT := 0;
    LineNo: INT := 1;
    Base: INT := 0;                 (* a BASE word was just read *)

  (* the reserved words and punctuation marks are interned first, so a word *)
  (* is reserved when its Txt is at most NKW *)
  PROCEDURE InitWords ()
    VAR start: INT;
        t, all: Txt;
    SB();
    SA("ALIGNMENT ALPHABET AND ARRAY AS ASSERT AT BASE2 BASE8 BASE10 BASE16 BEGIN CASE ");
    SA("CONST DIMENSIONS DIV DO ELSE ELSIF END ENDEXCEPTION ENDFOR ENDFUNCTION ENDIF ");
    SA("ENDLOOP ENDMODULE ENDMONITOR ENDPROCEDURE ENDPROCESS ENDRECORD ENDSELECT ");
    SA("ENDTEMPLATE ENDWHILE EXCEPTION EXIT EXPORT EXTENDS FILE FOR FUNCTION GOTO IF ");
    SA("IMPORT IN INLINE INSTANCE INSTANCES LABEL LOOP MOD MODULE MONITOR NIL NOT OF ");
    SA("OPAQUE OR ORDERED OUT PACKED POINTER PRECISION PRIORITY PROCEDURE PROCESS ");
    SA("PROPAGATE_EXCEPTION READONLY RECORD REPLACES REPRESENTATION RETURN RETURNS ");
    SA("SCALE SELECT SET SIMULATED_TIME SIZE SPACE TEMPLATE TERMINATE_PROCESS THEN ");
    SA("TRANSPARENT TYPE UNORDERED VAR WHILE XOR ");
    SA("<<<= >>>= ### === <<< >>> <<= >>= *** /// --- +++ := -> .. <= >= ## == << >> ");
    SA("** // -- ++ # + - * / = < > ( ) [ ] , ; : . ^ ");
    all := SE();
    NTxt := 0;
    start := TS[all];
    FOR i: INTEGER [TS[all]..(TS[all] + TL[all]) - 1] DO
      IF Pool[i] = ' ' THEN
        t := Intern(start, i - start);
        start := i + 1
      ENDIF
    ENDFOR;
    IF NTxt # NPUNCT THEN PROPAGATE_EXCEPTION word_table ENDIF;
    RETURN
  ENDPROCEDURE InitWords;

  PROCEDURE ReadSource ()
    VAR c: ASCII;
    OPEN(Input, "INPUT", READ);
    SrcStart := PoolTop + 1;
    WHILE NOT CHECK_EOF(Input) DO
      GET(Input, c);
      PoolAdd(c)
    ENDWHILE;
    SrcEnd := PoolTop;
    CLOSE(Input);
    RETURN
  ENDPROCEDURE ReadSource;

  PROCEDURE AddTok (CONST kind, val: INT)
    NTok := NTok + 1;
    TKind[NTok] := kind;
    TVal[NTok] := val;
    TLine[NTok] := LineNo;
    RETURN
  ENDPROCEDURE AddTok;

  PROCEDURE At RETURNS ASCII (CONST i: INT)
    IF i > SrcEnd THEN RETURN 'NUL' ENDIF;
    RETURN Pool[i]
  ENDPROCEDURE At;

  (* after an operand a sign is an operator; elsewhere it may begin a literal *)
  PROCEDURE EndsOperand RETURNS BOOLEAN ()
    VAR k, v: INT;
    IF NTok = 0 THEN RETURN FALSE ENDIF;
    k := TKind[NTok];
    v := TVal[NTok];
    IF (k = K_ID) OR (k = K_INT) OR (k = K_FIXED) OR (k = K_FLOAT) OR (k = K_CHAR) OR (k = K_STR) THEN
      RETURN TRUE
    ENDIF;
    IF k = K_OP THEN RETURN (v = P_RPAR) OR (v = P_RBRACK) OR (v = P_UP) ENDIF;
    IF k = K_KW THEN RETURN v = W_NIL ENDIF;
    RETURN FALSE
  ENDPROCEDURE EndsOperand;

  FUNCTION DigitVal RETURNS INT (CONST c: ASCII)
    IF (c >= '0') AND (c <= '9') THEN RETURN Code[c] - 48 ENDIF;
    IF (c >= 'A') AND (c <= 'F') THEN RETURN Code[c] - 55 ENDIF;
    RETURN 99
  ENDFUNCTION DigitVal;

  PROCEDURE LexError (CONST msg: ARRAY (1 DIMENSIONS OF ASCII))
    FailS(LineNo, msg);
    RETURN
  ENDPROCEDURE LexError;

  (* a number at Pos (VI.B): integer, fixed (with P) or floating (with a point) *)
  PROCEDURE LexNumber (CONST neg: BOOLEAN)
    VAR b: INT := 10;
        mstart, mend, fstart, fend: INT;
        hasfrac: BOOLEAN := FALSE;
        v, d, exp, esign, nfrac: INT := 0;
        t: Txt;
    IF Base # 0 THEN b := Base ENDIF;
    Base := 0;
    mstart := Pos;
    WHILE DigitVal(At(Pos)) < b DO Pos := Pos + 1 ENDWHILE;
    mend := Pos;
    fstart := Pos;
    fend := Pos;
    IF (At(Pos) = '.') AND (At(Pos + 1) # '.') THEN
      hasfrac := TRUE;
      Pos := Pos + 1;
      fstart := Pos;
      WHILE DigitVal(At(Pos)) < b DO Pos := Pos + 1 ENDWHILE;
      fend := Pos
    ENDIF;
    IF At(Pos) = 'P' THEN
      (* a fixed-point literal: mantissa times base to the power given *)
      Pos := Pos + 1;
      esign := 1;
      IF ((At(Pos) = '-') OR (At(Pos) = '+')) AND IsDigit(At(Pos + 1)) THEN
        IF At(Pos) = '-' THEN esign := -1 ENDIF;
        Pos := Pos + 1
      ENDIF;
      exp := 0;
      WHILE IsDigit(At(Pos)) DO
        exp := (exp * 10) + DigitVal(At(Pos));
        Pos := Pos + 1
      ENDWHILE;
      exp := exp * esign;
      v := 0;
      FOR i: INTEGER [mstart..mend - 1] DO v := (v * b) + DigitVal(Pool[i]) ENDFOR;
      nfrac := fend - fstart;
      FOR i: INTEGER [fstart..fend - 1] DO v := (v * b) + DigitVal(Pool[i]) ENDFOR;
      SB();
      SA("(");
      IF neg THEN SA("-") ENDIF;
      SA("(double)");
      SI(v);
      SA(" * pow(");
      SI(b);
      SA(", ");
      SI(exp - nfrac);
      SA("))");
      t := SE();
      AddTok(K_FIXED, t);
      RETURN
    ENDIF;
    IF hasfrac THEN
      IF b # 10 THEN LexError("a floating-point literal is decimal") ENDIF;
      IF At(Pos) = 'E' THEN
        Pos := Pos + 1;
        IF (At(Pos) = '-') OR (At(Pos) = '+') THEN Pos := Pos + 1 ENDIF;
        WHILE IsDigit(At(Pos)) DO Pos := Pos + 1 ENDWHILE
      ENDIF;
      SB();
      IF neg THEN SA("-") ENDIF;
      FOR i: INTEGER [mstart..Pos - 1] DO SC(Pool[i]) ENDFOR;
      t := SE();
      AddTok(K_FLOAT, t);
      RETURN
    ENDIF;
    v := 0;
    FOR i: INTEGER [mstart..mend - 1] DO
      d := DigitVal(Pool[i]);
      IF v > (4611686018427387903 DIV b) THEN LexError("integer literal too large") ENDIF;
      v := (v * b) + d
    ENDFOR;
    IF neg THEN v := -v ENDIF;
    AddTok(K_INT, v);
    RETURN
  ENDPROCEDURE LexNumber;

  (* a string: "..." with 'MNEMONIC' inside; strings separated only by *)
  (* blanks and line ends make one literal (p.998). The Txt keeps the text *)
  (* between the quotation marks, the mnemonics still in apostrophes. *)
  PROCEDURE LexString ()
    VAR t: Txt;
        k, nl: INT;
        more: BOOLEAN;
    SB();
    LOOP parts
      Pos := Pos + 1;
      WHILE At(Pos) # 'DQ' DO
        IF (At(Pos) = 'LF') OR (Pos > SrcEnd) THEN
          Building := FALSE;
          LexError("a string must close on its line")
        ENDIF;
        SC(At(Pos));
        Pos := Pos + 1
      ENDWHILE;
      Pos := Pos + 1;
      k := Pos;
      nl := 0;
      more := TRUE;
      WHILE more DO
        IF (At(k) = ' ') OR (At(k) = 'HT') OR (At(k) = 'CR') THEN
          k := k + 1
        ELSIF At(k) = 'LF' THEN
          nl := nl + 1;
          k := k + 1
        ELSE
          more := FALSE
        ENDIF
      ENDWHILE;
      IF At(k) # 'DQ' THEN EXIT parts ENDIF;
      LineNo := LineNo + nl;
      Pos := k
    ENDLOOP parts;
    t := SE();
    AddTok(K_STR, t);
    RETURN
  ENDPROCEDURE LexString;

  PROCEDURE Lex ()
    VAR c: ASCII;
        start, k, best, len: INT;
        t: Txt;
        neg, match: BOOLEAN;
    Pos := SrcStart;
    WHILE Pos <= SrcEnd DO
      c := Pool[Pos];
      IF c = 'LF' THEN
        LineNo := LineNo + 1;
        Pos := Pos + 1
      ELSIF (c = ' ') OR (c = 'HT') OR (c = 'CR') OR (c = 'FF') THEN
        Pos := Pos + 1
      ELSIF (c = '(') AND (At(Pos + 1) = '*') THEN
        (* a comment closes on its line (p.994) *)
        Pos := Pos + 2;
        WHILE NOT ((At(Pos) = '*') AND (At(Pos + 1) = ')')) DO
          IF (At(Pos) = 'LF') OR (Pos > SrcEnd) THEN LexError("a comment must close on its line") ENDIF;
          Pos := Pos + 1
        ENDWHILE;
        Pos := Pos + 2
      ELSIF IsDigit(c) OR ((Base = 16) AND (DigitVal(c) < 16)) THEN
        LexNumber(FALSE)
      ELSIF ((c = '-') OR (c = '+')) AND NOT EndsOperand() AND
            (IsDigit(At(Pos + 1)) OR ((Base = 16) AND (DigitVal(At(Pos + 1)) < 16))) THEN
        Pos := Pos + 1;
        LexNumber(c = '-')
      ELSIF IsLetter(c) THEN
        start := Pos;
        WHILE IsLetter(At(Pos)) OR IsDigit(At(Pos)) DO Pos := Pos + 1 ENDWHILE;
        t := Intern(start, Pos - start);
        IF t = W_BASE2 THEN Base := 2
        ELSIF t = W_BASE8 THEN Base := 8
        ELSIF t = W_BASE10 THEN Base := 10
        ELSIF t = W_BASE16 THEN Base := 16
        ELSIF t <= NKW THEN AddTok(K_KW, t)
        ELSE AddTok(K_ID, t)
        ENDIF
      ELSIF c = 'SQ' THEN
        start := Pos + 1;
        k := start;
        WHILE At(k) # 'SQ' DO
          IF (At(k) = 'LF') OR (At(k) = 'DQ') OR (k > SrcEnd) THEN LexError("bad character literal") ENDIF;
          k := k + 1
        ENDWHILE;
        IF k = start THEN LexError("empty character literal") ENDIF;
        t := Intern(start, k - start);
        AddTok(K_CHAR, t);
        Pos := k + 1
      ELSIF c = 'DQ' THEN
        LexString()
      ELSE
        (* the longest punctuation mark that matches *)
        best := 0;
        k := NKW + 1;
        WHILE (best = 0) AND (k <= NPUNCT) DO
          len := TL[k];
          match := TRUE;
          FOR i: INTEGER [0..len - 1] DO
            IF At(Pos + i) # Pool[TS[k] + i] THEN match := FALSE ENDIF
          ENDFOR;
          IF match THEN best := k ENDIF;
          k := k + 1
        ENDWHILE;
        IF best = 0 THEN LexError("a character that is not in the language") ENDIF;
        AddTok(K_OP, best);
        Pos := Pos + TL[best]
      ENDIF
    ENDWHILE;
    AddTok(K_EOF, 0);
    RETURN
  ENDPROCEDURE Lex;

  (* ---- the parser: Appendix B of the Report (pp.1084-1089) --------------- *)
  (* Rule numbers in comments are those of the Appendix. *)

  VAR
    TPos: INT := 1;
    Labels: Node := Node NIL;       (* the LABEL names of the blocks being read *)
    FromWord, DimensionWord: Txt := 0;

  PROCEDURE NewNode RETURNS Node (CONST kind, line: INT)
    VAR n: Node;
    NEW(n);
    n^ := NodeRec(kind, line, 0, 0, 0, 0, Node NIL, Node NIL, Node NIL, Node NIL, Node NIL,
                  Node NIL, Rep NIL, Sym NIL);
    RETURN n
  ENDPROCEDURE NewNode;

  PROCEDURE Link (VAR head, tail: Node; CONST n: Node)
    IF head = Node NIL THEN head := n ELSE tail^.next := n ENDIF;
    tail := n;
    RETURN
  ENDPROCEDURE Link;

  FUNCTION Count RETURNS INT (CONST list: Node)
    VAR n: INT := 0;
        p: Node := list;
    WHILE p # Node NIL DO
      n := n + 1;
      p := p^.next
    ENDWHILE;
    RETURN n
  ENDFUNCTION Count;

  PROCEDURE TK RETURNS INT ()
    RETURN TKind[TPos]
  ENDPROCEDURE TK;

  PROCEDURE TV RETURNS INT ()
    RETURN TVal[TPos]
  ENDPROCEDURE TV;

  PROCEDURE TLn RETURNS INT ()
    RETURN TLine[TPos]
  ENDPROCEDURE TLn;

  (* is token TPos + k the word or mark w *)
  PROCEDURE IsAt RETURNS BOOLEAN (CONST k, w: INT)
    VAR kind: INT := TKind[TPos + k];
    RETURN ((kind = K_KW) OR (kind = K_OP)) AND (TVal[TPos + k] = w)
  ENDPROCEDURE IsAt;

  PROCEDURE Is RETURNS BOOLEAN (CONST w: INT)
    RETURN IsAt(0, w)
  ENDPROCEDURE Is;

  PROCEDURE IsIdAt RETURNS BOOLEAN (CONST k: INT)
    RETURN TKind[TPos + k] = K_ID
  ENDPROCEDURE IsIdAt;

  PROCEDURE Skip ()
    IF TKind[TPos] # K_EOF THEN TPos := TPos + 1 ENDIF;
    RETURN
  ENDPROCEDURE Skip;

  PROCEDURE Accept RETURNS BOOLEAN (CONST w: INT)
    IF Is(w) THEN
      Skip();
      RETURN TRUE
    ENDIF;
    RETURN FALSE
  ENDPROCEDURE Accept;

  (* the text of the current token, for a message *)
  PROCEDURE TokText RETURNS Txt ()
    VAR k: INT := TK();
    IF (k = K_ID) OR (k = K_KW) OR (k = K_OP) OR (k = K_CHAR) THEN RETURN TV() ENDIF;
    IF k = K_EOF THEN RETURN T("the end of the text") ENDIF;
    IF k = K_INT THEN
      SB();
      SI(TV());
      RETURN SE()
    ENDIF;
    RETURN T("a literal")
  ENDPROCEDURE TokText;

  PROCEDURE Expect (CONST w: INT)
    VAR t: Txt;
    IF NOT Accept(w) THEN
      SB();
      SA("expected ");
      ST(w);
      SA(", found ");
      ST(TokText());
      t := SE();
      Fail(TLn(), t)
    ENDIF;
    RETURN
  ENDPROCEDURE Expect;

  PROCEDURE Ident RETURNS Txt ()
    VAR t: Txt;
    IF TK() # K_ID THEN
      SB();
      SA("expected an identifier, found ");
      ST(TokText());
      t := SE();
      Fail(TLn(), t)
    ENDIF;
    t := TV();
    Skip();
    RETURN t
  ENDPROCEDURE Ident;

  (* the closing name must repeat the opening one *)
  PROCEDURE CloseName (CONST open: Txt; CONST line: INT)
    VAR t: Txt;
    IF (TK() = K_ID) OR (TK() = K_KW) OR (TK() = K_OP) THEN
      t := TV();
      IF t = open THEN
        Skip();
        RETURN
      ENDIF
    ENDIF;
    FailN(line, open, " is closed with another name");
    RETURN
  ENDPROCEDURE CloseName;

  (* rule 56: a name that may also be an operator *)
  PROCEDURE ExtendedId RETURNS Txt ()
    VAR t: Txt := TV();
    IF TK() = K_ID THEN
      Skip();
      RETURN t
    ENDIF;
    IF (TK() = K_KW) AND ((t = W_NOT) OR (t = W_AND) OR (t = W_OR) OR (t = W_DIV) OR
                          (t = W_MOD) OR (t = W_XOR) OR (t = W_IN)) THEN
      Skip();
      RETURN t
    ENDIF;
    IF (TK() = K_OP) AND (t # P_LPAR) AND (t # P_RPAR) AND (t # P_LBRACK) AND (t # P_RBRACK) AND
       (t # P_COMMA) AND (t # P_SEMI) AND (t # P_COLON) AND (t # P_DOT) AND (t # P_DOTDOT) AND
       (t # P_ARROW) THEN
      Skip();
      RETURN t
    ENDIF;
    FailS(TLn(), "expected a name");
    RETURN 0
  ENDPROCEDURE ExtendedId;

  PROCEDURE IsLabel RETURNS BOOLEAN (CONST name: Txt)
    VAR p: Node := Labels;
    WHILE p # Node NIL DO
      IF p^.name = name THEN RETURN TRUE ENDIF;
      p := p^.next
    ENDWHILE;
    RETURN FALSE
  ENDPROCEDURE IsLabel;

  (* ---- modules: rules 2-5 ------------------------------------------------- *)

  PROCEDURE ImportItem RETURNS Node ()
    VAR n: Node := NewNode(N_ITEM, TLn());
    n^.name := ExtendedId();
    (* FROM is not among the reserved words of Appendix A, but rules 4 *)
    (* and 5 use it: it is read here as a word of the import list *)
    IF IsIdAt(0) AND (TV() = FromWord) THEN
      Skip();
      n^.text := Ident()
    ENDIF;
    IF Accept(W_AS) THEN n^.ival := ExtendedId() ENDIF;
    RETURN n
  ENDPROCEDURE ImportItem;

  PROCEDURE ParseModule RETURNS Node ()
    VAR n: Node := NewNode(N_MODULE, TLn());
        it, itail, etail: Node := Node NIL;
        attr: INT;
    IF Accept(W_MONITOR) THEN n^.flag := 1 ELSE Expect(W_MODULE) ENDIF;
    n^.name := Ident();
    WHILE Accept(W_IMPORT) DO
      LOOP items
        it := ImportItem();
        Link(n^.a, itail, it);
        IF NOT Accept(P_COMMA) THEN EXIT items ENDIF
      ENDLOOP items;
      Expect(P_SEMI)
    ENDWHILE;
    WHILE Accept(W_EXPORT) DO
      attr := 0;
      IF Is(W_OPAQUE) OR Is(W_TRANSPARENT) OR Is(W_READONLY) OR Is(W_VAR) THEN
        attr := TV();
        Skip()
      ENDIF;
      LOOP items
        it := ImportItem();
        it^.flag := attr;
        Link(n^.b, etail, it);
        IF NOT Accept(P_COMMA) THEN EXIT items ENDIF
      ENDLOOP items;
      Expect(P_SEMI)
    ENDWHILE;
    n^.c := ParseBlock();
    IF n^.flag = 1 THEN Expect(W_ENDMONITOR) ELSE Expect(W_ENDMODULE) ENDIF;
    CloseName(n^.name, n^.line);
    RETURN n
  ENDPROCEDURE ParseModule;

  (* ---- blocks: rule 6 -------------------------------------------------------- *)

  PROCEDURE IsDeclWord RETURNS BOOLEAN ()
    VAR v: INT;
    IF TK() # K_KW THEN RETURN FALSE ENDIF;
    v := TV();
    RETURN (v = W_CONST) OR (v = W_VAR) OR (v = W_LABEL) OR (v = W_TYPE) OR
           (v = W_REPRESENTATION) OR (v = W_FUNCTION) OR (v = W_PROCEDURE) OR
           (v = W_MODULE) OR (v = W_MONITOR) OR (v = W_TEMPLATE) OR (v = W_INSTANCE) OR
           (v = W_PROCESS)
  ENDPROCEDURE IsDeclWord;

  PROCEDURE ParseBlock RETURNS Node ()
    VAR n: Node := NewNode(N_BLOCK, TLn());
        tail: Node := Node NIL;
        saved: Node := Labels;
        d: Node;
    WHILE IsDeclWord() DO
      ParseDeclGroup(n^.a, tail);
      WHILE Accept(P_SEMI) DO ENDWHILE
    ENDWHILE;
    IF Is(W_EXCEPTION) THEN
      n^.b := ParseHandler();
      d := n^.b;
      IF Accept(P_SEMI) THEN ENDIF
    ENDIF;
    n^.c := ParseStatements(TRUE);
    Labels := saved;
    RETURN n
  ENDPROCEDURE ParseBlock;

  (* rule 18 *)
  PROCEDURE ParseHandler RETURNS Node ()
    VAR n: Node := NewNode(N_HANDLER, TLn());
        c, ctail, nm, ntail: Node := Node NIL;
    Expect(W_EXCEPTION);
    WHILE Accept(W_CASE) DO
      c := NewNode(N_HCASE, TLn());
      ntail := Node NIL;
      LOOP names
        nm := NewNode(N_NAMEL, TLn());
        nm^.name := Ident();
        Link(c^.a, ntail, nm);
        IF NOT Accept(P_COMMA) THEN EXIT names ENDIF
      ENDLOOP names;
      Expect(P_ARROW);
      c^.b := ParseStatements(FALSE);
      Link(n^.a, ctail, c)
    ENDWHILE;
    IF Accept(W_ELSE) THEN
      n^.flag := 1;
      n^.b := ParseStatements(FALSE)
    ENDIF;
    Expect(W_ENDEXCEPTION);
    RETURN n
  ENDPROCEDURE ParseHandler;

  (* ---- declarations: rules 7-17 ----------------------------------------------- *)

  (* Names, rule 57: Id* [AT ManifestConstant] {, ...} *)
  PROCEDURE ParseNames RETURNS Node ()
    VAR head, tail, n: Node := Node NIL;
    LOOP names
      n := NewNode(N_NAMEL, TLn());
      n^.name := Ident();
      IF Accept(W_AT) THEN n^.a := ParseExpr() ENDIF;
      Link(head, tail, n);
      IF NOT Accept(P_COMMA) THEN EXIT names ENDIF
    ENDLOOP names;
    RETURN head
  ENDPROCEDURE ParseNames;

  PROCEDURE SimpleEntry RETURNS Node (CONST w: INT)
    VAR n: Node;
    IF w = W_CONST THEN
      n := NewNode(N_CONST, TLn());
      n^.a := ParseNames();
      Expect(P_COLON);
      n^.b := ParseRep();
      Expect(P_EQ);
      n^.c := ParseExpr()
    ELSIF w = W_VAR THEN
      n := NewNode(N_VAR, TLn());
      n^.a := ParseNames();
      Expect(P_COLON);
      n^.b := ParseRep();
      IF Accept(P_ASSIGN) THEN n^.c := ParseExpr() ENDIF
    ELSIF w = W_TYPE THEN
      n := NewNode(N_TYPE, TLn());
      n^.name := Ident();
      Expect(P_EQ);
      n^.b := ParseConcrete1()
    ELSE
      n := NewNode(N_REPDECL, TLn());
      n^.name := Ident();
      Expect(P_EQ);
      n^.b := ParseRep()
    ENDIF;
    RETURN n
  ENDPROCEDURE SimpleEntry;

  (* "VAR a: R; b: S" -- an entry goes on while an identifier (not a label) *)
  (* is followed by "," or ":" (CONST, VAR) or by "=" (TYPE, REPRESENTATION) *)
  PROCEDURE Continues RETURNS BOOLEAN (CONST w: INT)
    IF NOT (Is(P_SEMI) AND IsIdAt(1)) THEN RETURN FALSE ENDIF;
    IF IsLabel(TVal[TPos + 1]) THEN RETURN FALSE ENDIF;
    IF (w = W_CONST) OR (w = W_VAR) THEN RETURN IsAt(2, P_COMMA) OR IsAt(2, P_COLON) ENDIF;
    RETURN IsAt(2, P_EQ)
  ENDPROCEDURE Continues;

  PROCEDURE ParseDeclGroup (VAR head, tail: Node)
    VAR w: INT := TV();
        n, nm, ntail: Node;
    IF (w = W_CONST) OR (w = W_VAR) OR (w = W_TYPE) OR (w = W_REPRESENTATION) THEN
      Skip();
      Link(head, tail, SimpleEntry(w));
      WHILE Continues(w) DO
        Skip();
        Link(head, tail, SimpleEntry(w))
      ENDWHILE;
      RETURN
    ENDIF;
    IF w = W_LABEL THEN
      n := NewNode(N_LABEL, TLn());
      Skip();
      ntail := Node NIL;
      LOOP names
        nm := NewNode(N_NAMEL, TLn());
        nm^.name := Ident();
        Link(n^.a, ntail, nm);
        IF NOT Accept(P_COMMA) THEN EXIT names ENDIF
      ENDLOOP names;
      (* the labels of this block are known to the statement reader *)
      nm := n^.a;
      WHILE nm # Node NIL DO
        n^.b := NewNode(N_NAMEL, nm^.line);
        n^.b^.name := nm^.name;
        n^.b^.next := Labels;
        Labels := n^.b;
        nm := nm^.next
      ENDWHILE;
      n^.b := Node NIL;
      Link(head, tail, n);
      RETURN
    ENDIF;
    Link(head, tail, ParseDecl());
    RETURN
  ENDPROCEDURE ParseDeclGroup;

  PROCEDURE ParseDecl RETURNS Node ()
    VAR n, f, ftail: Node;
        w: INT := TV();
        line: INT := TLn();
        start: INT;
    IF (w = W_FUNCTION) OR (w = W_PROCEDURE) THEN
      n := NewNode(N_ROUTINE, line);
      Skip();
      IF w = W_FUNCTION THEN n^.flag := 1 ENDIF;
      IF Is(W_EXTENDS) OR Is(W_REPLACES) THEN
        n^.ival := TV();
        Skip()
      ENDIF;
      n^.name := ExtendedId();
      ParseFormals(n);
      IF Accept(W_INLINE) THEN n^.e := NewNode(N_NAMEL, line) ENDIF;
      n^.c := ParseBlock();
      IF w = W_FUNCTION THEN Expect(W_ENDFUNCTION) ELSE Expect(W_ENDPROCEDURE) ENDIF;
      CloseName(n^.name, line);
      RETURN n
    ENDIF;
    IF (w = W_MODULE) OR (w = W_MONITOR) THEN RETURN ParseModule() ENDIF;
    IF w = W_TEMPLATE THEN
      n := NewNode(N_TEMPLATE, line);
      Skip();
      n^.name := Ident();
      Expect(P_LPAR);
      ftail := Node NIL;
      LOOP formals
        f := NewNode(N_NAMEL, TLn());
        f^.name := Ident();
        Link(n^.a, ftail, f);
        IF NOT Accept(P_COMMA) THEN EXIT formals ENDIF
      ENDLOOP formals;
      Expect(P_RPAR);
      start := TPos;
      n^.b := ParseModule();
      n^.ival := start;
      n^.flag := TPos;
      Expect(W_ENDTEMPLATE);
      CloseName(n^.name, line);
      RETURN n
    ENDIF;
    IF w = W_INSTANCE THEN
      n := NewNode(N_INSTANCE, line);
      Skip();
      n^.name := Ident();
      Expect(P_LPAR);
      ftail := Node NIL;
      LOOP actuals
        f := NewNode(N_NAMEL, TLn());
        f^.name := ExtendedId();
        Link(n^.a, ftail, f);
        IF NOT Accept(P_COMMA) THEN EXIT actuals ENDIF
      ENDLOOP actuals;
      Expect(P_RPAR);
      RETURN n
    ENDIF;
    IF w = W_PROCESS THEN
      n := NewNode(N_PROCESS, line);
      Skip();
      n^.name := Ident();
      ParseFormals(n);
      IF n^.b # Node NIL THEN FailS(line, "a process returns no value") ENDIF;
      IF Accept(W_PRIORITY) THEN n^.d := ParseExpr() ENDIF;
      IF Accept(W_INSTANCES) THEN n^.e := ParseExpr() ENDIF;
      IF Accept(W_SIZE) THEN f := ParseExpr() ENDIF;
      n^.c := ParseBlock();
      Expect(W_ENDPROCESS);
      CloseName(n^.name, line);
      RETURN n
    ENDIF;
    FailS(line, "expected a declaration");
    RETURN Node NIL
  ENDPROCEDURE ParseDecl;

  (* rule 87: [RETURNS Representation] ( {(CONST|OUT|VAR) {Names : FormalRep ;}} [;] ) *)
  (* into n^.a (the parameters) and n^.b (the result) *)
  PROCEDURE ParseFormals (CONST n: Node)
    VAR p, tail: Node := Node NIL;
        cls: INT;
    IF Accept(W_RETURNS) THEN n^.b := ParseRep() ENDIF;
    Expect(P_LPAR);
    WHILE NOT Is(P_RPAR) DO
      IF Accept(W_CONST) THEN cls := C_CONST
      ELSIF Accept(W_OUT) THEN cls := C_OUT
      ELSIF Accept(W_VAR) THEN cls := C_VAR
      ELSE FailS(TLn(), "a formal parameter is CONST, OUT or VAR")
      ENDIF;
      LOOP group
        p := NewNode(N_PARAM, TLn());
        p^.ival := cls;
        p^.a := ParseNames();
        Expect(P_COLON);
        p^.b := ParseFormalRep();
        Link(n^.a, tail, p);
        (* the class carries over "; name"; the 1978 examples also use "," *)
        IF NOT ((Is(P_SEMI) OR Is(P_COMMA)) AND IsIdAt(1)) THEN EXIT group ENDIF;
        Skip()
      ENDLOOP group;
      IF NOT Accept(P_SEMI) THEN
        IF NOT Accept(P_COMMA) THEN Expect(P_RPAR); RETURN ENDIF
      ENDIF
    ENDWHILE;
    Expect(P_RPAR);
    RETURN
  ENDPROCEDURE ParseFormals;

  (* rules 85-86 *)
  PROCEDURE ParseFormalRep RETURNS Node ()
    VAR n: Node;
    IF Is(W_ARRAY) AND IsAt(1, P_LPAR) AND (IsAt(3, W_DIMENSIONS) OR
                                         (IsIdAt(3) AND (TVal[TPos + 3] = DimensionWord))) THEN
      n := NewNode(N_RUARRAY, TLn());
      Skip();
      Skip();
      n^.a := ParseExpr();
      Skip();                         (* DIMENSIONS, or DIMENSION as on p.1063 *)
      Expect(W_OF);
      n^.b := ParseRep();
      Expect(P_RPAR);
      RETURN n
    ENDIF;
    IF Is(W_SPACE) THEN
      n := NewNode(N_RSPACE, TLn());
      Skip();
      RETURN n
    ENDIF;
    RETURN ParseRep()
  ENDPROCEDURE ParseFormalRep;

  (* ---- representations: rules 61-84 ------------------------------------------- *)

  PROCEDURE IsStructWord RETURNS BOOLEAN (CONST k: INT)
    VAR v: INT := TVal[TPos + k];
    IF TKind[TPos + k] # K_KW THEN RETURN FALSE ENDIF;
    RETURN (v = W_UNORDERED) OR (v = W_ORDERED) OR (v = W_ALPHABET) OR (v = W_ARRAY) OR
           (v = W_RECORD) OR (v = W_FILE) OR (v = W_POINTER) OR (v = W_SET)
  ENDPROCEDURE IsStructWord;

  (* rule 61: [Type] ConcreteType -- the Type is taken as a type identifier *)
  PROCEDURE ParseRep RETURNS Node ()
    VAR tname: Txt;
        n: Node;
    IF IsIdAt(0) AND (IsStructWord(1) OR (IsIdAt(1) AND IsAt(2, P_LBRACK))) THEN
      tname := Ident();
      n := ParseConcrete();
      n^.text := tname;
      RETURN n
    ENDIF;
    RETURN ParseConcrete()
  ENDPROCEDURE ParseRep;

  (* rule 72: ConcreteType1 [PACKED [ManifestConstant]] [ALIGNMENT ManifestConstant] *)
  (* -- the storage directives of XIV are read and ignored *)
  PROCEDURE ParseConcrete RETURNS Node ()
    VAR n, x: Node;
    n := ParseConcrete1();
    IF Accept(W_PACKED) THEN
      IF (TK() = K_INT) OR (TK() = K_ID) OR Is(P_LPAR) THEN x := ParseExpr() ENDIF
    ENDIF;
    IF Accept(W_ALIGNMENT) THEN x := ParseExpr() ENDIF;
    RETURN n
  ENDPROCEDURE ParseConcrete;

  PROCEDURE ParseIds RETURNS Node ()
    VAR head, tail, n: Node := Node NIL;
    LOOP ids
      n := NewNode(N_NAMEL, TLn());
      n^.name := Ident();
      Link(head, tail, n);
      IF NOT Accept(P_COMMA) THEN EXIT ids ENDIF
    ENDLOOP ids;
    RETURN head
  ENDPROCEDURE ParseIds;

  PROCEDURE ParseFieldGroups RETURNS Node ()
    VAR head, tail, f: Node := Node NIL;
        cls: INT;
    WHILE Is(W_CONST) OR Is(W_VAR) DO
      cls := TV();
      Skip();
      LOOP group
        f := NewNode(N_FIELD, TLn());
        f^.ival := cls;
        f^.a := ParseNames();
        Expect(P_COLON);
        f^.b := ParseRep();
        Link(head, tail, f);
        IF NOT (Is(P_SEMI) AND IsIdAt(1)) THEN EXIT group ENDIF;
        Skip()
      ENDLOOP group;
      IF NOT Accept(P_SEMI) THEN RETURN head ENDIF
    ENDWHILE;
    RETURN head
  ENDPROCEDURE ParseFieldGroups;

  PROCEDURE ParseConcrete1 RETURNS Node ()
    VAR n, v, c, ctail, lab, ltail: Node;
        w: INT;
        line: INT := TLn();
    IF TK() = K_ID THEN
      n := NewNode(N_RNAME, line);
      n^.name := Ident();
      n^.a := ParseQualifier();
      RETURN n
    ENDIF;
    IF TK() # K_KW THEN FailS(line, "expected a representation") ENDIF;
    w := TV();
    IF (w = W_UNORDERED) OR (w = W_ORDERED) THEN
      n := NewNode(N_RENUM, line);
      IF w = W_ORDERED THEN n^.flag := 1 ENDIF;
      Skip();
      Expect(P_LPAR);
      n^.a := ParseIds();
      Expect(P_RPAR);
      n^.b := ParseQualifier();
      RETURN n
    ENDIF;
    IF w = W_ALPHABET THEN
      n := NewNode(N_RALPHA, line);
      Skip();
      Expect(P_LPAR);
      ltail := Node NIL;
      LOOP chars
        IF TK() # K_CHAR THEN FailS(TLn(), "an ALPHABET lists character literals") ENDIF;
        lab := NewNode(N_CHARLIT, TLn());
        lab^.text := TV();
        Skip();
        Link(n^.a, ltail, lab);
        IF NOT Accept(P_COMMA) THEN EXIT chars ENDIF
      ENDLOOP chars;
      Expect(P_RPAR);
      n^.b := ParseQualifier();
      RETURN n
    ENDIF;
    IF w = W_ARRAY THEN
      n := NewNode(N_RARRAY, line);
      Skip();
      Expect(P_LPAR);
      ltail := Node NIL;
      LOOP indices
        Link(n^.a, ltail, ParseRep());
        IF NOT Accept(P_COMMA) THEN EXIT indices ENDIF
      ENDLOOP indices;
      Expect(W_OF);
      n^.b := ParseRep();
      Expect(P_RPAR);
      RETURN n
    ENDIF;
    IF w = W_RECORD THEN
      n := NewNode(N_RRECORD, line);
      Skip();
      n^.a := ParseFieldGroups();
      IF Accept(W_SELECT) THEN
        v := NewNode(N_VARIANT, TLn());
        v^.name := Ident();
        Expect(P_COLON);
        v^.b := ParseRep();
        ctail := Node NIL;
        WHILE Accept(W_CASE) DO
          c := NewNode(N_VCASE, TLn());
          ltail := Node NIL;
          LOOP labels
            Link(c^.a, ltail, ParseExpr());
            IF NOT Accept(P_COMMA) THEN EXIT labels ENDIF
          ENDLOOP labels;
          Expect(P_ARROW);
          c^.b := ParseFieldGroups();
          WHILE Accept(P_SEMI) DO ENDWHILE;
          Link(v^.a, ctail, c)
        ENDWHILE;
        Expect(W_ENDSELECT);
        IF Accept(P_SEMI) THEN ENDIF;
        n^.b := v
      ENDIF;
      Expect(W_ENDRECORD);
      RETURN n
    ENDIF;
    IF (w = W_FILE) OR (w = W_POINTER) OR (w = W_SET) THEN
      IF w = W_FILE THEN n := NewNode(N_RFILE, line)
      ELSIF w = W_POINTER THEN n := NewNode(N_RPOINTER, line)
      ELSE n := NewNode(N_RSET, line)
      ENDIF;
      Skip();
      Expect(P_LPAR);
      n^.a := ParseRep();
      Expect(P_RPAR);
      RETURN n
    ENDIF;
    FailS(line, "expected a representation");
    RETURN Node NIL
  ENDPROCEDURE ParseConcrete1;

  (* rules 82-84 *)
  PROCEDURE ParseQualifier RETURNS Node ()
    VAR q: Node;
    IF NOT Is(P_LBRACK) THEN RETURN Node NIL ENDIF;
    q := NewNode(N_QUAL, TLn());
    Skip();
    q^.a := ParseExpr();
    Expect(P_DOTDOT);
    q^.b := ParseExpr();
    Expect(P_RBRACK);
    IF Accept(W_SCALE) THEN q^.c := ParseExpr()
    ELSIF Accept(W_PRECISION) THEN q^.d := ParseExpr()
    ENDIF;
    RETURN q
  ENDPROCEDURE ParseQualifier;

  (* ---- statements: rules 19-33 ------------------------------------------------ *)

  (* the words that end a sequence of statements *)
  PROCEDURE IsStop RETURNS BOOLEAN ()
    VAR v: INT;
    IF TK() = K_EOF THEN RETURN TRUE ENDIF;
    IF TK() # K_KW THEN RETURN FALSE ENDIF;
    v := TV();
    RETURN (v = W_ELSIF) OR (v = W_ELSE) OR (v = W_ENDIF) OR (v = W_CASE) OR
           (v = W_ENDSELECT) OR (v = W_ENDWHILE) OR (v = W_ENDFOR) OR (v = W_ENDLOOP) OR
           (v = W_END) OR (v = W_ENDEXCEPTION) OR (v = W_ENDPROCEDURE) OR
           (v = W_ENDFUNCTION) OR (v = W_ENDPROCESS) OR (v = W_ENDMODULE) OR
           (v = W_ENDMONITOR)
  ENDPROCEDURE IsStop;

  (* rule 33, and the labelled statements of a block (rule 6) *)
  PROCEDURE ParseStatements RETURNS Node (CONST labelled: BOOLEAN)
    VAR head, tail, s: Node := Node NIL;
        label: Txt;
    LOOP stmts
      WHILE Accept(P_SEMI) DO ENDWHILE;
      IF IsStop() THEN EXIT stmts ENDIF;
      label := 0;
      IF labelled AND IsIdAt(0) AND IsAt(1, P_COLON) THEN
        label := Ident();
        Skip()
      ENDIF;
      s := ParseStatement();
      s^.text := label;
      Link(head, tail, s);
      IF NOT Is(P_SEMI) THEN EXIT stmts ENDIF
    ENDLOOP stmts;
    RETURN head
  ENDPROCEDURE ParseStatements;

  PROCEDURE ParseStatement RETURNS Node ()
    VAR n, arm, tail, lab, ltail, d: Node;
        w: INT;
        line: INT := TLn();
    IF TK() = K_KW THEN
      w := TV();
      IF w = W_ASSERT THEN
        Skip();
        n := NewNode(N_ASSERT, line);
        n^.a := ParseExpr();
        RETURN n
      ENDIF;
      IF w = W_GOTO THEN
        Skip();
        n := NewNode(N_GOTO, line);
        n^.name := Ident();
        RETURN n
      ENDIF;
      IF w = W_EXIT THEN
        Skip();
        n := NewNode(N_EXIT, line);
        n^.name := Ident();
        RETURN n
      ENDIF;
      IF w = W_RETURN THEN
        Skip();
        n := NewNode(N_RETURN, line);
        IF NOT (Is(P_SEMI) OR IsStop()) THEN n^.a := ParseExpr() ENDIF;
        RETURN n
      ENDIF;
      IF w = W_TERMINATE_PROCESS THEN
        Skip();
        RETURN NewNode(N_TERMINATE, line)
      ENDIF;
      IF w = W_PROPAGATE_EXCEPTION THEN
        Skip();
        n := NewNode(N_PROPAGATE, line);
        IF IsIdAt(0) THEN n^.name := Ident() ENDIF;
        RETURN n
      ENDIF;
      IF w = W_IF THEN
        Skip();
        n := NewNode(N_IF, line);
        tail := Node NIL;
        arm := NewNode(N_ARM, line);
        arm^.a := ParseExpr();
        Expect(W_THEN);
        arm^.b := ParseStatements(FALSE);
        Link(n^.a, tail, arm);
        WHILE Is(W_ELSIF) DO
          arm := NewNode(N_ARM, TLn());
          Skip();
          arm^.a := ParseExpr();
          Expect(W_THEN);
          arm^.b := ParseStatements(FALSE);
          Link(n^.a, tail, arm)
        ENDWHILE;
        IF Accept(W_ELSE) THEN
          n^.flag := 1;
          n^.b := ParseStatements(FALSE)
        ENDIF;
        Expect(W_ENDIF);
        RETURN n
      ENDIF;
      IF w = W_SELECT THEN
        Skip();
        n := NewNode(N_SELECT, line);
        n^.a := ParseExpr();
        tail := Node NIL;
        WHILE Is(W_CASE) DO
          arm := NewNode(N_ARM, TLn());
          Skip();
          ltail := Node NIL;
          LOOP labels
            Link(arm^.a, ltail, ParseExpr());
            IF NOT Accept(P_COMMA) THEN EXIT labels ENDIF
          ENDLOOP labels;
          Expect(P_ARROW);
          arm^.b := ParseStatements(FALSE);
          Link(n^.b, tail, arm)
        ENDWHILE;
        IF Accept(W_ELSE) THEN
          n^.flag := 1;
          n^.c := ParseStatements(FALSE)
        ENDIF;
        Expect(W_ENDSELECT);
        RETURN n
      ENDIF;
      IF w = W_WHILE THEN
        Skip();
        n := NewNode(N_WHILE, line);
        n^.a := ParseExpr();
        Expect(W_DO);
        n^.b := ParseStatements(FALSE);
        Expect(W_ENDWHILE);
        RETURN n
      ENDIF;
      IF w = W_FOR THEN
        Skip();
        n := NewNode(N_FOR, line);
        n^.name := Ident();
        Expect(P_COLON);
        n^.a := ParseRep();
        Expect(W_DO);
        n^.b := ParseStatements(FALSE);
        Expect(W_ENDFOR);
        RETURN n
      ENDIF;
      IF w = W_LOOP THEN
        Skip();
        n := NewNode(N_LOOP, line);
        n^.name := Ident();
        n^.b := ParseStatements(FALSE);
        Expect(W_ENDLOOP);
        CloseName(n^.name, line);
        RETURN n
      ENDIF;
      IF (w = W_BEGIN) OR (w = W_SIMULATED_TIME) THEN
        n := NewNode(N_BEGIN, line);
        IF Accept(W_SIMULATED_TIME) THEN n^.flag := 1 ENDIF;
        Expect(W_BEGIN);
        n^.a := ParseBlock();
        Expect(W_END);
        RETURN n
      ENDIF
    ENDIF;
    (* rules 19-20: an assignment, or a call of a procedure or process *)
    d := ParseDesignator();
    IF Accept(P_ASSIGN) THEN
      n := NewNode(N_ASSIGN, line);
      n^.a := d;
      n^.b := ParseExpr();
      RETURN n
    ENDIF;
    IF d^.kind # N_CALL THEN FailS(line, "expected a statement") ENDIF;
    n := NewNode(N_CALLST, line);
    n^.a := d;
    RETURN n
  ENDPROCEDURE ParseStatement;

  (* ---- expressions: rules 34-54 --------------------------------------------- *)

  (* the operator at TPos, as a Txt (a word or a mark), or 0 *)
  PROCEDURE OpAt RETURNS Txt ()
    IF (TK() = K_OP) OR (TK() = K_KW) THEN RETURN TV() ENDIF;
    RETURN 0
  ENDPROCEDURE OpAt;

  FUNCTION IsRel RETURNS BOOLEAN (CONST o: Txt)
    RETURN (o = W_IN) OR (o = P_NE) OR (o = P_EQ) OR (o = P_LT) OR (o = P_LE) OR (o = P_GT) OR
           (o = P_GE) OR (o = P_NE2) OR (o = P_NE3) OR (o = P_EQ2) OR (o = P_EQ3) OR
           (o = P_LT2) OR (o = P_LE3) OR (o = P_LT3) OR (o = P_LE4) OR (o = P_GT2) OR
           (o = P_GE3) OR (o = P_GT3) OR (o = P_GE4)
  ENDFUNCTION IsRel;

  FUNCTION IsAssocMul RETURNS BOOLEAN (CONST o: Txt)
    RETURN (o = P_STAR) OR (o = W_AND)
  ENDFUNCTION IsAssocMul;

  FUNCTION IsNonAssocMul RETURNS BOOLEAN (CONST o: Txt)
    RETURN (o = P_SLASH) OR (o = W_DIV) OR (o = W_MOD) OR (o = P_MUL2) OR (o = P_MUL3) OR
           (o = P_DIV2) OR (o = P_DIV3)
  ENDFUNCTION IsNonAssocMul;

  FUNCTION IsAssocAdd RETURNS BOOLEAN (CONST o: Txt)
    RETURN (o = P_PLUS) OR (o = W_OR)
  ENDFUNCTION IsAssocAdd;

  FUNCTION IsNonAssocAdd RETURNS BOOLEAN (CONST o: Txt)
    RETURN (o = P_MINUS) OR (o = W_XOR) OR (o = P_SUB2) OR (o = P_SUB3) OR (o = P_ADD2) OR
           (o = P_ADD3)
  ENDFUNCTION IsNonAssocAdd;

  PROCEDURE Bin RETURNS Node (CONST op: Txt; CONST a, b: Node; CONST line: INT)
    VAR n: Node := NewNode(N_BIN, line);
    n^.name := op;
    n^.a := a;
    n^.b := b;
    RETURN n
  ENDPROCEDURE Bin;

  (* non-associative operators need parentheses next to an operator of *)
  (* their level (VIII.A, p.1031; Design Discussion VIII.B) *)
  PROCEDURE NeedParens (CONST op: Txt; CONST line: INT)
    VAR t: Txt;
    SB();
    ST(op);
    SA(" next to another operator of its level needs parentheses (VIII.A)");
    t := SE();
    Fail(line, t);
    RETURN
  ENDPROCEDURE NeedParens;

  (* rule 34 *)
  PROCEDURE ParseExpr RETURNS Node ()
    VAR a: Node;
        op: Txt;
        line: INT := TLn();
    a := ParseSimple();
    op := OpAt();
    IF IsRel(op) THEN
      Skip();
      a := Bin(op, a, ParseSimple(), line);
      IF IsRel(OpAt()) THEN NeedParens(op, line) ENDIF
    ENDIF;
    RETURN a
  ENDPROCEDURE ParseExpr;

  (* rules 35-37 *)
  PROCEDURE ParseSimple RETURNS Node ()
    VAR a, n: Node;
        op: Txt;
        line: INT := TLn();
    IF Is(P_MINUS) THEN
      Skip();
      n := NewNode(N_NEG, line);
      n^.a := ParseTerm();
      op := OpAt();
      IF IsAssocAdd(op) OR IsNonAssocAdd(op) THEN NeedParens(P_MINUS, line) ENDIF;
      RETURN n
    ENDIF;
    a := ParseTerm();
    op := OpAt();
    IF IsNonAssocAdd(op) THEN
      Skip();
      a := Bin(op, a, ParseTerm(), line);
      IF IsAssocAdd(OpAt()) OR IsNonAssocAdd(OpAt()) THEN NeedParens(op, line) ENDIF;
      RETURN a
    ENDIF;
    WHILE IsAssocAdd(op) DO
      Skip();
      a := Bin(op, a, ParseTerm(), line);
      IF IsNonAssocAdd(OpAt()) THEN NeedParens(OpAt(), line) ENDIF;
      op := OpAt()
    ENDWHILE;
    RETURN a
  ENDPROCEDURE ParseSimple;

  (* rules 38-39 *)
  PROCEDURE ParseTerm RETURNS Node ()
    VAR a: Node;
        op: Txt;
        line: INT := TLn();
    a := ParseFactor();
    op := OpAt();
    IF IsNonAssocMul(op) THEN
      Skip();
      a := Bin(op, a, ParseFactor(), line);
      IF IsAssocMul(OpAt()) OR IsNonAssocMul(OpAt()) THEN NeedParens(op, line) ENDIF;
      RETURN a
    ENDIF;
    WHILE IsAssocMul(op) DO
      Skip();
      a := Bin(op, a, ParseFactor(), line);
      IF IsNonAssocMul(OpAt()) THEN NeedParens(OpAt(), line) ENDIF;
      op := OpAt()
    ENDWHILE;
    RETURN a
  ENDPROCEDURE ParseTerm;

  PROCEDURE IsLiteralAt RETURNS BOOLEAN (CONST k: INT)
    VAR kind: INT := TKind[TPos + k];
    RETURN (kind = K_INT) OR (kind = K_FIXED) OR (kind = K_FLOAT) OR (kind = K_CHAR) OR
           (kind = K_STR) OR IsAt(k, W_NIL)
  ENDPROCEDURE IsLiteralAt;

  PROCEDURE ParseLiteral RETURNS Node ()
    VAR n: Node;
        kind: INT := TK();
        line: INT := TLn();
    IF kind = K_INT THEN
      n := NewNode(N_INT, line);
      n^.ival := TV()
    ELSIF kind = K_FIXED THEN
      n := NewNode(N_FIXED, line);
      n^.text := TV()
    ELSIF kind = K_FLOAT THEN
      n := NewNode(N_FLOAT, line);
      n^.text := TV()
    ELSIF kind = K_CHAR THEN
      n := NewNode(N_CHARLIT, line);
      n^.text := TV()
    ELSIF kind = K_STR THEN
      n := NewNode(N_STRLIT, line);
      n^.text := TV()
    ELSE
      n := NewNode(N_NIL, line)
    ENDIF;
    Skip();
    RETURN n
  ENDPROCEDURE ParseLiteral;

  (* rule 40: {NOT} ( "(" Expression ")" | Designator | [Id*] Literal ) *)
  PROCEDURE ParseFactor RETURNS Node ()
    VAR n: Node;
        q: Txt;
        line: INT := TLn();
    IF Is(W_NOT) THEN
      Skip();
      n := NewNode(N_NOT, line);
      n^.a := ParseFactor();
      RETURN n
    ENDIF;
    IF Is(P_LPAR) THEN
      Skip();
      n := NewNode(N_PAREN, line);
      n^.a := ParseExpr();
      Expect(P_RPAR);
      RETURN n
    ENDIF;
    IF IsLiteralAt(0) THEN RETURN ParseLiteral() ENDIF;
    IF IsIdAt(0) THEN
      (* a literal qualified by the name of its type: Colors Orange, *)
      (* Tree NIL, BASE-less numbers of another integer type (VI.A.3) *)
      IF IsLiteralAt(1) OR (IsIdAt(1) AND NOT (IsAt(2, P_LPAR) OR IsAt(2, P_LBRACK) OR
                            IsAt(2, P_DOT) OR IsAt(2, P_UP) OR IsAt(2, P_ASSIGN) OR
                            IsAt(2, P_COLON))) THEN
        q := Ident();
        IF IsIdAt(0) THEN
          n := NewNode(N_NAME, line);
          n^.name := Ident()
        ELSE
          n := ParseLiteral()
        ENDIF;
        n^.d := NewNode(N_NAMEL, line);
        n^.d^.name := q;
        RETURN n
      ENDIF;
      RETURN ParseDesignator()
    ENDIF;
    FailN(line, TokText(), " cannot begin an operand");
    RETURN Node NIL
  ENDPROCEDURE ParseFactor;

  (* rules 41-43 *)
  PROCEDURE ParseDesignator RETURNS Node ()
    VAR d, n, tail: Node;
        line: INT := TLn();
    d := NewNode(N_NAME, line);
    d^.name := Ident();
    IF Accept(P_LPAR) THEN
      d^.kind := N_CALL;
      tail := Node NIL;
      WHILE NOT Is(P_RPAR) DO
        Link(d^.a, tail, ParseExpr());
        IF NOT Accept(P_COMMA) THEN EXIT_ARGS() ENDIF
      ENDWHILE;
      Expect(P_RPAR)
    ENDIF;
    LOOP sel
      IF Accept(P_DOT) THEN
        n := NewNode(N_SEL, TLn());
        n^.a := d;
        n^.name := Ident();
        d := n
      ELSIF Accept(P_LBRACK) THEN
        n := NewNode(N_INDEX, TLn());
        n^.a := d;
        tail := Node NIL;
        LOOP subscripts
          Link(n^.b, tail, ParseExpr());
          IF NOT Accept(P_COMMA) THEN EXIT subscripts ENDIF
        ENDLOOP subscripts;
        Expect(P_RBRACK);
        d := n
      ELSIF Accept(P_UP) THEN
        n := NewNode(N_DEREF, TLn());
        n^.a := d;
        d := n
      ELSE
        EXIT sel
      ENDIF
    ENDLOOP sel;
    RETURN d
  ENDPROCEDURE ParseDesignator;

  (* the arguments of a call end at ")" *)
  PROCEDURE EXIT_ARGS ()
    IF NOT Is(P_RPAR) THEN Expect(P_RPAR) ENDIF;
    RETURN
  ENDPROCEDURE EXIT_ARGS;

  (* ---- the program: a sequence of segments (XIII.A) ----------------------------- *)

  PROCEDURE ParseProgram RETURNS Node ()
    VAR head, tail: Node := Node NIL;
    WHILE TK() # K_EOF DO
      IF NOT (Is(W_MODULE) OR Is(W_MONITOR)) THEN FailS(TLn(), "a segment is a module (XIII.A)") ENDIF;
      Link(head, tail, ParseModule());
      WHILE Accept(P_SEMI) DO ENDWHILE
    ENDWHILE;
    RETURN head
  ENDPROCEDURE ParseProgram;

  (* ---- entities and scopes (VII.J, X.B) ------------------------------------ *)
  (* Every name is kept in a hash table of chains; a scope is a level of the *)
  (* scope stack. A module is a closed scope: inside it only its own names, *)
  (* the names it imports and the standard names are visible (X.B.2), so *)
  (* the search stops at the module and goes on in the standard scope. *)

  VAR
    Table: SymTable;
    Scopes: ARRAY (INTEGER [0..400] OF Scope);
    Depth: INT := -1;
    VisibleFrom: INT := 0;          (* scopes below this one are hidden *)
    Level: INT := 0;                (* the frame being written: 0 is global *)
    FrameName: ARRAY (INTEGER [0..400] OF Txt);  (* C struct of the frame of each level *)

  PROCEDURE NewSym RETURNS Sym (CONST kind: INT; CONST name: Txt)
    VAR s: Sym;
    NEW(s);
    s^ := SymRec(kind, name, Rep NIL, 0, 0, FALSE, FALSE, 0, FALSE, Param NIL, 0, Rep NIL,
                 FALSE, Node NIL, 0, Sym NIL, Sym NIL, Sym NIL, Sym NIL, Sym NIL, Sym NIL,
                 Sym NIL, 0);
    s^.serial := NewSerial();
    RETURN s
  ENDPROCEDURE NewSym;

  PROCEDURE OpenScope (CONST closed: BOOLEAN)
    VAR s: Scope;
    NEW(s);
    s^ := ScopeRec(Sym NIL, closed, Sym NIL, Level, Node NIL, Scope NIL);
    IF Depth >= 0 THEN s^.up := Scopes[Depth] ENDIF;
    Depth := Depth + 1;
    Scopes[Depth] := s;
    RETURN
  ENDPROCEDURE OpenScope;

  (* take the names of the innermost scope out of the table *)
  PROCEDURE CloseScope ()
    VAR s, p, prev: Sym;
        h: INT;
    s := Scopes[Depth]^.syms;
    WHILE s # Sym NIL DO
      h := s^.name MOD 8192;
      p := Table[h];
      prev := Sym NIL;
      WHILE (p # Sym NIL) AND (p # s) DO
        prev := p;
        p := p^.chain
      ENDWHILE;
      IF p = s THEN
        IF prev = Sym NIL THEN Table[h] := s^.chain ELSE prev^.chain := s^.chain ENDIF
      ENDIF;
      s := s^.stack
    ENDWHILE;
    Depth := Depth - 1;
    RETURN
  ENDPROCEDURE CloseScope;

  PROCEDURE Visible RETURNS BOOLEAN (CONST s: Sym)
    RETURN (s^.depth >= VisibleFrom) OR (s^.depth = 0)
  ENDPROCEDURE Visible;

  (* the entity a name denotes here, or NIL *)
  PROCEDURE Find RETURNS Sym (CONST name: Txt)
    VAR s: Sym := Table[name MOD 8192];
    WHILE s # Sym NIL DO
      IF (s^.name = name) AND Visible(s) THEN RETURN s ENDIF;
      s := s^.chain
    ENDWHILE;
    RETURN Sym NIL
  ENDPROCEDURE Find;

  (* the entity named in this very scope, or NIL *)
  PROCEDURE FindHere RETURNS Sym (CONST name: Txt)
    VAR s: Sym := Table[name MOD 8192];
    WHILE s # Sym NIL DO
      IF (s^.name = name) AND (s^.depth = Depth) THEN RETURN s ENDIF;
      s := s^.chain
    ENDWHILE;
    RETURN Sym NIL
  ENDPROCEDURE FindHere;

  PROCEDURE Lookup RETURNS Sym (CONST name: Txt; CONST line: INT)
    VAR s: Sym := Find(name);
    IF s = Sym NIL THEN FailN(line, name, " is not declared here") ENDIF;
    RETURN s
  ENDPROCEDURE Lookup;

  (* an enumeration literal named in more than one visible type must be *)
  (* qualified by its type (VI.A.3) *)
  PROCEDURE Ambiguous RETURNS BOOLEAN (CONST s: Sym)
    VAR p: Sym := s^.chain;
    WHILE p # Sym NIL DO
      IF (p^.name = s^.name) AND Visible(p) AND (p^.kind = S_LIT) AND (p^.rep^.tid # s^.rep^.tid) THEN
        RETURN TRUE
      ENDIF;
      p := p^.chain
    ENDWHILE;
    RETURN FALSE
  ENDPROCEDURE Ambiguous;

  (* the literal name of the enumeration rep, among the visible ones *)
  PROCEDURE FindLit RETURNS Sym (CONST name: Txt; CONST r: Rep)
    VAR s: Sym := Table[name MOD 8192];
    WHILE s # Sym NIL DO
      IF (s^.name = name) AND (s^.kind = S_LIT) AND (s^.rep^.tid = r^.tid) THEN RETURN s ENDIF;
      s := s^.chain
    ENDWHILE;
    RETURN Sym NIL
  ENDPROCEDURE FindLit;

  PROCEDURE Define (CONST s: Sym; CONST line: INT)
    VAR old: Sym := FindHere(s^.name);
        h: INT := s^.name MOD 8192;
    IF (old # Sym NIL) AND NOT ((old^.kind = S_LIT) AND (s^.kind = S_LIT)) THEN
      FailN(line, s^.name, " is declared twice in this scope")
    ENDIF;
    s^.depth := Depth;
    s^.chain := Table[h];
    Table[h] := s;
    s^.stack := Scopes[Depth]^.syms;
    Scopes[Depth]^.syms := s;
    RETURN
  ENDPROCEDURE Define;

  (* ---- storage and the frames of routines ------------------------------------ *)
  (* Each routine (and process) has a frame, a C struct with its parameters *)
  (* and locals and a link "up" to the frame of the routine around it. Level *)
  (* 0 is the global level: its storage is C globals. *)

  (* the C text that reaches storage cname held at level lev *)
  PROCEDURE Path RETURNS Txt (CONST lev: INT; CONST cname: Txt)
    VAR hops: INT := Level - lev;
    IF lev = 0 THEN RETURN cname ENDIF;
    SB();
    IF hops = 0 THEN
      SA("F.")
    ELSE
      SA("F.up->");
      WHILE hops > 1 DO
        SA("up->");
        hops := hops - 1
      ENDWHILE
    ENDIF;
    ST(cname);
    RETURN SE()
  ENDPROCEDURE Path;

  (* the C text of a pointer to the frame of level lev, from here *)
  PROCEDURE FramePtr RETURNS Txt (CONST lev: INT)
    VAR hops: INT := Level - lev;
    IF hops = 0 THEN RETURN T("&F") ENDIF;
    SB();
    SA("F.up");
    WHILE hops > 1 DO
      SA("->up");
      hops := hops - 1
    ENDWHILE;
    RETURN SE()
  ENDPROCEDURE FramePtr;

  (* declare storage of C type ct named cname at the current level *)
  PROCEDURE DeclStorage (CONST ct, cname: Txt)
    VAR t: Txt;
    SB();
    IF Level = 0 THEN SA("static ") ENDIF;
    ST(ct);
    SA(" ");
    ST(cname);
    SA(";");
    t := SE();
    IF Level = 0 THEN Put(OGlobals, t) ELSE Put(Locals, t) ENDIF;
    RETURN
  ENDPROCEDURE DeclStorage;

  (* the access path of a variable, constant or parameter *)
  PROCEDURE SymPath RETURNS Txt (CONST s: Sym)
    VAR p: Txt := Path(s^.level, s^.cname);
    IF s^.byref THEN
      SB();
      SA("(*");
      ST(p);
      SA(")");
      RETURN SE()
    ENDIF;
    RETURN p
  ENDPROCEDURE SymPath;

  (* follow imports and renamings to the entity itself *)
  PROCEDURE Real RETURNS Sym (CONST s: Sym)
    VAR p: Sym := s;
    WHILE p^.kind = S_EXPORT DO p := p^.target ENDWHILE;
    RETURN p
  ENDPROCEDURE Real;

  (* ---- representations (Section VI, VII.D-H) ------------------------------- *)
  (* A Rep is a representation; its tid names its type. Two declarations *)
  (* have the same type when their representations derive from the same type *)
  (* identifier (VII.G, p.1039): INTEGER [1..5] and INTEGER [0..9] are both *)
  (* INTEGER, but two RECORD ... ENDRECORD written apart are different types. *)

  VAR
    RInt, RBool, RAscii, RVoid, RNil, RStr, RFloat, RFixed, RSignal, RSem, RAny: Rep;
    Pending: Node := Node NIL;       (* pointer representations waiting for their base *)

  PROCEDURE NewRep RETURNS Rep (CONST kind: INT; CONST tid: Txt)
    VAR r: Rep;
    NEW(r);
    r^ := RepRec(kind, tid, tid, 0, 0, 0, 0, FALSE, 0, 0, Rep NIL, Rep NIL, 0, Rep NIL,
                 Node NIL, 0, Field NIL, Field NIL, 0, 0, 0, FALSE, FALSE, FALSE, FALSE, 0, 0,
                 Sym NIL, 0);
    r^.serial := NewSerial();
    RETURN r
  ENDPROCEDURE NewRep;

  (* a new representation of the same type *)
  PROCEDURE CopyRep RETURNS Rep (CONST r: Rep)
    VAR c: Rep;
    NEW(c);
    c^ := r^;
    c^.serial := NewSerial();
    RETURN c
  ENDPROCEDURE CopyRep;

  FUNCTION IsDiscrete RETURNS BOOLEAN (CONST r: Rep)
    RETURN (r^.kind = R_INT) OR (r^.kind = R_BOOL) OR (r^.kind = R_ENUM) OR (r^.kind = R_ALPHA)
  ENDFUNCTION IsDiscrete;

  FUNCTION IsNumeric RETURNS BOOLEAN (CONST r: Rep)
    RETURN (r^.kind = R_INT) OR (r^.kind = R_FIXED) OR (r^.kind = R_FLOAT)
  ENDFUNCTION IsNumeric;

  FUNCTION IsArrayLike RETURNS BOOLEAN (CONST r: Rep)
    RETURN (r^.kind = R_ARRAY) OR (r^.kind = R_UARRAY) OR (r^.kind = R_STR)
  ENDFUNCTION IsArrayLike;

  (* a string literal (any one-dimensional array of an alphabet) *)
  FUNCTION IsString RETURNS BOOLEAN (CONST r: Rep)
    IF r^.kind = R_STR THEN RETURN TRUE ENDIF;
    IF (r^.kind = R_ARRAY) AND (r^.nidx = 1) THEN RETURN r^.elem^.kind = R_ALPHA ENDIF;
    IF (r^.kind = R_UARRAY) AND (r^.nidx = 1) THEN RETURN r^.elem^.kind = R_ALPHA ENDIF;
    RETURN FALSE
  ENDFUNCTION IsString;

  PROCEDURE Deep RETURNS BOOLEAN (CONST r: Rep)
    IF (r^.kind = R_ARRAY) OR (r^.kind = R_UARRAY) OR (r^.kind = R_STR) THEN RETURN TRUE ENDIF;
    RETURN (r^.kind = R_RECORD) AND r^.deep
  ENDPROCEDURE Deep;

  (* the C type of a value *)
  PROCEDURE CType RETURNS Txt (CONST r: Rep)
    VAR k: INT := r^.kind;
    IF (k = R_INT) OR (k = R_BOOL) OR (k = R_ENUM) THEN RETURN T("rt_int") ENDIF;
    IF k = R_ALPHA THEN RETURN T("unsigned char") ENDIF;
    IF (k = R_FLOAT) OR (k = R_FIXED) THEN RETURN T("double") ENDIF;
    IF (k = R_ARRAY) OR (k = R_UARRAY) OR (k = R_STR) THEN RETURN T("yarr") ENDIF;
    IF k = R_RECORD THEN RETURN r^.cname ENDIF;
    IF (k = R_PTR) OR (k = R_NIL) THEN RETURN T("void *") ENDIF;
    IF k = R_FILE THEN RETURN T("yfile *") ENDIF;
    IF k = R_SET THEN RETURN T("yset") ENDIF;
    IF k = R_SIGNAL THEN RETURN T("ysig") ENDIF;
    IF k = R_SEM THEN RETURN T("rt_lock") ENDIF;
    RETURN T("void")
  ENDPROCEDURE CType;

  (* the C text of the descriptor of a representation *)
  PROCEDURE DescOf RETURNS Txt (CONST r: Rep)
    VAR k: INT := r^.kind;
    IF (k = R_INT) OR (k = R_BOOL) OR (k = R_ENUM) THEN RETURN T("&y_d_int") ENDIF;
    IF k = R_ALPHA THEN RETURN T("&y_d_byte") ENDIF;
    IF (k = R_FLOAT) OR (k = R_FIXED) THEN RETURN T("&y_d_float") ENDIF;
    IF (k = R_PTR) OR (k = R_NIL) THEN RETURN T("&y_d_ptr") ENDIF;
    IF k = R_SET THEN RETURN T("&y_d_set") ENDIF;
    IF (k = R_ARRAY) OR (k = R_RECORD) THEN
      SB();
      SA("&");
      ST(Path(r^.dlevel, r^.dname));
      RETURN SE()
    ENDIF;
    IF k = R_STR THEN RETURN T("&y_d_str") ENDIF;
    RETURN T("&y_d_opaque")
  ENDPROCEDURE DescOf;

  (* storage for the run-time descriptor of r, at this level *)
  PROCEDURE NewDesc (CONST r: Rep)
    r^.dname := Fresh("yd_");
    r^.dlevel := Level;
    DeclStorage(T("ydesc"), r^.dname);
    RETURN
  ENDPROCEDURE NewDesc;

  (* types are equal when their identities are (VII.G) *)
  PROCEDURE SameType RETURNS BOOLEAN (CONST a, b: Rep)
    IF a^.tid = b^.tid THEN RETURN TRUE ENDIF;
    IF (a^.kind = R_STR) AND IsString(b) THEN RETURN TRUE ENDIF;
    IF (b^.kind = R_STR) AND IsString(a) THEN RETURN TRUE ENDIF;
    IF (a^.kind = R_NIL) AND (b^.kind = R_PTR) THEN RETURN TRUE ENDIF;
    IF (b^.kind = R_NIL) AND (a^.kind = R_PTR) THEN RETURN TRUE ENDIF;
    IF (a^.kind = R_ANY) OR (b^.kind = R_ANY) THEN RETURN TRUE ENDIF;
    RETURN FALSE
  ENDPROCEDURE SameType;

  PROCEDURE TypeClash (CONST line: INT; CONST want, got: Rep)
    VAR t: Txt;
    SB();
    SA("type conflict: ");
    ST(want^.tname);
    SA(" expected, ");
    ST(got^.tname);
    SA(" found");
    t := SE();
    Fail(line, t);
    RETURN
  ENDPROCEDURE TypeClash;

  PROCEDURE CheckType (CONST line: INT; CONST want, got: Rep)
    IF NOT SameType(want, got) THEN TypeClash(line, want, got) ENDIF;
    RETURN
  ENDPROCEDURE CheckType;

  (* a representation fit to declare entities with: numbers need a range *)
  (* (VI.A.1, "an explicit representation is always required") *)
  PROCEDURE CheckRepresented (CONST r: Rep; CONST line: INT)
    IF r^.abstract THEN FailN(line, r^.tname, " is a type, not a representation (VI.A.1)") ENDIF;
    RETURN
  ENDPROCEDURE CheckRepresented;

  (* ---- elaborating a representation from its tree ------------------------------- *)

  (* the bounds [lo..hi] of a discrete representation *)
  PROCEDURE Qualify (CONST r: Rep; CONST q: Node)
    VAR lo, hi: Txt;
        lr, hr: Rep;
        ok: BOOLEAN;
        v: INT;
    Expr(q^.a, r, lo, lr);
    Expr(q^.b, r, hi, hr);
    IF (r^.kind = R_FLOAT) OR (r^.kind = R_FIXED) THEN
      CheckType(q^.line, r, lr);
      CheckType(q^.line, r, hr);
      r^.lo := lo;
      r^.hi := hi;
      IF r^.kind = R_FLOAT THEN
        IF q^.d = Node NIL THEN FailS(q^.line, "FLOATING needs PRECISION (VI.A.1.c)") ENDIF;
        Manifest(q^.d, ok, v);
        IF NOT ok THEN FailS(q^.line, "PRECISION is a manifest constant") ENDIF;
        SB();
        SI(v);
        r^.prec := SE()
      ELSE
        IF q^.c = Node NIL THEN FailS(q^.line, "FIXED needs SCALE (VI.A.1.b)") ENDIF;
        Expr(q^.c, r, r^.scale, lr)
      ENDIF;
      r^.abstract := FALSE;
      RETURN
    ENDIF;
    IF NOT IsDiscrete(r) THEN FailS(q^.line, "only a scalar or integer representation takes a range") ENDIF;
    IF (q^.c # Node NIL) OR (q^.d # Node NIL) THEN FailS(q^.line, "SCALE and PRECISION qualify numbers") ENDIF;
    CheckType(q^.line, r, lr);
    CheckType(q^.line, r, hr);
    r^.lo := lo;
    r^.hi := hi;
    Manifest(q^.a, ok, r^.mlo);
    r^.hasm := ok;
    Manifest(q^.b, ok, r^.mhi);
    r^.hasm := r^.hasm AND ok;
    r^.abstract := FALSE;
    RETURN
  ENDPROCEDURE Qualify;

  (* the literals of an enumeration become names in this scope *)
  PROCEDURE DefineLits (CONST r: Rep)
    VAR p: Node := r^.lits;
        s: Sym;
        i: INT := 0;
    WHILE p # Node NIL DO
      IF Find(p^.name) # Sym NIL THEN
        s := Find(p^.name);
        IF (s^.kind # S_LIT) AND (s^.depth = Depth) THEN
          FailN(p^.line, p^.name, " is declared twice in this scope")
        ENDIF
      ENDIF;
      s := NewSym(S_LIT, p^.name);
      s^.rep := r;
      s^.mval := i;
      s^.hasmv := TRUE;
      Define(s, p^.line);
      i := i + 1;
      p := p^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE DefineLits;

  PROCEDURE SetRange (CONST r: Rep; CONST lo, hi: INT)
    SB();
    SI(lo);
    r^.lo := SE();
    SB();
    SI(hi);
    r^.hi := SE();
    r^.mlo := lo;
    r^.mhi := hi;
    r^.hasm := TRUE;
    RETURN
  ENDPROCEDURE SetRange;

  (* a fresh type identity, from a declared name when there is one *)
  PROCEDURE NewTid RETURNS Txt (CONST name: Txt)
    VAR n: INT := NewSerial();
    SB();
    IF name # 0 THEN ST(name) ELSE SA("anonymous") ENDIF;
    SA("#");
    SI(n);
    RETURN SE()
  ENDPROCEDURE NewTid;

  (* elaborate the representation n; name is the declared name or 0, and *)
  (* typeonly is set for a TYPE declaration (rules 63-71) *)
  PROCEDURE MakeRep RETURNS Rep (CONST n: Node; CONST name: Txt; CONST typeonly: BOOLEAN)
    VAR r, b, ix, last: Rep;
        s: Sym;
        k: INT := n^.kind;
        p: Node;
        tid, tname: Txt;
    tid := 0;
    tname := name;
    (* [Type] ConcreteType: the type comes from the named type (rule 61) *)
    IF n^.text # 0 THEN
      s := Real(Lookup(n^.text, n^.line));
      IF (s^.kind # S_TYPE) AND (s^.kind # S_REP) THEN FailN(n^.line, n^.text, " is not a type") ENDIF;
      tid := s^.rep^.tid;
      tname := s^.rep^.tname
    ENDIF;
    IF k = N_RNAME THEN
      s := Real(Lookup(n^.name, n^.line));
      IF (s^.kind # S_TYPE) AND (s^.kind # S_REP) THEN FailN(n^.line, n^.name, " is not a representation") ENDIF;
      r := s^.rep;
      IF n^.a # Node NIL THEN
        r := CopyRep(r);
        Qualify(r, n^.a)
      ENDIF;
      RETURN r
    ENDIF;
    IF tid = 0 THEN
      tid := NewTid(name);
      IF tname = 0 THEN tname := tid ENDIF
    ENDIF;
    IF k = N_RENUM THEN
      r := NewRep(R_ENUM, tid);
      r^.tname := tname;
      r^.ordered := n^.flag = 1;
      r^.lits := n^.a;
      r^.nlits := Count(n^.a);
      SetRange(r, 0, r^.nlits - 1);
      DefineLits(r);
      IF n^.b # Node NIL THEN Qualify(r, n^.b) ENDIF;
      RETURN r
    ENDIF;
    IF k = N_RALPHA THEN
      r := NewRep(R_ALPHA, tid);
      r^.tname := tname;
      r^.ordered := TRUE;
      r^.lits := n^.a;
      r^.nlits := Count(n^.a);
      IF r^.nlits > 256 THEN FailS(n^.line, "this implementation takes alphabets of up to 256 characters") ENDIF;
      SetRange(r, 0, r^.nlits - 1);
      IF n^.b # Node NIL THEN Qualify(r, n^.b) ENDIF;
      RETURN r
    ENDIF;
    IF k = N_RARRAY THEN
      r := NewRep(R_ARRAY, tid);
      r^.tname := tname;
      p := n^.a;
      last := Rep NIL;
      WHILE p # Node NIL DO
        ix := CopyRep(MakeRep(p, 0, FALSE));
        IF NOT IsDiscrete(ix) THEN FailS(p^.line, "an index is an integer or scalar representation") ENDIF;
        CheckRepresented(ix, p^.line);
        ix^.link := Rep NIL;
        IF last = Rep NIL THEN r^.idx := ix ELSE last^.link := ix ENDIF;
        last := ix;
        r^.nidx := r^.nidx + 1;
        p := p^.next
      ENDWHILE;
      IF r^.nidx > 4 THEN FailS(n^.line, "this implementation takes arrays of up to 4 dimensions") ENDIF;
      r^.elem := MakeRep(n^.b, 0, typeonly);
      IF NOT typeonly THEN
        CheckRepresented(r^.elem, n^.line);
        BuildArrayDesc(r)
      ELSE
        r^.abstract := r^.elem^.abstract;
        IF NOT r^.abstract THEN BuildArrayDesc(r) ENDIF
      ENDIF;
      r^.deep := TRUE;
      RETURN r
    ENDIF;
    IF k = N_RRECORD THEN
      r := NewRep(R_RECORD, tid);
      r^.tname := tname;
      MakeRecord(r, n, typeonly);
      RETURN r
    ENDIF;
    IF (k = N_RPOINTER) OR (k = N_RFILE) OR (k = N_RSET) THEN
      IF k = N_RPOINTER THEN
        r := NewRep(R_PTR, tid);
        r^.tname := tname;
        (* a pointer may name its base before the base is declared (VII.I) *)
        IF (n^.a^.kind = N_RNAME) AND (n^.a^.a = Node NIL) AND (Find(n^.a^.name) = Sym NIL) THEN
          r^.forward := n^.a^.name;
          r^.fwdscope := Depth;
          p := NewNode(N_NAMEL, n^.line);
          p^.rep := r;
          p^.next := Pending;
          Pending := p;
          RETURN r
        ENDIF;
        r^.elem := MakeRep(n^.a, 0, FALSE);
        RETURN r
      ENDIF;
      IF k = N_RFILE THEN
        r := NewRep(R_FILE, tid);
        r^.tname := tname;
        r^.elem := MakeRep(n^.a, 0, typeonly);
        RETURN r
      ENDIF;
      r := NewRep(R_SET, tid);
      r^.tname := tname;
      r^.elem := MakeRep(n^.a, 0, FALSE);
      IF NOT IsDiscrete(r^.elem) THEN FailS(n^.line, "a set is of an integer or scalar representation") ENDIF;
      CheckRepresented(r^.elem, n^.line);
      RETURN r
    ENDIF;
    FailS(n^.line, "this representation is not translated");
    RETURN Rep NIL
  ENDPROCEDURE MakeRep;

  (* a pointer named before its base: the base is now declared *)
  PROCEDURE ResolvePending (CONST name: Txt; CONST r: Rep)
    VAR p: Node := Pending;
        prev: Node := Node NIL;
    WHILE p # Node NIL DO
      IF p^.rep^.forward = name THEN
        p^.rep^.elem := r;
        p^.rep^.forward := 0;
        IF prev = Node NIL THEN Pending := p^.next ELSE prev^.next := p^.next ENDIF
      ELSE
        prev := p
      ENDIF;
      p := p^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE ResolvePending;

  PROCEDURE CheckPending ()
    VAR p: Node := Pending;
    WHILE p # Node NIL DO
      IF p^.rep^.fwdscope >= Depth THEN
        FailN(p^.line, p^.rep^.forward, " is named by a pointer but not declared")
      ENDIF;
      p := p^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE CheckPending;

  PROCEDURE BuildArrayDesc (CONST r: Rep)
    VAR ix: Rep;
        t: Txt;
        first: BOOLEAN;
    NewDesc(r);
    SB();
    SA("{ rt_int lo[");
    SI(r^.nidx);
    SA("] = {");
    ix := r^.idx;
    first := TRUE;
    WHILE ix # Rep NIL DO
      IF NOT first THEN SA(", ") ENDIF;
      first := FALSE;
      ST(ix^.lo);
      ix := ix^.link
    ENDWHILE;
    SA("}, hi[");
    SI(r^.nidx);
    SA("] = {");
    ix := r^.idx;
    first := TRUE;
    WHILE ix # Rep NIL DO
      IF NOT first THEN SA(", ") ENDIF;
      first := FALSE;
      ST(ix^.hi);
      ix := ix^.link
    ENDWHILE;
    SA("}; y_desc_array(");
    ST(DescOf(r));
    SA(", ");
    SI(r^.nidx);
    SA(", lo, hi, ");
    ST(DescOf(r^.elem));
    SA("); }");
    t := SE();
    Emit(t);
    RETURN
  ENDPROCEDURE BuildArrayDesc;

  (* the fields of a record, and its C struct (VI.B.2) *)
  PROCEDURE AddField (CONST r: Rep; VAR last: Field; CONST name: Txt; CONST fr: Rep;
                      CONST isconst: BOOLEAN; CONST variant: INT; CONST labels: Node;
                      CONST line: INT)
    VAR f: Field := r^.fields;
    WHILE f # Field NIL DO
      IF f^.name = name THEN FailN(line, name, " is a component twice") ENDIF;
      f := f^.next
    ENDWHILE;
    NEW(f);
    f^ := FieldRec(name, fr, isconst, variant, labels, Field NIL);
    IF last = Field NIL THEN r^.fields := f ELSE last^.next := f ENDIF;
    last := f;
    IF Deep(fr) THEN r^.deep := TRUE ENDIF;
    IF fr^.abstract THEN r^.abstract := TRUE ENDIF;
    RETURN
  ENDPROCEDURE AddField;

  PROCEDURE AddFields (CONST r: Rep; VAR last: Field; CONST groups: Node; CONST variant: INT;
                       CONST labels: Node; CONST typeonly: BOOLEAN)
    VAR g, nm: Node := groups;
        fr: Rep;
    WHILE g # Node NIL DO
      fr := MakeRep(g^.b, 0, typeonly);
      IF NOT typeonly THEN CheckRepresented(fr, g^.line) ENDIF;
      IF (fr^.kind = R_SIGNAL) OR (fr^.kind = R_FILE) THEN
        FailS(g^.line, "this implementation does not keep signals or files in records")
      ENDIF;
      nm := g^.a;
      WHILE nm # Node NIL DO
        AddField(r, last, nm^.name, fr, g^.ival = W_CONST, variant, labels, nm^.line);
        nm := nm^.next
      ENDWHILE;
      g := g^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE AddFields;

  PROCEDURE MakeRecord (CONST r: Rep; CONST n: Node; CONST typeonly: BOOLEAN)
    VAR last: Field := Field NIL;
        v, c: Node;
        sr: Rep;
        i: INT := 0;
        f: Field;
        t: Txt;
        nf: INT := 0;
    AddFields(r, last, n^.a, 0, Node NIL, typeonly);
    IF n^.b # Node NIL THEN
      (* a variant record: the case-selection component is CONST (VI.B.2) *)
      v := n^.b;
      sr := MakeRep(v^.b, 0, FALSE);
      IF NOT IsDiscrete(sr) THEN FailS(v^.line, "the case-selection component is integer or scalar") ENDIF;
      AddField(r, last, v^.name, sr, TRUE, 0, Node NIL, v^.line);
      r^.selector := last;
      c := v^.a;
      WHILE c # Node NIL DO
        i := i + 1;
        AddFields(r, last, c^.b, i, c^.a, typeonly);
        c := c^.next
      ENDWHILE
    ENDIF;
    IF typeonly AND r^.abstract THEN RETURN ENDIF;
    r^.abstract := FALSE;
    r^.cname := Fresh("yR");
    SB();
    SA("typedef struct ");
    ST(r^.cname);
    SA(" ");
    ST(r^.cname);
    SA(";");
    t := SE();
    Put(OTypes, t);
    SB();
    SA("struct ");
    ST(r^.cname);
    SA(" {");
    f := r^.fields;
    WHILE f # Field NIL DO
      SA(" ");
      ST(CType(f^.rep));
      SA(" f_");
      ST(f^.name);
      SA(";");
      nf := nf + 1;
      f := f^.next
    ENDWHILE;
    IF nf = 0 THEN SA(" int empty_;") ENDIF;
    SA(" };");
    t := SE();
    Put(OStructs, t);
    (* its descriptor *)
    NewDesc(r);
    SB();
    SA("{ static const size_t o[] = {");
    f := r^.fields;
    WHILE f # Field NIL DO
      SA("offsetof(");
      ST(r^.cname);
      SA(", f_");
      ST(f^.name);
      SA("), ");
      f := f^.next
    ENDWHILE;
    SA("0}; const ydesc **f = rt_alloc(");
    SI(nf + 1);
    SA(" * sizeof *f);");
    i := 0;
    f := r^.fields;
    WHILE f # Field NIL DO
      SA(" f[");
      SI(i);
      SA("] = ");
      ST(DescOf(f^.rep));
      SA(";");
      i := i + 1;
      f := f^.next
    ENDWHILE;
    SA(" y_desc_record(");
    ST(DescOf(r));
    SA(", sizeof(");
    ST(r^.cname);
    SA("), ");
    SI(nf);
    SA(", o, (const ydesc *const *)f); }");
    t := SE();
    Emit(t);
    RETURN
  ENDPROCEDURE MakeRecord;

  PROCEDURE FindField RETURNS Field (CONST r: Rep; CONST name: Txt)
    VAR f: Field := r^.fields;
    WHILE f # Field NIL DO
      IF f^.name = name THEN RETURN f ENDIF;
      f := f^.next
    ENDWHILE;
    RETURN Field NIL
  ENDPROCEDURE FindField;

  (* ---- expressions (Section VIII) --------------------------------------------- *)
  (* Every expression has a type deduced from its form (Design Discussion *)
  (* VI, p.1132): literals of an enumeration named in two visible types, NIL, *)
  (* and strings in a scope with two alphabets carry the name of their type. *)

  CONST
    (* the standard operations of Sections XI, XII and XIV *)
    F_LOW: INT = 1; F_HIGH: INT = 2; F_SUCC: INT = 3; F_PRED: INT = 4; F_FIRST: INT = 5;
    F_LAST: INT = 6; F_NEW: INT = 7; F_OPEN: INT = 8; F_CLOSE: INT = 9; F_GET: INT = 10;
    F_PUT: INT = 11; F_CHECK_EOF: INT = 12; F_MOVE: INT = 13; F_AND_LONG: INT = 14;
    F_OR_LONG: INT = 15; F_DELAY: INT = 16; F_CLOCK_TIME: INT = 17; F_WAIT: INT = 18;
    F_SEND: INT = 19; F_AWAITED: INT = 20; F_FLOOR: INT = 21; F_CEILING: INT = 22;
    F_NEAR_INTEGER: INT = 23; F_NEAR_FIXED: INT = 24; F_NEAR_FLOATING: INT = 25;
    F_FIXED_DIV: INT = 26; F_CLAIM: INT = 27; F_RELEASE: INT = 28; F_COND_CLAIM: INT = 29;
    F_PROCESS_IDENTITY: INT = 30; F_CHANGE_PRIORITY: INT = 31; F_RAISE_TERM: INT = 32;
    F_FREE_POINTER: INT = 33; F_CODE_INSERT: INT = 34; F_ADDR: INT = 35; F_EXTENT: INT = 36;

  VAR
    CharNames: Txt := 0;             (* the mnemonics of ASCII, in order *)

  (* ---- characters of an alphabet ----------------------------------------------- *)

  (* the position of character literal text in the alphabet a, or -1 *)
  PROCEDURE CharOrd RETURNS INT (CONST a: Rep; CONST text: Txt)
    VAR p: Node;
        i, k, start: INT;
        w: Txt;
    IF a^.tid = RAscii^.tid THEN
      IF TL[text] = 1 THEN RETURN Code[TChar(text, 1)] ENDIF;
      (* the control characters by name, then SP DEL SQ DQ *)
      i := 0;
      start := 1;
      FOR j: INTEGER [1..TL[CharNames]] DO
        IF TChar(CharNames, j) = ' ' THEN
          w := Intern(TS[CharNames] + (start - 1), j - start);
          IF w = text THEN
            IF i < 32 THEN RETURN i ENDIF;
            IF i = 32 THEN RETURN 32 ENDIF;
            IF i = 33 THEN RETURN 127 ENDIF;
            IF i = 34 THEN RETURN 39 ENDIF;
            RETURN 34
          ENDIF;
          i := i + 1;
          start := j + 1
        ENDIF
      ENDFOR;
      RETURN -1
    ENDIF;
    IF a^.kind # R_ALPHA THEN RETURN -1 ENDIF;
    p := a^.lits;
    k := 0;
    WHILE p # Node NIL DO
      IF TEq(p^.text, text) THEN RETURN k ENDIF;
      k := k + 1;
      p := p^.next
    ENDWHILE;
    RETURN -1
  ENDPROCEDURE CharOrd;

  (* the alphabet of an unqualified character or string: the one wanted *)
  (* when it has the characters, else ASCII *)
  PROCEDURE AlphabetFor RETURNS Rep (CONST n: Node; CONST want: Rep)
    VAR s: Sym;
    IF n^.d # Node NIL THEN
      s := Real(Lookup(n^.d^.name, n^.line));
      IF ((s^.kind # S_REP) AND (s^.kind # S_TYPE)) OR (s^.rep^.kind # R_ALPHA) THEN
        FailN(n^.line, n^.d^.name, " is not an alphabet")
      ENDIF;
      RETURN s^.rep
    ENDIF;
    IF want # Rep NIL THEN
      IF want^.kind = R_ALPHA THEN RETURN want ENDIF;
      IF IsArrayLike(want) AND (want^.elem # Rep NIL) THEN
        IF want^.elem^.kind = R_ALPHA THEN RETURN want^.elem ENDIF
      ENDIF
    ENDIF;
    RETURN RAscii
  ENDPROCEDURE AlphabetFor;

  PROCEDURE CharValue RETURNS INT (CONST a: Rep; CONST text: Txt; CONST line: INT)
    VAR v: INT := CharOrd(a, text);
        t: Txt;
    IF v < 0 THEN
      SB();
      SA("'SQ'");
      ST(text);
      SA("'SQ' is not a character of ");
      ST(a^.tname);
      t := SE();
      Fail(line, t)
    ENDIF;
    RETURN v
  ENDPROCEDURE CharValue;

  (* the characters of a string literal, as positions in the alphabet a, into *)
  (* a C string; n gets their number *)
  PROCEDURE StringCodes RETURNS Txt (CONST a: Rep; CONST text: Txt; OUT n: INT; CONST line: INT)
    VAR i, j, v: INT;
        codes: ARRAY (INTEGER [1..4096] OF INT);
        c: ASCII;
        w: Txt;
    n := 0;
    i := 1;
    WHILE i <= TL[text] DO
      c := TChar(text, i);
      IF c = 'SQ' THEN
        j := i + 1;
        WHILE TChar(text, j) # 'SQ' DO j := j + 1 ENDWHILE;
        w := Intern(TS[text] + i, (j - i) - 1);
        v := CharValue(a, w, line);
        i := j + 1
      ELSE
        w := Intern(TS[text] + (i - 1), 1);
        v := CharValue(a, w, line);
        i := i + 1
      ENDIF;
      IF n >= 4096 THEN FailS(line, "string literal too long") ENDIF;
      n := n + 1;
      codes[n] := v
    ENDWHILE;
    SB();
    SC('DQ');
    FOR k: INTEGER [1..n] DO
      v := codes[k];
      IF (v = 34) OR (v = 92) THEN
        SC('\');
        SC(Chr[v])
      ELSIF (v >= 32) AND (v < 127) AND ((v # 63) OR (k = 1) OR (codes[k - 1] # 63)) THEN
        SC(Chr[v])
      ELSE
        SC('\');
        SC(Chr[48 + (v DIV 64)]);
        SC(Chr[48 + ((v DIV 8) MOD 8)]);
        SC(Chr[48 + (v MOD 8)])
      ENDIF
    ENDFOR;
    SC('DQ');
    RETURN SE()
  ENDPROCEDURE StringCodes;

  (* ---- manifest constants (VI.C) ------------------------------------------------- *)

  PROCEDURE Manifest (CONST n: Node; OUT ok: BOOLEAN; OUT v: INT)
    VAR s: Sym;
        a, b: INT;
        oa, ob: BOOLEAN;
        op: Txt;
        al: Rep;
    ok := FALSE;
    v := 0;
    IF n^.kind = N_INT THEN
      ok := TRUE;
      v := n^.ival;
      RETURN
    ENDIF;
    IF n^.kind = N_CHARLIT THEN
      al := AlphabetFor(n, Rep NIL);
      v := CharOrd(al, n^.text);
      ok := v >= 0;
      RETURN
    ENDIF;
    IF n^.kind = N_NAME THEN
      IF n^.d # Node NIL THEN
        s := Real(Lookup(n^.d^.name, n^.line));
        s := FindLit(n^.name, s^.rep)
      ELSE
        s := Find(n^.name)
      ENDIF;
      IF s = Sym NIL THEN RETURN ENDIF;
      s := Real(s);
      IF ((s^.kind = S_LIT) OR (s^.kind = S_CONST)) AND s^.hasmv THEN
        ok := TRUE;
        v := s^.mval
      ENDIF;
      RETURN
    ENDIF;
    IF n^.kind = N_PAREN THEN
      Manifest(n^.a, ok, v);
      RETURN
    ENDIF;
    IF n^.kind = N_NEG THEN
      Manifest(n^.a, ok, v);
      v := -v;
      RETURN
    ENDIF;
    IF n^.kind = N_BIN THEN
      Manifest(n^.a, oa, a);
      Manifest(n^.b, ob, b);
      IF NOT (oa AND ob) THEN RETURN ENDIF;
      op := n^.name;
      ok := TRUE;
      IF op = P_PLUS THEN v := a + b
      ELSIF op = P_MINUS THEN v := a - b
      ELSIF op = P_STAR THEN v := a * b
      ELSIF (op = W_DIV) AND (b # 0) THEN v := a DIV b
      ELSIF (op = W_MOD) AND (b # 0) THEN v := a MOD b
      ELSE ok := FALSE
      ENDIF;
      RETURN
    ENDIF;
    RETURN
  ENDPROCEDURE Manifest;

  (* ---- conversions between representations of one type (IX.A.1) ------------------- *)

  (* the C text of value code (of representation from) held in to: ranges are *)
  (* checked unless the manifest bounds show there is no need *)
  PROCEDURE Convert RETURNS Txt (CONST code: Txt; CONST to, from: Rep)
    IF IsDiscrete(to) AND (to^.lo # 0) THEN
      IF to^.hasm AND from^.hasm AND (to^.mlo <= from^.mlo) AND (from^.mhi <= to^.mhi) THEN
        RETURN code
      ENDIF;
      SB();
      SA("rt_range(");
      ST(code);
      SA(", ");
      ST(to^.lo);
      SA(", ");
      ST(to^.hi);
      SA(")");
      RETURN SE()
    ENDIF;
    IF (to^.kind = R_FLOAT) AND (to^.lo # 0) THEN
      SB();
      SA("rt_frange(");
      ST(code);
      SA(", ");
      ST(to^.lo);
      SA(", ");
      ST(to^.hi);
      SA(")");
      RETURN SE()
    ENDIF;
    IF (to^.kind = R_FIXED) AND (to^.lo # 0) THEN
      SB();
      SA("y_fixed(");
      ST(code);
      SA(", ");
      ST(to^.lo);
      SA(", ");
      ST(to^.hi);
      SA(", ");
      ST(to^.scale);
      SA(")");
      RETURN SE()
    ENDIF;
    RETURN code
  ENDPROCEDURE Convert;

  (* assignment of code (of representation er) to dst (of representation r) *)
  PROCEDURE Store (CONST dst: Txt; CONST r: Rep; CONST code: Txt; CONST er: Rep; CONST line: INT)
    VAR t, tmp: Txt;
    CheckType(line, r, er);
    IF Deep(r) THEN
      tmp := Fresh("t");
      SB();
      SA("{ ");
      ST(CType(r));
      SA(" ");
      ST(tmp);
      SA(" = ");
      ST(code);
      SA("; y_store(");
      ST(DescOf(r));
      SA(", &");
      ST(dst);
      SA(", &");
      ST(tmp);
      SA("); }");
      t := SE();
      Emit(t);
      RETURN
    ENDIF;
    SB();
    ST(dst);
    SA(" = ");
    ST(Convert(code, r, er));
    SA(";");
    t := SE();
    Emit(t);
    RETURN
  ENDPROCEDURE Store;

  (* ---- designators that denote variables (VIII.B, X.A.6) ------------------------------- *)

  (* does the designator n denote a variable (and not a constant or a value) *)
  PROCEDURE IsVariable RETURNS BOOLEAN (CONST n: Node)
    VAR s: Sym;
        f: Field;
    IF n^.kind = N_NAME THEN
      s := Find(n^.name);
      IF s = Sym NIL THEN RETURN FALSE ENDIF;
      IF s^.readonly THEN RETURN FALSE ENDIF;
      RETURN Real(s)^.kind = S_VAR
    ENDIF;
    IF n^.kind = N_DEREF THEN RETURN TRUE ENDIF;
    IF n^.kind = N_INDEX THEN RETURN IsVariable(n^.a) ENDIF;
    IF n^.kind = N_SEL THEN
      IF NOT IsVariable(n^.a) THEN RETURN FALSE ENDIF;
      f := FindField(n^.a^.rep, n^.name);
      IF f = Field NIL THEN RETURN FALSE ENDIF;
      RETURN NOT f^.isconst
    ENDIF;
    RETURN FALSE
  ENDPROCEDURE IsVariable;

  PROCEDURE LValue (CONST n: Node; OUT code: Txt; OUT r: Rep)
    Expr(n, Rep NIL, code, r);
    IF NOT IsVariable(n) THEN FailS(n^.line, "a variable is needed here (IX.A.1)") ENDIF;
    RETURN
  ENDPROCEDURE LValue;

  (* ---- expressions ------------------------------------------------------------------ *)

  PROCEDURE Paren RETURNS Txt (CONST code: Txt)
    SB();
    SA("(");
    ST(code);
    SA(")");
    RETURN SE()
  ENDPROCEDURE Paren;

  PROCEDURE Lit RETURNS Rep (CONST base: Rep; CONST v: INT)
    VAR r: Rep := CopyRep(base);
    SetRange(r, v, v);
    RETURN r
  ENDPROCEDURE Lit;

  (* a literal qualified by a type name: the representation it names *)
  PROCEDURE Qualifier RETURNS Rep (CONST n: Node)
    VAR s: Sym := Real(Lookup(n^.d^.name, n^.line));
    IF (s^.kind # S_REP) AND (s^.kind # S_TYPE) THEN FailN(n^.line, n^.d^.name, " is not a type") ENDIF;
    RETURN s^.rep
  ENDPROCEDURE Qualifier;

  PROCEDURE Expr (CONST n: Node; CONST want: Rep; OUT code: Txt; OUT r: Rep)
    VAR k: INT := n^.kind;
        s: Sym;
        c, c2: Txt;
        r2, a: Rep;
        f: Field;
        len, v: INT;
    CurLine := n^.line;
    IF k = N_PAREN THEN
      Expr(n^.a, want, c, r);
      code := Paren(c);
    ELSIF k = N_INT THEN
      r := Lit(RInt, n^.ival);
      IF n^.d # Node NIL THEN
        a := Qualifier(n);
        IF a^.kind # R_INT THEN FailS(n^.line, "an integer literal qualified by a type that is not INTEGER") ENDIF;
        r^.tid := a^.tid;
        r^.tname := a^.tname
      ENDIF;
      SB();
      SA("INT64_C(");
      SI(n^.ival);
      SA(")");
      code := SE()
    ELSIF k = N_CHARLIT THEN
      a := AlphabetFor(n, want);
      v := CharValue(a, n^.text, n^.line);
      r := Lit(a, v);
      SB();
      SI(v);
      code := SE()
    ELSIF k = N_STRLIT THEN
      a := AlphabetFor(n, want);
      c := StringCodes(a, n^.text, len, n^.line);
      r := NewRep(R_STR, T("string"));
      r^.tname := T("a string literal");
      r^.elem := a;
      r^.nidx := 1;
      r^.nlits := len;
      SB();
      SA("y_str(");
      ST(c);
      SA(", ");
      SI(len);
      SA(")");
      code := SE()
    ELSIF k = N_FLOAT THEN
      r := RFloat;
      IF n^.d # Node NIL THEN r := Qualifier(n) ENDIF;
      code := Paren(n^.text)
    ELSIF k = N_FIXED THEN
      r := RFixed;
      IF n^.d # Node NIL THEN r := Qualifier(n) ENDIF;
      code := n^.text
    ELSIF k = N_NIL THEN
      IF n^.d = Node NIL THEN FailS(n^.line, "NIL is qualified by the name of a pointer type (VI.B.4)") ENDIF;
      r := Qualifier(n);
      IF r^.kind # R_PTR THEN FailS(n^.line, "NIL of a type that is not a pointer") ENDIF;
      code := T("((void *)0)")
    ELSIF k = N_NAME THEN
      IF n^.d # Node NIL THEN
        a := Qualifier(n);
        s := FindLit(n^.name, a);
        IF s = Sym NIL THEN FailN(n^.line, n^.name, " is not a literal of that type") ENDIF
      ELSE
        s := Lookup(n^.name, n^.line)
      ENDIF;
      NameExpr(n, s, code, r)
    ELSIF k = N_CALL THEN
      CallExpr(n, want, FALSE, code, r)
    ELSIF k = N_SEL THEN
      Expr(n^.a, Rep NIL, c, a);
      n^.a^.rep := a;
      IF a^.kind # R_RECORD THEN FailN(n^.line, n^.name, ": a component of something that is not a record") ENDIF;
      IF a^.opaque THEN FailN(n^.line, a^.tname, " is exported opaquely: its components are hidden (X.B.3)") ENDIF;
      f := FindField(a, n^.name);
      IF f = Field NIL THEN FailN(n^.line, n^.name, " is not a component of this record") ENDIF;
      r := f^.rep;
      IF f^.variant # 0 THEN
        (* a component of a variant: checked against the case-selection *)
        (* component when the program runs *)
        c2 := Fresh("vr");
        SB();
        SA("(*({ ");
        ST(CType(a));
        SA(" *");
        ST(c2);
        SA(" = &");
        ST(Paren(c));
        SA("; if (!(");
        ST(VariantTest(a, f, c2));
        SA(")) rt_raise(RT_X_TAG); &");
        ST(c2);
        SA("->f_");
        ST(n^.name);
        SA("; }))");
        code := SE()
      ELSE
        SB();
        ST(Paren(c));
        SA(".f_");
        ST(n^.name);
        code := SE()
      ENDIF
    ELSIF k = N_DEREF THEN
      Expr(n^.a, Rep NIL, c, a);
      IF a^.kind # R_PTR THEN FailS(n^.line, "^ of something that is not a pointer") ENDIF;
      IF a^.elem = Rep NIL THEN FailN(n^.line, a^.forward, " is not declared") ENDIF;
      r := a^.elem;
      SB();
      SA("(*(");
      ST(CType(r));
      SA(" *)rt_nil_check(");
      ST(c);
      SA("))");
      code := SE()
    ELSIF k = N_INDEX THEN
      IndexExpr(n, code, r)
    ELSIF k = N_NOT THEN
      Expr(n^.a, RBool, c, a);
      CheckType(n^.line, RBool, a);
      r := RBool;
      SB();
      SA("(!");
      ST(c);
      SA(")");
      code := SE()
    ELSIF k = N_NEG THEN
      IF NOT UserOp(n, P_MINUS, n^.a, Node NIL, code, r) THEN
        Expr(n^.a, want, c, a);
        NegExpr(n, c, a, code, r)
      ENDIF
    ELSIF k = N_BIN THEN
      BinExpr(n, want, code, r)
    ELSE
      FailS(n^.line, "not an expression")
    ENDIF;
    n^.rep := r;
    RETURN
  ENDPROCEDURE Expr;

  (* the test that a record held at *p has the variant of field f *)
  PROCEDURE VariantTest RETURNS Txt (CONST r: Rep; CONST f: Field; CONST p: Txt)
    VAR l: Node := f^.labels;
        ok: BOOLEAN;
        v: INT;
    SB();
    SA("0");
    WHILE l # Node NIL DO
      Manifest(l, ok, v);
      SA(" || ");
      ST(p);
      SA("->f_");
      ST(r^.selector^.name);
      SA(" == ");
      SI(v);
      l := l^.next
    ENDWHILE;
    RETURN SE()
  ENDPROCEDURE VariantTest;

  PROCEDURE NameExpr (CONST n: Node; CONST s0: Sym; OUT code: Txt; OUT r: Rep)
    VAR s: Sym := Real(s0);
    IF s^.kind = S_LIT THEN
      IF (n^.d = Node NIL) AND Ambiguous(s) THEN
        FailN(n^.line, n^.name, " names values of two types here: qualify it (VI.A.3)")
      ENDIF;
      r := Lit(s^.rep, s^.mval);
      SB();
      SI(s^.mval);
      code := SE();
      RETURN
    ENDIF;
    IF (s^.kind = S_VAR) OR (s^.kind = S_CONST) THEN
      r := s^.rep;
      code := SymPath(s);
      RETURN
    ENDIF;
    IF s^.kind = S_ROUTINE THEN FailN(n^.line, n^.name, " is a routine: a call needs ()") ENDIF;
    FailN(n^.line, n^.name, " is not a value");
    RETURN
  ENDPROCEDURE NameExpr;

  PROCEDURE IndexExpr (CONST n: Node; OUT code: Txt; OUT r: Rep)
    VAR c, ic, arr: Txt;
        a, ir, ix: Rep;
        p: Node;
        nd: INT;
        simple: BOOLEAN;
    Expr(n^.a, Rep NIL, c, a);
    IF NOT IsArrayLike(a) THEN FailS(n^.line, "[] of something that is not an array") ENDIF;
    nd := Count(n^.b);
    IF nd # a^.nidx THEN FailS(n^.line, "the number of subscripts is not the number of dimensions") ENDIF;
    r := a^.elem;
    (* an array that is a path is used twice; anything else goes into a temporary *)
    simple := (n^.a^.kind = N_NAME) OR (n^.a^.kind = N_SEL) OR (n^.a^.kind = N_INDEX) OR
              (n^.a^.kind = N_DEREF);
    IF simple THEN arr := c ELSE arr := Fresh("ya") ENDIF;
    SB();
    IF NOT simple THEN
      SA("(*({ yarr ");
      ST(arr);
      SA(" = ");
      ST(c);
      SA("; &")
    ENDIF;
    SA("((");
    ST(CType(r));
    SA(" *)(");
    ST(arr);
    SA(").p)[y_ix");
    SI(nd);
    SA("(");
    ST(arr);
    code := SE();
    p := n^.b;
    ix := a^.idx;
    WHILE p # Node NIL DO
      Expr(p, ix, ic, ir);
      IF (ix # Rep NIL) AND (a^.kind = R_ARRAY) THEN
        CheckType(p^.line, ix, ir)
      ELSIF NOT ((ir^.kind = R_INT) OR IsDiscrete(ir)) THEN
        FailS(p^.line, "a subscript is an integer or scalar value")
      ENDIF;
      SB();
      ST(code);
      SA(", ");
      ST(ic);
      code := SE();
      IF ix # Rep NIL THEN ix := ix^.link ENDIF;
      p := p^.next
    ENDWHILE;
    SB();
    ST(code);
    SA(")]");
    IF NOT simple THEN SA("; }))") ENDIF;
    code := SE();
    RETURN
  ENDPROCEDURE IndexExpr;

  PROCEDURE NegExpr (CONST n: Node; CONST c: Txt; CONST a: Rep; OUT code: Txt; OUT r: Rep)
    SB();
    IF a^.kind = R_INT THEN
      r := CopyRep(a);
      r^.lo := 0;
      r^.hasm := FALSE;
      SA("rt_neg(");
      ST(c);
      SA(")")
    ELSIF (a^.kind = R_FLOAT) OR (a^.kind = R_FIXED) THEN
      r := CopyRep(a);
      r^.lo := 0;
      SA("(-");
      ST(c);
      SA(")")
    ELSIF a^.kind = R_SET THEN
      (* the complement of a set (VIII.A.2) *)
      r := a;
      SA("y_set_compl(");
      ST(c);
      SA(")")
    ELSE
      Building := FALSE;
      FailS(n^.line, "- of something that is not a number or a set")
    ENDIF;
    code := SE();
    RETURN
  ENDPROCEDURE NegExpr;

  (* the result representation of arithmetic: the type, without a range *)
  PROCEDURE Unbounded RETURNS Rep (CONST a: Rep)
    VAR r: Rep := CopyRep(a);
    r^.lo := 0;
    r^.hi := 0;
    r^.hasm := FALSE;
    RETURN r
  ENDPROCEDURE Unbounded;

  PROCEDURE Call2 RETURNS Txt (CONST f: ARRAY (1 DIMENSIONS OF ASCII); CONST a, b: Txt)
    SB();
    SA(f);
    SA("(");
    ST(a);
    SA(", ");
    ST(b);
    SA(")");
    RETURN SE()
  ENDPROCEDURE Call2;

  PROCEDURE Infix RETURNS Txt (CONST a: Txt; CONST op: ARRAY (1 DIMENSIONS OF ASCII); CONST b: Txt)
    SB();
    SA("(");
    ST(a);
    SA(" ");
    SA(op);
    SA(" ");
    ST(b);
    SA(")");
    RETURN SE()
  ENDPROCEDURE Infix;

  (* equality of two values of one type: structured values compare by their *)
  (* components (VII.B: the definition of a type provides =) *)
  PROCEDURE EqCode RETURNS Txt (CONST a: Txt; CONST ra: Rep; CONST b: Txt; CONST rb: Rep)
    VAR t1, t2: Txt;
        r: Rep := ra;
    IF ra^.kind = R_STR THEN r := rb ENDIF;
    IF (r^.kind = R_ARRAY) OR (r^.kind = R_RECORD) OR (r^.kind = R_UARRAY) OR (r^.kind = R_STR) THEN
      t1 := Fresh("e");
      t2 := Fresh("e");
      SB();
      SA("({ ");
      ST(CType(r));
      SA(" ");
      ST(t1);
      SA(" = ");
      ST(a);
      SA(", ");
      ST(t2);
      SA(" = ");
      ST(b);
      SA("; y_eq(");
      IF (r^.kind = R_UARRAY) OR (r^.kind = R_STR) THEN
        SA("y_desc_vector(");
        ST(DescOf(r^.elem));
        SA(")")
      ELSE
        ST(DescOf(r))
      ENDIF;
      SA(", &");
      ST(t1);
      SA(", &");
      ST(t2);
      SA("); })");
      RETURN SE()
    ENDIF;
    IF r^.kind = R_SET THEN RETURN Call2("y_set_eq", a, b) ENDIF;
    RETURN Infix(a, "==", b)
  ENDPROCEDURE EqCode;

  PROCEDURE IsOrdered RETURNS BOOLEAN (CONST r: Rep)
    IF (r^.kind = R_INT) OR (r^.kind = R_FLOAT) OR (r^.kind = R_FIXED) OR (r^.kind = R_ALPHA) THEN
      RETURN TRUE
    ENDIF;
    RETURN (r^.kind = R_ENUM) AND r^.ordered
  ENDPROCEDURE IsOrdered;

  PROCEDURE BinExpr (CONST n: Node; CONST want: Rep; OUT code: Txt; OUT r: Rep)
    VAR op: Txt := n^.name;
        a, b, t: Txt;
        ra, rb, w: Rep;
        k: INT;
    IF UserOp(n, op, n^.a, n^.b, code, r) THEN RETURN ENDIF;
    IF (op = W_AND) OR (op = W_OR) THEN
      (* short circuit (VIII.A.2-3) *)
      Expr(n^.a, RBool, a, ra);
      CheckType(n^.line, RBool, ra);
      Expr(n^.b, RBool, b, rb);
      CheckType(n^.line, RBool, rb);
      r := RBool;
      IF op = W_AND THEN code := Infix(a, "&&", b) ELSE code := Infix(a, "||", b) ENDIF;
      RETURN
    ENDIF;
    IF op = W_IN THEN
      Expr(n^.b, Rep NIL, b, rb);
      IF rb^.kind # R_SET THEN FailS(n^.line, "IN needs a set on its right") ENDIF;
      Expr(n^.a, rb^.elem, a, ra);
      CheckType(n^.line, rb^.elem, ra);
      r := RBool;
      code := Call2("y_set_in", a, b);
      RETURN
    ENDIF;
    w := Rep NIL;
    IF (want # Rep NIL) AND (op # P_EQ) AND (op # P_NE) AND (op # P_LT) AND (op # P_LE) AND
       (op # P_GT) AND (op # P_GE) THEN
      w := want
    ENDIF;
    Expr(n^.a, w, a, ra);
    Expr(n^.b, ra, b, rb);
    IF (op = P_EQ) OR (op = P_NE) THEN
      CheckType(n^.line, ra, rb);
      IF (ra^.kind = R_SIGNAL) OR (ra^.kind = R_FILE) OR (ra^.kind = R_SEM) THEN
        FailS(n^.line, "= and # are not defined for signals, files and semaphores")
      ENDIF;
      IF ra^.opaque THEN FailN(n^.line, ra^.tname, " is opaque here: = is not exported (X.B.3)") ENDIF;
      r := RBool;
      code := EqCode(a, ra, b, rb);
      IF op = P_NE THEN
        SB();
        SA("(!");
        ST(code);
        SA(")");
        code := SE()
      ENDIF;
      RETURN
    ENDIF;
    IF (op = P_LT) OR (op = P_LE) OR (op = P_GT) OR (op = P_GE) THEN
      CheckType(n^.line, ra, rb);
      IF NOT IsOrdered(ra) THEN FailS(n^.line, "< <= > >= apply to ordered values (VIII.A.1)") ENDIF;
      r := RBool;
      IF op = P_LT THEN code := Infix(a, "<", b)
      ELSIF op = P_LE THEN code := Infix(a, "<=", b)
      ELSIF op = P_GT THEN code := Infix(a, ">", b)
      ELSE code := Infix(a, ">=", b)
      ENDIF;
      RETURN
    ENDIF;
    CheckType(n^.line, ra, rb);
    k := ra^.kind;
    IF ra^.kind = R_STR THEN k := rb^.kind ENDIF;
    IF op = W_XOR THEN
      IF k = R_BOOL THEN
        r := RBool;
        code := Infix(a, "!=", b)
      ELSIF k = R_SET THEN
        r := ra;
        code := Call2("y_set_xor", a, b)
      ELSE
        FailS(n^.line, "XOR applies to BOOLEAN values and sets")
      ENDIF;
      RETURN
    ENDIF;
    IF k = R_SET THEN
      r := ra;
      IF op = P_PLUS THEN code := Call2("y_set_union", a, b)
      ELSIF op = P_MINUS THEN code := Call2("y_set_diff", a, b)
      ELSIF op = P_STAR THEN code := Call2("y_set_inter", a, b)
      ELSE FailS(n^.line, "this operator does not apply to sets")
      ENDIF;
      RETURN
    ENDIF;
    IF k = R_INT THEN
      r := Unbounded(ra);
      IF op = P_PLUS THEN code := Call2("rt_add", a, b)
      ELSIF op = P_MINUS THEN code := Call2("rt_sub", a, b)
      ELSIF op = P_STAR THEN code := Call2("rt_mul", a, b)
      ELSIF op = W_DIV THEN code := Call2("rt_div", a, b)
      ELSIF op = W_MOD THEN code := Call2("rt_mod", a, b)
      ELSIF op = P_SLASH THEN
        (* integer / gives a floating-point result (VIII.C) *)
        r := RFloat;
        SB();
        SA("rt_fdiv((double)(");
        ST(a);
        SA("), (double)(");
        ST(b);
        SA("))");
        code := SE()
      ELSE
        FailN(n^.line, op, " is a free operator: no definition of it is visible (VIII.A)")
      ENDIF;
      RETURN
    ENDIF;
    IF (k = R_FLOAT) OR (k = R_FIXED) THEN
      r := Unbounded(ra);
      IF op = P_PLUS THEN code := Infix(a, "+", b)
      ELSIF op = P_MINUS THEN code := Infix(a, "-", b)
      ELSIF op = P_STAR THEN code := Infix(a, "*", b)
      ELSIF op = P_SLASH THEN
        r := RFloat;
        code := Call2("rt_fdiv", a, b)
      ELSE
        FailN(n^.line, op, " does not apply to these numbers")
      ENDIF;
      RETURN
    ENDIF;
    FailN(n^.line, op, " does not apply to these values");
    RETURN
  ENDPROCEDURE BinExpr;

  (* ---- calls, overloading and the standard operations (X.A, XI, XII) -------- *)
  (* A routine name may have several definitions, told apart by the types of *)
  (* their parameters (X.A.1): EXTENDS adds a definition, REPLACES overrides *)
  (* one, and a definition with neither hides all others. The alternatives *)
  (* of a name are chained by alt, newest first. *)

  (* the compiled actuals of the calls being compiled, as a stack: the *)
  (* actuals of a call inside an actual go above those of the outer call *)
  VAR
    ArgCode: ARRAY (INTEGER [1..4096] OF Txt);
    ArgRep: ARRAY (INTEGER [1..4096] OF Rep);
    ArgNode: ARRAY (INTEGER [1..4096] OF Node);
    ArgTop: INT := 0;

  (* does an actual of representation a fit a formal of representation f *)
  PROCEDURE Fits RETURNS BOOLEAN (CONST f, a: Rep)
    IF f^.kind = R_UARRAY THEN
      IF NOT IsArrayLike(a) THEN RETURN FALSE ENDIF;
      IF a^.nidx # f^.nidx THEN RETURN FALSE ENDIF;
      RETURN SameType(f^.elem, a^.elem)
    ENDIF;
    IF f^.kind = R_SPACE THEN RETURN TRUE ENDIF;
    RETURN SameType(f, a)
  ENDPROCEDURE Fits;

  (* the definition among the alternatives of s that takes these actuals *)
  PROCEDURE Choose RETURNS Sym (CONST s0: Sym; CONST base, nargs: INT)
    VAR s: Sym := s0;
        p: Param;
        ok: BOOLEAN;
        i: INT;
    WHILE s # Sym NIL DO
      IF s^.nparams = nargs THEN
        ok := TRUE;
        p := s^.params;
        i := 1;
        WHILE p # Param NIL DO
          IF NOT Fits(p^.rep, ArgRep[base + i]) THEN ok := FALSE ENDIF;
          i := i + 1;
          p := p^.next
        ENDWHILE;
        IF ok THEN RETURN s ENDIF
      ENDIF;
      s := s^.alt
    ENDWHILE;
    RETURN Sym NIL
  ENDPROCEDURE Choose;

  (* the alternatives of name s hide the standard operations unless all of *)
  (* them were declared with EXTENDS or REPLACES *)
  PROCEDURE HidesStandard RETURNS BOOLEAN (CONST s0: Sym)
    VAR s: Sym := s0;
    WHILE s # Sym NIL DO
      IF (s^.decl # Node NIL) AND (s^.decl^.ival = 0) THEN RETURN TRUE ENDIF;
      s := s^.alt
    ENDWHILE;
    RETURN FALSE
  ENDPROCEDURE HidesStandard;

  (* compile the actuals; with one definition the formals guide literals *)
  PROCEDURE CompileArgs (CONST args: Node; CONST guide: Sym; OUT base, nargs: INT)
    VAR a: Node := args;
        p: Param := Param NIL;
        want: Rep;
    base := ArgTop;
    nargs := 0;
    IF guide # Sym NIL THEN p := guide^.params ENDIF;
    WHILE a # Node NIL DO
      IF ArgTop >= 4000 THEN FailS(a^.line, "calls nested too deeply") ENDIF;
      nargs := nargs + 1;
      ArgTop := base + nargs;
      want := Rep NIL;
      IF p # Param NIL THEN
        want := p^.rep;
        p := p^.next
      ENDIF;
      Expr(a, want, ArgCode[base + nargs], ArgRep[base + nargs]);
      ArgNode[base + nargs] := a;
      a := a^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE CompileArgs;

  (* the C call of routine s with the compiled actuals *)
  PROCEDURE CallCode RETURNS Txt (CONST s: Sym; CONST base, nargs: INT; CONST line: INT)
    VAR p: Param := s^.params;
        i: INT := base + 1;
        first: BOOLEAN := TRUE;
    IF nargs # s^.nparams THEN FailN(line, s^.name, ": the number of actual parameters is wrong") ENDIF;
    SB();
    ST(s^.cname);
    SA("(");
    IF s^.level > 1 THEN
      ST(FramePtr(s^.level - 1));
      first := FALSE
    ENDIF;
    WHILE p # Param NIL DO
      IF NOT first THEN SA(", ") ENDIF;
      first := FALSE;
      IF NOT Fits(p^.rep, ArgRep[i]) THEN
        Building := FALSE;
        TypeClash(ArgNode[i]^.line, p^.rep, ArgRep[i])
      ENDIF;
      IF p^.cls = C_CONST THEN
        ST(Convert(ArgCode[i], p^.rep, ArgRep[i]))
      ELSE
        (* VAR and OUT actuals are variables (X.A.2) *)
        IF NOT IsVariable(ArgNode[i]) THEN
          Building := FALSE;
          FailN(ArgNode[i]^.line, p^.name, ": the actual of a VAR or OUT parameter must be a variable")
        ENDIF;
        SA("&");
        ST(ArgCode[i])
      ENDIF;
      i := i + 1;
      p := p^.next
    ENDWHILE;
    SA(")");
    ArgTop := base;
    RETURN SE()
  ENDPROCEDURE CallCode;

  (* an operator with user definitions visible: a call, when one fits *)
  PROCEDURE UserOp RETURNS BOOLEAN (CONST n: Node; CONST op: Txt; CONST x, y: Node;
                                    OUT code: Txt; OUT r: Rep)
    VAR s, c: Sym;
        base, nargs: INT;
    s := Find(op);
    IF s = Sym NIL THEN RETURN FALSE ENDIF;
    s := Real(s);
    IF s^.kind # S_ROUTINE THEN RETURN FALSE ENDIF;
    x^.next := y;
    IF y # Node NIL THEN y^.next := Node NIL ENDIF;
    CompileArgs(x, Sym NIL, base, nargs);
    c := Choose(s, base, nargs);
    IF c = Sym NIL THEN
      ArgTop := base;
      IF HidesStandard(s) THEN FailN(n^.line, op, ": no definition takes operands of these types") ENDIF;
      RETURN FALSE
    ENDIF;
    code := CallCode(c, base, nargs, n^.line);
    r := c^.ret;
    RETURN TRUE
  ENDPROCEDURE UserOp;

  (* Id ( args ): a function or value-returning procedure, a standard *)
  (* operation, or the denotation of a structured value (VIII.B) *)
  PROCEDURE CallExpr (CONST n: Node; CONST want: Rep; CONST statement: BOOLEAN;
                      OUT code: Txt; OUT r: Rep)
    VAR s, c: Sym;
        base, nargs: INT;
    s := Real(Lookup(n^.name, n^.line));
    IF s^.kind = S_STD THEN
      StdCall(s^.mval, n, statement, code, r);
      RETURN
    ENDIF;
    IF (s^.kind = S_REP) OR (s^.kind = S_TYPE) THEN
      IF statement THEN FailS(n^.line, "a value is not a statement") ENDIF;
      Denote(s^.rep, n, code, r);
      RETURN
    ENDIF;
    IF s^.kind # S_ROUTINE THEN FailN(n^.line, n^.name, " is not a routine") ENDIF;
    IF s^.alt = Sym NIL THEN
      CompileArgs(n^.a, s, base, nargs);
      c := s
    ELSE
      CompileArgs(n^.a, Sym NIL, base, nargs);
      c := Choose(s, base, nargs);
      IF c = Sym NIL THEN FailN(n^.line, n^.name, ": no definition takes actuals of these types") ENDIF
    ENDIF;
    code := CallCode(c, base, nargs, n^.line);
    r := c^.ret;
    IF statement AND (r^.kind # R_VOID) THEN
      FailN(n^.line, n^.name, " returns a value: it is called in an expression (IX.A.2)")
    ENDIF;
    IF NOT statement AND (r^.kind = R_VOID) THEN
      FailN(n^.line, n^.name, " returns no value")
    ENDIF;
    RETURN
  ENDPROCEDURE CallExpr;

  (* ---- denotations of structured values (VI.B) ---------------------------------- *)

  PROCEDURE Denote (CONST r: Rep; CONST n: Node; OUT code: Txt; OUT res: Rep)
    VAR a: Node := n^.a;
        f: Field;
        c, t, el: Txt;
        ar: Rep;
        nargs, count, i: INT;
        ok: BOOLEAN;
        variant: INT := 0;
        sel: INT;
        lab: Node;
        first: BOOLEAN := TRUE;
    res := r;
    IF r^.abstract THEN FailN(n^.line, r^.tname, " has no representation to denote a value of") ENDIF;
    IF r^.kind = R_RECORD THEN
      IF r^.opaque THEN FailN(n^.line, r^.tname, " is opaque here (X.B.3)") ENDIF;
      SB();
      SA("((");
      ST(r^.cname);
      SA("){ ");
      t := SE();
      f := r^.fields;
      WHILE f # Field NIL DO
        IF (f^.variant = 0) OR (f^.variant = variant) THEN
          IF a = Node NIL THEN FailS(n^.line, "too few components in this record value") ENDIF;
          Expr(a, f^.rep, c, ar);
          CheckType(a^.line, f^.rep, ar);
          IF f = r^.selector THEN
            (* the case-selection value is a manifest constant (VI.C) *)
            Manifest(a, ok, sel);
            IF NOT ok THEN FailS(a^.line, "the case-selection value is a manifest constant") ENDIF;
            variant := VariantOf(r, sel, a^.line)
          ENDIF;
          SB();
          ST(t);
          IF NOT first THEN SA(", ") ENDIF;
          first := FALSE;
          SA(".f_");
          ST(f^.name);
          SA(" = ");
          ST(Convert(c, f^.rep, ar));
          t := SE();
          a := a^.next
        ENDIF;
        f := f^.next
      ENDWHILE;
      IF a # Node NIL THEN FailS(n^.line, "too many components in this record value") ENDIF;
      SB();
      ST(t);
      SA(" })");
      code := SE();
      RETURN
    ENDIF;
    IF r^.kind = R_ARRAY THEN
      nargs := Count(a);
      t := Fresh("da");
      IF nargs = 1 THEN
        (* every component gets the one value *)
        Expr(a, r^.elem, c, ar);
        CheckType(a^.line, r^.elem, ar);
        el := Fresh("dv");
        SB();
        SA("({ ");
        ST(CType(r^.elem));
        SA(" ");
        ST(el);
        SA(" = ");
        ST(Convert(c, r^.elem, ar));
        SA("; y_fill(");
        ST(DescOf(r));
        SA(", &");
        ST(el);
        SA("); })");
        code := SE();
        RETURN
      ENDIF;
      (* the components in row-major order; their number must be exact *)
      SB();
      SA("({ yarr ");
      ST(t);
      SA("; y_init(");
      ST(DescOf(r));
      SA(", &");
      ST(t);
      SA("); if (y_count(");
      ST(t);
      SA(", ");
      SI(r^.nidx);
      SA(") != ");
      SI(nargs);
      SA(") rt_raise_msg(RT_X_RANGE, ");
      SC('DQ');
      SA("wrong number of components");
      SC('DQ');
      SA(");");
      code := SE();
      i := 0;
      WHILE a # Node NIL DO
        Expr(a, r^.elem, c, ar);
        CheckType(a^.line, r^.elem, ar);
        SB();
        ST(code);
        IF Deep(r^.elem) THEN
          SA(" { ");
          ST(CType(r^.elem));
          SA(" dv = ");
          ST(c);
          SA("; y_copy(");
          ST(DescOf(r^.elem));
          SA(", &((");
          ST(CType(r^.elem));
          SA(" *)");
          ST(t);
          SA(".p)[");
          SI(i);
          SA("], &dv); }")
        ELSE
          SA(" ((");
          ST(CType(r^.elem));
          SA(" *)");
          ST(t);
          SA(".p)[");
          SI(i);
          SA("] = ");
          ST(Convert(c, r^.elem, ar));
          SA(";")
        ENDIF;
        code := SE();
        i := i + 1;
        a := a^.next
      ENDWHILE;
      SB();
      ST(code);
      SA(" ");
      ST(t);
      SA("; })");
      code := SE();
      RETURN
    ENDIF;
    IF r^.kind = R_SET THEN
      SB();
      SA("y_set_new(");
      ST(r^.elem^.lo);
      SA(", ");
      ST(r^.elem^.hi);
      SA(")");
      code := SE();
      WHILE a # Node NIL DO
        Expr(a, r^.elem, c, ar);
        CheckType(a^.line, r^.elem, ar);
        code := Call2("y_set_add", code, c);
        a := a^.next
      ENDWHILE;
      RETURN
    ENDIF;
    FailN(n^.line, r^.tname, " has no denotations of values");
    RETURN
  ENDPROCEDURE Denote;

  (* the variant whose case labels hold the selector value v *)
  PROCEDURE VariantOf RETURNS INT (CONST r: Rep; CONST v: INT; CONST line: INT)
    VAR f: Field := r^.fields;
        l: Node;
        ok: BOOLEAN;
        lv: INT;
    WHILE f # Field NIL DO
      IF f^.variant # 0 THEN
        l := f^.labels;
        WHILE l # Node NIL DO
          Manifest(l, ok, lv);
          IF ok AND (lv = v) THEN RETURN f^.variant ENDIF;
          l := l^.next
        ENDWHILE
      ENDIF;
      f := f^.next
    ENDWHILE;
    (* a case with no components has no field to find it by: any other value *)
    (* chooses no components *)
    RETURN -1
  ENDPROCEDURE VariantOf;

  (* ---- statements (Section IX) --------------------------------------------- *)

  VAR
    XFrames: ARRAY (INTEGER [1..1000] OF Txt);  (* the handler frames entered *)
    XTop: INT := 0;
    XBase: INT := 0;                 (* the first frame of the routine being written *)
    BlockFrame: ARRAY (INTEGER [1..1000] OF Txt);  (* per block: its handler frame or 0 *)
    BTop: INT := 0;
    HandlerXc: ARRAY (INTEGER [1..1000] OF Txt);   (* the exception a handler handles *)
    HTop: INT := 0;
    LoopName, LoopLabel: ARRAY (INTEGER [1..1000] OF Txt);
    LoopFrames: ARRAY (INTEGER [1..1000] OF INT);
    LTop: INT := 0;
    LoopBase: INT := 0;
    CurRoutine: Sym := Sym NIL;      (* the routine or process being written *)
    HasHandler: BOOLEAN := FALSE;    (* it has an exception handler *)

  PROCEDURE Emit2 (CONST a: ARRAY (1 DIMENSIONS OF ASCII); CONST b: Txt)
    VAR t: Txt;
    SB();
    SA(a);
    ST(b);
    t := SE();
    Emit(t);
    RETURN
  ENDPROCEDURE Emit2;

  PROCEDURE Emit3 (CONST a: ARRAY (1 DIMENSIONS OF ASCII); CONST b: Txt;
                   CONST c: ARRAY (1 DIMENSIONS OF ASCII))
    VAR t: Txt;
    SB();
    SA(a);
    ST(b);
    SA(c);
    t := SE();
    Emit(t);
    RETURN
  ENDPROCEDURE Emit3;

  (* leave the handler frames entered after the first depth of them *)
  PROCEDURE PopTo (CONST depth: INT)
    IF XTop > depth THEN Emit3("rt_xtop = ", XFrames[depth + 1], ".prev;") ENDIF;
    RETURN
  ENDPROCEDURE PopTo;

  (* PROPAGATE_EXCEPTION and ASSERT end the block they are in: its own *)
  (* handler does not see them (IX.A.8, p.1039; X.F, p.1058) *)
  PROCEDURE LeaveBlock ()
    IF BTop > 0 THEN
      IF BlockFrame[BTop] # 0 THEN Emit3("rt_xtop = ", BlockFrame[BTop], ".prev;") ENDIF
    ENDIF;
    RETURN
  ENDPROCEDURE LeaveBlock;

  PROCEDURE RaiseCode RETURNS Txt (CONST name: Txt)
    SB();
    SA("rt_raise(rt_exc(");
    SC('DQ');
    ST(name);
    SC('DQ');
    SA("));");
    RETURN SE()
  ENDPROCEDURE RaiseCode;

  (* the statements of a block and its exception handler (X.F) *)
  PROCEDURE BlockStatements (CONST b: Node)
    VAR f, xc, t: Txt;
        c, nm: Node;
        first: BOOLEAN;
    IF b^.b = Node NIL THEN
      BTop := BTop + 1;
      BlockFrame[BTop] := 0;
      Statements(b^.c);
      BTop := BTop - 1;
      RETURN
    ENDIF;
    HasHandler := TRUE;
    f := Fresh("xf");
    Emit3("{ rt_frame ", f, ";");
    Emit3("if (RT_TRY(", f, ")) {");
    XTop := XTop + 1;
    XFrames[XTop] := f;
    BTop := BTop + 1;
    BlockFrame[BTop] := f;
    Statements(b^.c);
    BTop := BTop - 1;
    XTop := XTop - 1;
    Emit3("RT_POP(", f, ");");
    EmitS("} else {");
    Emit3("RT_POP(", f, ");");
    xc := Fresh("xc");
    Emit3("int ", xc, " = rt_xcur;");
    BTop := BTop + 1;
    BlockFrame[BTop] := 0;
    HTop := HTop + 1;
    HandlerXc[HTop] := xc;
    first := TRUE;
    c := b^.b^.a;
    WHILE c # Node NIL DO
      SB();
      IF first THEN SA("if (") ELSE SA("} else if (") ENDIF;
      first := FALSE;
      nm := c^.a;
      WHILE nm # Node NIL DO
        ST(xc);
        SA(" == rt_exc(");
        SC('DQ');
        ST(nm^.name);
        SC('DQ');
        SA(")");
        IF nm^.next # Node NIL THEN SA(" || ") ENDIF;
        nm := nm^.next
      ENDWHILE;
      SA(") {");
      t := SE();
      Emit(t);
      Statements(c^.b);
      c := c^.next
    ENDWHILE;
    IF NOT first THEN EmitS("} else {") ENDIF;
    IF b^.b^.flag = 1 THEN
      Statements(b^.b^.b)
    ELSE
      (* no ELSE: the same exception goes on (p.1059) *)
      Emit3("rt_raise(", xc, ");")
    ENDIF;
    IF NOT first THEN EmitS("}") ENDIF;
    HTop := HTop - 1;
    BTop := BTop - 1;
    EmitS("}}");
    RETURN
  ENDPROCEDURE BlockStatements;

  PROCEDURE Statements (CONST list: Node)
    VAR s: Node := list;
    WHILE s # Node NIL DO
      Statement(s);
      s := s^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE Statements;

  (* a BOOLEAN expression *)
  PROCEDURE Cond RETURNS Txt (CONST n: Node)
    VAR c: Txt;
        r: Rep;
    Expr(n, RBool, c, r);
    CheckType(n^.line, RBool, r);
    RETURN c
  ENDPROCEDURE Cond;

  (* a CASE label of a SELECT on a value of representation r: the literals *)
  (* of the selector's type need not be visible (VI.A.3 is about values *)
  (* that could be of two types, and here there is one) *)
  PROCEDURE Label RETURNS INT (CONST n: Node; CONST r: Rep)
    VAR ok: BOOLEAN;
        v: INT;
        s: Sym;
        lr: Rep;
        c: Txt;
    IF (n^.kind = N_NAME) AND (n^.d = Node NIL) AND (r^.kind = R_ENUM) THEN
      s := FindLit(n^.name, r);
      IF s # Sym NIL THEN RETURN s^.mval ENDIF
    ENDIF;
    Expr(n, r, c, lr);
    CheckType(n^.line, r, lr);
    Manifest(n, ok, v);
    IF NOT ok THEN FailS(n^.line, "a CASE label is a manifest constant (IX.B.1)") ENDIF;
    RETURN v
  ENDPROCEDURE Label;

  (* copy the OUT parameters back to their actuals (X.A.2) *)
  PROCEDURE CopyOut ()
    VAR p: Param;
        t: Txt;
    IF CurRoutine = Sym NIL THEN RETURN ENDIF;
    p := CurRoutine^.params;
    WHILE p # Param NIL DO
      IF p^.cls = C_OUT THEN
        SB();
        SA("(*F.");
        ST(p^.cname);
        SA("_o)");
        t := SE();
        Store(t, p^.rep, Path(Level, p^.cname), p^.rep, 0)
      ENDIF;
      p := p^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE CopyOut;

  PROCEDURE Statement (CONST s: Node)
    VAR k: INT := s^.kind;
        c, c2, t, lab, v, hi: Txt;
        r, er: Rep;
        arm, l: Node;
        first: BOOLEAN;
        found: BOOLEAN;
        i, val: INT;
        sym: Sym;
    CurLine := s^.line;
    IF s^.text # 0 THEN
      FailS(s^.line, "this translator has no labelled statements yet")
    ENDIF;
    IF k = N_ASSIGN THEN
      LValue(s^.a, c, r);
      IF r^.kind = R_SIGNAL THEN FailS(s^.line, "assignment is not defined for signals (VI.A.1.d)") ENDIF;
      IF (r^.kind = R_FILE) OR (r^.kind = R_SEM) THEN
        FailS(s^.line, "assignment is not defined for files and semaphores (VII.B)")
      ENDIF;
      IF r^.opaque THEN FailN(s^.line, r^.tname, " is opaque here: := is not exported (X.B.3)") ENDIF;
      Expr(s^.b, r, c2, er);
      Store(c, r, c2, er, s^.line)
    ELSIF k = N_CALLST THEN
      sym := Find(s^.a^.name);
      IF sym # Sym NIL THEN sym := Real(sym) ENDIF;
      IF (sym # Sym NIL) AND (sym^.kind = S_PROCESS) THEN
        Activate(s^.a, sym)
      ELSE
        CallExpr(s^.a, Rep NIL, TRUE, c, r);
        Emit2("", c);
        SB();
        ST(c);
        SA(";");
        t := SE();
        Body.tail^.t := t
      ENDIF
    ELSIF k = N_IF THEN
      first := TRUE;
      arm := s^.a;
      WHILE arm # Node NIL DO
        c := Cond(arm^.a);
        IF first THEN Emit3("if (", c, ") {") ELSE Emit3("} else if (", c, ") {") ENDIF;
        first := FALSE;
        Statements(arm^.b);
        arm := arm^.next
      ENDWHILE;
      IF s^.flag = 1 THEN
        EmitS("} else {");
        Statements(s^.b)
      ENDIF;
      EmitS("}")
    ELSIF k = N_WHILE THEN
      c := Cond(s^.a);
      Emit3("while (", c, ") {");
      Statements(s^.b);
      EmitS("}")
    ELSIF k = N_LOOP THEN
      lab := Fresh("yl_");
      LTop := LTop + 1;
      LoopName[LTop] := s^.name;
      LoopLabel[LTop] := lab;
      LoopFrames[LTop] := XTop;
      EmitS("for (;;) {");
      Statements(s^.b);
      EmitS("}");
      Emit3("", lab, ": ;");
      LTop := LTop - 1
    ELSIF k = N_EXIT THEN
      found := FALSE;
      i := LTop;
      WHILE (i > LoopBase) AND NOT found DO
        IF LoopName[i] = s^.name THEN
          found := TRUE;
          PopTo(LoopFrames[i]);
          Emit3("goto ", LoopLabel[i], ";")
        ENDIF;
        i := i - 1
      ENDWHILE;
      IF NOT found THEN FailN(s^.line, s^.name, ": EXIT names no LOOP around it here (IX.A.5)") ENDIF
    ELSIF k = N_FOR THEN
      ForStatement(s)
    ELSIF k = N_SELECT THEN
      Expr(s^.a, Rep NIL, c, r);
      IF NOT IsDiscrete(r) THEN FailS(s^.line, "SELECT on a value that is not integer or scalar") ENDIF;
      Emit3("switch (", c, ") {");
      arm := s^.b;
      WHILE arm # Node NIL DO
        l := arm^.a;
        WHILE l # Node NIL DO
          val := Label(l, r);
          SB();
          SA("case ");
          SI(val);
          SA(":");
          t := SE();
          Emit(t);
          l := l^.next
        ENDWHILE;
        EmitS("{");
        Statements(arm^.b);
        EmitS("} break;");
        arm := arm^.next
      ENDWHILE;
      (* no case and no ELSE: nothing is done (IX.B.1) *)
      EmitS("default: {");
      IF s^.flag = 1 THEN Statements(s^.c) ENDIF;
      EmitS("} break;");
      EmitS("}")
    ELSIF k = N_RETURN THEN
      ReturnStatement(s)
    ELSIF k = N_PROPAGATE THEN
      IF s^.name = 0 THEN
        IF HTop = 0 THEN FailS(s^.line, "PROPAGATE_EXCEPTION without a name is used in a handler (IX.A.8)") ENDIF;
        Emit3("rt_raise(", HandlerXc[HTop], ");")
      ELSE
        LeaveBlock();
        Emit(RaiseCode(s^.name))
      ENDIF
    ELSIF k = N_ASSERT THEN
      c := Cond(s^.a);
      Emit3("if (!(", c, ")) {");
      LeaveBlock();
      EmitS("rt_raise(RT_X_ASSERT); }")
    ELSIF k = N_BEGIN THEN
      BeginStatement(s)
    ELSIF k = N_TERMINATE THEN
      TerminateStatement(s)
    ELSIF k = N_GOTO THEN
      FailS(s^.line, "this translator has no GOTO yet")
    ELSE
      FailS(s^.line, "not a statement")
    ENDIF;
    RETURN
  ENDPROCEDURE Statement;

  (* FOR Name : Representation DO ... ENDFOR -- the name is a constant of *)
  (* each value of the representation in turn (IX.B.2) *)
  PROCEDURE ForStatement (CONST s: Node)
    VAR r: Rep;
        v, hi, t: Txt;
        sym: Sym;
    r := MakeRep(s^.a, 0, FALSE);
    IF NOT IsDiscrete(r) THEN FailS(s^.line, "FOR goes over an integer or scalar representation") ENDIF;
    CheckRepresented(r, s^.line);
    OpenScope(FALSE);
    sym := NewSym(S_CONST, s^.name);
    sym^.rep := r;
    sym^.level := Level;
    sym^.cname := Fresh("c_");
    DeclStorage(T("rt_int"), sym^.cname);
    Define(sym, s^.line);
    v := Fresh("i");
    hi := Fresh("hi");
    SB();
    SA("{ rt_int ");
    ST(hi);
    SA(" = ");
    ST(r^.hi);
    SA(";");
    t := SE();
    Emit(t);
    SB();
    SA("for (rt_int ");
    ST(v);
    SA(" = ");
    ST(r^.lo);
    SA("; ");
    ST(v);
    SA(" <= ");
    ST(hi);
    SA("; ");
    ST(v);
    SA("++) { ");
    ST(SymPath(sym));
    SA(" = ");
    ST(v);
    SA(";");
    t := SE();
    Emit(t);
    Statements(s^.b);
    Emit3("if (", v, " == ");
    Body.tail^.t := Join(Body.tail^.t, hi, T(") break;"));
    EmitS("}}");
    CloseScope();
    RETURN
  ENDPROCEDURE ForStatement;

  PROCEDURE Join RETURNS Txt (CONST a, b, c: Txt)
    SB();
    ST(a);
    ST(b);
    ST(c);
    RETURN SE()
  ENDPROCEDURE Join;

  PROCEDURE ReturnStatement (CONST s: Node)
    VAR c, t, tmp: Txt;
        r, ret: Rep;
    IF CurRoutine = Sym NIL THEN FailS(s^.line, "RETURN outside a routine (IX.A.6)") ENDIF;
    IF CurRoutine^.kind = S_PROCESS THEN FailS(s^.line, "a process ends with TERMINATE_PROCESS (IX.A.7)") ENDIF;
    ret := CurRoutine^.ret;
    IF s^.a = Node NIL THEN
      IF ret^.kind # R_VOID THEN FailS(s^.line, "RETURN needs a value here (IX.A.6)") ENDIF;
      CopyOut();
      LeaveMonitor();
      PopTo(XBase);
      EmitS("return;");
      RETURN
    ENDIF;
    IF ret^.kind = R_VOID THEN FailS(s^.line, "this routine returns no value (IX.A.6)") ENDIF;
    Expr(s^.a, ret, c, r);
    CheckType(s^.line, ret, r);
    tmp := Fresh("rv");
    SB();
    SA("{ ");
    ST(CType(ret));
    SA(" ");
    ST(tmp);
    SA(" = ");
    ST(Convert(c, ret, r));
    SA(";");
    t := SE();
    Emit(t);
    CopyOut();
    LeaveMonitor();
    PopTo(XBase);
    Emit3("return ", tmp, "; }");
    RETURN
  ENDPROCEDURE ReturnStatement;

  PROCEDURE BeginStatement (CONST s: Node)
    EmitS("{");
    OpenScope(FALSE);
    Declarations(s^.a^.a);
    BlockStatements(s^.a);
    AwaitProcesses();
    CloseScope();
    EmitS("}");
    RETURN
  ENDPROCEDURE BeginStatement;

  (* ---- declarations (Sections VII and X) -------------------------------------- *)
  (* Simple declarations take effect in their order; the bodies of routines *)
  (* wait until all the declarations of the scope are seen, so routines may *)
  (* call each other in any order (X.G, p.1059). *)

  (* the C name of a routine: its own when it is an identifier *)
  PROCEDURE RoutineCName RETURNS Txt (CONST name: Txt)
    VAR n: INT := NewSerial();
        ok: BOOLEAN := TRUE;
    FOR i: INTEGER [1..TL[name]] DO
      IF NOT (IsLetter(TChar(name, i)) OR IsDigit(TChar(name, i))) THEN ok := FALSE ENDIF
    ENDFOR;
    SB();
    SA("yr");
    SI(n);
    IF ok THEN
      SA("_");
      ST(name)
    ENDIF;
    RETURN SE()
  ENDPROCEDURE RoutineCName;

  (* the representation of a formal parameter (rules 85-86) *)
  PROCEDURE FormalRep RETURNS Rep (CONST n: Node)
    VAR r: Rep;
        ok: BOOLEAN;
        v: INT;
    IF n^.kind = N_RUARRAY THEN
      (* a length-unresolved array: integer indices, bounds of the actual *)
      Manifest(n^.a, ok, v);
      IF NOT ok OR (v < 1) OR (v > 4) THEN FailS(n^.line, "DIMENSIONS is a manifest constant from 1 to 4") ENDIF;
      r := NewRep(R_UARRAY, T("length-unresolved array"));
      r^.nidx := v;
      r^.elem := MakeRep(n^.b, 0, FALSE);
      CheckRepresented(r^.elem, n^.line);
      r^.deep := TRUE;
      RETURN r
    ENDIF;
    IF n^.kind = N_RSPACE THEN RETURN NewRep(R_SPACE, T("SPACE")) ENDIF;
    r := MakeRep(n, 0, FALSE);
    CheckRepresented(r, n^.line);
    RETURN r
  ENDPROCEDURE FormalRep;

  PROCEDURE ParamCType RETURNS Txt (CONST p: Param)
    VAR t: Txt := CType(p^.rep);
    IF p^.cls = C_CONST THEN RETURN t ENDIF;
    SB();
    ST(t);
    SA(" *");
    RETURN SE()
  ENDPROCEDURE ParamCType;

  (* the header of a routine or process: its parameters and C prototype *)
  PROCEDURE RoutineHeader (CONST d: Node; CONST kind: INT)
    VAR s, old: Sym;
        g, nm: Node;
        p, last: Param;
        r: Rep;
        t: Txt;
        first: BOOLEAN := TRUE;
    s := NewSym(kind, d^.name);
    s^.decl := d;
    s^.func := d^.flag = 1;
    s^.level := Level + 1;
    s^.cname := RoutineCName(d^.name);
    IF d^.b # Node NIL THEN
      s^.ret := MakeRep(d^.b, 0, FALSE);
      CheckRepresented(s^.ret, d^.line)
    ELSE
      s^.ret := RVoid;
      IF s^.func THEN FailN(d^.line, d^.name, ": a FUNCTION has a RETURNS clause (X.A)") ENDIF
    ENDIF;
    last := Param NIL;
    g := d^.a;
    WHILE g # Node NIL DO
      r := FormalRep(g^.b);
      IF s^.func AND (g^.ival # C_CONST) THEN
        FailN(g^.line, d^.name, ": the parameters of a FUNCTION are CONST (X.A.2)")
      ENDIF;
      IF (kind = S_PROCESS) AND (g^.ival = C_OUT) THEN
        FailN(g^.line, d^.name, ": a process has no OUT parameters")
      ENDIF;
      nm := g^.a;
      WHILE nm # Node NIL DO
        NEW(p);
        p^ := ParamRec(nm^.name, g^.ival, r, Fresh("p"), Param NIL);
        IF last = Param NIL THEN s^.params := p ELSE last^.next := p ENDIF;
        last := p;
        s^.nparams := s^.nparams + 1;
        nm := nm^.next
      ENDWHILE;
      g := g^.next
    ENDWHILE;
    (* overloading: EXTENDS adds to the visible definitions, REPLACES *)
    (* overrides one of them, and neither hides them all (X.A.1) *)
    old := Find(d^.name);
    IF old # Sym NIL THEN old := Real(old) ENDIF;
    IF (d^.ival # 0) AND (old # Sym NIL) AND (old^.kind = S_ROUTINE) THEN
      s^.alt := old;
      IF (d^.ival = W_EXTENDS) AND (SameSignature(s, old) # Sym NIL) THEN
        FailN(d^.line, d^.name, " EXTENDS a definition for the same parameter types: use REPLACES")
      ENDIF;
      IF (d^.ival = W_REPLACES) AND (SameSignature(s, old) = Sym NIL) THEN
        FailN(d^.line, d^.name, " REPLACES no definition for these parameter types")
      ENDIF
    ENDIF;
    d^.sym := s;
    Define(s, d^.line);
    (* the frame struct is declared now and written with the body *)
    FrameName[s^.level] := Fresh("yf");
    s^.members := NewSym(S_STD, FrameName[s^.level]);
    SB();
    SA("struct ");
    ST(FrameName[s^.level]);
    SA(";");
    t := SE();
    Put(OTypes, t);
    SB();
    SA("static ");
    IF kind = S_PROCESS THEN SA("void") ELSE ST(CType(s^.ret)) ENDIF;
    SA(" ");
    ST(s^.cname);
    SA("(");
    t := SE();
    IF kind = S_PROCESS THEN
      t := Join(t, T("void *arg"), 0);
      first := FALSE
    ELSIF Level > 0 THEN
      SB();
      ST(t);
      SA("struct ");
      ST(FrameName[Level]);
      SA(" *up");
      t := SE();
      first := FALSE
    ENDIF;
    p := s^.params;
    WHILE (p # Param NIL) AND (kind # S_PROCESS) DO
      SB();
      ST(t);
      IF NOT first THEN SA(", ") ENDIF;
      first := FALSE;
      ST(ParamCType(p));
      SA(" a_");
      ST(p^.cname);
      t := SE();
      p := p^.next
    ENDWHILE;
    IF first THEN t := Join(t, T("void"), 0) ENDIF;
    t := Join(t, T(")"), 0);
    s^.mnext := NewSym(S_STD, t);
    Put(OProtos, Join(t, T(";"), 0));
    RETURN
  ENDPROCEDURE RoutineHeader;

  (* the definition among the alternatives with the parameter types of s *)
  PROCEDURE SameSignature RETURNS Sym (CONST s, alts: Sym)
    VAR a: Sym := alts;
        p, q: Param;
        same: BOOLEAN;
    WHILE a # Sym NIL DO
      IF a^.nparams = s^.nparams THEN
        same := TRUE;
        p := s^.params;
        q := a^.params;
        WHILE p # Param NIL DO
          IF NOT SameType(p^.rep, q^.rep) THEN same := FALSE ENDIF;
          p := p^.next;
          q := q^.next
        ENDWHILE;
        IF same THEN RETURN a ENDIF
      ENDIF;
      a := a^.alt
    ENDWHILE;
    RETURN Sym NIL
  ENDPROCEDURE SameSignature;

  (* ---- the body of a routine: a C function with its frame ---------------------- *)

  PROCEDURE RoutineBody (CONST d: Node)
    VAR s: Sym := d^.sym;
        saveBody, saveLocals: Buf;
        saveLevel, saveX, saveXB, saveB, saveH, saveL, saveLB: INT;
        saveRoutine: Sym;
        saveHas: BOOLEAN;
        p: Param;
        ps: Sym;
        frame, t: Txt;
        fn: Buf;
    saveBody := Body;
    saveLocals := Locals;
    saveLevel := Level;
    saveX := XTop;
    saveXB := XBase;
    saveB := BTop;
    saveH := HTop;
    saveL := LTop;
    saveLB := LoopBase;
    saveRoutine := CurRoutine;
    saveHas := HasHandler;
    Body := Buf(Line NIL, Line NIL);
    Locals := Buf(Line NIL, Line NIL);
    fn := Buf(Line NIL, Line NIL);
    Level := s^.level;
    frame := s^.members^.name;
    FrameName[Level] := frame;
    XBase := XTop;
    LoopBase := LTop;
    HTop := 0;
    CurRoutine := s;
    HasHandler := FALSE;
    OpenScope(FALSE);
    (* the parameters live in the frame *)
    p := s^.params;
    WHILE p # Param NIL DO
      IF p^.cls = C_CONST THEN ps := NewSym(S_CONST, p^.name) ELSE ps := NewSym(S_VAR, p^.name) ENDIF;
      ps^.rep := p^.rep;
      ps^.level := Level;
      ps^.cname := p^.cname;
      IF s^.kind = S_PROCESS THEN
        (* the activation has filled the frame already *)
        ps^.byref := p^.cls = C_VAR;
        DeclStorage(ParamCType(p), p^.cname)
      ELSIF p^.cls = C_VAR THEN
        ps^.byref := TRUE;
        DeclStorage(ParamCType(p), p^.cname);
        Emit(Join(T("F."), p^.cname, Join(T(" = a_"), p^.cname, T(";"))))
      ELSIF p^.cls = C_OUT THEN
        (* computed in the frame and copied out at RETURN (X.A.2) *)
        DeclStorage(CType(p^.rep), p^.cname);
        DeclStorage(ParamCType(p), Join(p^.cname, T("_o"), 0));
        Emit(Join(T("F."), p^.cname, Join(T("_o = a_"), p^.cname, T(";"))));
        IF Deep(p^.rep) AND (p^.rep^.kind # R_UARRAY) THEN
          Emit(Join(T("y_init("), DescOf(p^.rep), Join(T(", &F."), p^.cname, T(");"))))
        ENDIF;
        IF p^.rep^.kind = R_UARRAY THEN
          Emit(Join(T("F."), p^.cname, Join(T(" = *a_"), p^.cname, T(";"))))
        ENDIF
      ELSE
        DeclStorage(CType(p^.rep), p^.cname);
        Emit(Join(T("F."), p^.cname, Join(T(" = a_"), p^.cname, T(";"))))
      ENDIF;
      Define(ps, d^.line);
      p := p^.next
    ENDWHILE;
    EnterMonitor(s);
    Declarations(d^.c^.a);
    BlockStatements(d^.c);
    IF s^.kind = S_PROCESS THEN
      EmitS("rt_raise(Y_X_NO_RETURN);")
    ELSE
      EmitS("rt_raise(Y_X_NO_RETURN);")
    ENDIF;
    AwaitProcesses();
    CloseScope();
    (* the frame *)
    SB();
    SA("struct ");
    ST(frame);
    SA(" {");
    IF Level > 1 THEN
      SA(" struct ");
      ST(FrameName[Level - 1]);
      SA(" *up;")
    ELSE
      SA(" void *up;")
    ENDIF;
    t := SE();
    Put(OFrames, t);
    Append(OFrames, Locals);
    PutS(OFrames, "};");
    (* the function *)
    Put(fn, Join(s^.mnext^.name, T(" {"), 0));
    IF HasHandler THEN PutS(fn, "volatile") ENDIF;
    Put(fn, Join(T("struct "), frame, T(" F;")));
    PutS(fn, "memset((void *)&F, 0, sizeof F);");
    IF s^.kind = S_PROCESS THEN
      Put(fn, Join(T("F = *(struct "), frame, T(" *)arg;")))
    ELSIF Level > 1 THEN
      PutS(fn, "F.up = up;")
    ENDIF;
    Append(fn, Body);
    PutS(fn, "}");
    Append(OFuncs, fn);
    Body := saveBody;
    Locals := saveLocals;
    Level := saveLevel;
    FrameName[Level] := Fresh("unused");
    IF saveRoutine # Sym NIL THEN FrameName[Level] := saveRoutine^.members^.name ENDIF;
    XTop := saveX;
    XBase := saveXB;
    BTop := saveB;
    HTop := saveH;
    LTop := saveL;
    LoopBase := saveLB;
    CurRoutine := saveRoutine;
    HasHandler := saveHas;
    RETURN
  ENDPROCEDURE RoutineBody;

  (* ---- the simple declarations ------------------------------------------------------ *)

  PROCEDURE DeclareStorage (CONST s: Sym; CONST r: Rep; CONST line: INT)
    s^.rep := r;
    s^.level := Level;
    s^.cname := Fresh("v");
    DeclStorage(CType(r), s^.cname);
    IF Deep(r) THEN Emit(Join(T("y_init("), DescOf(r), Join(T(", &"), SymPath(s), T(");")))) ENDIF;
    IF r^.kind = R_SET THEN
      Emit(Join(SymPath(s), T(" = y_set_new("), Join(r^.elem^.lo, T(", "), Join(r^.elem^.hi, T(");"), 0))))
    ENDIF;
    IF r^.kind = R_SIGNAL THEN DeclareSignal(s, line) ENDIF;
    IF r^.kind = R_SEM THEN Emit(Join(T("rt_lock_init(&"), SymPath(s), T(");"))) ENDIF;
    RETURN
  ENDPROCEDURE DeclareStorage;

  PROCEDURE SimpleDecl (CONST d: Node)
    VAR k: INT := d^.kind;
        r, er: Rep;
        nm: Node;
        s: Sym;
        c: Txt;
        ok: BOOLEAN;
        v: INT;
    IF (k = N_CONST) OR (k = N_VAR) THEN
      r := MakeRep(d^.b, 0, FALSE);
      CheckRepresented(r, d^.line);
      IF (k = N_CONST) AND ((r^.kind = R_SIGNAL) OR (r^.kind = R_FILE) OR (r^.kind = R_SEM)) THEN
        FailS(d^.line, "signals, files and semaphores are variables (VII.B)")
      ENDIF;
      nm := d^.a;
      WHILE nm # Node NIL DO
        IF k = N_CONST THEN s := NewSym(S_CONST, nm^.name) ELSE s := NewSym(S_VAR, nm^.name) ENDIF;
        DeclareStorage(s, r, d^.line);
        IF d^.c # Node NIL THEN
          Expr(d^.c, r, c, er);
          Store(SymPath(s), r, c, er, d^.line);
          IF k = N_CONST THEN
            Manifest(d^.c, ok, v);
            IF ok AND IsDiscrete(r) THEN
              s^.hasmv := TRUE;
              s^.mval := v
            ENDIF
          ENDIF
        ENDIF;
        IF nm^.a # Node NIL THEN AtLocation(s, nm^.a) ENDIF;
        Define(s, nm^.line);
        nm := nm^.next
      ENDWHILE;
      RETURN
    ENDIF;
    IF k = N_REPDECL THEN
      r := MakeRep(d^.b, d^.name, FALSE);
      CheckRepresented(r, d^.line);
      s := NewSym(S_REP, d^.name);
      s^.rep := r;
      Define(s, d^.line);
      ResolvePending(d^.name, r);
      RETURN
    ENDIF;
    IF k = N_TYPE THEN
      r := MakeRep(d^.b, d^.name, TRUE);
      IF d^.b^.kind = N_RNAME THEN
        (* TYPE T = INTEGER: a new type, with the operations of the old (VIII.A) *)
        r := CopyRep(r);
        r^.tid := NewTid(d^.name);
        r^.tname := d^.name;
        IF (r^.kind = R_INT) OR (r^.kind = R_FIXED) OR (r^.kind = R_FLOAT) THEN
          IF d^.b^.a = Node NIL THEN r^.abstract := TRUE ENDIF
        ENDIF
      ENDIF;
      s := NewSym(S_TYPE, d^.name);
      s^.rep := r;
      Define(s, d^.line);
      ResolvePending(d^.name, r);
      RETURN
    ENDIF;
    IF k = N_LABEL THEN
      FailS(d^.line, "this translator has no labels yet");
      RETURN
    ENDIF;
    FailS(d^.line, "not a simple declaration");
    RETURN
  ENDPROCEDURE SimpleDecl;

  (* AT: the location of a variable is implementation-dependent (XIV.VII); *)
  (* this implementation takes it for device signals only *)
  PROCEDURE AtLocation (CONST s: Sym; CONST at: Node)
    IF s^.rep^.kind = R_SIGNAL THEN
      DeviceSignal(s, at);
      RETURN
    ENDIF;
    RETURN
  ENDPROCEDURE AtLocation;

  PROCEDURE Declarations (CONST list: Node)
    VAR d: Node := list;
        deferred, dtail, n: Node := Node NIL;
    WHILE d # Node NIL DO
      CurLine := d^.line;
      IF (d^.kind = N_ROUTINE) OR (d^.kind = N_PROCESS) THEN
        IF d^.kind = N_ROUTINE THEN RoutineHeader(d, S_ROUTINE) ELSE RoutineHeader(d, S_PROCESS) ENDIF;
        n := NewNode(N_NAMEL, d^.line);
        n^.a := d;
        Link(deferred, dtail, n);
        IF d^.kind = N_PROCESS THEN DeclareProcess(d) ENDIF
      ELSIF (d^.kind = N_MODULE) THEN
        CompileModule(d)
      ELSIF d^.kind = N_TEMPLATE THEN
        DeclareTemplate(d)
      ELSIF d^.kind = N_INSTANCE THEN
        Instantiate(d)
      ELSE
        SimpleDecl(d)
      ENDIF;
      d := d^.next
    ENDWHILE;
    CheckPending();
    n := deferred;
    WHILE n # Node NIL DO
      RoutineBody(n^.a);
      n := n^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE Declarations;

  (* ---- modules, monitors, templates and processes (X.B-X.E) ------------------ *)

  VAR
    CurMonitor: Sym := Sym NIL;      (* the monitor around the declarations being read *)
    ProcList: ARRAY (INTEGER [0..400] OF Node);  (* per scope: processes declared there *)

  (* ---- importing and exporting ---------------------------------------------- *)

  PROCEDURE Alias RETURNS Sym (CONST name: Txt; CONST target: Sym)
    VAR a: Sym := NewSym(S_EXPORT, name);
    a^.target := target;
    a^.readonly := target^.readonly;
    RETURN a
  ENDPROCEDURE Alias;

  (* the literals of the enumerations a representation is made of come with *)
  (* it (so that a user of Coordinate can write Polar, p.1102) *)
  PROCEDURE AddLits (VAR head: Sym; CONST r: Rep; CONST depth: INT)
    VAR p: Node;
        s: Sym;
        f: Field;
    IF (depth > 8) OR r^.opaque THEN RETURN ENDIF;
    IF r^.kind = R_ENUM THEN
      p := r^.lits;
      WHILE p # Node NIL DO
        s := FindLit(p^.name, r);
        IF s # Sym NIL THEN
          s := Alias(p^.name, s);
          s^.mnext := head;
          head := s
        ENDIF;
        p := p^.next
      ENDWHILE
    ELSIF r^.kind = R_RECORD THEN
      f := r^.fields;
      WHILE f # Field NIL DO
        AddLits(head, f^.rep, depth + 1);
        f := f^.next
      ENDWHILE
    ELSIF (r^.kind = R_ARRAY) OR (r^.kind = R_SET) OR (r^.kind = R_FILE) THEN
      AddLits(head, r^.elem, depth + 1)
    ENDIF;
    RETURN
  ENDPROCEDURE AddLits;

  (* one item of an import or export list, as aliases added to head; inner *)
  (* is the module whose names an export list speaks of, or NIL for imports *)
  PROCEDURE ResolveItem (CONST it: Node; VAR head: Sym; CONST exporting: BOOLEAN)
    VAR target, m, s: Sym;
        name: Txt;
        r: Rep;
        attr: INT := it^.flag;
    IF it^.text # 0 THEN
      (* x FROM M: M's exported x *)
      m := Real(Lookup(it^.text, it^.line));
      IF m^.kind # S_MODULE THEN FailN(it^.line, it^.text, " is not a module") ENDIF;
      target := m^.members;
      WHILE (target # Sym NIL) AND (target^.name # it^.name) DO target := target^.mnext ENDWHILE;
      IF target = Sym NIL THEN FailN(it^.line, it^.name, " is not exported by that module") ENDIF
    ELSE
      IF exporting THEN target := FindHere(it^.name) ELSE target := Find(it^.name) ENDIF;
      IF target = Sym NIL THEN
        IF exporting THEN FailN(it^.line, it^.name, " is not declared in this module")
        ELSE FailN(it^.line, it^.name, " is not declared around this module (X.B.2)")
        ENDIF
      ENDIF
    ENDIF;
    name := it^.name;
    IF it^.ival # 0 THEN name := it^.ival ENDIF;
    m := Real(target);
    IF (m^.kind = S_MODULE) AND (it^.text = 0) THEN
      (* a module stands for the list of what it exports (X.B.2) *)
      IF (attr # 0) OR (it^.ival # 0) THEN
        FailS(it^.line, "a module name in a list takes no attribute and no AS (X.B.3)")
      ENDIF;
      s := m^.members;
      WHILE s # Sym NIL DO
        target := Alias(s^.name, s);
        target^.mnext := head;
        head := target;
        s := s^.mnext
      ENDWHILE;
      RETURN
    ENDIF;
    s := Alias(name, target);
    IF exporting THEN
      (* the attributes restrict, they never relax (X.B.3, p.1052) *)
      IF (m^.kind = S_REP) OR (m^.kind = S_TYPE) THEN
        IF (attr = W_READONLY) OR (attr = W_VAR) THEN FailS(it^.line, "READONLY and VAR are for variables") ENDIF;
        IF (attr # W_TRANSPARENT) OR m^.rep^.opaque THEN
          (* OPAQUE is assumed: the outside sees no components and no := = # *)
          r := CopyRep(m^.rep);
          r^.opaque := TRUE;
          s^.target := NewSym(m^.kind, m^.name);
          s^.target^.rep := r;
          s^.target^.decl := m^.decl
        ELSE
          AddLits(head, m^.rep, 0)
        ENDIF
      ELSIF m^.kind = S_VAR THEN
        IF (attr = W_OPAQUE) OR (attr = W_TRANSPARENT) THEN FailS(it^.line, "OPAQUE and TRANSPARENT are for types") ENDIF;
        IF attr # W_VAR THEN s^.readonly := TRUE ENDIF
      ELSIF attr # 0 THEN
        FailS(it^.line, "an attribute is for a type, a representation or a variable")
      ENDIF;
      IF (m^.kind = S_VAR) AND (m^.rep^.kind = R_SIGNAL) THEN
        FailS(it^.line, "a signal may not be exported from its monitor (X.E.4)")
      ENDIF
    ELSIF (m^.kind = S_REP) OR (m^.kind = S_TYPE) THEN
      AddLits(head, m^.rep, 0)
    ENDIF;
    s^.mnext := head;
    head := s;
    RETURN
  ENDPROCEDURE ResolveItem;

  PROCEDURE DefineAll (CONST list: Sym; CONST line: INT)
    VAR s, next, old: Sym := list;
    WHILE s # Sym NIL DO
      next := s^.mnext;
      old := FindHere(s^.name);
      IF (old = Sym NIL) OR (Real(old) # Real(s)) THEN
        IF (old # Sym NIL) AND (Real(s)^.kind = S_LIT) AND (Real(old)^.kind = S_LIT) THEN
          Define(s, line)
        ELSIF old = Sym NIL THEN
          Define(s, line)
        ELSE
          FailN(line, s^.name, " comes into this scope twice")
        ENDIF
      ENDIF;
      s := next
    ENDWHILE;
    RETURN
  ENDPROCEDURE DefineAll;

  (* ---- modules (X.B) and monitors (X.E.3) ------------------------------------------- *)

  PROCEDURE CompileModule (CONST d: Node)
    VAR imports, exports, it, m, s, saveMon, mon, next: Sym;
        item, p: Node;
        saveVis: INT;
        t: Txt;
        monitorHere: BOOLEAN := FALSE;
    (* imports are names of the scope around the module *)
    imports := Sym NIL;
    item := d^.a;
    WHILE item # Node NIL DO
      ResolveItem(item, imports, FALSE);
      item := item^.next
    ENDWHILE;
    saveMon := CurMonitor;
    IF (d^.flag = 1) AND (CurMonitor = Sym NIL) THEN
      (* a monitor: its lock; a monitor inside a monitor adds no exclusion *)
      mon := NewSym(S_VAR, d^.name);
      mon^.level := Level;
      mon^.cname := Fresh("mon");
      mon^.rep := RVoid;
      DeclStorage(T("ymon"), mon^.cname);
      Emit(Join(T("y_mon_init(&"), Path(Level, mon^.cname), T(");")));
      CurMonitor := mon;
      monitorHere := TRUE
    ENDIF;
    OpenScope(TRUE);
    ProcList[Depth] := Node NIL;
    saveVis := VisibleFrom;
    VisibleFrom := Depth;
    DefineAll(imports, d^.line);
    Declarations(d^.c^.a);
    (* the body initializes the module, inside the monitor if it is one *)
    IF monitorHere THEN Emit(Join(T("y_mon_enter(&"), Path(CurMonitor^.level, CurMonitor^.cname), T(");"))) ENDIF;
    BTop := BTop + 1;
    BlockFrame[BTop] := 0;
    BlockStatements(d^.c);
    BTop := BTop - 1;
    IF monitorHere THEN Emit(Join(T("y_mon_leave(&"), Path(CurMonitor^.level, CurMonitor^.cname), T(");"))) ENDIF;
    (* exports are names of the module *)
    exports := Sym NIL;
    item := d^.b;
    WHILE item # Node NIL DO
      ResolveItem(item, exports, TRUE);
      item := item^.next
    ENDWHILE;
    p := ProcList[Depth];
    VisibleFrom := saveVis;
    CloseScope();
    (* processes of a module hold the scope around it (X.E.1) *)
    WHILE p # Node NIL DO
      item := p^.next;
      p^.next := ProcList[Depth];
      ProcList[Depth] := p;
      p := item
    ENDWHILE;
    CurMonitor := saveMon;
    m := NewSym(S_MODULE, d^.name);
    m^.members := exports;
    Define(m, d^.line);
    (* the exports are names of the scope around; a list of aliases is kept *)
    (* in the module for IMPORT M and FROM M *)
    s := exports;
    exports := Sym NIL;
    WHILE s # Sym NIL DO
      next := s^.mnext;
      it := Alias(s^.name, s);
      it^.readonly := s^.readonly;
      it^.mnext := exports;
      exports := it;
      s := next
    ENDWHILE;
    m^.members := exports;
    s := exports;
    WHILE s # Sym NIL DO
      next := Alias(s^.name, s);
      next^.readonly := s^.readonly;
      IF FindHere(s^.name) = Sym NIL THEN Define(next, d^.line)
      ELSIF Real(s)^.kind # S_LIT THEN FailN(d^.line, s^.name, " is exported into a scope that has it already")
      ENDIF;
      s := s^.mnext
    ENDWHILE;
    RETURN
  ENDPROCEDURE CompileModule;

  (* ---- module templates and their instances (X.C-D) ---------------------------------- *)

  PROCEDURE DeclareTemplate (CONST d: Node)
    VAR s: Sym := NewSym(S_TEMPLATE, d^.name);
    s^.decl := d;
    Define(s, d^.line);
    RETURN
  ENDPROCEDURE DeclareTemplate;

  (* the module of the template, with the actuals put for the formals *)
  (* throughout (p.1055): its tokens are copied with the names replaced *)
  (* and read again *)
  PROCEDURE Instantiate (CONST d: Node)
    VAR s: Sym := Real(Lookup(d^.name, d^.line));
        t: Node;
        f, a: Node;
        start, saveT, kind, val: INT;
        n: Node;
    IF s^.kind # S_TEMPLATE THEN FailN(d^.line, d^.name, " is not a template") ENDIF;
    t := s^.decl;
    IF Count(t^.a) # Count(d^.a) THEN FailN(d^.line, d^.name, ": the number of actuals is wrong") ENDIF;
    start := NTok + 1;
    FOR i: INTEGER [t^.ival..t^.flag - 1] DO
      kind := TKind[i];
      val := TVal[i];
      IF kind = K_ID THEN
        f := t^.a;
        a := d^.a;
        WHILE f # Node NIL DO
          IF f^.name = val THEN
            val := a^.name;
            IF val <= NKW THEN kind := K_KW ELSIF val <= NPUNCT THEN kind := K_OP ENDIF
          ENDIF;
          f := f^.next;
          a := a^.next
        ENDWHILE
      ENDIF;
      NTok := NTok + 1;
      TKind[NTok] := kind;
      TVal[NTok] := val;
      TLine[NTok] := TLine[i]
    ENDFOR;
    NTok := NTok + 1;
    TKind[NTok] := K_EOF;
    TVal[NTok] := 0;
    TLine[NTok] := d^.line;
    saveT := TPos;
    TPos := start;
    n := ParseModule();
    TPos := saveT;
    CompileModule(n);
    RETURN
  ENDPROCEDURE Instantiate;

  (* ---- processes (X.E.1-2, XIV.X.2) -------------------------------------------------- *)

  (* a process declaration: its routine, and the count of its activations *)
  (* that the scope waits for before it ends *)
  PROCEDURE DeclareProcess (CONST d: Node)
    VAR s: Sym := d^.sym;
        p: Node;
    s^.monitor := CurMonitor;
    DeclStorage(T("rt_taskdecl"), Join(s^.cname, T("_d"), 0));
    p := NewNode(N_NAMEL, d^.line);
    p^.sym := s;
    p^.next := ProcList[Depth];
    ProcList[Depth] := p;
    RETURN
  ENDPROCEDURE DeclareProcess;

  (* the scope ends when its processes have ended (X.E.1) *)
  PROCEDURE AwaitProcesses ()
    VAR p: Node := ProcList[Depth];
    WHILE p # Node NIL DO
      Emit(Join(T("rt_await_decl(&"), Path(p^.sym^.level - 1, Join(p^.sym^.cname, T("_d"), 0)), T(");")));
      p := p^.next
    ENDWHILE;
    ProcList[Depth] := Node NIL;
    RETURN
  ENDPROCEDURE AwaitProcesses;

  (* a process activation: a new frame, filled with the actuals, and a new *)
  (* process running the body on it (IX.A.2, X.E.2) *)
  PROCEDURE Activate (CONST n: Node; CONST s: Sym)
    VAR base, nargs, i: INT;
        p: Param;
        pf, t, c, pc, lim, pr: Txt;
        d: Node := s^.decl;
        r: Rep;
    CompileArgs(n^.a, s, base, nargs);
    IF nargs # s^.nparams THEN FailN(n^.line, s^.name, ": the number of actual parameters is wrong") ENDIF;
    pf := Fresh("pf");
    Emit(Join(T("{ struct "), s^.members^.name, Join(T(" *"), pf, Join(T(" = rt_alloc(sizeof *"), pf, T(");")))));
    IF s^.level > 1 THEN
      Emit(Join(pf, T("->up = "), Join(FramePtr(s^.level - 1), T(";"), 0)))
    ENDIF;
    p := s^.params;
    i := base + 1;
    WHILE p # Param NIL DO
      IF NOT Fits(p^.rep, ArgRep[i]) THEN TypeClash(ArgNode[i]^.line, p^.rep, ArgRep[i]) ENDIF;
      pc := Join(pf, T("->"), p^.cname);
      IF p^.cls = C_VAR THEN
        IF NOT IsVariable(ArgNode[i]) THEN FailN(ArgNode[i]^.line, p^.name, ": the actual of a VAR parameter must be a variable") ENDIF;
        Emit(Join(pc, T(" = &"), Join(ArgCode[i], T(";"), 0)))
      ELSIF Deep(p^.rep) THEN
        (* the process may outlive the value: it gets its own copy *)
        t := Fresh("t");
        Emit(Join(T("{ "), CType(p^.rep), Join(T(" "), t, Join(T(" = "), ArgCode[i], T(";")))));
        IF p^.rep^.kind = R_UARRAY THEN
          Emit(Join(T("y_copy(y_desc_vector("), DescOf(p^.rep^.elem), Join(T("), &"), pc, Join(T(", &"), t, T("); }")))))
        ELSE
          Emit(Join(T("y_copy("), DescOf(p^.rep), Join(T(", &"), pc, Join(T(", &"), t, T("); }")))))
        ENDIF
      ELSE
        Emit(Join(pc, T(" = "), Join(Convert(ArgCode[i], p^.rep, ArgRep[i]), T(";"), 0)))
      ENDIF;
      i := i + 1;
      p := p^.next
    ENDWHILE;
    ArgTop := base;
    lim := T("0");
    IF d^.e # Node NIL THEN
      Expr(d^.e, RInt, lim, r);
      CheckType(d^.line, RInt, r)
    ENDIF;
    pr := T("0, 0");
    IF d^.d # Node NIL THEN
      Expr(d^.d, RInt, c, r);
      CheckType(d^.line, RInt, r);
      pr := Join(T("1, "), c, 0)
    ENDIF;
    SB();
    SA("y_create(&");
    ST(Path(s^.level - 1, Join(s^.cname, T("_d"), 0)));
    SA(", ");
    ST(lim);
    SA(", ");
    ST(pr);
    SA(", ");
    ST(s^.cname);
    SA(", ");
    ST(pf);
    SA("); }");
    t := SE();
    Emit(t);
    RETURN
  ENDPROCEDURE Activate;

  PROCEDURE MonitorPath RETURNS Txt (CONST m: Sym)
    RETURN Join(T("&"), Path(m^.level, m^.cname), 0)
  ENDPROCEDURE MonitorPath;

  (* a monitor procedure or a process of a monitor holds the monitor while *)
  (* it runs; an exception that leaves it lets the monitor go (X.E.3) *)
  PROCEDURE EnterMonitor (CONST s: Sym)
    VAR f: Txt;
    IF s^.kind = S_ROUTINE THEN s^.monitor := CurMonitor ENDIF;
    IF s^.monitor = Sym NIL THEN RETURN ENDIF;
    Emit(Join(T("y_mon_enter("), MonitorPath(s^.monitor), T(");")));
    f := Fresh("mf");
    HasHandler := TRUE;
    Emit(Join(T("rt_frame "), f, T(";")));
    SB();
    SA("if (!RT_TRY(");
    ST(f);
    SA(")) { RT_POP(");
    ST(f);
    SA("); ");
    IF s^.kind = S_PROCESS THEN SA("y_mon_drop(") ELSE SA("y_mon_leave(") ENDIF;
    ST(MonitorPath(s^.monitor));
    SA("); rt_raise(rt_xcur); }");
    Emit(SE());
    XTop := XTop + 1;
    XFrames[XTop] := f;
    RETURN
  ENDPROCEDURE EnterMonitor;

  PROCEDURE LeaveMonitor ()
    IF CurRoutine = Sym NIL THEN RETURN ENDIF;
    IF CurRoutine^.monitor = Sym NIL THEN RETURN ENDIF;
    IF CurRoutine^.kind = S_PROCESS THEN
      Emit(Join(T("y_mon_drop("), MonitorPath(CurRoutine^.monitor), T(");")))
    ELSE
      Emit(Join(T("y_mon_leave("), MonitorPath(CurRoutine^.monitor), T(");")))
    ENDIF;
    RETURN
  ENDPROCEDURE LeaveMonitor;

  PROCEDURE TerminateStatement (CONST s: Node)
    IF (CurRoutine = Sym NIL) OR (CurRoutine^.kind # S_PROCESS) THEN
      FailS(s^.line, "TERMINATE_PROCESS ends a process (IX.A.7)")
    ENDIF;
    AwaitProcesses();
    LeaveMonitor();
    PopTo(XBase);
    EmitS("return;");
    RETURN
  ENDPROCEDURE TerminateStatement;

  (* ---- signals (X.E.4) ----------------------------------------------------------- *)

  PROCEDURE DeclareSignal (CONST s: Sym; CONST line: INT)
    IF CurMonitor = Sym NIL THEN FailS(line, "signal variables are declared in a monitor (X.E.4)") ENDIF;
    s^.rep := CopyRep(s^.rep);
    s^.rep^.monitor := CurMonitor;
    Emit(Join(T("y_sig_init(&"), SymPath(s), Join(T(", "), MonitorPath(CurMonitor), T(");"))));
    RETURN
  ENDPROCEDURE DeclareSignal;

  (* a device signal (XIV.VII): the address is kept; this implementation *)
  (* has no devices, so such a signal is sent only by software *)
  PROCEDURE DeviceSignal (CONST s: Sym; CONST at: Node)
    VAR ok: BOOLEAN;
        v: INT;
    Manifest(at, ok, v);
    IF NOT ok THEN FailS(at^.line, "an AT location is a manifest constant (XIV.VII)") ENDIF;
    RETURN
  ENDPROCEDURE DeviceSignal;

  (* ---- the standard operations (Sections XI, XII, XIV.XI) --------------------- *)

  PROCEDURE Arg RETURNS Node (CONST n: Node; CONST i: INT)
    VAR p: Node := n^.a;
        k: INT := 1;
    WHILE (p # Node NIL) AND (k < i) DO
      p := p^.next;
      k := k + 1
    ENDWHILE;
    IF p = Node NIL THEN FailN(n^.line, n^.name, ": too few actual parameters") ENDIF;
    RETURN p
  ENDPROCEDURE Arg;

  PROCEDURE NArgs (CONST n: Node; CONST k: INT)
    IF Count(n^.a) # k THEN FailN(n^.line, n^.name, ": the number of actual parameters is wrong") ENDIF;
    RETURN
  ENDPROCEDURE NArgs;

  PROCEDURE Call1 RETURNS Txt (CONST f: ARRAY (1 DIMENSIONS OF ASCII); CONST a: Txt)
    SB();
    SA(f);
    SA("(");
    ST(a);
    SA(")");
    RETURN SE()
  ENDPROCEDURE Call1;

  PROCEDURE Addr RETURNS Txt (CONST a: Txt)
    RETURN Join(T("&"), a, 0)
  ENDPROCEDURE Addr;

  (* a variable of one of the kinds listed, for VAR parameters of the *)
  (* standard procedures *)
  PROCEDURE StdVar (CONST n: Node; CONST kind: INT; OUT code: Txt; OUT r: Rep)
    VAR t: Txt;
    LValue(n, code, r);
    IF (kind # R_ANY) AND (r^.kind # kind) THEN
      SB();
      SA("a ");
      IF kind = R_FILE THEN SA("file")
      ELSIF kind = R_SIGNAL THEN SA("signal")
      ELSIF kind = R_SEM THEN SA("SEMAPHORE")
      ELSIF kind = R_PTR THEN SA("pointer")
      ELSE SA("variable")
      ENDIF;
      SA(" is needed here");
      t := SE();
      Fail(n^.line, t)
    ENDIF;
    RETURN
  ENDPROCEDURE StdVar;

  PROCEDURE NumArg (CONST n: Node; OUT code: Txt; OUT r: Rep)
    Expr(n, Rep NIL, code, r);
    IF NOT IsNumeric(r) THEN FailS(n^.line, "a number is needed here") ENDIF;
    RETURN
  ENDPROCEDURE NumArg;

  PROCEDURE IntArg RETURNS Txt (CONST n: Node)
    VAR c: Txt;
        r: Rep;
    Expr(n, RInt, c, r);
    IF r^.kind # R_INT THEN FailS(n^.line, "an integer is needed here") ENDIF;
    RETURN c
  ENDPROCEDURE IntArg;

  (* C_CODE_INSERT("..."): the implementation's code insert (XIV.XI.5). *)
  (* The machine of this implementation is C: the text is put into the *)
  (* program, with $name standing for the variable, constant or parameter *)
  (* name visible here. *)
  PROCEDURE CodeInsert (CONST n: Node)
    VAR a: Node := Arg(n, 1);
        text, w, t: Txt;
        i, j, len: INT;
        c: ASCII;
        s: Sym;
        alpha: ARRAY (INTEGER [1..1] OF Txt);
    IF a^.kind # N_STRLIT THEN FailS(n^.line, "a code insert takes a string literal (XIV.XI.5)") ENDIF;
    text := a^.text;
    len := TL[text];
    SB();
    i := 1;
    WHILE i <= len DO
      c := TChar(text, i);
      IF c = 'SQ' THEN
        j := i + 1;
        WHILE TChar(text, j) # 'SQ' DO j := j + 1 ENDWHILE;
        w := Intern(TS[text] + i, (j - i) - 1);
        SC(Chr[CharValue(RAscii, w, n^.line)]);
        i := j + 1
      ELSIF c = '$' THEN
        j := i + 1;
        WHILE (j <= len) AND (IsLetter(TChar(text, j)) OR IsDigit(TChar(text, j))) DO j := j + 1 ENDWHILE;
        w := Intern(TS[text] + i, (j - i) - 1);
        s := Find(w);
        IF s = Sym NIL THEN
          ScTop := 0;
          SbDepth := 0;
          FailN(n^.line, w, " in a code insert is not declared here")
        ENDIF;
        s := Real(s);
        IF (s^.kind # S_VAR) AND (s^.kind # S_CONST) THEN
          ScTop := 0;
          SbDepth := 0;
          FailN(n^.line, w, " in a code insert is not a variable or constant")
        ENDIF;
        ST(Paren(SymPath(s)));
        i := j
      ELSE
        SC(c);
        i := i + 1
      ENDIF
    ENDWHILE;
    t := SE();
    Emit(t);
    RETURN
  ENDPROCEDURE CodeInsert;

  PROCEDURE StdCall (CONST f: INT; CONST n: Node; CONST statement: BOOLEAN;
                     OUT code: Txt; OUT r: Rep)
    VAR a, b, c, d, t: Txt;
        ra, rb, rc, el: Rep;
        nargs, i, dim: INT;
        ok: BOOLEAN;
        p: Node;
        isproc: BOOLEAN;
    r := RVoid;
    code := T("((void)0)");
    isproc := (f = F_NEW) OR (f = F_OPEN) OR (f = F_CLOSE) OR (f = F_GET) OR (f = F_PUT) OR
              (f = F_MOVE) OR (f = F_DELAY) OR (f = F_WAIT) OR (f = F_SEND) OR (f = F_CLAIM) OR
              (f = F_RELEASE) OR (f = F_CHANGE_PRIORITY) OR (f = F_RAISE_TERM) OR
              (f = F_FREE_POINTER) OR (f = F_CODE_INSERT);
    IF statement AND NOT isproc THEN FailN(n^.line, n^.name, " returns a value: it is called in an expression") ENDIF;
    IF NOT statement AND isproc THEN FailN(n^.line, n^.name, " returns no value") ENDIF;
    IF (f = F_LOW) OR (f = F_HIGH) THEN
      NArgs(n, 2);
      Expr(Arg(n, 1), Rep NIL, a, ra);
      IF NOT IsArrayLike(ra) THEN FailN(n^.line, n^.name, " of something that is not an array") ENDIF;
      b := IntArg(Arg(n, 2));
      Manifest(Arg(n, 2), ok, dim);
      r := Unbounded(RInt);
      IF ok AND (ra^.kind = R_ARRAY) THEN
        IF (dim < 1) OR (dim > ra^.nidx) THEN FailS(n^.line, "no such dimension") ENDIF;
        el := ra^.idx;
        FOR k: INTEGER [2..dim] DO el := el^.link ENDFOR;
        r := el
      ENDIF;
      IF f = F_LOW THEN code := Call2("y_low", a, b) ELSE code := Call2("y_high", a, b) ENDIF;
      RETURN
    ENDIF;
    IF (f = F_SUCC) OR (f = F_PRED) OR (f = F_FIRST) OR (f = F_LAST) THEN
      NArgs(n, 1);
      Expr(Arg(n, 1), Rep NIL, a, ra);
      IF NOT IsDiscrete(ra) THEN FailN(n^.line, n^.name, " of something that is not integer or scalar") ENDIF;
      IF ((f = F_FIRST) OR (f = F_LAST)) AND (ra^.kind = R_INT) THEN
        FailS(n^.line, "FIRST and LAST apply to ordered enumerations and alphabets (XI)")
      ENDIF;
      IF (ra^.kind = R_ENUM) AND NOT ra^.ordered THEN
        FailN(n^.line, n^.name, " applies to ordered enumerations (XI)")
      ENDIF;
      r := Unbounded(ra);
      IF f = F_FIRST THEN
        code := ra^.lo
      ELSIF f = F_LAST THEN
        code := ra^.hi
      ELSE
        SB();
        IF ra^.lo # 0 THEN SA("rt_range(") ENDIF;
        IF f = F_SUCC THEN SA("rt_add(") ELSE SA("rt_sub(") ENDIF;
        ST(a);
        SA(", 1)");
        IF ra^.lo # 0 THEN
          SA(", ");
          ST(ra^.lo);
          SA(", ");
          ST(ra^.hi);
          SA(")")
        ENDIF;
        code := SE()
      ENDIF;
      IF ra^.kind # R_INT THEN r := ra ENDIF;
      RETURN
    ENDIF;
    IF f = F_NEW THEN
      NArgs(n, 1);
      StdVar(Arg(n, 1), R_PTR, a, ra);
      IF ra^.elem = Rep NIL THEN FailN(n^.line, ra^.forward, " is not declared") ENDIF;
      el := ra^.elem;
      SB();
      SA("({ ");
      ST(a);
      SA(" = rt_alloc(sizeof(");
      ST(CType(el));
      SA("));");
      IF Deep(el) THEN
        SA(" y_init(");
        ST(DescOf(el));
        SA(", ");
        ST(a);
        SA(");")
      ENDIF;
      SA(" })");
      code := SE();
      RETURN
    ENDIF;
    IF f = F_FREE_POINTER THEN
      NArgs(n, 1);
      StdVar(Arg(n, 1), R_PTR, a, ra);
      code := Join(T("({ free("), a, Join(T("); "), a, T(" = 0; })")));
      RETURN
    ENDIF;
    IF f = F_OPEN THEN
      NArgs(n, 3);
      StdVar(Arg(n, 1), R_FILE, a, ra);
      Expr(Arg(n, 2), RAscii, b, rb);
      IF NOT IsString(rb) THEN FailS(n^.line, "OPEN takes the name of the file as a string (XII.A)") ENDIF;
      Expr(Arg(n, 3), ROpenMode, c, rc);
      CheckType(n^.line, ROpenMode, rc);
      SB();
      SA("y_open(&");
      ST(a);
      SA(", ");
      ST(b);
      SA(", ");
      ST(c);
      SA(")");
      code := SE();
      RETURN
    ENDIF;
    IF (f = F_CLOSE) OR (f = F_CHECK_EOF) THEN
      NArgs(n, 1);
      StdVar(Arg(n, 1), R_FILE, a, ra);
      IF f = F_CLOSE THEN code := Call1("y_close", Addr(a))
      ELSE
        r := RBool;
        code := Call1("y_check_eof", Addr(a))
      ENDIF;
      RETURN
    ENDIF;
    IF f = F_GET THEN
      NArgs(n, 2);
      StdVar(Arg(n, 1), R_FILE, a, ra);
      StdVar(Arg(n, 2), R_ANY, b, rb);
      CheckType(n^.line, ra^.elem, rb);
      IF Deep(rb) OR (rb^.kind = R_PTR) THEN FailS(n^.line, "files of this implementation hold no arrays or pointers") ENDIF;
      SB();
      SA("({ ");
      ST(CType(rb));
      SA(" g; y_get(&");
      ST(a);
      SA(", &g, sizeof g); ");
      ST(b);
      SA(" = ");
      ST(Convert(T("g"), rb, ra^.elem));
      SA("; })");
      code := SE();
      RETURN
    ENDIF;
    IF f = F_PUT THEN
      NArgs(n, 2);
      StdVar(Arg(n, 1), R_FILE, a, ra);
      Expr(Arg(n, 2), ra^.elem, b, rb);
      CheckType(n^.line, ra^.elem, rb);
      IF Deep(rb) OR (rb^.kind = R_PTR) THEN FailS(n^.line, "files of this implementation hold no arrays or pointers") ENDIF;
      SB();
      SA("({ ");
      ST(CType(ra^.elem));
      SA(" pv = ");
      ST(Convert(b, ra^.elem, rb));
      SA("; y_put(&");
      ST(a);
      SA(", &pv, sizeof pv); })");
      code := SE();
      RETURN
    ENDIF;
    IF f = F_MOVE THEN
      (* MOVE(object, i, source1, i1, j1, ...): the sources one after *)
      (* another into the object from index i (XI) *)
      nargs := Count(n^.a);
      IF (nargs < 5) OR (((nargs - 2) MOD 3) # 0) THEN FailS(n^.line, "MOVE takes an object, an index and triples") ENDIF;
      StdVar(Arg(n, 1), R_ANY, a, ra);
      IF NOT ((ra^.kind = R_ARRAY) OR (ra^.kind = R_UARRAY)) OR (ra^.nidx # 1) THEN
        FailS(n^.line, "MOVE works on one-dimensional arrays")
      ENDIF;
      b := IntArg(Arg(n, 2));
      t := Fresh("at");
      SB();
      SA("({ rt_int ");
      ST(t);
      SA(" = ");
      ST(b);
      SA(";");
      code := SE();
      i := 3;
      WHILE i < nargs DO
        Expr(Arg(n, i), ra^.elem, c, rc);
        IF NOT IsArrayLike(rc) OR NOT SameType(ra^.elem, rc^.elem) THEN FailS(n^.line, "MOVE: the components differ in type") ENDIF;
        d := IntArg(Arg(n, i + 1));
        b := IntArg(Arg(n, i + 2));
        SB();
        ST(code);
        SA(" { rt_int mi = ");
        ST(d);
        SA(", mj = ");
        ST(b);
        SA("; y_move(&");
        ST(a);
        SA(", ");
        ST(t);
        SA(", ");
        ST(c);
        SA(", mi, mj, ");
        ST(DescOf(ra^.elem));
        SA("); if (mj >= mi) ");
        ST(t);
        SA(" += mj - mi + 1; }");
        code := SE();
        i := i + 3
      ENDWHILE;
      code := Join(code, T(" })"), 0);
      RETURN
    ENDIF;
    IF (f = F_AND_LONG) OR (f = F_OR_LONG) THEN
      (* both operands are evaluated (XI, p.1062) *)
      NArgs(n, 2);
      a := Cond(Arg(n, 1));
      b := Cond(Arg(n, 2));
      r := RBool;
      IF f = F_AND_LONG THEN code := Infix(Paren(Infix(a, "!=", T("0"))), "&", Paren(Infix(b, "!=", T("0"))))
      ELSE code := Infix(Paren(Infix(a, "!=", T("0"))), "|", Paren(Infix(b, "!=", T("0"))))
      ENDIF;
      RETURN
    ENDIF;
    IF f = F_DELAY THEN
      NArgs(n, 1);
      code := Call1("rt_delay", IntArg(Arg(n, 1)));
      RETURN
    ENDIF;
    IF f = F_CLOCK_TIME THEN
      NArgs(n, 0);
      r := Unbounded(RInt);
      code := T("rt_time()");
      RETURN
    ENDIF;
    IF (f = F_WAIT) OR (f = F_SEND) OR (f = F_AWAITED) THEN
      StdVar(Arg(n, 1), R_SIGNAL, a, ra);
      IF f = F_WAIT THEN
        (* WAIT(s) is WAIT(s, 1) *)
        IF Count(n^.a) = 1 THEN b := T("1") ELSE
          NArgs(n, 2);
          b := IntArg(Arg(n, 2))
        ENDIF;
        code := Call2("y_wait", Addr(a), b)
      ELSE
        NArgs(n, 1);
        IF f = F_SEND THEN code := Call1("y_send", Addr(a))
        ELSE
          r := RBool;
          code := Call1("y_awaited", Addr(a))
        ENDIF
      ENDIF;
      RETURN
    ENDIF;
    IF (f = F_FLOOR) OR (f = F_CEILING) OR (f = F_NEAR_INTEGER) THEN
      NArgs(n, 1);
      NumArg(Arg(n, 1), a, ra);
      r := Unbounded(RInt);
      IF ra^.kind = R_INT THEN code := a
      ELSIF f = F_FLOOR THEN code := Call1("y_floor", a)
      ELSIF f = F_CEILING THEN code := Call1("y_ceiling", a)
      ELSE code := Call1("y_near_integer", a)
      ENDIF;
      RETURN
    ENDIF;
    IF f = F_NEAR_FLOATING THEN
      NArgs(n, 1);
      NumArg(Arg(n, 1), a, ra);
      r := RFloat;
      code := Join(T("((double)("), a, T("))"));
      RETURN
    ENDIF;
    IF f = F_NEAR_FIXED THEN
      NArgs(n, 2);
      NumArg(Arg(n, 1), a, ra);
      NumArg(Arg(n, 2), b, rb);
      r := RFixed;
      code := Call2("y_near_fixed", Join(T("(double)("), a, T(")")), b);
      RETURN
    ENDIF;
    IF f = F_FIXED_DIV THEN
      NArgs(n, 3);
      NumArg(Arg(n, 1), a, ra);
      NumArg(Arg(n, 2), b, rb);
      NumArg(Arg(n, 3), c, rc);
      r := RFixed;
      code := Join(T("y_fixed_div("), a, Join(T(", "), b, Join(T(", "), c, T(")"))));
      RETURN
    ENDIF;
    IF (f = F_CLAIM) OR (f = F_RELEASE) OR (f = F_COND_CLAIM) THEN
      NArgs(n, 1);
      StdVar(Arg(n, 1), R_SEM, a, ra);
      IF f = F_CLAIM THEN code := Call1("rt_region_enter", Addr(a))
      ELSIF f = F_RELEASE THEN code := Call1("rt_region_leave", Addr(a))
      ELSE
        r := RBool;
        code := Call1("y_cond_claim", Addr(a))
      ENDIF;
      RETURN
    ENDIF;
    IF f = F_PROCESS_IDENTITY THEN
      NArgs(n, 0);
      r := Unbounded(RInt);
      code := T("y_self()");
      RETURN
    ENDIF;
    IF f = F_CHANGE_PRIORITY THEN
      NArgs(n, 2);
      code := Call2("y_change_priority", IntArg(Arg(n, 1)), IntArg(Arg(n, 2)));
      RETURN
    ENDIF;
    IF f = F_RAISE_TERM THEN
      NArgs(n, 1);
      code := Call1("y_raise_termination", IntArg(Arg(n, 1)));
      RETURN
    ENDIF;
    IF f = F_CODE_INSERT THEN
      NArgs(n, 1);
      CodeInsert(n);
      RETURN
    ENDIF;
    IF (f = F_ADDR) OR (f = F_EXTENT) THEN
      NArgs(n, 1);
      Expr(Arg(n, 1), Rep NIL, a, ra);
      r := Unbounded(RInt);
      IF f = F_ADDR THEN code := Join(T("((rt_int)(intptr_t)&("), a, T("))"))
      ELSE code := Join(T("((rt_int)sizeof("), a, T("))"))
      ENDIF;
      RETURN
    ENDIF;
    FailN(n^.line, n^.name, " is not translated");
    RETURN
  ENDPROCEDURE StdCall;

  (* ---- the standard environment (Sections VI, XI, XII, XIV) -------------------- *)

  VAR
    ROpenMode: Rep;
    Program: Node;

  PROCEDURE StdRep (CONST name: ARRAY (1 DIMENSIONS OF ASCII); CONST r: Rep)
    VAR s: Sym := NewSym(S_TYPE, N(name));
    s^.rep := r;
    Define(s, 0);
    RETURN
  ENDPROCEDURE StdRep;

  PROCEDURE StdOp (CONST name: ARRAY (1 DIMENSIONS OF ASCII); CONST code: INT)
    VAR s: Sym := NewSym(S_STD, N(name));
    s^.mval := code;
    Define(s, 0);
    RETURN
  ENDPROCEDURE StdOp;

  PROCEDURE LitList RETURNS Node (CONST a, b, c: ARRAY (1 DIMENSIONS OF ASCII); CONST three: BOOLEAN)
    VAR head, tail, n: Node := Node NIL;
    n := NewNode(N_NAMEL, 0);
    n^.name := N(a);
    Link(head, tail, n);
    n := NewNode(N_NAMEL, 0);
    n^.name := N(b);
    Link(head, tail, n);
    IF three THEN
      n := NewNode(N_NAMEL, 0);
      n^.name := N(c);
      Link(head, tail, n)
    ENDIF;
    RETURN head
  ENDPROCEDURE LitList;

  PROCEDURE Abstract RETURNS Rep (CONST kind: INT; CONST name: ARRAY (1 DIMENSIONS OF ASCII))
    VAR r: Rep := NewRep(kind, N(name));
    r^.abstract := TRUE;
    RETURN r
  ENDPROCEDURE Abstract;

  PROCEDURE Predefine ()
    OpenScope(FALSE);
    ProcList[Depth] := Node NIL;
    RInt := Abstract(R_INT, "INTEGER");
    RFixed := Abstract(R_FIXED, "FIXED");
    RFloat := Abstract(R_FLOAT, "FLOATING");
    RSignal := NewRep(R_SIGNAL, N("SIGNAL"));
    RSem := NewRep(R_SEM, N("SEMAPHORE"));
    RVoid := NewRep(R_VOID, N("no value"));
    RAny := NewRep(R_ANY, N("any"));
    (* BOOLEAN is UNORDERED(FALSE, TRUE) (VI.A.2.a) *)
    RBool := NewRep(R_BOOL, N("BOOLEAN"));
    RBool^.lits := LitList("FALSE", "TRUE", "", FALSE);
    RBool^.nlits := 2;
    SetRange(RBool, 0, 1);
    DefineLits(RBool);
    (* the implementation's standard alphabet: ASCII in its order *)
    RAscii := NewRep(R_ALPHA, N("ASCII"));
    RAscii^.ordered := TRUE;
    RAscii^.nlits := 128;
    SetRange(RAscii, 0, 127);
    (* OPEN_MODE = UNORDERED(READ, WRITE, APPEND) (XII.A) *)
    ROpenMode := NewRep(R_ENUM, N("OPEN_MODE"));
    ROpenMode^.lits := LitList("READ", "WRITE", "APPEND", TRUE);
    ROpenMode^.nlits := 3;
    SetRange(ROpenMode, 0, 2);
    DefineLits(ROpenMode);
    StdRep("INTEGER", RInt);
    StdRep("FIXED", RFixed);
    StdRep("FLOATING", RFloat);
    StdRep("BOOLEAN", RBool);
    StdRep("SIGNAL", RSignal);
    StdRep("SEMAPHORE", RSem);
    StdRep("ASCII", RAscii);
    StdRep("STANDARD_ALPHABET", RAscii);
    StdRep("OPEN_MODE", ROpenMode);
    StdOp("LOW", F_LOW);
    StdOp("HIGH", F_HIGH);
    StdOp("SUCC", F_SUCC);
    StdOp("PRED", F_PRED);
    StdOp("FIRST", F_FIRST);
    StdOp("LAST", F_LAST);
    StdOp("NEW", F_NEW);
    StdOp("OPEN", F_OPEN);
    StdOp("CLOSE", F_CLOSE);
    StdOp("GET", F_GET);
    StdOp("PUT", F_PUT);
    StdOp("CHECK_EOF", F_CHECK_EOF);
    StdOp("MOVE", F_MOVE);
    StdOp("AND_LONG", F_AND_LONG);
    StdOp("OR_LONG", F_OR_LONG);
    StdOp("DELAY", F_DELAY);
    StdOp("CLOCK_TIME", F_CLOCK_TIME);
    StdOp("WAIT", F_WAIT);
    StdOp("SEND", F_SEND);
    StdOp("AWAITED", F_AWAITED);
    StdOp("FLOOR", F_FLOOR);
    StdOp("CEILING", F_CEILING);
    StdOp("NEAR_INTEGER", F_NEAR_INTEGER);
    StdOp("NEAR_FIXED", F_NEAR_FIXED);
    StdOp("NEAR_FLOATING", F_NEAR_FLOATING);
    StdOp("FIXED_DIV", F_FIXED_DIV);
    StdOp("CLAIM", F_CLAIM);
    StdOp("RELEASE", F_RELEASE);
    StdOp("CONDITIONAL_CLAIM", F_COND_CLAIM);
    StdOp("PROCESS_IDENTITY", F_PROCESS_IDENTITY);
    StdOp("CHANGE_PRIORITY", F_CHANGE_PRIORITY);
    StdOp("RAISE_PROCESS_TERMINATION", F_RAISE_TERM);
    StdOp("FREE_POINTER", F_FREE_POINTER);
    StdOp("C_CODE_INSERT", F_CODE_INSERT);
    StdOp("ADDR", F_ADDR);
    StdOp("EXTENT", F_EXTENT);
    RETURN
  ENDPROCEDURE Predefine;

  (* the program: its segments, as the modules of one block (XIII.A) *)
  PROCEDURE Translate ()
    VAR m: Node := Program;
    OpenScope(FALSE);
    ProcList[Depth] := Node NIL;
    Level := 0;
    WHILE m # Node NIL DO
      CompileModule(m);
      m := m^.next
    ENDWHILE;
    AwaitProcesses();
    RETURN
  ENDPROCEDURE Translate;

  PROCEDURE WriteProgram ()
    PutS(OInit, "static void y_elaborate(void) {");
    Append(OInit, Body);
    PutS(OInit, "}");
    PutS(OInit, "int main(int argc, char **argv) {");
    PutS(OInit, "y_lang();");
    PutS(OInit, "rt_init(argc, argv);");
    PutS(OInit, "y_elaborate();");
    PutS(OInit, "rt_main_done();");
    PutS(OInit, "return 0;");
    PutS(OInit, "}");
    WriteTxt(T("#include 'DQ'paleo.h'DQ'"));
    PUT(Output, 'LF');
    WriteTxt(T("#include <math.h>"));
    PUT(Output, 'LF');
    WriteTxt(T("#include <string.h>"));
    PUT(Output, 'LF');
    WriteTxt(T("#include <stdlib.h>"));
    PUT(Output, 'LF');
    WriteBuf(OTypes);
    WriteBuf(OStructs);
    WriteBuf(OFrames);
    WriteBuf(OGlobals);
    WriteBuf(OProtos);
    WriteBuf(OFuncs);
    WriteBuf(OInit);
    RETURN
  ENDPROCEDURE WriteProgram;

  (* ---- the translator --------------------------------------------------------- *)

  InitChars();
  InitWords();
  FromWord := N("FROM");
  DimensionWord := N("DIMENSION");
  CharNames := T("NUL SOH STX ETX EOT ENQ ACK BEL BS HT LF VT FF CR SO SI DLE DC1 DC2 DC3 DC4 NAK SYN ETB CAN EM SUB ESC FS GS RS US SP DEL SQ DQ ");
  OPEN(Output, "OUTPUT", WRITE);
  ReadSource();
  Lex();
  Program := ParseProgram();
  Predefine();
  Translate();
  WriteProgram();
  CLOSE(Output)
ENDMODULE yellowc
