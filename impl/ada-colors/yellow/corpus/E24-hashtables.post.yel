
(* a user of the module of p.1117 *)
MODULE UseTable
  IMPORT NumberTableImplementation, TextIO, MyStandardConventions;
  (* the table starts empty through Clear, added to the module: a variable *)
  (* is undefined until it is assigned *)
  VAR t: NumberTable;
  Clear(t);
  FOR i: INTEGER [1..5] DO
    IF NOT Insert(i * 1000, t) THEN Write("full") ENDIF
  ENDFOR;
  Write(Search(3000, t)); Write(Search(3001, t));
  Delete(3000, t);
  Write(Search(3000, t)); Write(Search(4000, t));
  IF Insert(3000, t) THEN Write(Search(3000, t)) ENDIF;
  WriteLn()
ENDMODULE UseTable
