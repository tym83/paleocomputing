;
INSTANCE ConvexHullTemplate(8);
VAR ok: BOOLEAN;
reset();
ok := addpoint(0.0, 0.0);
ok := addpoint(4.0, 0.0);
ok := addpoint(4.0, 4.0);
ok := addpoint(0.0, 4.0);
ok := addpoint(2.0, 2.0);
ok := addpoint(1.0, 3.0);
ok := addpoint(2.0, 5.0);
ok := addpoint(3.0, 1.0);
Write(addpoint(9.0, 9.0)); WriteLn();
convexhull();
FOR i: INTEGER [1..8] DO
  SELECT getstatus(i)
    CASE inside => Write("i")
    CASE onhull => Write("H")
    CASE unknown => Write("?")
  ENDSELECT
ENDFOR;
WriteLn()
ENDMODULE Hulls
