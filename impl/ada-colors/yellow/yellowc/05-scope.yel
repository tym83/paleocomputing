
  (* ---- entities and scopes (VII.J, X.B) ------------------------------------ *)
  (* Every name is kept in a hash table of chains; a scope is a level of the *)
  (* scope stack. A module is a closed scope: inside it only its own names, *)
  (* the names it imports and the standard names are visible (X.B.2), so *)
  (* the search stops at the module and goes on in the standard scope. *)

  PROCEDURE NewSym RETURNS Sym (CONST kind: INT; CONST name: Txt)
    VAR s: Sym;
    NEW(s);
    s^ := SymRec(kind, name, Rep NIL, 0, 0, FALSE, FALSE, 0, FALSE, Param NIL, 0, Rep NIL,
                 FALSE, Node NIL, 0, Sym NIL, Sym NIL, Sym NIL, Sym NIL, Sym NIL, Sym NIL,
                 Sym NIL, 0, Node NIL, Node NIL, Node NIL, 0, 0);
    s^.serial := NewSerial();
    RETURN s
  ENDPROCEDURE NewSym;

  PROCEDURE OpenScope (CONST closed: BOOLEAN)
    VAR s: Scope;
    NEW(s);
    s^ := ScopeRec(Sym NIL, closed, Sym NIL, Level, Node NIL, Scope NIL);
    IF Depth >= 0 THEN s^.up := Scopes[Depth] ENDIF;
    Depth := Depth + 1;
    Scopes[Depth] := s;
    DeclCursor[Depth] := Node NIL;
    RETURN
  ENDPROCEDURE OpenScope;

  (* put a closed scope back, its names visible again: the bodies of the *)
  (* routines of a module are written after the declarations of the scope *)
  (* around it (X.G) *)
  PROCEDURE ReopenScope (CONST sc: Scope)
    VAR p: Sym := sc^.syms;
        n: INT := 0;
        h: INT;
    Depth := Depth + 1;
    Scopes[Depth] := sc;
    DeclCursor[Depth] := Node NIL;
    WHILE p # Sym NIL DO
      n := n + 1;
      ReopenBuf[n] := p;
      p := p^.stack
    ENDWHILE;
    (* the oldest first, so that the newest of a name is found first *)
    WHILE n > 0 DO
      p := ReopenBuf[n];
      h := p^.name MOD 8192;
      p^.chain := Table[h];
      Table[h] := p;
      n := n - 1
    ENDWHILE;
    RETURN
  ENDPROCEDURE ReopenScope;

  (* take the names of the innermost scope out of the table *)
  PROCEDURE CloseScope ()
    VAR s, p, prev: Sym;
        h: INT;
    s := Scopes[Depth]^.syms;
    WHILE s # Sym NIL DO
      h := s^.name MOD 8192;
      p := Table[h];
      prev := Sym NIL;
      WHILE (p # Sym NIL) AND (p # s) DO
        prev := p;
        p := p^.chain
      ENDWHILE;
      IF p = s THEN
        IF prev = Sym NIL THEN Table[h] := s^.chain ELSE prev^.chain := s^.chain ENDIF
      ENDIF;
      s := s^.stack
    ENDWHILE;
    Depth := Depth - 1;
    RETURN
  ENDPROCEDURE CloseScope;

  PROCEDURE Visible RETURNS BOOLEAN (CONST s: Sym)
    RETURN (s^.depth >= VisibleFrom) OR (s^.depth = 0)
  ENDPROCEDURE Visible;

  (* the entity a name denotes here, or NIL *)
  PROCEDURE Find RETURNS Sym (CONST name: Txt)
    VAR s: Sym := Table[name MOD 8192];
    WHILE s # Sym NIL DO
      IF (s^.name = name) AND Visible(s) THEN RETURN s ENDIF;
      s := s^.chain
    ENDWHILE;
    RETURN Sym NIL
  ENDPROCEDURE Find;

  (* the entity named in this very scope, or NIL *)
  PROCEDURE FindHere RETURNS Sym (CONST name: Txt)
    VAR s: Sym := Table[name MOD 8192];
    WHILE s # Sym NIL DO
      IF (s^.name = name) AND (s^.depth = Depth) THEN RETURN s ENDIF;
      s := s^.chain
    ENDWHILE;
    RETURN Sym NIL
  ENDPROCEDURE FindHere;

  (* two modules of one scope may export the same name: it can then be *)
  (* used only through FROM (X.B.4, p.1053) *)
  PROCEDURE Lookup RETURNS Sym (CONST name: Txt; CONST line: INT)
    VAR s: Sym := Find(name);
        p: Sym;
    (* a name declared later in the declarations being read is that *)
    (* declaration, used before it is declared (VII.I) *)
    IF DeclCursor[Depth] # Node NIL THEN
      IF (s = Sym NIL) OR (s^.depth # Depth) THEN
        IF DeclaredFrom(DeclCursor[Depth], name) THEN
          FailN(line, name, " is used before its declaration in this scope (VII.I)")
        ENDIF
      ENDIF
    ENDIF;
    IF s = Sym NIL THEN FailN(line, name, " is not declared here") ENDIF;
    (* the body of a routine depends only on the simple declarations of its *)
    (* scope that precede it (X.G) *)
    FOR i: INTEGER [1..OTop] DO
      IF (s^.depth = OrderDepth[i]) AND (s^.serial > OrderSerial[i]) AND IsSimple(s^.kind) THEN
        FailN(line, name, " is declared after the routine that uses it: a simple declaration precedes the routines that use it (X.G)")
      ENDIF
    ENDFOR;
    IF s^.kind = S_EXPORT THEN
      p := s^.chain;
      WHILE p # Sym NIL DO
        IF (p^.name = name) AND (p^.depth = s^.depth) AND (p^.kind = S_EXPORT) AND Resolved(p) AND
           (Real(p) # Real(s)) AND (Real(s)^.kind # S_LIT) THEN
          FailN(line, name, " is exported here by two modules: name it with FROM (X.B.4)")
        ENDIF;
        p := p^.chain
      ENDWHILE
    ENDIF;
    RETURN s
  ENDPROCEDURE Lookup;

  FUNCTION IsSimple RETURNS BOOLEAN (CONST k: INT)
    RETURN (k = S_VAR) OR (k = S_CONST) OR (k = S_REP) OR (k = S_TYPE) OR (k = S_LIT) OR (k = S_LABEL)
  ENDFUNCTION IsSimple;

  (* is name declared by one of the declarations from d on: names of *)
  (* constants, variables, labels, types, representations, routines, *)
  (* modules and what they export, enumeration literals *)
  PROCEDURE DeclaredFrom RETURNS BOOLEAN (CONST d0: Node; CONST name: Txt)
    VAR d, nm: Node := d0;
        k: INT;
    WHILE d # Node NIL DO
      k := d^.kind;
      IF (k = N_CONST) OR (k = N_VAR) OR (k = N_LABEL) THEN
        nm := d^.a;
        WHILE nm # Node NIL DO
          IF nm^.name = name THEN RETURN TRUE ENDIF;
          nm := nm^.next
        ENDWHILE
      ENDIF;
      IF (k = N_TYPE) OR (k = N_REPDECL) OR (k = N_ROUTINE) OR (k = N_PROCESS) OR (k = N_MODULE) OR
         (k = N_TEMPLATE) THEN
        IF d^.name = name THEN RETURN TRUE ENDIF
      ENDIF;
      IF (k = N_CONST) OR (k = N_VAR) OR (k = N_TYPE) OR (k = N_REPDECL) THEN
        IF LiteralIn(d^.b, name) THEN RETURN TRUE ENDIF
      ENDIF;
      IF k = N_MODULE THEN
        nm := d^.b;
        WHILE nm # Node NIL DO
          IF (nm^.ival = name) OR ((nm^.ival = 0) AND (nm^.name = name)) THEN RETURN TRUE ENDIF;
          nm := nm^.next
        ENDWHILE
      ENDIF;
      d := d^.next
    ENDWHILE;
    RETURN FALSE
  ENDPROCEDURE DeclaredFrom;

  (* is name a literal of an enumeration written in the representation n *)
  PROCEDURE LiteralIn RETURNS BOOLEAN (CONST n: Node; CONST name: Txt)
    VAR p: Node;
    IF n = Node NIL THEN RETURN FALSE ENDIF;
    IF n^.kind = N_RENUM THEN
      p := n^.a;
      WHILE p # Node NIL DO
        IF p^.name = name THEN RETURN TRUE ENDIF;
        p := p^.next
      ENDWHILE;
      RETURN FALSE
    ENDIF;
    IF n^.kind = N_RARRAY THEN
      p := n^.a;
      WHILE p # Node NIL DO
        IF LiteralIn(p, name) THEN RETURN TRUE ENDIF;
        p := p^.next
      ENDWHILE;
      RETURN LiteralIn(n^.b, name)
    ENDIF;
    IF n^.kind = N_RRECORD THEN
      p := n^.a;
      WHILE p # Node NIL DO
        IF LiteralIn(p^.b, name) THEN RETURN TRUE ENDIF;
        p := p^.next
      ENDWHILE;
      IF n^.b # Node NIL THEN
        IF LiteralIn(n^.b^.b, name) THEN RETURN TRUE ENDIF;
        p := n^.b^.a;
        WHILE p # Node NIL DO
          IF LiteralInGroups(p^.b, name) THEN RETURN TRUE ENDIF;
          p := p^.next
        ENDWHILE
      ENDIF;
      RETURN FALSE
    ENDIF;
    IF (n^.kind = N_RFILE) OR (n^.kind = N_RSET) THEN RETURN LiteralIn(n^.a, name) ENDIF;
    RETURN FALSE
  ENDPROCEDURE LiteralIn;

  PROCEDURE LiteralInGroups RETURNS BOOLEAN (CONST g0: Node; CONST name: Txt)
    VAR g: Node := g0;
    WHILE g # Node NIL DO
      IF LiteralIn(g^.b, name) THEN RETURN TRUE ENDIF;
      g := g^.next
    ENDWHILE;
    RETURN FALSE
  ENDPROCEDURE LiteralInGroups;

  (* an import of a name that a declaration translated later provides: *)
  (* known by its alias without a target until then (X.G) *)
  FUNCTION Resolved RETURNS BOOLEAN (CONST s: Sym)
    IF s^.kind # S_EXPORT THEN RETURN TRUE ENDIF;
    IF s^.target = Sym NIL THEN RETURN FALSE ENDIF;
    RETURN Resolved(s^.target)
  ENDFUNCTION Resolved;

  (* an enumeration literal named in more than one visible type must be *)
  (* qualified by its type (VI.A.3) *)
  PROCEDURE Ambiguous RETURNS BOOLEAN (CONST s: Sym)
    VAR p: Sym := s^.chain;
    WHILE p # Sym NIL DO
      IF (p^.name = s^.name) AND Visible(p) AND (p^.kind = S_LIT) AND (p^.rep^.tid # s^.rep^.tid) THEN
        RETURN TRUE
      ENDIF;
      p := p^.chain
    ENDWHILE;
    RETURN FALSE
  ENDPROCEDURE Ambiguous;

  (* the literal name of the enumeration rep, among the visible ones *)
  PROCEDURE FindLit RETURNS Sym (CONST name: Txt; CONST r: Rep)
    VAR s: Sym := Table[name MOD 8192];
    WHILE s # Sym NIL DO
      IF (s^.name = name) AND Resolved(s) THEN
        IF (Real(s)^.kind = S_LIT) AND (Real(s)^.rep^.tid = r^.tid) THEN RETURN s ENDIF
      ENDIF;
      s := s^.chain
    ENDWHILE;
    RETURN Sym NIL
  ENDPROCEDURE FindLit;

  PROCEDURE Define (CONST s: Sym; CONST line: INT)
    VAR old: Sym := FindHere(s^.name);
        h: INT := s^.name MOD 8192;
    IF (old # Sym NIL) AND NOT ((old^.kind = S_LIT) AND (s^.kind = S_LIT)) AND
       NOT ((s^.kind = S_ROUTINE) AND (s^.alt # Sym NIL) AND Resolved(old) AND (s^.alt = Real(old))) AND
       NOT ((s^.kind = S_EXPORT) AND (old^.kind = S_EXPORT)) THEN
      FailN(line, s^.name, " is declared twice in this scope")
    ENDIF;
    s^.depth := Depth;
    s^.chain := Table[h];
    Table[h] := s;
    s^.stack := Scopes[Depth]^.syms;
    Scopes[Depth]^.syms := s;
    RETURN
  ENDPROCEDURE Define;

  (* ---- storage and the frames of routines ------------------------------------ *)
  (* Each routine (and process) has a frame, a C struct with its parameters *)
  (* and locals and a link "up" to the frame of the routine around it. Level *)
  (* 0 is the global level: its storage is C globals. *)

  (* the C text that reaches storage cname held at level lev *)
  PROCEDURE Path RETURNS Txt (CONST lev: INT; CONST cname: Txt)
    VAR hops: INT := Level - lev;
    IF lev = 0 THEN RETURN cname ENDIF;
    SB();
    IF hops = 0 THEN
      SA("F.")
    ELSE
      SA("F.up->");
      WHILE hops > 1 DO
        SA("up->");
        hops := hops - 1
      ENDWHILE
    ENDIF;
    ST(cname);
    RETURN SE()
  ENDPROCEDURE Path;

  (* the C text of a pointer to the frame of level lev, from here *)
  PROCEDURE FramePtr RETURNS Txt (CONST lev: INT)
    VAR hops: INT := Level - lev;
    IF hops = 0 THEN RETURN T("&F") ENDIF;
    SB();
    SA("F.up");
    WHILE hops > 1 DO
      SA("->up");
      hops := hops - 1
    ENDWHILE;
    RETURN SE()
  ENDPROCEDURE FramePtr;

  (* declare storage of C type ct named cname at the current level *)
  PROCEDURE DeclStorage (CONST ct, cname: Txt)
    VAR t: Txt;
    SB();
    IF Level = 0 THEN SA("static ") ENDIF;
    ST(ct);
    SA(" ");
    ST(cname);
    SA(";");
    t := SE();
    IF Level = 0 THEN Put(OGlobals, t) ELSE Put(Locals, t) ENDIF;
    RETURN
  ENDPROCEDURE DeclStorage;

  (* the access path of a variable, constant or parameter *)
  PROCEDURE SymPath RETURNS Txt (CONST s: Sym)
    VAR p: Txt := Path(s^.level, s^.cname);
    IF s^.byref THEN
      SB();
      SA("(*");
      ST(p);
      SA(")");
      RETURN SE()
    ENDIF;
    RETURN p
  ENDPROCEDURE SymPath;

  (* follow imports and renamings to the entity itself *)
  PROCEDURE Real RETURNS Sym (CONST s: Sym)
    VAR p: Sym := s;
    WHILE p^.kind = S_EXPORT DO
      IF p^.target = Sym NIL THEN
        FailN(CurLine, p^.name, " is imported from a declaration translated later: until then only the bodies of routines may use it (X.G)")
      ENDIF;
      p := p^.target
    ENDWHILE;
    RETURN p
  ENDPROCEDURE Real;
