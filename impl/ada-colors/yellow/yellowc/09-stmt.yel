
  (* ---- statements (Section IX) --------------------------------------------- *)

  PROCEDURE Emit2 (CONST a: ARRAY (1 DIMENSIONS OF ASCII); CONST b: Txt)
    VAR t: Txt;
    SB();
    SA(a);
    ST(b);
    t := SE();
    Emit(t);
    RETURN
  ENDPROCEDURE Emit2;

  PROCEDURE Emit3 (CONST a: ARRAY (1 DIMENSIONS OF ASCII); CONST b: Txt;
                   CONST c: ARRAY (1 DIMENSIONS OF ASCII))
    VAR t: Txt;
    SB();
    SA(a);
    ST(b);
    SA(c);
    t := SE();
    Emit(t);
    RETURN
  ENDPROCEDURE Emit3;

  (* leave the handler frames entered after the first depth of them *)
  PROCEDURE PopTo (CONST depth: INT)
    IF XTop > depth THEN Emit3("rt_xtop = ", XFrames[depth + 1], ".prev;") ENDIF;
    RETURN
  ENDPROCEDURE PopTo;

  (* PROPAGATE_EXCEPTION and ASSERT end the block they are in: its own *)
  (* handler does not see them (IX.A.8, p.1039; X.F, p.1058) *)
  PROCEDURE LeaveBlock ()
    IF BTop > 0 THEN
      IF BlockFrame[BTop] # 0 THEN Emit3("rt_xtop = ", BlockFrame[BTop], ".prev;") ENDIF
    ENDIF;
    RETURN
  ENDPROCEDURE LeaveBlock;

  PROCEDURE RaiseCode RETURNS Txt (CONST name: Txt)
    SB();
    SA("rt_raise(rt_exc(");
    SC('DQ');
    ST(name);
    SC('DQ');
    SA("));");
    RETURN SE()
  ENDPROCEDURE RaiseCode;

  (* the statements of a block and its exception handler (X.F) *)
  PROCEDURE BlockStatements (CONST b: Node)
    VAR saveSupp: INT := Supp;
    BlockStatements1(b);
    Supp := saveSupp;
    RETURN
  ENDPROCEDURE BlockStatements;

  PROCEDURE BlockStatements1 (CONST b: Node)
    VAR f, xc, t: Txt;
        c, nm: Node;
        first: BOOLEAN;
        d: Node := b^.a;
        xs: Txt := 0;
    (* a block with labels notes the handler frames at its start: a GOTO *)
    (* to one of its statements leaves the frames entered since *)
    WHILE d # Node NIL DO
      IF (d^.kind = N_LABEL) AND (xs = 0) THEN
        xs := Fresh("xs");
        Emit3("rt_frame *", xs, " = rt_xtop;")
      ENDIF;
      d := d^.next
    ENDWHILE;
    IF b^.b = Node NIL THEN
      BTop := BTop + 1;
      BlockFrame[BTop] := 0;
      BlockXs[BTop] := xs;
      Statements(b^.c);
      BTop := BTop - 1;
      CheckLabels(b^.a);
      RETURN
    ENDIF;
    HasHandler := TRUE;
    f := Fresh("xf");
    Emit3("{ rt_frame ", f, ";");
    Emit3("if (RT_TRY(", f, ")) {");
    XTop := XTop + 1;
    XFrames[XTop] := f;
    BTop := BTop + 1;
    BlockFrame[BTop] := f;
    BlockXs[BTop] := xs;
    Statements(b^.c);
    BTop := BTop - 1;
    XTop := XTop - 1;
    CheckLabels(b^.a);
    Emit3("RT_POP(", f, ");");
    EmitS("} else {");
    Emit3("RT_POP(", f, ");");
    IF Level > 0 THEN EmitS("y_use = F.yu + (rt_int)((sizeof F + 7) / 8);") ELSE EmitS("y_use = 0;") ENDIF;
    xc := Fresh("xc");
    Emit3("int ", xc, " = rt_xcur;");
    BTop := BTop + 1;
    BlockFrame[BTop] := 0;
    BlockXs[BTop] := 0;
    HTop := HTop + 1;
    HandlerXc[HTop] := xc;
    first := TRUE;
    c := b^.b^.a;
    WHILE c # Node NIL DO
      SB();
      IF first THEN SA("if (") ELSE SA("} else if (") ENDIF;
      first := FALSE;
      nm := c^.a;
      WHILE nm # Node NIL DO
        ST(xc);
        SA(" == rt_exc(");
        SC('DQ');
        ST(nm^.name);
        SC('DQ');
        SA(")");
        IF nm^.next # Node NIL THEN SA(" || ") ENDIF;
        nm := nm^.next
      ENDWHILE;
      SA(") {");
      t := SE();
      Emit(t);
      Statements(c^.b);
      c := c^.next
    ENDWHILE;
    IF NOT first THEN EmitS("} else {") ENDIF;
    IF b^.b^.flag = 1 THEN
      Statements(b^.b^.b)
    ELSE
      (* no ELSE: the same exception goes on (p.1059) *)
      Emit3("rt_raise(", xc, ");")
    ENDIF;
    IF NOT first THEN EmitS("}") ENDIF;
    HTop := HTop - 1;
    BTop := BTop - 1;
    EmitS("}}");
    RETURN
  ENDPROCEDURE BlockStatements1;

  (* do two designators name the same variable: the same names, components *)
  (* and pointers, subscripts that are the same constants or names *)
  PROCEDURE SameDesig RETURNS BOOLEAN (CONST a, b: Node)
    VAR p, q: Node;
        oa, ob: BOOLEAN;
        va, vb: INT;
    IF a^.kind = N_PAREN THEN RETURN SameDesig(a^.a, b) ENDIF;
    IF b^.kind = N_PAREN THEN RETURN SameDesig(a, b^.a) ENDIF;
    IF a^.kind # b^.kind THEN RETURN FALSE ENDIF;
    IF a^.kind = N_NAME THEN RETURN (a^.name = b^.name) AND (a^.d = Node NIL) AND (b^.d = Node NIL) ENDIF;
    IF a^.kind = N_SEL THEN RETURN (a^.name = b^.name) AND SameDesig(a^.a, b^.a) ENDIF;
    IF a^.kind = N_DEREF THEN RETURN SameDesig(a^.a, b^.a) ENDIF;
    IF a^.kind = N_INDEX THEN
      IF NOT SameDesig(a^.a, b^.a) THEN RETURN FALSE ENDIF;
      p := a^.b;
      q := b^.b;
      WHILE (p # Node NIL) AND (q # Node NIL) DO
        Manifest(p, oa, va);
        Manifest(q, ob, vb);
        IF oa AND ob THEN
          IF va # vb THEN RETURN FALSE ENDIF
        ELSIF NOT SameDesig(p, q) THEN
          RETURN FALSE
        ENDIF;
        p := p^.next;
        q := q^.next
      ENDWHILE;
      RETURN (p = Node NIL) AND (q = Node NIL)
    ENDIF;
    RETURN FALSE
  ENDPROCEDURE SameDesig;

  (* "the designation of a variant record component must be lexically *)
  (* embedded in a SELECT statement that verifies whether the record value *)
  (* has assumed the proper variant structure" (VIII.B): a case of a SELECT *)
  (* on the case-selection component of the same record, whose labels all *)
  (* belong to the component's variant *)
  PROCEDURE CheckVariantSelected (CONST n: Node; CONST r: Rep; CONST f: Field)
    VAR i: INT := STop;
        e, l, fl: Node;
        v, fv: INT;
        ok, found: BOOLEAN;
    WHILE i > 0 DO
      e := SelExpr[i];
      WHILE e^.kind = N_PAREN DO e := e^.a ENDWHILE;
      IF (e^.kind = N_SEL) AND (e^.name = r^.selector^.name) AND SameDesig(e^.a, n^.a) THEN
        l := SelLabels[i];
        IF l = Node NIL THEN
          FailN(n^.line, n^.name, " is a component of a variant: the ELSE of a SELECT does not say which variant the record has (VIII.B)")
        ENDIF;
        WHILE l # Node NIL DO
          v := Label(l, r^.selector^.rep);
          found := FALSE;
          fl := f^.labels;
          WHILE fl # Node NIL DO
            Manifest(fl, ok, fv);
            IF ok AND (fv = v) THEN found := TRUE ENDIF;
            fl := fl^.next
          ENDWHILE;
          IF NOT found THEN
            FailN(n^.line, n^.name, " is not a component of the variant this CASE selects (VIII.B)")
          ENDIF;
          l := l^.next
        ENDWHILE;
        RETURN
      ENDIF;
      i := i - 1
    ENDWHILE;
    FailN(n^.line, n^.name, " is a component of a variant: it is used inside a SELECT on the case-selection component (VIII.B)");
    RETURN
  ENDPROCEDURE CheckVariantSelected;

  (* the CASE labels of a SELECT are distinct values (IX.B.1) *)
  PROCEDURE CheckCaseLabels (CONST s: Node; CONST r: Rep)
    VAR arm, l: Node := s^.b;
        n, v: INT := 0;
    WHILE arm # Node NIL DO
      l := arm^.a;
      WHILE l # Node NIL DO
        v := Label(l, r);
        FOR j: INTEGER [1..n] DO
          IF LabelSeen[j] = v THEN FailS(l^.line, "a CASE label appears twice in this SELECT (IX.B.1)") ENDIF
        ENDFOR;
        IF n < 4096 THEN
          n := n + 1;
          LabelSeen[n] := v
        ENDIF;
        l := l^.next
      ENDWHILE;
      arm := arm^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE CheckCaseLabels;

  (* ---- falling out of the bottom (IX.A.6-7) ---------------------------------- *)
  (* "It is an error to fall out the bottom of a routine": the end of a body *)
  (* that control can reach is an error where the translator sees it. *)
  (* Control reaches the end of a statement sequence unless its last *)
  (* reachable statement ends otherwise: RETURN, TERMINATE_PROCESS, *)
  (* PROPAGATE_EXCEPTION, GOTO, EXIT, a LOOP no EXIT leaves, a WHILE TRUE, *)
  (* and IF and SELECT statements with an ELSE all of whose parts end so. *)

  PROCEDURE Falls RETURNS BOOLEAN (CONST list: Node)
    VAR s: Node := list;
        reach: BOOLEAN := TRUE;
    WHILE s # Node NIL DO
      IF s^.text # 0 THEN reach := TRUE ENDIF;
      IF reach THEN reach := Completes(s) ENDIF;
      s := s^.next
    ENDWHILE;
    RETURN reach
  ENDPROCEDURE Falls;

  PROCEDURE BlockFalls RETURNS BOOLEAN (CONST b: Node)
    VAR c: Node;
    IF Falls(b^.c) THEN RETURN TRUE ENDIF;
    IF b^.b = Node NIL THEN RETURN FALSE ENDIF;
    (* the cases of a handler are terminal sequences of the block (X.F) *)
    c := b^.b^.a;
    WHILE c # Node NIL DO
      IF Falls(c^.b) THEN RETURN TRUE ENDIF;
      c := c^.next
    ENDWHILE;
    IF b^.b^.flag = 1 THEN RETURN Falls(b^.b^.b) ENDIF;
    RETURN FALSE
  ENDPROCEDURE BlockFalls;

  PROCEDURE Completes RETURNS BOOLEAN (CONST s: Node)
    VAR k: INT := s^.kind;
        arm: Node;
        ok: BOOLEAN;
        v: INT;
    IF (k = N_RETURN) OR (k = N_TERMINATE) OR (k = N_PROPAGATE) OR (k = N_GOTO) OR (k = N_EXIT) THEN
      RETURN FALSE
    ENDIF;
    IF k = N_IF THEN
      IF s^.flag # 1 THEN RETURN TRUE ENDIF;
      arm := s^.a;
      WHILE arm # Node NIL DO
        IF Falls(arm^.b) THEN RETURN TRUE ENDIF;
        arm := arm^.next
      ENDWHILE;
      RETURN Falls(s^.b)
    ENDIF;
    IF k = N_SELECT THEN
      IF s^.flag # 1 THEN RETURN TRUE ENDIF;
      arm := s^.b;
      WHILE arm # Node NIL DO
        IF Falls(arm^.b) THEN RETURN TRUE ENDIF;
        arm := arm^.next
      ENDWHILE;
      RETURN Falls(s^.c)
    ENDIF;
    IF k = N_WHILE THEN
      Manifest(s^.a, ok, v);
      RETURN NOT (ok AND (v = 1))
    ENDIF;
    IF k = N_LOOP THEN RETURN Exits(s^.b, s^.name) ENDIF;
    IF k = N_BEGIN THEN RETURN BlockFalls(s^.a) ENDIF;
    RETURN TRUE
  ENDPROCEDURE Completes;

  (* does an EXIT name appear in the statements *)
  PROCEDURE Exits RETURNS BOOLEAN (CONST list: Node; CONST name: Txt)
    VAR s: Node := list;
        arm: Node;
    WHILE s # Node NIL DO
      IF (s^.kind = N_EXIT) AND (s^.name = name) THEN RETURN TRUE ENDIF;
      IF s^.kind = N_IF THEN
        arm := s^.a;
        WHILE arm # Node NIL DO
          IF Exits(arm^.b, name) THEN RETURN TRUE ENDIF;
          arm := arm^.next
        ENDWHILE;
        IF Exits(s^.b, name) THEN RETURN TRUE ENDIF
      ELSIF s^.kind = N_SELECT THEN
        arm := s^.b;
        WHILE arm # Node NIL DO
          IF Exits(arm^.b, name) THEN RETURN TRUE ENDIF;
          arm := arm^.next
        ENDWHILE;
        IF Exits(s^.c, name) THEN RETURN TRUE ENDIF
      ELSIF (s^.kind = N_WHILE) OR (s^.kind = N_FOR) OR (s^.kind = N_LOOP) THEN
        IF Exits(s^.b, name) THEN RETURN TRUE ENDIF
      ELSIF s^.kind = N_BEGIN THEN
        IF Exits(s^.a^.c, name) THEN RETURN TRUE ENDIF;
        IF s^.a^.b # Node NIL THEN
          arm := s^.a^.b^.a;
          WHILE arm # Node NIL DO
            IF Exits(arm^.b, name) THEN RETURN TRUE ENDIF;
            arm := arm^.next
          ENDWHILE;
          IF Exits(s^.a^.b^.b, name) THEN RETURN TRUE ENDIF
        ENDIF
      ENDIF;
      s := s^.next
    ENDWHILE;
    RETURN FALSE
  ENDPROCEDURE Exits;

  PROCEDURE Statements (CONST list: Node)
    VAR s: Node := list;
    WHILE s # Node NIL DO
      Statement(s);
      s := s^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE Statements;

  (* a BOOLEAN expression *)
  PROCEDURE Cond RETURNS Txt (CONST n: Node)
    VAR c: Txt;
        r: Rep;
    Expr(n, RBool, c, r);
    CheckType(n^.line, RBool, r);
    RETURN c
  ENDPROCEDURE Cond;

  (* a CASE label of a SELECT on a value of representation r: the literals *)
  (* of the selector's type need not be visible (VI.A.3 is about values *)
  (* that could be of two types, and here there is one) *)
  PROCEDURE Label RETURNS INT (CONST n: Node; CONST r: Rep)
    VAR ok: BOOLEAN;
        v: INT;
        s: Sym;
        lr: Rep;
        c: Txt;
    IF (n^.kind = N_NAME) AND (n^.d = Node NIL) AND (r^.kind = R_ENUM) THEN
      s := FindLit(n^.name, r);
      IF s # Sym NIL THEN RETURN Real(s)^.mval ENDIF
    ENDIF;
    Expr(n, r, c, lr);
    CheckType(n^.line, r, lr);
    Manifest(n, ok, v);
    IF NOT ok THEN FailS(n^.line, "a CASE label is a manifest constant (IX.B.1)") ENDIF;
    RETURN v
  ENDPROCEDURE Label;

  (* copy the OUT parameters back to their actuals (X.A.2) *)
  PROCEDURE CopyOut ()
    VAR p: Param;
        t: Txt;
    IF CurRoutine = Sym NIL THEN RETURN ENDIF;
    p := CurRoutine^.params;
    WHILE p # Param NIL DO
      IF p^.cls = C_OUT THEN
        SB();
        SA("(*F.");
        ST(p^.cname);
        SA("_o)");
        t := SE();
        IF p^.path # 0 THEN Assign(t, p^.rep, p^.path, p^.rep, 0)
        ELSE Assign(t, p^.rep, Path(Level, p^.cname), p^.rep, 0)
        ENDIF
      ENDIF;
      p := p^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE CopyOut;

  PROCEDURE Statement (CONST s: Node)
    VAR k: INT := s^.kind;
        c, c2, t, lab, v, hi: Txt;
        r, er: Rep;
        arm, l: Node;
        first: BOOLEAN;
        found: BOOLEAN;
        i, val: INT;
        sym: Sym;
    CurLine := s^.line;
    IF s^.text # 0 THEN PlaceLabel(s) ENDIF;
    IF k = N_ASSIGN THEN
      LValue(s^.a, c, r);
      CheckPure(s^.a);
      NoteWrite(s^.a);
      IF (r^.kind = R_SIGNAL) OR HoldsSignal(r) THEN
        FailS(s^.line, "assignment is not defined for signals (VI.A.1.d)")
      ENDIF;
      IF NonAssignable(r) THEN
        FailS(s^.line, "assignment is not defined for files and semaphores, nor what holds them (VII.B)")
      ENDIF;
      Expr(s^.b, r, c2, er);
      t := UserAssign(c, r, c2, er, s^.line);
      IF t # 0 THEN
        Emit(t)
      ELSE
        IF r^.opaque AND ((r^.opaqueops MOD 2) = 0) THEN
          FailN(s^.line, r^.tname, " is opaque here: := is not exported (X.B.3)")
        ENDIF;
        Store(c, r, c2, er, s^.line)
      ENDIF
    ELSIF k = N_CALLST THEN
      sym := Find(s^.a^.name);
      IF sym # Sym NIL THEN sym := Real(sym) ENDIF;
      IF (sym # Sym NIL) AND (sym^.kind = S_PROCESS) THEN
        Activate(s^.a, sym)
      ELSE
        CallExpr(s^.a, Rep NIL, TRUE, c, r);
        Emit2("", c);
        SB();
        ST(c);
        SA(";");
        t := SE();
        Body.tail^.t := t
      ENDIF
    ELSIF k = N_IF THEN
      first := TRUE;
      arm := s^.a;
      WHILE arm # Node NIL DO
        c := Cond(arm^.a);
        IF first THEN Emit3("if (", c, ") {") ELSE Emit3("} else if (", c, ") {") ENDIF;
        first := FALSE;
        Statements(arm^.b);
        arm := arm^.next
      ENDWHILE;
      IF s^.flag = 1 THEN
        EmitS("} else {");
        Statements(s^.b)
      ENDIF;
      EmitS("}")
    ELSIF k = N_WHILE THEN
      c := Cond(s^.a);
      Emit3("while (", c, ") {");
      EmitS("Y_TICK();");
      Statements(s^.b);
      EmitS("}")
    ELSIF k = N_LOOP THEN
      lab := Fresh("yl_");
      LTop := LTop + 1;
      LoopName[LTop] := s^.name;
      LoopLabel[LTop] := lab;
      LoopFrames[LTop] := XTop;
      EmitS("for (;;) {");
      EmitS("Y_TICK();");
      Statements(s^.b);
      EmitS("}");
      Emit3("", lab, ": ;");
      LTop := LTop - 1
    ELSIF k = N_EXIT THEN
      found := FALSE;
      i := LTop;
      WHILE (i > LoopBase) AND NOT found DO
        IF LoopName[i] = s^.name THEN
          found := TRUE;
          PopTo(LoopFrames[i]);
          Emit3("goto ", LoopLabel[i], ";")
        ENDIF;
        i := i - 1
      ENDWHILE;
      IF NOT found THEN FailN(s^.line, s^.name, ": EXIT names no LOOP around it here (IX.A.5)") ENDIF
    ELSIF k = N_FOR THEN
      ForStatement(s)
    ELSIF k = N_SELECT THEN
      Expr(s^.a, Rep NIL, c, r);
      IF NOT IsDiscrete(r) THEN FailS(s^.line, "SELECT on a value that is not integer or scalar") ENDIF;
      CheckCaseLabels(s, r);
      Emit3("switch (", c, ") {");
      arm := s^.b;
      WHILE arm # Node NIL DO
        l := arm^.a;
        WHILE l # Node NIL DO
          val := Label(l, r);
          SB();
          SA("case ");
          SI(val);
          SA(":");
          t := SE();
          Emit(t);
          l := l^.next
        ENDWHILE;
        EmitS("{");
        STop := STop + 1;
        SelExpr[STop] := s^.a;
        SelLabels[STop] := arm^.a;
        Statements(arm^.b);
        STop := STop - 1;
        EmitS("} break;");
        arm := arm^.next
      ENDWHILE;
      (* no case and no ELSE: nothing is done (IX.B.1) *)
      EmitS("default: {");
      STop := STop + 1;
      SelExpr[STop] := s^.a;
      SelLabels[STop] := Node NIL;
      IF s^.flag = 1 THEN Statements(s^.c) ENDIF;
      STop := STop - 1;
      EmitS("} break;");
      EmitS("}")
    ELSIF k = N_RETURN THEN
      ReturnStatement(s)
    ELSIF k = N_PROPAGATE THEN
      IF s^.name = 0 THEN
        IF HTop = 0 THEN FailS(s^.line, "PROPAGATE_EXCEPTION without a name is used in a handler (IX.A.8)") ENDIF;
        Emit3("rt_raise(", HandlerXc[HTop], ");")
      ELSE
        LeaveBlock();
        Emit(RaiseCode(s^.name))
      ENDIF
    ELSIF (k = N_ASSERT) AND Suppressed(T_ASSERTION) THEN
      (* "if the detection of this exception is suppressed, then the *)
      (* assertion has no effect" (IX.A.3) *)
      i := 0
    ELSIF k = N_ASSERT THEN
      i := ImpureCalls;
      c := Cond(s^.a);
      IF ImpureCalls # i THEN
        (* "translators shall give warning if the expression in an *)
        (* assertion statement might have side-effects" (IX.A.3) *)
        Warn(s^.line, T("the expression of this ASSERT calls a procedure: it might have side effects (IX.A.3)"))
      ENDIF;
      Emit3("if (!(", c, ")) {");
      LeaveBlock();
      EmitS("rt_raise(RT_X_ASSERT); }")
    ELSIF k = N_BEGIN THEN
      BeginStatement(s)
    ELSIF k = N_TERMINATE THEN
      TerminateStatement(s)
    ELSIF k = N_GOTO THEN
      GotoStatement(s)
    ELSE
      FailS(s^.line, "not a statement")
    ENDIF;
    RETURN
  ENDPROCEDURE Statement;

  (* FOR Name : Representation DO ... ENDFOR -- the name is a constant of *)
  (* each value of the representation in turn (IX.B.2) *)
  PROCEDURE ForStatement (CONST s: Node)
    VAR r: Rep;
        v, hi, t: Txt;
        sym: Sym;
    r := MakeRep(s^.a, 0, FALSE);
    IF NOT IsDiscrete(r) OR (r^.kind = R_BOOL) OR ((r^.kind = R_ENUM) AND NOT r^.ordered) THEN
      FailS(s^.line, "FOR goes over an ordered scalar or integer representation (IX.B.2)")
    ENDIF;
    CheckRepresented(r, s^.line);
    OpenScope(FALSE);
    sym := NewSym(S_CONST, s^.name);
    sym^.rep := r;
    sym^.level := Level;
    sym^.cname := Fresh("c_");
    DeclStorage(T("rt_int"), sym^.cname);
    Define(sym, s^.line);
    v := Fresh("i");
    hi := Fresh("hi");
    SB();
    SA("{ rt_int ");
    ST(hi);
    SA(" = ");
    ST(HiText(r));
    SA(";");
    t := SE();
    Emit(t);
    SB();
    SA("for (rt_int ");
    ST(v);
    SA(" = ");
    ST(LoText(r));
    SA("; ");
    ST(v);
    SA(" <= ");
    ST(hi);
    SA("; ");
    ST(v);
    SA("++) { ");
    ST(SymPath(sym));
    SA(" = ");
    ST(v);
    SA("; Y_TICK();");
    t := SE();
    Emit(t);
    Statements(s^.b);
    Emit3("if (", v, " == ");
    Body.tail^.t := Join(Body.tail^.t, hi, T(") break;"));
    EmitS("}}");
    CloseScope();
    RETURN
  ENDPROCEDURE ForStatement;

  PROCEDURE Join RETURNS Txt (CONST a, b, c: Txt)
    SB();
    ST(a);
    ST(b);
    ST(c);
    RETURN SE()
  ENDPROCEDURE Join;

  PROCEDURE ReturnStatement (CONST s: Node)
    VAR c, t, tmp: Txt;
        r, ret: Rep;
    IF CurRoutine = Sym NIL THEN FailS(s^.line, "RETURN outside a routine (IX.A.6)") ENDIF;
    IF CurRoutine^.kind = S_PROCESS THEN FailS(s^.line, "a process ends with TERMINATE_PROCESS (IX.A.7)") ENDIF;
    ret := CurRoutine^.ret;
    IF s^.a = Node NIL THEN
      IF ret^.kind # R_VOID THEN FailS(s^.line, "RETURN needs a value here (IX.A.6)") ENDIF;
      CopyOut();
      LeaveMonitor();
      PopTo(XBase);
      EmitS("y_use = F.yu; return;");
      RETURN
    ENDIF;
    IF ret^.kind = R_VOID THEN FailS(s^.line, "this routine returns no value (IX.A.6)") ENDIF;
    Expr(s^.a, ret, c, r);
    CheckType(s^.line, ret, r);
    tmp := Fresh("rv");
    SB();
    SA("{ ");
    ST(CType(ret));
    SA(" ");
    ST(tmp);
    SA(" = ");
    ST(Convert(c, ret, r));
    SA(";");
    t := SE();
    Emit(t);
    CopyOut();
    LeaveMonitor();
    PopTo(XBase);
    Emit3("y_use = F.yu; return ", tmp, "; }");
    RETURN
  ENDPROCEDURE ReturnStatement;

  (* SIMULATED_TIME BEGIN ... END: the block runs as one sequential *)
  (* process, its processes quasi-parallel: none is preempted by a time *)
  (* slice, and only DELAY makes time pass (IX.B.3, X.E.5); an exception *)
  (* that leaves the block leaves the simulation too *)
  PROCEDURE BeginStatement (CONST s: Node)
    VAR f, ys: Txt;
    EmitS("{");
    IF s^.flag = 1 THEN
      f := Fresh("sf");
      ys := Fresh("ys");
      HasHandler := TRUE;
      Emit(Join(T("int "), ys, T(" = y_sim_depth; y_sim_depth++;")));
      Emit(Join(T("rt_frame "), f, T(";")));
      Emit(Join(T("if (!RT_TRY("), f, Join(T(")) { RT_POP("), f, Join(T("); y_sim_depth = "), ys, T("; rt_raise(rt_xcur); }")))));
      XTop := XTop + 1;
      XFrames[XTop] := f
    ENDIF;
    OpenScope(FALSE);
    Declarations(s^.a^.a);
    BlockStatements(s^.a);
    AwaitProcesses();
    CloseScope();
    IF s^.flag = 1 THEN
      XTop := XTop - 1;
      Emit(Join(T("RT_POP("), f, Join(T("); y_sim_depth = "), ys, T(";"))))
    ENDIF;
    EmitS("}");
    RETURN
  ENDPROCEDURE BeginStatement;

  (* ---- labels and GOTO (VII.C, IX.A.4) ------------------------------------------- *)
  (* A label is declared by LABEL at the head of a block and labels a *)
  (* top-level statement of that block; a GOTO leaves lexical scopes but *)
  (* not a routine, process or module. *)

  PROCEDURE PlaceLabel (CONST s: Node)
    VAR sym: Sym := FindHere(s^.text);
    IF (sym = Sym NIL) OR (sym^.kind # S_LABEL) THEN
      FailN(s^.line, s^.text, " labels a statement but is not declared by LABEL in this block (VII.C)")
    ENDIF;
    IF sym^.hasmv THEN FailN(s^.line, s^.text, " labels two statements") ENDIF;
    sym^.hasmv := TRUE;
    Emit3("", sym^.cname, ": ;");
    IF BlockFrame[BTop] # 0 THEN
      Emit3("rt_xtop = &", BlockFrame[BTop], ";")
    ELSIF BlockXs[BTop] # 0 THEN
      Emit3("rt_xtop = ", BlockXs[BTop], ";")
    ENDIF;
    RETURN
  ENDPROCEDURE PlaceLabel;

  PROCEDURE GotoStatement (CONST s: Node)
    VAR sym: Sym := Lookup(s^.name, s^.line);
    IF sym^.kind # S_LABEL THEN FailN(s^.line, s^.name, " is not a label") ENDIF;
    IF sym^.level # Level THEN
      FailN(s^.line, s^.name, ": GOTO does not leave a routine or process (IX.A.4)")
    ENDIF;
    sym^.readonly := TRUE;
    EmitS("Y_TICK();");
    Emit3("goto ", sym^.cname, ";");
    RETURN
  ENDPROCEDURE GotoStatement;

  (* a label that a GOTO names must label a statement *)
  PROCEDURE CheckLabels (CONST decls: Node)
    VAR d: Node := decls;
        nm: Node;
        sym: Sym;
    WHILE d # Node NIL DO
      IF d^.kind = N_LABEL THEN
        nm := d^.a;
        WHILE nm # Node NIL DO
          sym := FindHere(nm^.name);
          IF (sym # Sym NIL) AND (sym^.kind = S_LABEL) AND sym^.readonly AND NOT sym^.hasmv THEN
            FailN(nm^.line, nm^.name, " is the target of a GOTO but labels no statement of its block")
          ENDIF;
          nm := nm^.next
        ENDWHILE
      ENDIF;
      d := d^.next
    ENDWHILE;
    RETURN
  ENDPROCEDURE CheckLabels;
