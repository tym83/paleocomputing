#!/bin/sh
# yc prog.yel [out]: translate a YELLOW program (after the standard prelude)
# with build/yellowc and link it with the runtime.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
src=$1; out=${2:-${1%.yel}}
cat "$here/lib/prelude.yel" "$src" | "$here/build/yellowc" > "$out.c" || { head -3 "$out.c" >&2; exit 1; }
${CC:-cc} -std=gnu11 -O1 -w -I"$here/../rt" "$out.c" "$here/../rt/paleo.c" -o "$out" -lpthread -lm
