-- Contrast 2, failure under a lock, in GREEN (1979). A lock is a server task
-- with SEIZE and RELEASE entries. Worker 1 seizes it and fails halfway; its
-- handler forgets the RELEASE, and nothing else can give it: the server only
-- knows it is waiting for a RELEASE call. Worker 2 waits for ever. (GREEN does
-- raise FAILURE into another task, but no one here knows that worker 1 died.)
restricted(TEXT_IO) procedure FAILURE_DEMO is
   use TEXT_IO;

   BALANCE : INTEGER := 100;
   THROUGH : INTEGER := 0;

   function IMG(N : INTEGER) return STRING is
   begin
      return INTEGER'REP(N);
   end IMG;

   procedure LOG(S : STRING) is
   begin
      PUT("[" & IMG(INTEGER(SYSTEM'CLOCK * 1000.0 / SECONDS)) & " ms] " & S);
      PUT(NEWLINE);
   end LOG;

   task LOCK is
      entry SEIZE;
      entry RELEASE;
   end LOCK;

   task WORKER(INTEGER range 1 .. 2);

   task body LOCK is
   begin
      loop
         accept SEIZE;
         accept RELEASE;
      end loop;
   end LOCK;

   task body WORKER is
      ID : INTEGER;
   begin
      ID := WORKER'INDEX;
      delay 0.001 * SECONDS;
      if ID = 2 then
         delay 0.001 * SECONDS;
      end if;
      LOCK.SEIZE;
      begin
         LOG("worker " & IMG(ID) & " holds the lock");
         delay 0.005 * SECONDS;
         if ID = 1 then
            raise RANGE_ERROR;
         end if;
         BALANCE := BALANCE + 10;
         LOCK.RELEASE;
      exception
         when RANGE_ERROR =>
            LOG("worker 1 failed while holding the lock");
      end;
      THROUGH := THROUGH + 1;
   end WORKER;

begin
   initiate LOCK, WORKER(1 .. 2);
   delay 0.100 * SECONDS;
   LOG(IMG(THROUGH) & " of 2 workers through, balance " & IMG(BALANCE)
       & ": worker 2 still waits on SEIZE, nothing released the lock");
   abort LOCK, WORKER(1 .. 2);
end FAILURE_DEMO;
