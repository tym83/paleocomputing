MAIN SEGMENT HASH_EXAMPLE
   USES (TERMINAL);
% a driver for the table search of 4.5.7
CONST VALUES: ARRAY [1:8] OF INTEGER := (12, 7, 12, 22, 3, 8, 12, 99);
%%ORIGINAL%%
LOOP FOR I IN [1:5] DO
   PUT_LINE (TO_CHAR (I) !! ': ' !! TO_CHAR (A (I)) !! ' found ' !! TO_CHAR (B (I)));
END LOOP I;
FUNCTION H (V: INTEGER) RETURNS (INTEGER);
   RETURN V * 3;
END FUNCTION H;
END SEGMENT HASH_EXAMPLE;
