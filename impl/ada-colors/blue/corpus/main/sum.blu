MAIN SEGMENT SUM_EXAMPLE
   USES (TERMINAL);
% a driver for SUM of 4.5.7: the stream is the standard input, an item a line; a
% line END ends a stream
TYPE STREAM = INTEGER;
LOOP UNTIL END_OF_INPUT () DO
   PUT_LINE ('SUM = ' !! TO_CHAR (SUM (0)));
EXCEPT
   INVALID_FORMAT --> PUT_LINE ('INVALID_FORMAT'); END;
END EXCEPT;
END LOOP;
FUNCTION GET_ITEM (S: STREAM) RETURNS (INTEGER) SIGNALS (EOF, INVALID_ITEM);
   IF END_OF_INPUT () THEN
      SIGNAL EOF;
   END IF;
   RETURN ITEM_OF (GET_LINE ());
END FUNCTION GET_ITEM;
FUNCTION ITEM_OF (L: ASCII_STR (?N)) RETURNS (INTEGER) SIGNALS (EOF, INVALID_ITEM);
   IF N = 3 THEN
      IF L = 'END' THEN
         SIGNAL EOF;
      END IF;
   END IF;
   RETURN TO_FIXED (L, 0);
EXCEPT
   CONVERSION --> SIGNAL INVALID_ITEM; END;
END EXCEPT;
END FUNCTION ITEM_OF;
%%ORIGINAL%%
END SEGMENT SUM_EXAMPLE;
