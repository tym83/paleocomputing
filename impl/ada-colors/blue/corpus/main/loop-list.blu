MAIN SEGMENT LOOP_LIST
   USES (TERMINAL);
%%ORIGINAL%%
PROCEDURE R (X: INTEGER);
   PUT_LINE ('R (' !! TO_CHAR (X) !! ')');
END PROCEDURE R;
FUNCTION LIST_OF_NODES (N: INTEGER) RETURNS (PTR (NODE))
   IMPORTS (TYPES: (NODE));
   VAR L: PTR (NODE) := NIL;
   LOOP FOR I IN [1:N] DO
      BLOCK
         CONST P: PTR (NODE) := NEW (NODE);
         P@ := (DATA: N + 1 - I, NEXT: L);
         L := P;
      END BLOCK;
   END LOOP I;
   RETURN L;
END FUNCTION LIST_OF_NODES;
END SEGMENT LOOP_LIST;
