MAIN SEGMENT GENERIC_STD_REPERR
   USES (TERMINAL);
% ?T without REP takes only a standard representation (5)
VAR A: INTEGER [0:10] REP FIXED_REP (4, UNSIGNED);
PRINT (A);
PROCEDURE PRINT (X: ?T)
   WHERE T NEEDS (TO_CHAR (T) RETURNS (ASCII_STR (?)));
   PUT_LINE (TO_CHAR (X));
END PROCEDURE PRINT;
END SEGMENT GENERIC_STD_REPERR;
