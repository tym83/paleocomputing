MAIN SEGMENT ENUMS
   USES (TERMINAL);
% enumerated types (3.4)
TYPE COLOR = ENUM (\RED, \ORANGE, \YELLOW, \GREEN, \BLUE, \VIOLET);
TYPE LIGHT = ENUM (\RED, \AMBER, \GREEN);
TYPE GRADE = UNORDERED (\EXCELLENT, \GOOD, \FAIR, \POOR);
VAR C: COLOR := \YELLOW;
VAR WARM: COLOR [\RED : \YELLOW] := \RED;
VAR L: LIGHT := \AMBER;
VAR G: GRADE := \GOOD;
PUT_LINE (TO_CHAR (C) !! ' ' !! TO_CHAR (TO_FIXED (C)) !! ' ' !! TO_CHAR (L));
C := SUCC (C);
PUT_LINE (TO_CHAR (C) !! ' ' !! TO_CHAR (PRED (C)));
IF C > \YELLOW & C IN [\GREEN : \VIOLET] THEN
   PUT_LINE ('green or later');
END IF;
LOOP FOR K IN [\ORANGE : \BLUE] DO
   PUT (TO_CHAR (K) !! ' ');
END LOOP K;
NEW_LINE;
SELECT C FROM
   \RED, \ORANGE --> PUT_LINE ('warm'); END;
   [\YELLOW : \BLUE] --> PUT_LINE ('middle'); END;
   ELSE --> PUT_LINE ('violet'); END;
END SELECT;
IF G = \GOOD THEN
   PUT_LINE ('good');
END IF;
PUT_LINE (TO_CHAR (C.MIN) !! ' ' !! TO_CHAR (WARM.MAX) !! ' ' !! TO_CHAR (WARM.EXTENT));
PUT_LINE (TO_CHAR ([LIGHT]$$(\GREEN)) !! ' ' !! TO_CHAR (TO_FIXED ([COLOR]$$(\GREEN))));
BLOCK
   WARM := \GREEN;
EXCEPT
   RANGE --> PUT_LINE ('RANGE raised'); END;
END EXCEPT;
END BLOCK;
BLOCK
   C := SUCC (\VIOLET);
EXCEPT
   RANGE --> PUT_LINE ('no successor'); END;
END EXCEPT;
END BLOCK;
END SEGMENT ENUMS;
