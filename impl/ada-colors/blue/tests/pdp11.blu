MAIN SEGMENT PDP11
   USES (TERMINAL);
% bluec -pdp11: the PDP-11 profile of the simulated machine (16-bit words): STD
% fixed point values have 16 bits (3.2.1, 3.2.3), pointers 16, and the floating
% point ranges are those of the F and D formats
VAR I: INTEGER := 32000;
VAR P: PTR (INTEGER);
VAR F: FLOAT (6);
VAR A: ARRAY [1:3] REP ARRAY_REP (PACKED) OF INTEGER [0:255] REP FIXED_REP (8, UNSIGNED);
PUT_LINE (TO_CHAR (I.SIZE) !! ' ' !! TO_CHAR (I.MAX) !! ' ' !! TO_CHAR (FIXED_MIN (0, 2, STD))
          !! ' ' !! TO_CHAR (P.SIZE) !! ' ' !! TO_CHAR (A.SIZE) !! ' ' !! TO_CHAR (F.EXPONENT_MAX));
BLOCK
   I := I + 1000;
   PUT_LINE ('no overflow');
END BLOCK
EXCEPT
   OVERFLOW --> PUT_LINE ('OVERFLOW at ' !! TO_CHAR (I)); END;
END EXCEPT;
BLOCK
   F := 1.0E30;
   F := F * 1.0E10;
   PUT_LINE ('no float overflow');
END BLOCK
EXCEPT
   OVERFLOW --> PUT_LINE ('float OVERFLOW'); END;
END EXCEPT;
END SEGMENT PDP11;
