MAIN SEGMENT SCOPES
   USES (TERMINAL);
% closed scopes, imports, nested routines, labels, exceptions (4.1 - 4.5)
VAR COUNT: INTEGER := 0;
VAR TOTAL: INTEGER := 0;
OUTER (5);
PUT_LINE ('COUNT ' !! TO_CHAR (COUNT) !! ', TOTAL ' !! TO_CHAR (TOTAL));
PUT_LINE ('SUM ' !! TO_CHAR (SUM (10)));
RETRY;
PUT_LINE ('FACT ' !! TO_CHAR (FACT (10)));
BLOCK
   VAR I: INTEGER := 0;
   AGAIN: I := I + 1;
   IF I < 3 THEN
      GO TO AGAIN;
   END IF;
   PUT_LINE ('GO TO looped ' !! TO_CHAR (I));
END BLOCK;
BLOCK
   CHECKED (-1);
EXCEPT
   NEGATIVE --> PUT_LINE ('NEGATIVE signalled'); END;
END EXCEPT;
END BLOCK;
BLOCK
   ASSERT COUNT = 0;
EXCEPT
   ASSERTION_VIOLATED --> PUT_LINE ('ASSERTION_VIOLATED'); END;
END EXCEPT;
END BLOCK;
PROCEDURE OUTER (N: INTEGER) IMPORTS (DATA: (# COUNT, TOTAL));
   VAR LOCAL: INTEGER := 100;
   LOOP FOR I IN [1:N] DO
      STEP (I);
   END LOOP I;
   PUT_LINE ('LOCAL ' !! TO_CHAR (LOCAL));
   PROCEDURE STEP (K: INTEGER) IMPORTS (DATA: (# COUNT, TOTAL, LOCAL));
      COUNT := COUNT + 1;
      TOTAL := TOTAL + K;
      LOCAL := LOCAL + K;
   END PROCEDURE STEP;
END PROCEDURE OUTER;
FUNCTION SUM (N: INTEGER) RETURNS (INTEGER);
   VAR T: INTEGER := 0;
   LOOP FOR I IN [1:N] DO
      T := T + I;
   END LOOP I;
   RETURN T;
EXCEPT
   OVERFLOW --> RETURN 0; END;
END EXCEPT;
END FUNCTION SUM;
% 4.5.7: a handler can GO TO the label of its statement
PROCEDURE RETRY ();
   VAR TRIES: INTEGER := 0;
   AGAIN: BLOCK
      TRIES := TRIES + 1;
      IF TRIES < 3 THEN
         SIGNAL FAILED;
      END IF;
      PUT_LINE ('succeeded after ' !! TO_CHAR (TRIES));
   END BLOCK;
   EXCEPT
      FAILED --> GO TO AGAIN; END;
   END EXCEPT;
END PROCEDURE RETRY;
FUNCTION FACT (N: INTEGER) RETURNS (INTEGER);
   IF N <= 1 THEN
      RETURN 1;
   END IF;
   RETURN N * FACT (N - 1);
END FUNCTION FACT;
PROCEDURE CHECKED (X: INTEGER) SIGNALS (NEGATIVE);
   IF X < 0 THEN
      SIGNAL NEGATIVE;
   END IF;
END PROCEDURE CHECKED;
END SEGMENT SCOPES;
