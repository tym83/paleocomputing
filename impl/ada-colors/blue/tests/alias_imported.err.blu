MAIN SEGMENT ALIAS_IMPORTEDERR
   USES (TERMINAL);
% an inout argument the procedure imports (4.3.3, example 1)
VAR A, B, C, E, F, G, H, L, N: INTEGER := 1;
VAR M, D: ARRAY [1:3] OF INTEGER;
VAR I: INTEGER := 1;
VAR J: INTEGER := 2;
P (E, F # A, G # H, L);
PROCEDURE P (IN1, IN2: INTEGER # INOUT1, INOUT2: INTEGER # OUT1, OUT2: INTEGER)
      IMPORTS (DATA: (A, B # C, D));
END PROCEDURE P;
END SEGMENT ALIAS_IMPORTEDERR;
