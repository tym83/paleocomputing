MAIN SEGMENT IDENTIFIERS
   USES (TERMINAL);
% an identifier may begin with \ or ? [2-10]; key words such as NEW and REPTYPE
% may be redeclared (2.1.7)
VAR \COUNT: INTEGER := 1;
VAR NEW: INTEGER := 7;
VAR REPTYPE: INTEGER := 40;
\COUNT := \COUNT + 1;
NEW := NEW + 1;
REPTYPE := REPTYPE + 2;
\SHOW (\COUNT);
PUT_LINE (TO_CHAR (NEW) !! ' ' !! TO_CHAR (REPTYPE) !! ' ' !! TO_CHAR (TWICE (3)));
PROCEDURE \SHOW (\N: INTEGER);
   PUT_LINE ('\SHOW ' !! TO_CHAR (\N));
END PROCEDURE \SHOW;
FUNCTION TWICE (X: INTEGER) RETURNS (INTEGER);
   VAR NEW: INTEGER := X;
   RETURN NEW + NEW;
END FUNCTION TWICE;
END SEGMENT IDENTIFIERS;
