MAIN SEGMENT OPERATORS
   USES (TERMINAL);
% operators are invocations of routines of their names (3.1.4.2, D.5), which may be
% invoked directly; the precision and rounding of an expression are further
% arguments of a program's operator routines (D.5 B, C); ROUNDINGS may be extended
TYPE ROUNDINGS = ENUM (ROUNDED, TRUNCATED, NATIVE_R, NATIVE_T, FLOOR);
TYPE SMALL = INTEGER [0 : 10];
VAR X: INTEGER := 0;
VAR F: FLOAT (6) := 2.5;
VAR S: ASCII_STR (5) := 'HELLO';
VAR A, B, C: T;
VAR V: FLOAT (2 * F.NOM_PRECISION);
PUT_LINE (TO_CHAR (ADD_ (2, 3)) !! ' ' !! TO_CHAR (MULTIPLY_ (4, 5)) !! ' '
          !! TO_CHAR (FIXED$ADD_ (1, 2)));
STORE_ (5 ## X);
PUT_LINE (TO_CHAR (X) !! ' ' !! SUBSTRING_ (S, 1, 3) !! ' ' !! CONCATENATE_ ('A', 'B'));
PUT_LINE (TO_CHAR (DIVIDE_ (7, 2)) !! ' ' !! TO_CHAR (DIVIDE_ (F, 2.0)) !! ' '
          !! TO_CHAR (DIVIDE_ (7, 2, ROUNDED)));
PUT_LINE (TO_CHAR (NEGATE_ (X)) !! ' ' !! TO_CHAR (LESS_THAN_ (1, 2)) !! ' '
          !! TO_CHAR (EQUAL_ (S, 'HELLO')));
SUBSTRING_STORE_ ('ABC', 1, 3 # S);
PUT_LINE (S !! ' ' !! TO_CHAR (MAX_NOM_PREC) !! ' ' !! TO_CHAR (CLOCK_SCALE) !! ' '
          !! TO_CHAR (V.NOM_PRECISION));
X := -7 // 2 FLOOR;
PUT_LINE ('-7 // 2 FLOOR = ' !! TO_CHAR (X));
A := MK (6);
B := MK (4);
C := A + B ROUNDED;
C := A !*3! B;
PUT_LINE (TO_CHAR (VAL (C)));
C := A !+! B;
C := -A WITH PREC 3;
PUT_LINE (TO_CHAR (VAL (C)));
BLOCK
   X := [SMALL]$$(11);
END BLOCK
EXCEPT
   INVALID_TYPE --> PUT_LINE ('11 is no SMALL: INVALID_TYPE (3.1.4.1)'); END;
END EXCEPT;
FUNCTION DIVIDE_ (A, B: INTEGER, R: ROUNDINGS) RETURNS (INTEGER);
   IF R = FLOOR THEN
      IF A MOD B <> 0 & (A < 0) <> (B < 0) THEN
         RETURN A // B - 1;
      END IF;
   END IF;
   RETURN A // B;
END FUNCTION DIVIDE_;
MODULE M EXPORTS (T);
   TYPE T = RECORD VAR V: INTEGER; END RECORD;
   FUNCTION T$MK (X: INTEGER) RETURNS (T);
      RETURN (V: X);
   END FUNCTION T$MK;
   FUNCTION T$VAL (X: T) RETURNS (INTEGER);
      RETURN X.V;
   END FUNCTION T$VAL;
   PROCEDURE T$STORE_ (Y: T ## X: T);
      X.V := Y.V;
   END PROCEDURE T$STORE_;
   PROCEDURE T$STORE_ (Y: T, R: ROUNDINGS ## X: T);
      PUT_LINE ('STORE_ ' !! TO_CHAR (R));
      X.V := Y.V;
   END PROCEDURE T$STORE_;
   PROCEDURE T$STORE_ (Y: T, P: INTEGER ## X: T);
      PUT_LINE ('STORE_ WITH PREC ' !! TO_CHAR (P));
      X.V := Y.V;
   END PROCEDURE T$STORE_;
   FUNCTION T$ADD_ (X, Y: T, R: ROUNDINGS) RETURNS (T);
      PUT_LINE ('ADD_ ' !! TO_CHAR (R));
      RETURN (V: X.V + Y.V);
   END FUNCTION T$ADD_;
   FUNCTION T$MD_ADD_ (X, Y: T) RETURNS (T);
      PUT_LINE ('MD_ADD_');
      RETURN (V: X.V + Y.V);
   END FUNCTION T$MD_ADD_;
   FUNCTION T$MULTIPLY_ (X, Y: T, S: INTEGER) RETURNS (T);
      RETURN (V: X.V * Y.V * S);
   END FUNCTION T$MULTIPLY_;
   FUNCTION T$NEGATE_ (X: T, P: INTEGER) RETURNS (T);
      RETURN (V: -X.V * P);
   END FUNCTION T$NEGATE_;
END MODULE M;
END SEGMENT OPERATORS;
