MAIN SEGMENT WHERE_ORDER_UNORDERED
   USES (TERMINAL);
% an UNORDERED type has no LESS_THAN_, and the WHERE clause says so where BIGGER is
% invoked (5.2, 3.4.4.1)
TYPE SUIT = UNORDERED (\CLUBS, \HEARTS);
PUT_LINE (TO_CHAR (BIGGER (\CLUBS, \HEARTS) = \CLUBS));
FUNCTION BIGGER (A, B: ?T) RETURNS (T)
      WHERE T NEEDS (LESS_THAN_ (T, T) RETURNS (BOOLEAN));
   IF A < B THEN
      RETURN B;
   END IF;
   RETURN A;
END FUNCTION BIGGER;
END SEGMENT WHERE_ORDER_UNORDERED;
