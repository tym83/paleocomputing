MAIN SEGMENT ENUM_EXPORT
   USES (TERMINAL);
% an exported enumerated type: its literals and equality outside the module, and
% its ordering where the module exports <, <=, >, >=, SUCC and PRED (4.4)
VAR C: COLOR := \RED;
VAR D: COLOR := \BLUE;
VAR L: LEVEL := \LOW;
IF C = D THEN PUT_LINE ('eq'); ELSE PUT_LINE ('ne'); END IF;
IF L < \HIGH THEN PUT_LINE ('LOW < HIGH'); END IF;
L := SUCC (L);
PUT_LINE (TO_CHAR (L));
MODULE M EXPORTS (COLOR, LEVEL);
   TYPE COLOR = ENUM (\RED, \BLUE);
   TYPE LEVEL = ENUM (\LOW, \MID, \HIGH);
   FUNCTION LEVEL$LESS_THAN_ (A, B: LEVEL) RETURNS (BOOLEAN);
      RETURN TO_FIXED (A) < TO_FIXED (B);
   END FUNCTION LEVEL$LESS_THAN_;
   FUNCTION LEVEL$LESS_EQUAL_ (A, B: LEVEL) RETURNS (BOOLEAN);
      RETURN TO_FIXED (A) <= TO_FIXED (B);
   END FUNCTION LEVEL$LESS_EQUAL_;
   FUNCTION LEVEL$GREATER_THAN_ (A, B: LEVEL) RETURNS (BOOLEAN);
      RETURN TO_FIXED (A) > TO_FIXED (B);
   END FUNCTION LEVEL$GREATER_THAN_;
   FUNCTION LEVEL$GREATER_EQUAL_ (A, B: LEVEL) RETURNS (BOOLEAN);
      RETURN TO_FIXED (A) >= TO_FIXED (B);
   END FUNCTION LEVEL$GREATER_EQUAL_;
   FUNCTION LEVEL$SUCC (A: LEVEL) RETURNS (LEVEL);
      RETURN SUCC (A);
   END FUNCTION LEVEL$SUCC;
   FUNCTION LEVEL$PRED (A: LEVEL) RETURNS (LEVEL);
      RETURN PRED (A);
   END FUNCTION LEVEL$PRED;
END MODULE M;
END SEGMENT ENUM_EXPORT;
