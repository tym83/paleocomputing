MAIN SEGMENT OPERATOR_ROUNDING
   USES (TERMINAL);
% A + B ROUNDED invokes ADD_ (A, B, ROUNDED) (D.5 C): a two-argument ADD_ does not do
VAR A, B: T;
A := A + B ROUNDED;
MODULE M EXPORTS (T);
   TYPE T = RECORD VAR V: INTEGER; END RECORD;
   PROCEDURE T$STORE_ (Y: T ## X: T);
      X.V := Y.V;
   END PROCEDURE T$STORE_;
   FUNCTION T$ADD_ (X, Y: T) RETURNS (T);
      RETURN (V: X.V + Y.V);
   END FUNCTION T$ADD_;
END MODULE M;
END SEGMENT OPERATOR_ROUNDING;
