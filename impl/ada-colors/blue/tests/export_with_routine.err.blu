MAIN SEGMENT EXPORT_WITH_ROUTINEERR
   USES (TERMINAL);
% only a type-name is followed by a WITH clause (4.4)
PUT_LINE (TO_CHAR (TWICE (2)));
MODULE M EXPORTS (TWICE WITH (GET));
   FUNCTION TWICE (A: INTEGER) RETURNS (INTEGER);
      RETURN 2 * A;
   END FUNCTION TWICE;
END MODULE M;
END SEGMENT EXPORT_WITH_ROUTINEERR;
