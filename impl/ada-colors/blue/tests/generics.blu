MAIN SEGMENT GENERICS
   USES (TERMINAL);
% generic definitions (section 5)
TYPE COLOR = ENUM (\RED, \GREEN, \BLUE);
VAR S: STACK (INTEGER, 10);
VAR C: STACK (COLOR, 3);
VAR I: INTEGER;
VAR K: COLOR;
CLEAR (# S);
CLEAR (# C);
PUSH (7 # S);
PUSH (8 # S);
PUSH (\GREEN # C);
POP (# S # I);
POP (# C # K);
PUT_LINE (TO_CHAR (I) !! ' ' !! TO_CHAR (K) !! ' ' !! TO_CHAR (S.LENGTH));
PUT_LINE (CONCAT ('BLUE', '1978') !! ' ' !! TO_CHAR (CONCAT ('A', 'BC').LENGTH));
PUT_LINE (TRUNCATE ('ABCDEFG', 3));
PRINT (42);
PRINT (\BLUE);
PRINT ('TEXT');
PUT_LINE (TO_CHAR (INTEGRATE (1, 4, SQUARE)));
PUT_LINE (TO_CHAR (TWICE (2.5\S1)));
FUNCTION CONCAT (X: ASCII_STR (?L1), Y: ASCII_STR (?L2)) RETURNS (ASCII_STR (L1 + L2));
   RETURN X !! Y;
END FUNCTION CONCAT;
FUNCTION TRUNCATE (C: ASCII_STR (?L1), L: INTEGER) RETURNS (ASCII_STR (L));
   RETURN C[0 : L - 1];
END FUNCTION TRUNCATE;
PROCEDURE PRINT (X: ?T)
   WHERE T NEEDS (TO_CHAR (T) RETURNS (ASCII_STR (?)));
   PUT_LINE ('PRINT ' !! TO_CHAR (X));
END PROCEDURE PRINT;
FUNCTION SQUARE (X: INTEGER) RETURNS (INTEGER);
   RETURN X * X;
END FUNCTION SQUARE;
FUNCTION INTEGRATE (FIRSTVAL, LASTVAL: FIXED (?S, ?R, ?P) [?:?],
                    F: FUNCTION (FIXED (?S, ?R, ?P) [?:?]) RETURNS (FIXED (?S, ?R, ?P) [?:?]))
      RETURNS (FIXED (S, R, P));
   VAR SUM: FIXED (S, R, P) := 0;
   LOOP FOR I IN [FIRSTVAL : LASTVAL] DO
      SUM := SUM + F (I);
   END LOOP I;
   RETURN SUM;
END FUNCTION INTEGRATE;
FUNCTION TWICE (X: FIXED (?S, 2, STD)) RETURNS (FIXED (S, 2, STD));
   RETURN X + X;
END FUNCTION TWICE;
MODULE M EXPORTS (STACK);
   TYPE STACK (ELEMENT_TYPE: TYPE,
               LENGTH: INTEGER [1:FIXED_MAX (0, 2, STD)]) =
      RECORD
         VAR ELEMENTS: ARRAY [1 : LENGTH] OF ELEMENT_TYPE;
         VAR TOP: INTEGER [0:LENGTH];
      END RECORD;
   PROCEDURE STACK$CLEAR (# S: STACK (?, ?));
      S.TOP := 0;
   END PROCEDURE STACK$CLEAR;
   PROCEDURE STACK$PUSH (E: ?T # S: STACK (?T, ?LENGTH))
      SIGNALS (STACK_OVERFLOW)
      WHERE T NEEDS (STORE_ (T ## T));
      IF S.TOP < LENGTH THEN
         S.TOP := S.TOP + 1;
         S.ELEMENTS (S.TOP) := E;
      ELSE
         SIGNAL STACK_OVERFLOW;
      END IF;
   END PROCEDURE STACK$PUSH;
   PROCEDURE STACK$POP (#S: STACK (?T, ?LENGTH) # E: ?T)
      SIGNALS (STACK_EMPTY)
      WHERE T NEEDS (STORE_ (T ## T));
      IF S.TOP > 0 THEN
         E := S.ELEMENTS (S.TOP);
         S.TOP := S.TOP - 1;
      ELSE
         SIGNAL STACK_EMPTY;
      END IF;
   END PROCEDURE STACK$POP;
END MODULE M;
END SEGMENT GENERICS;
