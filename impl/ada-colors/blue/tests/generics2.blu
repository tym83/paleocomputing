MAIN SEGMENT GENERICS2
   USES (TERMINAL);
% don't-care FIXED (?,?,?), a derived size in a reptype, routine arguments chosen
% by their templates, T$NAME of a WHERE routine (section 5, 5.1, 5.2)
VAR A: INTEGER [1:10] := 4;
VAR B: FIXED (3, 2, STD) := 2.5\S3;
VAR C: INTEGER [-100:100] REP FIXED_REP (8, SIGNED) := 3;
P (A);
P (B);
Q (C);
Q (A);
APPLY (SHOW (INTEGER));
APPLY2 (SHOW);
PUT_LINE (TO_CHAR (APPLYF (SQ (INTEGER) RETURNS (INTEGER))));
TWICE (21);
PROCEDURE P (X: FIXED (?,?,?) [?:?]);
   PUT_LINE ('scale ' !! TO_CHAR (X.SCALE));
END PROCEDURE P;
PROCEDURE Q (X: INTEGER REP FIXED_REP (?S, SIGNED));
   PUT_LINE ('size ' !! TO_CHAR (S));
END PROCEDURE Q;
PROCEDURE APPLY (P: PROCEDURE (INTEGER));
   P (5);
END PROCEDURE APPLY;
PROCEDURE APPLY2 (P: PROCEDURE (BOOLEAN));
   P (TRUE);
END PROCEDURE APPLY2;
FUNCTION APPLYF (F: FUNCTION (INTEGER) RETURNS (INTEGER)) RETURNS (INTEGER);
   RETURN F (4);
END FUNCTION APPLYF;
PROCEDURE SHOW (X: INTEGER);
   PUT_LINE ('int ' !! TO_CHAR (X));
END PROCEDURE SHOW;
PROCEDURE SHOW (X: BOOLEAN);
   PUT_LINE ('bool ' !! TO_CHAR (X));
END PROCEDURE SHOW;
FUNCTION SQ (X: INTEGER) RETURNS (INTEGER);
   RETURN X * X;
END FUNCTION SQ;
FUNCTION SQ (X: BOOLEAN) RETURNS (INTEGER);
   RETURN 0;
END FUNCTION SQ;
PROCEDURE TWICE (X: ?T)
      WHERE T NEEDS (TO_CHAR (T) RETURNS (ASCII_STR (?)), ADD_ (T, T) RETURNS (T));
   PUT_LINE (T$TO_CHAR (X + X));
END PROCEDURE TWICE;
END SEGMENT GENERICS2;
