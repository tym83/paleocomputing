MAIN SEGMENT SIDE_EFFECTERR
   USES (TERMINAL);
% F and G both modify X: not interference-free (4.3.4, example 1)
VAR X: INTEGER := 1;
VAR L: INTEGER;
L := F (1) + G (1);
FUNCTION F (A: INTEGER) RETURNS (INTEGER) IMPORTS (DATA: (# X));
   X := X + 1; RETURN X;
END FUNCTION F;
FUNCTION G (A: INTEGER) RETURNS (INTEGER) IMPORTS (DATA: (# X));
   X := X * 10; RETURN X;
END FUNCTION G;
END SEGMENT SIDE_EFFECTERR;
