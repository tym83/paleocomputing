MAIN SEGMENT STORE_CLASS
   USES (TERMINAL);
% both arguments of STORE_ belong to one type class (D.4)
VAR A: T;
A := 5;
MODULE M EXPORTS (T WITH (STORE_));
   TYPE T = RECORD VAR V: INTEGER; END RECORD;
   PROCEDURE T$STORE_ (Y: INTEGER ## X: T);
      X.V := Y;
   END PROCEDURE T$STORE_;
END MODULE M;
END SEGMENT STORE_CLASS;
