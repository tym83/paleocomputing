MAIN SEGMENT STRINGS
   USES (TERMINAL);
% character strings (3.7) and bitstrings (3.6)
VAR S1: ASCII_STR (4);
VAR S2: ASCII_STR (6) := 'BLUE78';
VAR C: ASCII_STR (1);
VAR B: BIT (6) := BIN '101 110';
VAR K: ASCII;
VAR N: INTEGER := 5;
S1 := S2[0:3];
PUT_LINE (S1 !! BLANKS (2) !! '|' !! DUP ('*', 3));
S2 := S1 !! BLANKS (2);
PUT_LINE ('[' !! S2 !! ']' !! TO_CHAR (S2.LENGTH));
C := ''\HT;
PUT_LINE (TO_CHAR (C = ''\HT) !! ' ' !! 'IT''S');
PUT_LINE ('L'\O\W\E\R' C'\A\S\E);
PUT_LINE (TO_CHAR (B) !! ' ' !! TO_CHAR (OCT '56' = B) !! ' ' !! TO_CHAR (HEX '0FF'.LENGTH));
PUT_LINE (TO_CHAR (B AND BIN '011011') !! ' ' !! TO_CHAR (NOT B) !! ' ' !! TO_CHAR (B[1:3]));
PUT_LINE (TO_CHAR (BIN '00' !! B[0:3]) !! ' ' !! TO_CHAR (TO_FIXED (B, 0)) !! ' ' !! TO_CHAR (ZEROS (3)));
PUT_LINE (TO_CHAR (BIN_OF ('10')) !! ' ' !! TO_CHAR (OCT_OF ('10')));
K := \'A';
PUT_LINE (TO_CHAR (K) !! TO_CHAR (SUCC (K)) !! ' ' !! TO_CHAR (TO_BIT (K)) !! ' ' !! TO_CHAR (TO_FIXED (\A)));
BLOCK
   S1 := S2[0:N];
EXCEPT
   SIZE --> PUT_LINE ('SIZE'); END;
END EXCEPT;
END BLOCK;
BLOCK
   IF S1 = S2 THEN
      ;
   END IF;
EXCEPT
   INVALID_LENGTH --> PUT_LINE ('INVALID_LENGTH'); END;
END EXCEPT;
END BLOCK;
BLOCK
   S1 := S2[3:6];
EXCEPT
   INVALID_SUBSTRING --> PUT_LINE ('INVALID_SUBSTRING'); END;
END EXCEPT;
END BLOCK;
END SEGMENT STRINGS;
