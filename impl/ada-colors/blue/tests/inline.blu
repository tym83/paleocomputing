MAIN SEGMENT INLINE_EXPANSION
   USES (TERMINAL);
% an INLINE routine is expanded at each invocation; a manifest argument makes its
% formal manifest there, and the conditions on it select their arms when the
% body is translated (4.3.1, 3.1.4.1)
VAR K: INTEGER := 2;
SHOW (3);
SHOW (5);
PICK (1);
PICK (2);
PICK (K);
INLINE PROCEDURE SHOW (N: INTEGER [0:10]);
   VAR X: FIXED (N, 2, STD) := 1;                    % a scale must be manifest
   PUT_LINE ('scale ' !! TO_CHAR (X.SCALE));
END PROCEDURE SHOW;
INLINE PROCEDURE PICK (N: INTEGER);
   IF N = 1 THEN
      PUT_LINE ('one');
   ELSE
      PUT_LINE ('not one: ' !! TO_CHAR (N));
   END IF;
END PROCEDURE PICK;
END SEGMENT INLINE_EXPANSION;
