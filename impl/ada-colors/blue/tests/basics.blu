MAIN SEGMENT HELLO
   USES (TERMINAL);
% a first test
CONST N: INTEGER := 10;
TYPE NODE_REC = RECORD
   VAR V: INTEGER;
   VAR NAME: ASCII_STR(5);
   VAR NEXT: PTR(NODE_REC);
END RECORD;
VAR LIST: PTR(NODE_REC) := NIL;
VAR A: ARRAY [1:N] OF INTEGER;
VAR S: ASCII_STR(5) := 'HELLO';
LOOP FOR I IN [1:N] DO
   A(I) := I * I;
   BLOCK
      VAR P: PTR(NODE_REC) := NEW(NODE_REC);
      P@.V := A(I);
      P@.NEXT := LIST;
      LIST := P;
   END BLOCK;
END LOOP I;
PUT_LINE(S !! ', WORLD' !! ''\LF !! 'sum=' !! TO_CHAR(SUM(LIST)));
SELECT A(3) FROM
   [1:8] --> PUT_LINE('small'); END;
   9, 10 --> PUT_LINE('nine'); END;
   ELSE --> PUT_LINE('big'); END;
END SELECT;
BLOCK
   VAR X: INTEGER [0:5] := 0;
   X := 7;
END BLOCK;
EXCEPT
   RANGE --> PUT_LINE('range!'); END;
END EXCEPT;
PUT_LINE(S[1:3]);
FUNCTION SUM (L: PTR(NODE_REC)) RETURNS (INTEGER);
   IF L = NIL THEN RETURN 0; END IF;
   RETURN L@.V + SUM(L@.NEXT);
END FUNCTION SUM;
END SEGMENT HELLO;
