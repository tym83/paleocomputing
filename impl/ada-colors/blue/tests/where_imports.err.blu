MAIN SEGMENT WHERE_IMPORTSERR
   USES (TERMINAL);
% routines named in WHERE clauses import no data (5.2)
VAR G: INTEGER := 0;
SHOW (5);
PROCEDURE SHOW (X: ?T) IMPORTS (DATA: (G))
      WHERE T NEEDS (IMG (T) RETURNS (ASCII_STR (?)));
   PUT_LINE (IMG (X));
END PROCEDURE SHOW;
FUNCTION IMG (X: INTEGER) RETURNS (ASCII_STR (1)) IMPORTS (DATA: (G));
   RETURN 'x';
END FUNCTION IMG;
END SEGMENT WHERE_IMPORTSERR;
