MAIN SEGMENT EXPLICIT_CONST
   USES (TERMINAL);
% the argument of an explicit generic parameter is a constant (section 5, example 7)
VAR N: INTEGER := 3;
VAR S1: ASCII_STR (10) := 'ABCDEFGHIJ';
PUT_LINE (TRUNCATE (S1, N));
FUNCTION TRUNCATE (C: ASCII_STR(?L1), L: INTEGER) RETURNS (ASCII_STR(L));
   RETURN C[0 : L - 1];
END FUNCTION TRUNCATE;
END SEGMENT EXPLICIT_CONST;
