MAIN SEGMENT PACKED_INOUTERR
   USES (TERMINAL);
% only elements of ARRAY_STD arrays are inout arguments (3.8.3)
VAR A: ARRAY [1:4] REP ARRAY_REP (DENSE) OF INTEGER [0:7] REP FIXED_REP (3, UNSIGNED);
P (# A(1));
PROCEDURE P (# X: INTEGER [0:7] REP FIXED_REP (3, UNSIGNED));
   X := 1;
END PROCEDURE P;
END SEGMENT PACKED_INOUTERR;
