MAIN SEGMENT ARRAYS2
   USES (TERMINAL);
% the attributes of arrays (3.8.1): BOUNDS and EXTENT as values, ELEMENT_TYPE, an
% UNORDERED index through the program's TO_FIXED; ARRAY_TOO_BIG; the STREAM of
% 3.9.1 with its earlier field's attribute; the unset tag of a T(ANY) record
TYPE DIR = UNORDERED (\NORTH, \EAST, \SOUTH, \WEST);
TYPE STREAM (TAG DEV: ENUM (\TAPE, \KEYBOARD)) = RECORD
   VAR UNIT: INTEGER [0:7];
   SELECT DEV FROM
      \TAPE --> VAR BUFFER: ARRAY [0:255] OF ASCII; END;
      \KEYBOARD -->
         VAR BUFFER: ASCII_STR (20);
         VAR BUF_FIRST, BUF_LAST: INTEGER [0:BUFFER.LENGTH];
      END;
   END SELECT;
END RECORD;
VAR A: ARRAY [1:3, 5:9] OF INTEGER [0:100];
VAR E: ARRAY [0:1] OF INTEGER;
VAR B: ARRAY [0:1] OF BOUNDS_DEF (STD);
VAR X: A.ELEMENT_TYPE := 7;
VAR W: ARRAY [\NORTH : \WEST] OF INTEGER;
VAR N: INTEGER := 2000000000000;
VAR K: STREAM (\KEYBOARD);
VAR Y: STREAM (ANY);
E := A.EXTENT;
B := A.BOUNDS;
W (\SOUTH) := 3;
PUT_LINE (TO_CHAR (E (0)) !! ' ' !! TO_CHAR (E (1)) !! ' ' !! TO_CHAR (B (1).MIN) !! ' '
          !! TO_CHAR (B (1).MAX) !! ' ' !! TO_CHAR ((A.ELEMENT_TYPE).MAX) !! ' ' !! TO_CHAR (X)
          !! ' ' !! TO_CHAR (W (\SOUTH)) !! ' ' !! TO_CHAR (W.BOUNDS (0).MAX)
          !! ' ' !! TO_CHAR ((K.BUF_LAST).MAX));
BLOCK
   BLOCK
      VAR BIG: ARRAY [1:N] OF INTEGER;
   END BLOCK;
END BLOCK
EXCEPT
   ARRAY_TOO_BIG --> PUT_LINE ('ARRAY_TOO_BIG'); END;
END EXCEPT;
BLOCK
   PUT_LINE (TO_CHAR (Y.DEV));
END BLOCK
EXCEPT
   UNINITIALIZED_VARIABLE --> PUT_LINE ('the tag of Y is unset'); END;
END EXCEPT;
FUNCTION TO_FIXED (D: DIR) RETURNS (INTEGER);
   SELECT D FROM
      \NORTH --> RETURN 0; END;
      \EAST --> RETURN 1; END;
      \SOUTH --> RETURN 2; END;
      ELSE --> RETURN 3; END;
   END SELECT;
END FUNCTION TO_FIXED;
END SEGMENT ARRAYS2;
