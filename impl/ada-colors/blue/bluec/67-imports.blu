
% ==== importing (4.1.1) and the exceptions a closed scope may signal (4.5.7) ===============
% A closed scope -- a routine, a path, a module -- uses a variable of an enclosing
% scope only if it imports it, for input or inout; it calls a routine that uses such a
% variable only if it imports the variable or the routine. The segment scope is exempt
% (4.4, example 2: the main program calls the operations of a module).

FUNCTION IN_IDENTS (L: NODE, NAME: TEXT) RETURNS (BOOLEAN);
   VAR P: NODE := L;
   LOOP UNTIL P = NIL DO
      IF TEQ (P@.NAME, NAME) THEN
         RETURN TRUE;
      END IF;
      P := P@.NEXT;
   END LOOP;
   RETURN FALSE;
END FUNCTION IN_IDENTS;

% may the variable Y be used here? TRUE if it may also be changed
FUNCTION CHECK_IMPORTED (Y: SYM, LINE: INTEGER) RETURNS (BOOLEAN);
   CONST IS: ISCOPE := W@.IS;
   IF Y@.KIND <> Y_VAR ! Y@.OWNER < 0 THEN
      RETURN NOT Y@.INPUT;
   END IF;
   IF IS = NIL THEN
      RETURN NOT Y@.INPUT;
   END IF;
   IF Y@.OWNER = IS@.ID ! IS@.ID = 0 THEN
      RETURN NOT Y@.INPUT;
   END IF;
   IF IS@.IMPORTS <> NIL THEN
      IF IN_IDENTS (IS@.IMPORTS@.B, Y@.NAME) THEN
         RETURN NOT Y@.INPUT;
      END IF;
      IF IN_IDENTS (IS@.IMPORTS@.A, Y@.NAME) THEN
         RETURN FALSE;                                % imported for input: a constant here
      END IF;
   END IF;
   FAILT (LINE, 'a variable of an enclosing scope must be imported (4.1.1): ', Y@.NAME);
END FUNCTION CHECK_IMPORTED;

% the variables the routine Y imports, directly or through the routines it imports:
% N_IDENT nodes, NAME the variable, IV the closed scope that declares it
PROCEDURE COMPUTE_USES (Y: SYM);
   CONST ITEMS: NODE := Y@.DECL@.E;
   VAR HEAD, TAIL: NODE := NIL;
   IF Y@.MV <> 0 THEN                                % done, or being done (recursion)
      RETURN;
   END IF;
   Y@.MV := 2;
   IF ITEMS = NIL THEN
      Y@.MV := 1;
      RETURN;
   END IF;
   ADD_USES (ITEMS@.A # HEAD, TAIL);
   ADD_USES (ITEMS@.B # HEAD, TAIL);
   BLOCK                                             % the routines it imports
      VAR R: NODE := ITEMS@.C;
      LOOP UNTIL R = NIL DO
         BLOCK
            VAR Z: SYM := LOOKUP (R@.NAME);
            IF Z = NIL & NOT LOCAL_MODULE_EXPORTS (Y@.DECL@.C, R@.NAME) THEN
               FAILT (R@.LINE, 'an imported routine is not visible: ', R@.NAME);
            END IF;
            LOOP UNTIL Z = NIL DO
               IF Z@.KIND = Y_ROUTINE THEN
                  BLOCK
                     CONST O: SYM := ORIGINAL (Z);
                     VAR U: NODE;
                     COMPUTE_USES (O);
                     U := O@.USES;
                     LOOP UNTIL U = NIL DO
                        IF NOT IN_IDENTS (HEAD, U@.NAME) THEN
                           BLOCK
                              VAR N: NODE := NEW_NODE (N_IDENT, U@.LINE);
                              N@.NAME := U@.NAME;
                              N@.IV := U@.IV;
                              ADD_LIST (N # HEAD, TAIL);
                           END BLOCK;
                        END IF;
                        U := U@.NEXT;
                     END LOOP;
                  END BLOCK;
               END IF;
               Z := LOOKUP_NEXT (Z);
            END LOOP;
         END BLOCK;
         R := R@.NEXT;
      END LOOP;
   END BLOCK;
   Y@.USES := HEAD;
   Y@.MV := 1;
END PROCEDURE COMPUTE_USES;

% does a module declared in the closed-scope-body B export NAME? The names a module
% exports are local to the scope around it (4.1.2), and a routine that invokes an
% exported routine using the module's own variables imports that routine (4.1.1)
FUNCTION LOCAL_MODULE_EXPORTS (B: NODE, NAME: TEXT) RETURNS (BOOLEAN);
   VAR M: NODE;
   IF B = NIL THEN
      RETURN FALSE;
   END IF;
   M := B@.C;
   LOOP UNTIL M = NIL DO
      IF M@.KIND = N_MODULE THEN
         IF M@.FL = 1 ! IN_IDENTS (M@.B, NAME) ! LOCAL_MODULE_EXPORTS (M@.C, NAME) THEN
            RETURN TRUE;
         END IF;
      END IF;
      M := M@.NEXT;
   END LOOP;
   RETURN FALSE;
END FUNCTION LOCAL_MODULE_EXPORTS;

% the uses of the routines of a body, once its objects are declared
PROCEDURE ROUTINE_USES (RS: NODE);
   VAR R: NODE := RS;
   LOOP UNTIL R = NIL DO
      IF R@.KIND = N_ROUTINE THEN
         COMPUTE_USES (FIND_DECL (R));
         IF R@.E <> NIL THEN                          % the data a routine imports are
            IMPORTS_KNOWN (R@.E@.A, FALSE);           % known in the scope around it
            IMPORTS_KNOWN (R@.E@.B, TRUE);            % (4.1.1)
         END IF;
      END IF;
      R := R@.NEXT;
   END LOOP;
END PROCEDURE ROUTINE_USES;

% the variables of an imports-clause are known, and for an inout item changeable,
% in the immediately enclosing scope (4.1.1)
PROCEDURE IMPORTS_KNOWN (L: NODE, INOUT: BOOLEAN);
   VAR P: NODE := L;
   LOOP UNTIL P = NIL DO
      BLOCK
         CONST V: SYM := LOOKUP (P@.NAME);
         IF V <> NIL THEN
            IF V@.KIND = Y_VAR THEN
               IF NOT CHECK_IMPORTED (V, P@.LINE) & INOUT & NOT V@.INPUT THEN
                  FAILT (P@.LINE, 'imported for change, but only for input in the enclosing scope (4.1.1): ',
                         P@.NAME);
               END IF;
            END IF;
         END IF;
      END BLOCK;
      P := P@.NEXT;
   END LOOP;
END PROCEDURE IMPORTS_KNOWN;

PROCEDURE ADD_USES (L: NODE # HEAD, TAIL: NODE);
   VAR P: NODE := L;
   LOOP UNTIL P = NIL DO
      BLOCK
         CONST V: SYM := LOOKUP (P@.NAME);
         VAR N: NODE := NEW_NODE (N_IDENT, P@.LINE);
         IF V = NIL THEN
            FAILT (P@.LINE, 'an imported name is not visible: ', P@.NAME);
         END IF;
         N@.NAME := P@.NAME;
         N@.IV := V@.OWNER;
         IF V@.KIND = Y_VAR THEN
            ADD_LIST (N # HEAD, TAIL);
         END IF;
      END BLOCK;
      P := P@.NEXT;
   END LOOP;
END PROCEDURE ADD_USES;

% the variables a call of Y uses must be imported, or Y (4.1.1)
PROCEDURE CHECK_CALL_IMPORTS (Y: SYM, LINE: INTEGER);
   CONST IS: ISCOPE := W@.IS;
   VAR U: NODE := Y@.USES;
   IF IS = NIL ! W@.START_IO THEN                    % START_IO is not an invocation
      RETURN;
   END IF;
   IF IS@.ID = 0 THEN
      RETURN;
   END IF;
   LOOP UNTIL U = NIL DO
      IF U@.IV <> IS@.ID THEN
         IF IS@.IMPORTS = NIL THEN
            FAIL (LINE, 'the routine ' !! STR (Y@.NAME, Y@.NAME.LEN) !! ' uses the variable '
                  !! STR (U@.NAME, U@.NAME.LEN) !! ': import one of them (4.1.1)');
         END IF;
         IF NOT (IN_IDENTS (IS@.IMPORTS@.A, U@.NAME) ! IN_IDENTS (IS@.IMPORTS@.B, U@.NAME)
               ! IN_IDENTS (IS@.IMPORTS@.C, Y@.NAME) ! IN_IDENTS (IS@.IMPORTS@.C, BASE_NAME (Y))
               ! MODULE_IMPORTED (IS@.IMPORTS@.E, Y)
               ! IMPORTED_ROUTINE_USES (IS@.IMPORTS@.C, U@.NAME))
            THEN
            FAIL (LINE, 'the routine ' !! STR (Y@.NAME, Y@.NAME.LEN) !! ' uses the variable '
                  !! STR (U@.NAME, U@.NAME.LEN) !! ': import one of them (4.1.1)');
         END IF;
      END IF;
      U := U@.NEXT;
   END LOOP;
END PROCEDURE CHECK_CALL_IMPORTS;

% does a routine the scope imports use the variable NAME? Then the scope may use it
% indirectly (4.1.1: "the routine that uses the variable may be imported"), also
% through its own local routines (C-28: FORMPRINT imports STRPUT, its local
% CONVERT_AND_PUT calls STRPUT)
FUNCTION IMPORTED_ROUTINE_USES (RS: NODE, NAME: TEXT) RETURNS (BOOLEAN);
   VAR R: NODE := RS;
   LOOP UNTIL R = NIL DO
      BLOCK
         VAR Z: SYM := LOOKUP (R@.NAME);
         LOOP UNTIL Z = NIL DO
            IF Z@.KIND = Y_ROUTINE THEN
               BLOCK
                  CONST O: SYM := ORIGINAL (Z);
                  COMPUTE_USES (O);
                  IF IN_IDENTS (O@.USES, NAME) THEN
                     RETURN TRUE;
                  END IF;
               END BLOCK;
            END IF;
            Z := LOOKUP_NEXT (Z);
         END LOOP;
      END BLOCK;
      R := R@.NEXT;
   END LOOP;
   RETURN FALSE;
END FUNCTION IMPORTED_ROUTINE_USES;

% does MODULES: (...) name a module that declares Y? (4.2: a MODULES item imports all
% the routines the module exports)
FUNCTION MODULE_IMPORTED (MODS: NODE, Y: SYM) RETURNS (BOOLEAN);
   VAR M: SYM := Y@.MODL;
   LOOP UNTIL M = NIL DO
      IF IN_IDENTS (MODS, M@.NAME) THEN
         RETURN TRUE;
      END IF;
      M := M@.MODL;
   END LOOP;
   RETURN FALSE;
END FUNCTION MODULE_IMPORTED;

% NAME of T$NAME
FUNCTION BASE_NAME (Y: SYM) RETURNS (TEXT);
   IF Y@.PREFIX.LEN = 0 ! Y@.NAME.LEN <= Y@.PREFIX.LEN + 1 THEN
      RETURN Y@.NAME;                                 % no prefix, or the short alias
   END IF;
   RETURN MKN (STR (Y@.NAME, Y@.NAME.LEN)[Y@.PREFIX.LEN + 1 : Y@.NAME.LEN - 1]);
END FUNCTION BASE_NAME;

% is there a handler for the exception NAME around here, in this closed scope, or does
% the closed scope signal it (3.5.6.1, 4.5.7)?
FUNCTION HANDLER_EXISTS (NAME: TEXT) RETURNS (BOOLEAN);
   VAR C: CTX := W@.CTXS;
   LOOP UNTIL C = NIL DO
      IF C@.KIND = 1 THEN
         EXIT;
      END IF;
      IF C@.KIND = 3 THEN
         BLOCK
            VAR H: NODE := C@.HANDLERS;
            LOOP UNTIL H = NIL DO
               IF IN_IDENTS (H@.A, NAME) THEN
                  RETURN TRUE;
               END IF;
               H := H@.NEXT;
            END LOOP;
         END BLOCK;
      END IF;
      C := C@.NEXT;
   END LOOP;
   IF W@.IS <> NIL THEN
      IF IN_IDENTS (W@.IS@.SIGNALS, NAME) THEN
         RETURN TRUE;
      END IF;
   END IF;
   RETURN TEQS (NAME, 'TERMINATED');
END FUNCTION HANDLER_EXISTS;
