
% ==== closed scopes: segments (4.2), routines (4.3), modules (4.4) ========================
% A closed-scope-body [4-2] is translated in this order: its type declarations and the
% declarations of its modules and routines (known throughout the scope, 4.1), its
% objects, the objects of its modules (initialized after those of the scope, 4.1), its
% statements, then the bodies of its routines and of the routines of its modules.

PROCEDURE ENTER_ISCOPE (IMPORTS, SIGNALS: NODE, NAME: TEXT);
   VAR I: ISCOPE := NEW (ISCOPE_REC);
   W@.NSCOPES := W@.NSCOPES + 1;
   I@ := (ID: W@.NSCOPES, IMPORTS: IMPORTS, SIGNALS: SIGNALS, NAME: NAME, UP: W@.IS);
   W@.IS := I;
END PROCEDURE ENTER_ISCOPE;

PROCEDURE LEAVE_ISCOPE ();
   W@.IS := W@.IS@.UP;
END PROCEDURE LEAVE_ISCOPE;

% a C name for a routine, unique in the program
FUNCTION ROUTINE_CNAME (NAME: TEXT) RETURNS (TEXT);
   VAR BASE: TEXT := FMT1 ('r_@', CID (NAME));
   CONST S: ASCII_STR(BASE.LEN) := STR (BASE, BASE.LEN);
   VAR N: NODE := W@.CNAMES;
   LOOP FOR I IN [0 : BASE.LEN - 1] DO                % T$NAME
      IF S[I:I] = '$' THEN
         BASE := MK (S[0 : I - 1] !! '__' !! S[I + 1 : BASE.LEN - 1]);
      END IF;
   END LOOP I;
   LOOP UNTIL N = NIL DO
      IF TEQ (N@.NAME, BASE) THEN
         RETURN FMT2 ('@_@', BASE, NEW_NAME (''));
      END IF;
      N := N@.NEXT;
   END LOOP;
   N := NEW_NODE (N_IDENT, 0);
   N@.NAME := BASE;
   N@.NEXT := W@.CNAMES;
   W@.CNAMES := N;
   RETURN BASE;
END FUNCTION ROUTINE_CNAME;

% does a body need a heap frame: nested routines or modules, or exceptions clauses?
FUNCTION NEEDS_FRAME (B: NODE) RETURNS (BOOLEAN);
   IF B = NIL THEN
      RETURN FALSE;
   END IF;
   IF B@.C <> NIL THEN
      RETURN TRUE;
   END IF;
   RETURN HAS_HANDLERS (B@.B);
END FUNCTION NEEDS_FRAME;

FUNCTION HAS_HANDLERS (S0: NODE) RETURNS (BOOLEAN);
   VAR S: NODE := S0;
   LOOP UNTIL S = NIL DO
      IF S@.KIND = N_EXCEPT ! S@.KIND = N_PAR THEN
         RETURN TRUE;
      END IF;
      IF S@.KIND = N_LABELED ! S@.KIND = N_WITH THEN
         IF HAS_HANDLERS (S@.A) ! HAS_HANDLERS (S@.B) THEN
            RETURN TRUE;
         END IF;
      ORIF S@.KIND = N_BLOCK THEN
         IF HAS_HANDLERS (S@.A@.B) THEN
            RETURN TRUE;
         END IF;
      ORIF S@.KIND = N_LOOP ! S@.KIND = N_FOR THEN
         IF HAS_HANDLERS (S@.B@.B) THEN
            RETURN TRUE;
         END IF;
      ORIF S@.KIND = N_IF ! S@.KIND = N_CASE THEN
         BLOCK
            VAR A: NODE := S@.A;
            IF S@.KIND = N_CASE THEN
               A := S@.B;
               IF S@.D <> NIL THEN
                  RETURN TRUE;
               END IF;
               IF S@.C <> NIL THEN
                  IF HAS_HANDLERS (S@.C@.B) THEN
                     RETURN TRUE;
                  END IF;
               END IF;
            ORIF S@.B <> NIL THEN
               IF HAS_HANDLERS (S@.B@.B) THEN
                  RETURN TRUE;
               END IF;
            END IF;
            LOOP UNTIL A = NIL DO
               IF A@.C <> NIL THEN
                  RETURN TRUE;
               END IF;
               IF HAS_HANDLERS (A@.B@.B) THEN
                  RETURN TRUE;
               END IF;
               A := A@.NEXT;
            END LOOP;
         END BLOCK;
      END IF;
      S := S@.NEXT;
   END LOOP;
   RETURN FALSE;
END FUNCTION HAS_HANDLERS;

% the symbol of a routine declaration, and of its short name if it is T$NAME (4.4)
PROCEDURE DECLARE_ROUTINE_SYM (R: NODE);
   VAR Y: SYM := NEW_SYM (Y_ROUTINE, R@.NAME);
   CONST S: ASCII_STR(R@.NAME.LEN) := STR (R@.NAME, R@.NAME.LEN);
   Y@.DECL := R;
   Y@.ACCESS := ROUTINE_CNAME (R@.NAME);
   Y@.FRAMED := NEEDS_FRAME (R@.C);
   IF W@.CS@.LEVEL >= 1 THEN
      Y@.FIELD := W@.CS@.FTYPE;
   END IF;
   DEFINE (Y, R@.LINE);
   LOOP FOR I IN [1 : R@.NAME.LEN - 2] DO
      IF S[I:I] = '$' THEN
         Y@.PREFIX := MKN (S[0 : I - 1]);
         BLOCK
            VAR SHORT: SYM := NEW_SYM (Y_ROUTINE, MKN (S[I + 1 : R@.NAME.LEN - 1]));
            SHORT@.ORIG := Y;
            SHORT@.PREFIX := Y@.PREFIX;
            SHORT@.DECL := R;
            DEFINE (SHORT, R@.LINE);
         END BLOCK;
         EXIT;
      END IF;
   END LOOP I;
END PROCEDURE DECLARE_ROUTINE_SYM;

% the names declared by the routines-and-modules of a body, and their headers
PROCEDURE DECLARE_MEMBERS (RS: NODE);
   VAR R: NODE := RS;
   LOOP UNTIL R = NIL DO
      IF R@.KIND = N_MODULE THEN
         PREDECLARE_MODULE (R);
      ELSE
         DECLARE_ROUTINE_SYM (R);
      END IF;
      R := R@.NEXT;
   END LOOP;
END PROCEDURE DECLARE_MEMBERS;

PROCEDURE ROUTINE_HEADERS (RS: NODE);
   VAR R: NODE := RS;
   LOOP UNTIL R = NIL DO
      IF R@.KIND = N_MODULE THEN
         BLOCK
            CONST M: SYM := FIND_DECL (R);
            ENTER_MODULE (M);
            ROUTINE_HEADERS (R@.C@.C);
            LEAVE_MODULE (M);
         END BLOCK;
      ELSE
         BLOCK
            CONST Y: SYM := FIND_DECL (R);
            ROUTINE_HEADER (Y);
         END BLOCK;
      END IF;
      R := R@.NEXT;
   END LOOP;
END PROCEDURE ROUTINE_HEADERS;

% the symbol declared by the declaration D, visible here
% two routines declared in one scope with one name have different signatures
% (4.1, p.4-4), whether or not they are invoked
PROCEDURE DISTINCT_SIGNATURES (RS: NODE);
   VAR R: NODE := RS;
   LOOP UNTIL R = NIL DO
      IF R@.KIND = N_ROUTINE THEN
         BLOCK
            VAR Q: NODE := R@.NEXT;
            LOOP UNTIL Q = NIL DO
               IF Q@.KIND = N_ROUTINE & TEQ (Q@.NAME, R@.NAME) THEN
                  BLOCK
                     CONST A: SYM := FIND_DECL (R);
                     CONST B: SYM := FIND_DECL (Q);
                     ROUTINE_HEADER (A);
                     ROUTINE_HEADER (B);
                     IF SAME_SIGNATURE (A, B) THEN
                        FAILT (Q@.LINE, 'two routines of one scope with the same signature (4.1): ',
                               Q@.NAME);
                     END IF;
                  END BLOCK;
               END IF;
               Q := Q@.NEXT;
            END LOOP;
         END BLOCK;
      END IF;
      R := R@.NEXT;
   END LOOP;
END PROCEDURE DISTINCT_SIGNATURES;

FUNCTION FIND_DECL (D: NODE) RETURNS (SYM);
   VAR Y: SYM := LOOKUP (D@.NAME);
   LOOP UNTIL Y = NIL DO
      IF Y@.DECL = D & Y@.ORIG = NIL THEN
         RETURN Y;
      END IF;
      Y := LOOKUP_NEXT (Y);
   END LOOP;
   FAILT (D@.LINE, 'lost the declaration of ', D@.NAME);
END FUNCTION FIND_DECL;

% enumerated types are resolved at once: their literals belong to the scope
PROCEDURE RESOLVE_ENUM_TYPES (DECLS: NODE);
   VAR D: NODE := DECLS;
   LOOP UNTIL D = NIL DO
      IF D@.KIND = N_TYPE & D@.A = NIL THEN
         IF D@.B@.KIND = TS_ENUM THEN
            BLOCK
               CONST Y: SYM := FIND_DECL (D);
               CONST T: TYP := RESOLVE_USER (TYPE_REF (D));
            END BLOCK;
         END IF;
      END IF;
      D := D@.NEXT;
   END LOOP;
END PROCEDURE RESOLVE_ENUM_TYPES;

FUNCTION TYPE_REF (D: NODE) RETURNS (NODE);
   VAR TS: NODE := NEW_NODE (TS_NAME, D@.LINE);
   TS@.NAME := D@.NAME;
   RETURN TS;
END FUNCTION TYPE_REF;

% ---- modules [4-45] -------------------------------------------------------------------------

% the module's types, routines and nested modules are declared in its own scope, which
% is then put aside; what it exports is declared outside (4.1.2)
PROCEDURE PREDECLARE_MODULE (M: NODE);
   VAR Y: SYM := NEW_SYM (Y_MODULE, M@.NAME);
   CONST SAVED: SYM := W@.MODL;
   Y@.DECL := M;
   DEFINE (Y, M@.LINE);
   IF M@.C@.B <> NIL THEN
      FAIL (M@.LINE, 'a module body has no statements (4.4)');
   END IF;
   OPEN_SCOPE;
   BLOCK
      CONST MARK: SYM := W@.SCOPE;
      W@.MODL := Y;
      DECLARE_TYPES (M@.C@.A);
      DECLARE_MEMBERS (M@.C@.C);
      RESOLVE_ENUM_TYPES (M@.C@.A);
      Y@.MEMBERS := TAKE_SCOPE (MARK);
   END BLOCK;
   W@.MODL := SAVED;
   CLOSE_SCOPE;
   EXPORT_MODULE (Y);
END PROCEDURE PREDECLARE_MODULE;

% make the members of the module M visible again, in a new scope
PROCEDURE ENTER_MODULE (M: SYM);
   VAR Y: SYM := M@.MEMBERS;
   OPEN_SCOPE;
   LOOP UNTIL Y = NIL DO
      BLOCK
         CONST NEXT: SYM := Y@.SNEXT;
         DEFINE (Y, 0);
         Y := NEXT;
      END BLOCK;
   END LOOP;
   M@.BUSY := TRUE;
   M@.FWD.H := W@.SCOPE@.DEPTH;
   M@.SAVED := W@.MODL;
   W@.MODL := M;
   ENTER_ISCOPE (M@.DECL@.A, NIL, M@.NAME);
END PROCEDURE ENTER_MODULE;

PROCEDURE LEAVE_MODULE (M: SYM);
   VAR MARK: SYM := W@.SCOPE;
   LEAVE_ISCOPE;
   W@.MODL := M@.SAVED;
   % the scope of the module is what was defined at its depth
   LOOP UNTIL MARK = NIL DO
      IF MARK@.DEPTH < W@.DEPTH THEN
         EXIT;
      END IF;
      MARK := MARK@.SNEXT;
   END LOOP;
   M@.MEMBERS := TAKE_SCOPE (MARK);
   W@.DEPTH := W@.DEPTH - 1;
   M@.BUSY := FALSE;
END PROCEDURE LEAVE_MODULE;

% the module that declares G, entered if it is not the one being translated
PROCEDURE ENTER_MODULE_OF (G: SYM);
   IF G@.MODL <> NIL THEN
      IF NOT IN_MODULE (G@.MODL) & NOT G@.MODL@.BUSY THEN
         ENTER_MODULE (G@.MODL);
      END IF;
   END IF;
END PROCEDURE ENTER_MODULE_OF;

% the module that declares G, entered if the translation is outside it: was it?
FUNCTION ENTER_MODULE_FOR (G: SYM) RETURNS (BOOLEAN);
   IF G@.MODL <> NIL THEN
      IF NOT IN_MODULE (G@.MODL) & NOT G@.MODL@.BUSY THEN
         ENTER_MODULE (G@.MODL);
         RETURN TRUE;
      END IF;
   END IF;
   RETURN FALSE;
END FUNCTION ENTER_MODULE_FOR;

PROCEDURE LEAVE_MODULE_OF (G: SYM);
   IF G@.MODL <> NIL THEN
      IF W@.MODL = G@.MODL & G@.MODL@.BUSY & W@.DEPTH = G@.MODL@.FWD.H THEN
         LEAVE_MODULE (G@.MODL);
      END IF;
   END IF;
END PROCEDURE LEAVE_MODULE_OF;

% EXPORTS (names [WITH (operations)]) or EXPORTS ALL [4-50]
PROCEDURE EXPORT_MODULE (M: SYM);
   CONST D: NODE := M@.DECL;
   VAR Y: SYM := M@.MEMBERS;
   LOOP UNTIL Y = NIL DO
      IF EXPORTED_BY (D, Y) THEN
         Y@.EXPORTED := TRUE;
         BLOCK
            VAR A: SYM := NEW_SYM (Y@.KIND, Y@.NAME);
            A@ := Y@;
            A@.ORIG := ORIGINAL (Y);
            A@.DEPTH := W@.DEPTH;
            DEFINE (A, D@.LINE);
         END BLOCK;
      END IF;
      Y := Y@.SNEXT;
   END LOOP;
   BLOCK                                             % every name listed must exist
      VAR X: NODE := D@.B;
      LOOP UNTIL X = NIL DO
         IF NOT MEMBER_NAMED (M, X@.NAME) THEN
            FAILT (X@.LINE, 'the module does not declare ', X@.NAME);
         END IF;
         CHECK_EXPORT_ITEM (M, X);
         X := X@.NEXT;
      END LOOP;
   END BLOCK;
END PROCEDURE EXPORT_MODULE;

% only type and routine names are exported, and only a type-name takes a WITH
% clause, listing operations of the type (4.4)
PROCEDURE CHECK_EXPORT_ITEM (M: SYM, X: NODE);
   VAR Y: SYM := M@.MEMBERS;
   VAR IS_TYPE, IS_ROUTINE: BOOLEAN := FALSE;
   LOOP UNTIL Y = NIL DO
      IF TEQ (Y@.NAME, X@.NAME) THEN
         IF Y@.KIND = Y_TYPE THEN
            IS_TYPE := TRUE;
         ORIF Y@.KIND = Y_ROUTINE ! Y@.KIND = Y_MODULE ! Y@.KIND = Y_ENUMLIT THEN
            IS_ROUTINE := TRUE;
         END IF;
      ORIF TEQ (Y@.PREFIX, X@.NAME) THEN
         IS_ROUTINE := TRUE;
      END IF;
      Y := Y@.SNEXT;
   END LOOP;
   IF NOT IS_TYPE & NOT IS_ROUTINE THEN
      FAILT (X@.LINE, 'only type and routine names are exported (4.4): ', X@.NAME);
   END IF;
   IF X@.A <> NIL THEN
      IF NOT IS_TYPE THEN
         FAILT (X@.LINE, 'only a type-name is followed by a WITH clause (4.4): ', X@.NAME);
      END IF;
      BLOCK
         VAR OP: NODE := X@.A;
         LOOP UNTIL OP = NIL DO
            BLOCK
               VAR FOUND: BOOLEAN := FALSE;
               Y := M@.MEMBERS;
               LOOP UNTIL Y = NIL DO
                  IF Y@.KIND = Y_ROUTINE & TEQ (Y@.PREFIX, X@.NAME) THEN
                     IF TEQ (BASE_NAME (ORIGINAL (Y)), OP@.NAME) THEN
                        FOUND := TRUE;
                     END IF;
                  END IF;
                  Y := Y@.SNEXT;
               END LOOP;
               IF NOT FOUND THEN
                  FAILT (OP@.LINE, 'a WITH clause lists operations of the type (4.4): ', OP@.NAME);
               END IF;
            END BLOCK;
            OP := OP@.NEXT;
         END LOOP;
      END BLOCK;
   END IF;
END PROCEDURE CHECK_EXPORT_ITEM;

FUNCTION MEMBER_NAMED (M: SYM, NAME: TEXT) RETURNS (BOOLEAN);
   VAR Y: SYM := M@.MEMBERS;
   LOOP UNTIL Y = NIL DO
      IF TEQ (Y@.NAME, NAME) ! TEQ (Y@.PREFIX, NAME) THEN
         RETURN TRUE;
      END IF;
      Y := Y@.SNEXT;
   END LOOP;
   RETURN FALSE;
END FUNCTION MEMBER_NAMED;

% is the member Y exported by the module declaration D? A type takes its operations
% (T$NAME, or those of its WITH list) and its literals along (4.4)
FUNCTION EXPORTED_BY (D: NODE, Y: SYM) RETURNS (BOOLEAN);
   VAR X: NODE := D@.B;
   IF Y@.KIND = Y_VAR ! Y@.KIND = Y_CONST ! Y@.KIND = Y_LABEL THEN
      RETURN FALSE;                                   % data is not exported (4.1.2)
   END IF;
   IF D@.FL = 1 THEN                                  % EXPORTS ALL
      RETURN Y@.KIND = Y_TYPE ! Y@.KIND = Y_ROUTINE ! Y@.KIND = Y_ENUMLIT
         ! Y@.KIND = Y_MODULE;
   END IF;
   LOOP UNTIL X = NIL DO
      IF TEQ (X@.NAME, Y@.NAME) THEN
         RETURN TRUE;
      END IF;
      IF Y@.KIND = Y_ROUTINE & TEQ (X@.NAME, Y@.PREFIX) THEN
         IF X@.A = NIL THEN
            RETURN TRUE;
         END IF;
         IF IN_IDENTS (X@.A, BASE_NAME (ORIGINAL (Y))) THEN
            RETURN TRUE;
         END IF;
      END IF;
      IF Y@.KIND = Y_ENUMLIT THEN                     % the literals of an exported type
         BLOCK
            CONST T: SYM := ORIG_LOOKUP_MEMBER (X@.NAME, Y);
            IF T <> NIL THEN
               RETURN TRUE;
            END IF;
         END BLOCK;
      END IF;
      X := X@.NEXT;
   END LOOP;
   RETURN FALSE;
END FUNCTION EXPORTED_BY;

% the exported type NAME, if the literal Y is one of its literals
FUNCTION ORIG_LOOKUP_MEMBER (NAME: TEXT, Y: SYM) RETURNS (SYM);
   CONST M: SYM := Y@.MODL;
   VAR Z: SYM;
   IF M = NIL THEN
      RETURN NIL;
   END IF;
   Z := M@.MEMBERS;
   LOOP UNTIL Z = NIL DO
      IF Z@.KIND = Y_TYPE & TEQ (Z@.NAME, NAME) THEN
         IF Z@.T <> NIL THEN
            IF Z@.T@.KIND = T_ENUM THEN
               IF Z@.T@.BASE = Y@.T@.BASE THEN
                  RETURN Z;
               END IF;
            END IF;
         END IF;
      END IF;
      Z := Z@.SNEXT;
   END LOOP;
   RETURN NIL;
END FUNCTION ORIG_LOOKUP_MEMBER;

% the objects of the modules of a body, after those of the scope (4.1)
PROCEDURE MODULE_DATA (RS: NODE);
   VAR R: NODE := RS;
   LOOP UNTIL R = NIL DO
      IF R@.KIND = N_MODULE THEN
         BLOCK
            CONST M: SYM := FIND_DECL (R);
            VAR D: NODE := R@.C@.A;
            ENTER_MODULE (M);
            LOOP UNTIL D = NIL DO
               IF D@.KIND = N_VAR ! D@.KIND = N_CONST THEN
                  DECLARE_OBJECTS (D);
               END IF;
               D := D@.NEXT;
            END LOOP;
            MODULE_DATA (R@.C@.C);
            DISTINCT_SIGNATURES (R@.C@.C);
            ROUTINE_USES (R@.C@.C);
            LEAVE_MODULE (M);
         END BLOCK;
      END IF;
      R := R@.NEXT;
   END LOOP;
END PROCEDURE MODULE_DATA;

% the bodies of the routines of a body and of its modules
PROCEDURE ROUTINE_BODIES (RS: NODE);
   VAR R: NODE := RS;
   LOOP UNTIL R = NIL DO
      IF R@.KIND = N_MODULE THEN
         BLOCK
            CONST M: SYM := FIND_DECL (R);
            ENTER_MODULE (M);
            ROUTINE_BODIES (R@.C@.C);
            LEAVE_MODULE (M);
         END BLOCK;
      ELSE
         BLOCK
            CONST Y: SYM := FIND_DECL (R);
            IF Y@.DECL@.FL = 1 & NOT Y@.GENERIC THEN  % INLINE: expanded where invoked;
               ;                                      % its own body only when needed
            ORIF NOT Y@.GENERIC THEN
               ROUTINE_BODY (Y);
            END IF;
         END BLOCK;
      END IF;
      R := R@.NEXT;
   END LOOP;
END PROCEDURE ROUTINE_BODIES;

% the instances made for generics declared at this level
PROCEDURE PENDING_BODIES ();
   CONST LEVEL: INTEGER := CUR_LEVEL ();
   VAR MORE: BOOLEAN := TRUE;
   LOOP UNTIL NOT MORE DO
      MORE := FALSE;
      BLOCK
         VAR P: SYM := W@.PENDING;
         VAR PREV: SYM := NIL;
         LOOP UNTIL P = NIL DO
            IF P@.LEVEL = LEVEL THEN
               IF PREV = NIL THEN
                  W@.PENDING := P@.MEMBERS;
               ELSE
                  PREV@.MEMBERS := P@.MEMBERS;
               END IF;
               BLOCK                                  % an instance is its generic's
                  CONST SAVED_SEG: SYM := W@.CURSEG;  % code: no USES check, in the
                  CONST HOME: SYM := ENTER_HOME (P);  % scope of its segment
                  W@.CURSEG := P@.HOME;
                  ENTER_MODULE_OF (P);
                  ROUTINE_BODY (P);
                  LEAVE_MODULE_OF (P);
                  W@.CURSEG := SAVED_SEG;
                  LEAVE_HOME (P, HOME);
               END BLOCK;
               MORE := TRUE;
               EXIT;
            END IF;
            PREV := P;
            P := P@.MEMBERS;
         END LOOP;
      END BLOCK;
   END LOOP;
END PROCEDURE PENDING_BODIES;

% a closed-scope-body [4-2] in the closed scope W@.CS
PROCEDURE CLOSED_BODY (B: NODE);
   VAR D: NODE := B@.A;
   VAR S: NODE := B@.B;
   DECLARE_TYPES (B@.A);
   DECLARE_MEMBERS (B@.C);
   RESOLVE_ENUM_TYPES (B@.A);
   % the headers of the routines may use the constants (and the objects may call the
   % routines: a call resolves the header it needs)
   LOOP UNTIL D = NIL DO
      IF D@.KIND = N_VAR ! D@.KIND = N_CONST THEN
         DECLARE_OBJECTS (D);
      END IF;
      D := D@.NEXT;
   END LOOP;
   MODULE_DATA (B@.C);
   ROUTINE_HEADERS (B@.C);
   DISTINCT_SIGNATURES (B@.C);
   ROUTINE_USES (B@.C);
   DECLARE_LABELS (B@.B);
   LOOP UNTIL S = NIL DO
      STMT (S);
      S := S@.NEXT;
   END LOOP;
   ROUTINE_BODIES (B@.C);
   PENDING_BODIES;
END PROCEDURE CLOSED_BODY;

% ---- routines [4-17] [4-30] -----------------------------------------------------------------

PROCEDURE ROUTINE_BODY (Y: SYM);
   CONST R: NODE := Y@.DECL;
   CONST SAVED_CODE: BUF := W@.CODE;
   CONST SAVED_CTXS: CTX := W@.CTXS;
   CONST SAVED_BINDS: BIND := W@.BINDS;
   CONST OUTER: CSCOPE := W@.CS;
   VAR CS: CSCOPE := NEW (SCOPE_REC);
   VAR PROLOGUE: TEXT := MK ('');
   CS@ := (LEVEL: Y@.LEVEL + 1, R: Y, FRAMED: Y@.FRAMED, FTYPE: FMT1 ('fr_@', Y@.ACCESS),
           FIELDS: (HEAD: NIL, TAIL: NIL), UP: OUTER, IMPORTS: R@.E, SIGNALS: R@.D@.A,
           RESULT: Y@.RESULT, IS_PATH: FALSE, COPYOUT: MK (''));
   IF Y@.FRAMED THEN
      EMIT (O_TYPEDEFS, FMT2 ('typedef struct @ @;', CS@.FTYPE, CS@.FTYPE));
      IF Y@.LEVEL >= 1 THEN
         APPEND (FMT1 (' @ *up;', Y@.FIELD) # CS@.FIELDS);
      ELSE
         APPEND (MK (' void *up;') # CS@.FIELDS);
      END IF;
      PROLOGUE := FMT2 ('@ *F = rt_alloc(sizeof *F); (void)F;', CS@.FTYPE, CS@.FTYPE);
      IF Y@.LEVEL >= 1 THEN
         PROLOGUE := CATS (PROLOGUE, ' F->up = up_;');
      END IF;
   END IF;
   W@.CS := CS;
   W@.CODE := (HEAD: NIL, TAIL: NIL);
   W@.CTXS := NIL;
   W@.BINDS := Y@.BINDINGS;
   PUSH_CTX (1, NO_TEXT ());
   ENTER_ISCOPE (R@.E, R@.D@.A, Y@.NAME);
   OPEN_SCOPE;
   BIND_INSTANCE (Y@.BINDINGS, R@.LINE);
   BLOCK                                             % the formal parameters
      VAR P: PARM := Y@.PARAMS;
      LOOP UNTIL P = NIL DO
         IF P@.T <> NIL THEN
            IF REAL_TYPE (P@.T)@.KIND <> T_VOID THEN
               BLOCK
                  VAR V: SYM := NEW_SYM (Y_VAR, P@.NAME);
                  CONST MB: BIND := FIND_BIND (Y@.BINDINGS, MKN ('=' !! STR (P@.NAME, P@.NAME.LEN)));
                  V@.T := P@.T;
                  V@.INPUT := P@.MODE = M_IN;
                  IF MB <> NIL THEN                    % an INLINE expansion's manifest
                     V@.HASMV := MB@.HASMV;            % argument (4.3.1)
                     V@.MV := MB@.MV;
                  END IF;
                  V@.BYREF := P@.MODE <> M_IN;
                  V@.FIELD := FMT1 ('p_@', CID (P@.NAME));
                  IF Y@.FRAMED THEN
                     IF V@.BYREF THEN
                        APPEND (FMT2 (' @ *p_@;', CTYPE (P@.T), CID (P@.NAME)) # CS@.FIELDS);
                        V@.ACCESS := FMT1 ('(*F->p_@)', CID (P@.NAME));
                     ELSE
                        APPEND (FMT2 (' @ p_@;', CTYPE (P@.T), CID (P@.NAME)) # CS@.FIELDS);
                        V@.ACCESS := FMT1 ('F->p_@', CID (P@.NAME));
                     END IF;
                     PROLOGUE := FMT3 ('@ F->p_@ = p_@;', PROLOGUE, CID (P@.NAME), CID (P@.NAME));
                  ORIF V@.BYREF THEN
                     V@.ACCESS := FMT1 ('(*p_@)', CID (P@.NAME));
                  ELSE
                     V@.ACCESS := FMT1 ('p_@', CID (P@.NAME));
                  END IF;
                  IF P@.MODE = M_OUT THEN
                     % an output is a local object, stored into the argument only
                     % when the procedure completes normally (4.3.2)
                     BLOCK
                        CONST ARGA: TEXT := V@.ACCESS;
                        DEFINE_PARAM_GENS (P@.T, ARGA, R@.LINE, TRUE);
                        V@.BYREF := FALSE;
                        IF Y@.FRAMED THEN
                           APPEND (FMT2 (' @ o_@;', CTYPE (P@.T), CID (P@.NAME)) # CS@.FIELDS);
                           V@.ACCESS := FMT1 ('F->o_@', CID (P@.NAME));
                        ELSE
                           PROLOGUE := FMT3 ('@ @ o_@;', PROLOGUE, CTYPE (P@.T), CID (P@.NAME));
                           V@.ACCESS := FMT1 ('o_@', CID (P@.NAME));
                        END IF;
                        PROLOGUE := FMT3 ('@ @ = @;', PROLOGUE, V@.ACCESS, ARGA);
                        IF NEEDS_INIT (P@.T) THEN
                           PROLOGUE := FMT3 ('@ @ = @;', PROLOGUE, V@.ACCESS, COPY_OF (P@.T, ARGA));
                        END IF;
                        CS@.COPYOUT := CAT (CS@.COPYOUT, ASSIGN_CODE (P@.T, ARGA, V@.ACCESS));
                        DEFINE (V, R@.LINE);
                     END BLOCK;
                  ELSE
                     DEFINE (V, R@.LINE);
                     DEFINE_PARAM_GENS (P@.T, V@.ACCESS, R@.LINE, TRUE);
                  END IF;
               END BLOCK;
            END IF;
         END IF;
         P := P@.NEXT;
      END LOOP;
   END BLOCK;
   IF R@.FL >= 2 THEN                                % TARGET: no machine code here (4.8.2)
      BLOCK                                          % the stack-size: a manifest integer
         CONST N: NODE := R@.D@.C;                   % >= 0 [4-111]
         CONST SAVED_CODE: BUF := W@.CODE;
         CONST V: ET := EXPR (N, W@.TY_INT);
         CONST M: MVAL := MANIFEST (N);
         W@.CODE := SAVED_CODE;
         IF REAL_TYPE (V.T)@.KIND <> T_INT ! REAL_TYPE (V.T)@.SCALE <> 0 ! NOT M.OK THEN
            FAIL (N@.LINE, 'the stack-size is a manifest integer expression (4.8.2 [4-111])');
         END IF;
         IF M.V < 0 THEN
            FAIL (N@.LINE, 'the stack-size must be greater than or equal to zero (4.8.2)');
         END IF;
      END BLOCK;
      CODE (FMT1 ('rt_b_no_target_code(@);', CSTRING (R@.NAME)));
   ELSE
      CLOSED_BODY (R@.C);
   END IF;
   CLOSE_SCOPE;
   LEAVE_ISCOPE;
   IF Y@.FRAMED THEN
      EMIT (O_STRUCTS, FMT2 ('struct @ {@ };', CS@.FTYPE, JOIN_BUF (CS@.FIELDS)));
   END IF;
   EMIT (O_FUNCS, FMT2 ('@ { RT_B_TICK(); @', Y@.FWD, PROLOGUE));
   APPEND_BUF (W@.CODE # W@.OUT(O_FUNCS));
   IF Y@.RESULT@.KIND <> T_VOID THEN                 % 4.3.2: no value to return
      EMITS (O_FUNCS, 'rt_raise(RT_X_INIT);');
   ORIF CS@.COPYOUT.LEN > 0 THEN
      EMIT (O_FUNCS, CS@.COPYOUT);
   END IF;
   EMITS (O_FUNCS, '}');
   W@.CS := OUTER;
   W@.CODE := SAVED_CODE;
   W@.CTXS := SAVED_CTXS;
   W@.BINDS := SAVED_BINDS;
END PROCEDURE ROUTINE_BODY;

% inside an instance, the generic parameters are declared: types, and values
PROCEDURE BIND_INSTANCE (BS: BIND, LINE: INTEGER);
   VAR B: BIND := BS;
   LOOP UNTIL B = NIL DO
      IF B@.T <> NIL THEN
         BLOCK
            VAR Y: SYM := NEW_SYM (Y_TYPE, B@.NAME);
            Y@.T := B@.T;
            DEFINE (Y, LINE);
         END BLOCK;
      ORIF B@.HASMV THEN
         BLOCK
            VAR Y: SYM := NEW_SYM (Y_GEN, B@.NAME);
            Y@.T := W@.TY_INT;
            Y@.HASMV := TRUE;
            Y@.MV := B@.MV;
            Y@.ACCESS := B@.C;
            Y@.INPUT := TRUE;
            DEFINE (Y, LINE);
         END BLOCK;
      END IF;
      B := B@.NEXT;
   END LOOP;
END PROCEDURE BIND_INSTANCE;

PROCEDURE APPEND_BUF (SRC: BUF # DST: BUF);
   VAR C: CHUNK := SRC.HEAD;
   LOOP UNTIL C = NIL DO
      APPEND (C@.T # DST);
      C := C@.NEXT;
   END LOOP;
END PROCEDURE APPEND_BUF;

% ---- segments [4-4] and the program ---------------------------------------------------------

FUNCTION USES_SEGMENT (S: NODE, NAME: ASCII_STR(?L)) RETURNS (BOOLEAN);
   VAR U: NODE := S@.A;
   LOOP UNTIL U = NIL DO
      IF TEQS (U@.NAME, NAME) THEN
         RETURN TRUE;
      END IF;
      U := U@.NEXT;
   END LOOP;
   RETURN FALSE;
END FUNCTION USES_SEGMENT;

% have the segments of this compilation that S uses been translated?
FUNCTION SEGMENT_READY (S, SEGS: NODE) RETURNS (BOOLEAN);
   VAR U: NODE := S@.A;
   LOOP UNTIL U = NIL DO
      BLOCK
         VAR T: NODE := SEGS;
         LOOP UNTIL T = NIL DO
            IF T <> S & T@.D = NIL & TEQ (T@.NAME, U@.NAME) THEN
               RETURN FALSE;
            END IF;
            T := T@.NEXT;
         END LOOP;
      END BLOCK;
      U := U@.NEXT;
   END LOOP;
   RETURN TRUE;
END FUNCTION SEGMENT_READY;

% the first segment named in a USES clause that is not in the compilation
FUNCTION MISSING_SEGMENT (SEGS: NODE) RETURNS (TEXT);
   VAR S: NODE := SEGS;
   LOOP UNTIL S = NIL DO
      BLOCK
         VAR U: NODE := S@.A;
         LOOP UNTIL U = NIL DO
            IF NOT TEQS (U@.NAME, 'TERMINAL') THEN
               BLOCK
                  VAR T: NODE := SEGS;
                  VAR FOUND: BOOLEAN := FALSE;
                  LOOP UNTIL T = NIL DO
                     IF TEQ (T@.NAME, U@.NAME) THEN
                        FOUND := TRUE;
                     END IF;
                     T := T@.NEXT;
                  END LOOP;
                  IF NOT FOUND THEN
                     RETURN U@.NAME;
                  END IF;
               END BLOCK;
            END IF;
            U := U@.NEXT;
         END LOOP;
      END BLOCK;
      S := S@.NEXT;
   END LOOP;
   RETURN NO_TEXT ();
END FUNCTION MISSING_SEGMENT;

PROCEDURE TRANSLATE (SEGS: NODE);
   VAR S: NODE := SEGS;
   VAR MAINS: INTEGER := 0;
   VAR ROOT: CSCOPE := NEW (SCOPE_REC);
   IF SEGS = NIL THEN
      FAIL (0, 'no segment');
   END IF;
   ROOT@ := (LEVEL: 0, R: NIL, FRAMED: FALSE, FTYPE: NO_TEXT (), FIELDS: (HEAD: NIL, TAIL: NIL),
             UP: NIL, IMPORTS: NIL, SIGNALS: NIL, RESULT: NIL, IS_PATH: FALSE, COPYOUT: MK (''));
   W@.CS := ROOT;
   W@.IS := NIL;
   ENTER_ISCOPE (NIL, NIL, MK ('segment'));
   W@.IS@.ID := 0;
   W@.NSCOPES := 0;
   EMITS (O_TYPEDEFS, '#include "paleo.h"');
   EMITS (O_TYPEDEFS, '#include <float.h>');
   EMITS (O_TYPEDEFS, '#include <math.h>');
   EMITS (O_TYPEDEFS, '#include <string.h>');
   EMITS (O_MAINHEAD, 'int main(int argc, char **argv) {');
   EMITS (O_MAINHEAD, 'rt_b_lang();');
   EMITS (O_MAINHEAD, 'rt_init(argc, argv);');
   W@.CODE := (HEAD: NIL, TAIL: NIL);
   W@.CTXS := NIL;
   PUSH_CTX (1, NO_TEXT ());
   % a segment is translated after the segments of this compilation it uses (4.2),
   % otherwise in the order of the text
   LOOP
      S := SEGS;
      LOOP UNTIL S = NIL DO
         IF S@.D = NIL THEN
            IF SEGMENT_READY (S, SEGS) THEN
               EXIT;
            END IF;
         END IF;
         S := S@.NEXT;
      END LOOP;
      IF S = NIL THEN
         EXIT;
      END IF;
      S@.D := S;                                     % translated
      MAINS := MAINS + S@.IV;
      IF S@.IV = 0 & S@.B@.B <> NIL THEN
         FAIL (S@.LINE, 'only the MAIN segment has statements (4.2)');
      END IF;
      OPEN_SCOPE;
      BEGIN_SEGMENT (S);
      IF USES_SEGMENT (S, 'TERMINAL') THEN
         PREDEFINE_TERMINAL;
      END IF;
      CLOSED_BODY (S@.B);
      SEGMENT_EXPORTS (S);
   END LOOP;
   S := SEGS;
   LOOP UNTIL S = NIL DO
      IF S@.D = NIL THEN
         FAILT (S@.LINE, 'the segments use each other: ', S@.NAME);
      END IF;
      S := S@.NEXT;
   END LOOP;
   IF MAINS <> 1 THEN
      FAIL (0, 'a program has exactly one MAIN segment (4.2)');
   END IF;
   BLOCK
      VAR X: NODE := W@.EXCS;
      LOOP UNTIL X = NIL DO
         EMIT (O_GLOBALS, FMT1 ('static int x_@;', CID (X@.NAME)));
         EMIT (O_STARTUP, FMT2 ('x_@ = rt_exc(@);', CID (X@.NAME), CSTRING (X@.NAME)));
         X := X@.NEXT;
      END LOOP;
   END BLOCK;
   APPEND_BUF (W@.CODE # W@.OUT(O_MAIN));
   EMITS (O_MAIN, 'rt_main_done();');
   EMITS (O_MAIN, 'return 0;');
   EMITS (O_MAIN, '}');
END PROCEDURE TRANSLATE;

% what a module named in DEFINES exports comes along with it (Appendix C: STANDARD_IO
% DEFINES (TEXTUAL_IO, BINARY_IO) and the application uses STREAM_FILE, PRINT ...)
FUNCTION FROM_DEFINED_MODULE (S: NODE, Y: SYM) RETURNS (BOOLEAN);
   VAR M: SYM := Y@.MODL;
   IF Y@.ORIG = NIL THEN
      RETURN FALSE;                                   % not an exported name
   END IF;
   LOOP UNTIL M = NIL DO
      IF IN_IDENTS (S@.C, M@.NAME) THEN
         RETURN TRUE;
      END IF;
      M := M@.MODL;
   END LOOP;
   RETURN FALSE;
END FUNCTION FROM_DEFINED_MODULE;

% a segment's DEFINES names stay visible to the segments after it (4.2), which see
% them only as their USES clauses select them (SEG_VISIBLE); the others go
PROCEDURE SEGMENT_EXPORTS (S: NODE);
   VAR MARK: SYM := W@.SCOPE;
   VAR TAKEN: SYM;
   CONST SEG: SYM := W@.CURSEG;
   VAR NAMES: NODE := NIL;
   LOOP UNTIL MARK = NIL DO
      IF MARK@.DEPTH < W@.DEPTH THEN
         EXIT;
      END IF;
      MARK := MARK@.SNEXT;
   END LOOP;
   TAKEN := TAKE_SCOPE (MARK);
   W@.DEPTH := W@.DEPTH - 1;
   BLOCK                                             % only names local to the segment or
      VAR X: NODE := S@.C;                           % imported into it (4.2)
      LOOP UNTIL X = NIL DO
         BLOCK
            VAR Y: SYM := TAKEN;
            VAR FOUND: BOOLEAN := LOOKUP (X@.NAME) <> NIL;
            LOOP UNTIL Y = NIL DO
               IF TEQ (Y@.NAME, X@.NAME) ! TEQ (Y@.PREFIX, X@.NAME) THEN
                  FOUND := TRUE;
               ORIF Y@.KIND = Y_ROUTINE THEN
                  IF TEQ (BASE_NAME (Y), X@.NAME) THEN
                     FOUND := TRUE;
                  END IF;
               END IF;
               Y := Y@.SNEXT;
            END LOOP;
            IF NOT FOUND THEN
               FAILT (X@.LINE, 'DEFINES names a name local to the segment or imported into it (4.2): ',
                      X@.NAME);
            END IF;
            NAMES := NAME_REF (X@.NAME, 0, NIL, NAMES);
         END BLOCK;
         X := X@.NEXT;
      END LOOP;
   END BLOCK;
   LOOP UNTIL TAKEN = NIL DO
      BLOCK
         CONST NEXT: SYM := TAKEN@.SNEXT;
         IF TAKEN@.KIND <> Y_BUILTIN
            & (S@.FL = 1 ! IN_IDENTS (S@.C, TAKEN@.NAME) ! IN_IDENTS (S@.C, TAKEN@.PREFIX)
               ! TAKEN@.KIND = Y_ENUMLIT ! FROM_DEFINED_MODULE (S, TAKEN)
               ! (TAKEN@.KIND = Y_ROUTINE & IN_IDENTS (S@.C, BASE_NAME (TAKEN)))) THEN
            % (DEFINES (NEW) also defines T$NEW: "T$NEW for device-types T", C-5)
            TAKEN@.SEGM := SEG;
            NAMES := NAME_REF (TAKEN@.NAME, 0, NIL, NAMES);
            DEFINE (TAKEN, S@.LINE);
         ORIF TAKEN@.KIND <> Y_BUILTIN THEN          % kept for the generic instances
            TAKEN@.SNEXT := SEG@.MEMBERS;             % made later of its routines
            SEG@.MEMBERS := TAKEN;
         END IF;
         TAKEN := NEXT;
      END BLOCK;
   END LOOP;
   SEG@.USES := NAMES;                               % what it defines, by name
   W@.CURSEG := NIL;
   W@.TRSEG := NIL;
END PROCEDURE SEGMENT_EXPORTS;

% the segment S begins: USES names segments of the program (4.2)
PROCEDURE BEGIN_SEGMENT (S: NODE);
   VAR SEG: SYM := NEW_SYM (Y_SEGMENT, S@.NAME);
   VAR U: NODE := S@.A;
   SEG@.DECL := S;
   SEG@.INSTANCES := W@.SEGS;
   W@.SEGS := SEG;
   LOOP UNTIL U = NIL DO
      IF NOT TEQS (U@.NAME, 'TERMINAL') THEN
         BLOCK
            CONST T: SYM := FIND_SEGMENT (U@.NAME);
            IF T = NIL THEN
               FAILT (U@.LINE, 'USES names a segment of the program (4.2): ', U@.NAME);
            END IF;
            IF U@.A <> NIL THEN                       % each item defined by the segment
               CHECK_ITEMS_DEFINED (T, U@.A@.A);
               CHECK_ITEMS_DEFINED (T, U@.A@.B);
               CHECK_ITEMS_DEFINED (T, U@.A@.C);
               CHECK_ITEMS_DEFINED (T, U@.A@.D);
               CHECK_ITEMS_DEFINED (T, U@.A@.E);
            END IF;
         END BLOCK;
      END IF;
      U := U@.NEXT;
   END LOOP;
   W@.CURSEG := SEG;
   W@.TRSEG := SEG;
   U := S@.A;
   LOOP UNTIL U = NIL DO
      IF U@.A <> NIL THEN
         INPUT_IMPORT_CONFLICT (U@.A, U@.LINE);
      END IF;
      U := U@.NEXT;
   END LOOP;
END PROCEDURE BEGIN_SEGMENT;

% an instance of a generic routine of another segment is translated in the scope
% of that segment: its local names are made visible again (4.2, section 5)
FUNCTION ENTER_HOME (Y: SYM) RETURNS (SYM);
   CONST SAVED: SYM := W@.TRSEG;
   IF Y@.HOME = NIL ! Y@.HOME = W@.TRSEG THEN
      RETURN SAVED;
   END IF;
   OPEN_SCOPE;
   BLOCK
      VAR X: SYM := Y@.HOME@.MEMBERS;
      LOOP UNTIL X = NIL DO
         BLOCK
            VAR A: SYM := NEW_SYM (X@.KIND, X@.NAME);
            A@ := X@;
            A@.ORIG := ORIGINAL (X);
            DEFINE_ALIAS (A);
         END BLOCK;
         X := X@.SNEXT;
      END LOOP;
   END BLOCK;
   W@.TRSEG := Y@.HOME;
   RETURN SAVED;
END FUNCTION ENTER_HOME;

PROCEDURE DEFINE_ALIAS (A: SYM);
   CONST B: INTEGER := BUCKET (A@.NAME);
   A@.DEPTH := W@.DEPTH;
   A@.CHAIN := W@.TABLE(B);
   W@.TABLE(B) := A;
   A@.SNEXT := W@.SCOPE;
   W@.SCOPE := A;
END PROCEDURE DEFINE_ALIAS;

PROCEDURE LEAVE_HOME (Y: SYM, SAVED: SYM);
   IF Y@.HOME = NIL ! Y@.HOME = SAVED THEN
      RETURN;
   END IF;
   CLOSE_SCOPE;
   W@.TRSEG := SAVED;
END PROCEDURE LEAVE_HOME;

FUNCTION FIND_SEGMENT (NAME: TEXT) RETURNS (SYM);
   VAR T: SYM := W@.SEGS;
   LOOP UNTIL T = NIL DO
      IF TEQ (T@.NAME, NAME) THEN
         RETURN T;
      END IF;
      T := T@.INSTANCES;
   END LOOP;
   RETURN NIL;
END FUNCTION FIND_SEGMENT;

PROCEDURE CHECK_ITEMS_DEFINED (T: SYM, L: NODE);
   VAR N: NODE := L;
   LOOP UNTIL N = NIL DO
      IF NOT IN_IDENTS (T@.USES, N@.NAME) THEN
         FAILT (N@.LINE, 'the segment does not define ', N@.NAME);
      END IF;
      N := N@.NEXT;
   END LOOP;
END PROCEDURE CHECK_ITEMS_DEFINED;

% may the segment being translated use Y, a name another segment defines (4.2)?
% FALSE: only for input (a DATA input item); an error if its USES clause does not
% select it
FUNCTION SEG_VISIBLE (Y: SYM, LINE: INTEGER) RETURNS (BOOLEAN);
   VAR U: NODE;
   VAR INPUT_ONLY: BOOLEAN := FALSE;
   IF W@.CURSEG = NIL ! Y@.SEGM = NIL ! W@.IN_TYPEDECL > 0 ! W@.IN_RECORD > 0 THEN
      RETURN TRUE;                                   % (a declaration's own code)
   END IF;
   IF Y@.SEGM = W@.CURSEG THEN
      RETURN TRUE;
   END IF;
   U := W@.CURSEG@.DECL@.A;
   LOOP UNTIL U = NIL DO
      BLOCK
         CONST T: SYM := FIND_SEGMENT (U@.NAME);
         IF T <> NIL THEN
            IF IN_IDENTS (T@.USES, Y@.NAME) THEN
               IF U@.A = NIL THEN
                  RETURN TRUE;                        % all it defines, variables inout
               END IF;
               BLOCK
                  CONST I: NODE := U@.A;
                  IF Y@.KIND = Y_VAR ! Y@.KIND = Y_CONST THEN
                     IF IN_IDENTS (I@.B, Y@.NAME) THEN
                        RETURN TRUE;
                     ORIF IN_IDENTS (I@.A, Y@.NAME) THEN
                        INPUT_ONLY := TRUE;
                     END IF;
                  ORIF Y@.KIND = Y_ROUTINE THEN
                     IF IN_IDENTS (I@.C, Y@.NAME) ! IN_IDENTS (I@.C, BASE_NAME (Y))
                        ! IN_IDENTS (I@.D, Y@.PREFIX) ! FROM_MODULES (I@.E, Y) THEN
                        RETURN TRUE;
                     END IF;
                  ORIF Y@.KIND = Y_TYPE THEN
                     IF IN_IDENTS (I@.D, Y@.NAME) ! FROM_MODULES (I@.E, Y) THEN
                        RETURN TRUE;
                     END IF;
                  ELSE
                     RETURN TRUE;
                  END IF;
               END BLOCK;
            END IF;
         END IF;
      END BLOCK;
      U := U@.NEXT;
   END LOOP;
   IF INPUT_ONLY THEN
      RETURN FALSE;
   END IF;
   FAILT (LINE, 'not imported by the USES clause of the segment (4.2): ', Y@.NAME);
END FUNCTION SEG_VISIBLE;

FUNCTION FROM_MODULES (MODS: NODE, Y: SYM) RETURNS (BOOLEAN);
   VAR M: SYM := Y@.MODL;
   IF MODS = NIL THEN
      RETURN FALSE;
   END IF;
   LOOP UNTIL M = NIL DO
      IF IN_IDENTS (MODS, M@.NAME) THEN
         RETURN TRUE;
      END IF;
      M := M@.MODL;
   END LOOP;
   RETURN FALSE;
END FUNCTION FROM_MODULES;
