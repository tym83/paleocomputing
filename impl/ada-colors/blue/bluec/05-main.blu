
% ==== the main program ==================================================================
READ_SOURCE;
OPTIONS;
LEX;
BLOCK
   VAR SEGS: NODE := PARSE_COMPILATION ();
   LOOP                                              % the library segments it uses
      BLOCK
         CONST NAME: TEXT := MISSING_SEGMENT (SEGS);
         IF NAME.LEN = 0 THEN
            EXIT;
         END IF;
         LOAD_LIBRARY (NAME);
         LEX;
         BLOCK
            VAR MORE: NODE := PARSE_COMPILATION ();
            VAR LAST: NODE := SEGS;
            LOOP UNTIL LAST@.NEXT = NIL DO
               LAST := LAST@.NEXT;
            END LOOP;
            LAST@.NEXT := MORE;
         END BLOCK;
      END BLOCK;
   END LOOP;
   PREDEFINE;
   TRANSLATE (SEGS);
END BLOCK;
WRITE_OUTPUT;
