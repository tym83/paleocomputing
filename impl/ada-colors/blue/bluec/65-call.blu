
% ==== routine invocation (4.3.2), overloading, generic instances (section 5) ============

% the type of an actual argument, translated once
PROCEDURE TYPE_ARG (A: ARG);
   IF NOT A@.HAVE THEN
      A@.V := EXPR (A@.E, NIL);
      A@.HAVE := TRUE;
   END IF;
END PROCEDURE TYPE_ARG;

% an argument whose type depends on what is wanted: a literal, NIL, a constructor
FUNCTION WANT_SENSITIVE (A: ARG) RETURNS (BOOLEAN);
   IF A@.HAVE THEN
      RETURN FALSE;
   END IF;
   RETURN IS_LITERALISH (A@.E) ! A@.E@.KIND = N_INT ! A@.E@.KIND = N_NEW;
END FUNCTION WANT_SENSITIVE;

FUNCTION COUNT_ARGS (A: ARG) RETURNS (INTEGER);
   VAR N: INTEGER := 0;
   VAR P: ARG := A;
   LOOP UNTIL P = NIL DO
      N := N + 1;
      P := P@.NEXT;
   END LOOP;
   RETURN N;
END FUNCTION COUNT_ARGS;

% the arguments of a call node, in the order input # inout # output
FUNCTION CALL_ARGS (E: NODE) RETURNS (ARG);
   VAR HEAD, TAIL: ARG := NIL;
   VAR G: INTEGER := 0;
   LOOP FOR M IN [0:2] DO
      BLOCK
         VAR P: NODE := E@.A;
         IF M = 1 THEN
            P := E@.B;
         ORIF M = 2 THEN
            P := E@.C;
         END IF;
         LOOP UNTIL P = NIL DO
            BLOCK
               CONST A: ARG := NODE_ARG (P, M, NIL);
               IF TAIL = NIL THEN
                  HEAD := A;
               ELSE
                  TAIL@.NEXT := A;
               END IF;
               TAIL := A;
            END BLOCK;
            P := P@.NEXT;
         END LOOP;
      END BLOCK;
   END LOOP M;
   RETURN HEAD;
END FUNCTION CALL_ARGS;

% a rounding mode applies to the operators of its expression, not to the arguments
% of the routines invoked in it (3.1.4.1, p.3-16)
FUNCTION CALL_EXPR (E: NODE, WANT: TYP) RETURNS (ET);
   CONST SAVED: BOOLEAN := W@.ROUNDED;
   CONST SAVED_Q: NODE := W@.QUAL;
   VAR V: ET;
   W@.ROUNDED := FALSE;
   W@.QUAL := NIL;
   V := CALL_EXPR1 (E, WANT);
   W@.ROUNDED := SAVED;
   W@.QUAL := SAVED_Q;
   RETURN V;
END FUNCTION CALL_EXPR;

FUNCTION CALL_EXPR1 (E: NODE, WANT: TYP) RETURNS (ET);
   CONST ARGS: ARG := CALL_ARGS (E);
   VAR Y: SYM;
   IF TEQS (E@.NAME, 'START_IO') THEN               % a start-io-stmt [4-104]
      REQUIRE_MACHINE (E@.LINE);
      RETURN START_IO_CALL (E);
   END IF;
   % a routine bound by a WHERE clause or a routine parameter of the instance
   Y := BOUND_ROUTINE (E@.NAME);
   IF Y <> NIL THEN
      IF Y@.KIND = Y_BUILTIN THEN                    % T$TO_CHAR: TO_CHAR (5.2)
         BLOCK
            VAR N: NODE := COPY_NODE (E);
            N@.NAME := Y@.NAME;
            N@.NEXT := E@.NEXT;
            RETURN BUILTIN (N, WANT);
         END BLOCK;
      END IF;
      RETURN CALL_SYM (Y, ARGS, E@.LINE);
   END IF;
   BLOCK                                             % T$NAME of a predefined operation
      CONST SHORT: TEXT := WHERE_SHORT_NAME (E@.NAME);  % named in the WHERE clause (5.2)
      IF NOT TEQ (SHORT, E@.NAME) THEN
         BLOCK
            VAR N: NODE := COPY_NODE (E);
            N@.NAME := SHORT;
            N@.NEXT := E@.NEXT;
            RETURN CALL_EXPR1 (N, WANT);
         END BLOCK;
      END IF;
   END BLOCK;
   Y := FIND_ROUTINE (E@.NAME, ARGS, E@.LINE, TRUE);
   IF Y = NIL THEN
      BLOCK                                          % a predefined routine of the name
         VAR P: SYM := LOOKUP (E@.NAME);
         LOOP UNTIL P = NIL DO
            IF P@.KIND = Y_BUILTIN THEN
               RETURN BUILTIN (E, WANT);
            END IF;
            P := LOOKUP_NEXT (P);
         END LOOP;
      END BLOCK;
      BLOCK
         CONST B: SYM := LOOKUP (E@.NAME);
         IF B <> NIL THEN
            IF B@.KIND = Y_BUILTIN THEN
               RETURN BUILTIN (E, WANT);
            END IF;
            IF B@.KIND = Y_ROUTINE ! B@.ORIG <> NIL THEN
               FAILT (E@.LINE, 'no declaration of the routine fits these arguments: ', E@.NAME);
            END IF;
            FAILT (E@.LINE, 'not a routine: ', E@.NAME);
         END IF;
      END BLOCK;
      BLOCK                                          % FIXED$ADD_: an operation of a
         CONST BASE: TEXT := CLASS_OPERATION (E@.NAME);   % predefined type class (D.2)
         IF BASE.LEN > 0 THEN
            BLOCK
               VAR N: NODE := COPY_NODE (E);
               N@.NAME := BASE;
               RETURN BUILTIN (N, WANT);
            END BLOCK;
         END IF;
      END BLOCK;
      FAILT (E@.LINE, 'unknown routine ', E@.NAME);
   END IF;
   RETURN CALL_SYM (Y, ARGS, E@.LINE);
END FUNCTION CALL_EXPR1;

% NAME of T$NAME when T is a predefined type or type class and NAME a predefined
% routine (the operations of the PRELUDE, D.4 - D.6); nothing otherwise
FUNCTION CLASS_OPERATION (NAME: TEXT) RETURNS (TEXT);
   CONST S: ASCII_STR (NAME.LEN) := STR (NAME, NAME.LEN);
   LOOP FOR I IN [1 : NAME.LEN - 2] DO
      IF S[I:I] = '$' THEN
         BLOCK
            CONST P: TEXT := MKN (S[0 : I - 1]);
            CONST B: TEXT := MKN (S[I + 1 : NAME.LEN - 1]);
            IF IS_TYPE_WORD (P) ! TEQS (P, 'INTEGER') ! TEQS (P, 'BOOLEAN') ! TEQS (P, 'ENUM')
               ! TEQS (P, 'ARRAY') ! TEQS (P, 'RECORD') ! TEQS (P, 'PTR') ! TEQS (P, 'SEMAPHORE') THEN
               BLOCK
                  VAR Y: SYM := LOOKUP (B);
                  LOOP UNTIL Y = NIL DO
                     IF Y@.KIND = Y_BUILTIN THEN
                        RETURN B;
                     END IF;
                     Y := LOOKUP_NEXT (Y);
                  END LOOP;
               END BLOCK;
            END IF;
         END BLOCK;
         RETURN NO_TEXT ();
      END IF;
   END LOOP I;
   RETURN NO_TEXT ();
END FUNCTION CLASS_OPERATION;

% T$NAME in a generic body where T is a TYPE parameter and NAME is in the WHERE
% clause: NAME; else NAME as it is
FUNCTION WHERE_SHORT_NAME (NAME: TEXT) RETURNS (TEXT);
   CONST G: SYM := CUR_GENERIC ();
   CONST S: ASCII_STR (NAME.LEN) := STR (NAME, NAME.LEN);
   IF G = NIL THEN
      RETURN NAME;
   END IF;
   LOOP FOR I IN [1 : NAME.LEN - 2] DO
      IF S[I:I] = '$' THEN
         IF FIND_BIND (G@.BINDINGS, MKN (S[0:I - 1])) <> NIL
            & IN_WHERE (G, MKN (S[I + 1 : NAME.LEN - 1])) THEN
            RETURN MKN (S[I + 1 : NAME.LEN - 1]);
         END IF;
         RETURN NAME;
      END IF;
   END LOOP I;
   RETURN NAME;
END FUNCTION WHERE_SHORT_NAME;

FUNCTION BOUND_ROUTINE (NAME: TEXT) RETURNS (SYM);
   VAR B: BIND := W@.BINDS;
   % T$NAME, T a bound generic type: the routine NAME the WHERE clause bound (C-32:
   % READ calls T$FROM_CHAR)
   BLOCK
      CONST S: ASCII_STR (NAME.LEN) := STR (NAME, NAME.LEN);
      LOOP FOR I IN [1 : NAME.LEN - 2] DO
         IF S[I:I] = '$' THEN
            IF FIND_BIND (W@.BINDS, MKN (S[0:I - 1])) <> NIL THEN
               RETURN BOUND_ROUTINE (MKN (S[I + 1 : NAME.LEN - 1]));
            END IF;
            EXIT;
         END IF;
      END LOOP I;
   END BLOCK;
   LOOP UNTIL B = NIL DO
      IF B@.R <> NIL & TEQ (B@.NAME, NAME) THEN
         RETURN B@.R;
      END IF;
      B := B@.NEXT;
   END LOOP;
   RETURN NIL;
END FUNCTION BOUND_ROUTINE;

% may the routine Y be invoked by this name here? the T$ operations of a module are
% named with their prefix inside it (4.4)
FUNCTION CANDIDATE (Y: SYM, NAME: TEXT) RETURNS (BOOLEAN);
   IF Y@.KIND <> Y_ROUTINE THEN
      RETURN FALSE;
   END IF;
   IF Y@.ORIG <> NIL & Y@.PREFIX.LEN > 0 & NOT TEQ (Y@.NAME, Y@.ORIG@.NAME) THEN
      IF Y@.MODL <> NIL THEN
         IF IN_MODULE (Y@.MODL) THEN
            RETURN FALSE;                             % the short name, inside the module
         END IF;
      END IF;
   END IF;
   RETURN TRUE;
END FUNCTION CANDIDATE;

% the routine named NAME that the arguments fit (4.3.2): an exact match, else a unique
% assignment-compatible one; nothing if none fits (or, if MUST, a translation error when
% several do)
FUNCTION FIND_ROUTINE (NAME: TEXT, ARGS: ARG, LINE: INTEGER, MUST: BOOLEAN) RETURNS (SYM);
   VAR Y: SYM := LOOKUP (NAME);
   VAR BEST: SYM := NIL;
   VAR BEST_SCORE: INTEGER := 0;
   VAR TIES: INTEGER := 0;
   VAR COUNT: INTEGER := 0;
   CONST N: INTEGER := COUNT_ARGS (ARGS);
   LOOP UNTIL Y = NIL DO
      IF NOT IS_ROUTINE (Y) THEN
         IF Y@.KIND <> Y_ENUMLIT THEN
            EXIT;                                     % a local non-routine hides them (4.1)
         END IF;
      ORIF CANDIDATE (Y, NAME) THEN
         BLOCK
            CONST R: SYM := ORIGINAL (Y);
            VAR SCORE: INTEGER;
            ROUTINE_HEADER (R);
            IF PARAM_COUNT (R) = N & NOT SEEN_ROUTINE (R, NAME, Y) & NOT HIDDEN_ROUTINE (R, NAME, Y) THEN
               COUNT := COUNT + 1;
               SCORE := MATCH_SCORE (R, ARGS);
               IF SCORE > BEST_SCORE THEN
                  BEST := R;
                  BEST_SCORE := SCORE;
                  TIES := 0;
               ORIF SCORE = BEST_SCORE & SCORE > 0 THEN
                  TIES := TIES + 1;
               END IF;
            END IF;
         END BLOCK;
      END IF;
      Y := LOOKUP_NEXT (Y);
   END LOOP;
   IF TIES > 0 & MUST THEN
      FAILT (LINE, 'an ambiguous invocation (4.3.2): ', NAME);
   END IF;
   RETURN BEST;
END FUNCTION FIND_ROUTINE;

% has the same declaration been met earlier in the bucket (an alias and its original)?
FUNCTION SEEN_ROUTINE (R: SYM, NAME: TEXT, STOP: SYM) RETURNS (BOOLEAN);
   VAR Y: SYM := LOOKUP (NAME);
   LOOP UNTIL Y = STOP ! Y = NIL DO
      IF Y@.KIND = Y_ROUTINE THEN
         IF ORIGINAL (Y) = R THEN
            RETURN TRUE;
         END IF;
      END IF;
      Y := LOOKUP_NEXT (Y);
   END LOOP;
   RETURN FALSE;
END FUNCTION SEEN_ROUTINE;

% is the routine R (met as Y) hidden by a routine of the same signature declared
% in an inner scope (4.1: "the global routine will not be known in the scope")?
FUNCTION HIDDEN_ROUTINE (R: SYM, NAME: TEXT, STOP: SYM) RETURNS (BOOLEAN);
   VAR Y: SYM := LOOKUP (NAME);
   LOOP UNTIL Y = STOP ! Y = NIL DO
      IF Y@.KIND = Y_ROUTINE & Y@.DEPTH > STOP@.DEPTH THEN
         BLOCK
            CONST O: SYM := ORIGINAL (Y);
            IF O <> R THEN
               ROUTINE_HEADER (O);
               IF SAME_SIGNATURE (O, R) THEN
                  RETURN TRUE;
               END IF;
            END IF;
         END BLOCK;
      END IF;
      Y := LOOKUP_NEXT (Y);
   END LOOP;
   RETURN FALSE;
END FUNCTION HIDDEN_ROUTINE;

% the same signature: the same parameter types and modes, in order (4.1)
FUNCTION SAME_SIGNATURE (A, B: SYM) RETURNS (BOOLEAN);
   VAR P: PARM := A@.PARAMS;
   VAR Q: PARM := B@.PARAMS;
   IF A@.GENERIC ! B@.GENERIC THEN
      RETURN FALSE;
   END IF;
   LOOP UNTIL P = NIL ! Q = NIL DO
      IF P@.MODE <> Q@.MODE THEN
         RETURN FALSE;
      END IF;
      IF P@.T = NIL ! Q@.T = NIL THEN
         IF P@.T <> Q@.T THEN
            RETURN FALSE;
         END IF;
      ORIF NOT SAME_TYPE (P@.T, Q@.T) THEN
         RETURN FALSE;
      END IF;
      P := P@.NEXT;
      Q := Q@.NEXT;
   END LOOP;
   RETURN P = NIL & Q = NIL;
END FUNCTION SAME_SIGNATURE;

FUNCTION PARAM_COUNT (R: SYM) RETURNS (INTEGER);
   VAR N: INTEGER := 0;
   VAR P: PARM := R@.PARAMS;
   LOOP UNTIL P = NIL DO
      N := N + 1;
      P := P@.NEXT;
   END LOOP;
   RETURN N;
END FUNCTION PARAM_COUNT;

% 0: the arguments do not fit R; 1: assignment compatible; 2: exact
FUNCTION MATCH_SCORE (R: SYM, ARGS: ARG) RETURNS (INTEGER);
   VAR P: PARM := R@.PARAMS;
   VAR A: ARG := ARGS;
   VAR EXACT: BOOLEAN := TRUE;
   CONST BS: BIND := NEW_BINDS ();                   % one unification for all parameters
   VAR PT: TYP;
   LOOP UNTIL P = NIL DO
      PT := FORMAL_VIEW (R, P);
      IF P@.MODE <> A@.MODE THEN
         RETURN 0;
      END IF;
      IF R@.GENERIC & P@.TS <> NIL THEN
         IF NOT GENERIC_FITS (P, A, BS) THEN
            RETURN 0;
         END IF;
      ORIF PT = NIL THEN                            % a TYPE parameter: a type argument
         IF A@.HAVE THEN
            IF A@.V.T <> W@.TY_TYPE THEN              % (a WHERE template says TYPE)
               RETURN 0;
            END IF;
         END IF;
      ORIF WANT_SENSITIVE (A) THEN
         IF NOT LITERAL_FITS (A@.E, PT) THEN
            RETURN 0;
         END IF;
      ELSE
         TYPE_ARG (A);
         BLOCK
            CONST AT: TYP := A@.V.T;
            IF NOT (SAME_CLASS (PT, AT) ! (AT@.KIND = T_NIL & REAL_TYPE (PT)@.KIND = T_PTR)) THEN
               RETURN 0;
            END IF;
            IF REAL_TYPE (PT)@.GEN.LEN > 0 & REAL_TYPE (AT)@.MLEN.OK THEN
               BLOCK                                  % ?L repeated: one length (5)
                  CONST KEY: TEXT := QMKN ('%', REAL_TYPE (PT)@.GEN);
                  CONST B: BIND := FIND_BIND (BS@.NEXT, KEY);
                  IF B <> NIL THEN
                     IF B@.MV <> REAL_TYPE (AT)@.MLEN.V THEN
                        RETURN 0;
                     END IF;
                  ELSE
                     ADD_BIND (KEY, NIL, REAL_TYPE (AT)@.MLEN, NIL, BS);
                  END IF;
               END BLOCK;
            END IF;
            IF NOT SAME_TYPE (PT, AT) THEN
               IF P@.MODE = M_INOUT THEN               % an inout matches exactly (4.3.2)
                  RETURN 0;
               END IF;
               EXACT := FALSE;
            END IF;
            IF REAL_TYPE (AT)@.KIND = T_INT & REAL_TYPE (PT)@.KIND = T_INT THEN
               % no implicit approximation: an input's scale may not exceed the
               % formal's, the formal's of an output may not exceed the argument's
               IF P@.MODE = M_IN & AT@.SCALE > PT@.SCALE THEN
                  RETURN 0;
               ORIF P@.MODE = M_OUT & PT@.SCALE > AT@.SCALE THEN
                  RETURN 0;
               END IF;
            END IF;
         END BLOCK;
      END IF;
      P := P@.NEXT;
      A := A@.NEXT;
   END LOOP;
   IF EXACT THEN
      RETURN 2;
   END IF;
   RETURN 1;
END FUNCTION MATCH_SCORE;

% could the literal-like expression E be of the type T?
FUNCTION LITERAL_FITS (E: NODE, T: TYP) RETURNS (BOOLEAN);
   CONST RT: TYP := REAL_TYPE (T);
   IF E@.KIND = N_ENUMLIT ! E@.KIND = N_NAME THEN
      IF RT@.KIND = T_ENUM THEN
         RETURN FIND_LITERAL (E@.NAME, RT) <> NIL;
      END IF;
      RETURN FALSE;
   ORIF E@.KIND = N_NIL THEN
      RETURN RT@.KIND = T_PTR;
   ORIF E@.KIND = N_RECCONS THEN
      RETURN RT@.KIND = T_REC;
   ORIF E@.KIND = N_ARRCONS THEN
      RETURN RT@.KIND = T_ARR;
   ORIF E@.KIND = N_INT THEN
      RETURN RT@.KIND = T_INT;
   ORIF E@.KIND = N_NEW THEN
      RETURN RT@.KIND = T_PTR ! RT@.KIND = T_SEM;
   END IF;
   RETURN FALSE;
END FUNCTION LITERAL_FITS;

% the variable an inout or output argument belongs to, unless reached through a pointer
FUNCTION ARG_ROOT (E: NODE) RETURNS (SYM);
   VAR N: NODE := E;
   LOOP UNTIL N = NIL DO
      IF N@.KIND = N_NAME ! N@.KIND = N_APPLY THEN
         BLOCK
            CONST Y: SYM := LOOKUP (N@.NAME);
            IF Y = NIL THEN
               RETURN NIL;
            END IF;
            IF Y@.KIND <> Y_VAR THEN
               RETURN NIL;
            END IF;
            RETURN Y;
         END BLOCK;
      ORIF N@.KIND = N_INDEX ! N@.KIND = N_FIELD ! N@.KIND = N_SUBSTR ! N@.KIND = N_PAREN THEN
         N := N@.A;
      ELSE
         RETURN NIL;
      END IF;
   END LOOP;
   RETURN NIL;
END FUNCTION ARG_ROOT;

% the selections from the root variable to the argument E, root first: field names,
% and * for a subscript or substring
FUNCTION PATH_OF (E: NODE) RETURNS (NODE);
   VAR N: NODE := E;
   VAR P: NODE := NIL;
   LOOP UNTIL N = NIL DO
      IF N@.KIND = N_FIELD THEN
         P := NAME_REF (N@.NAME, 0, NIL, P);
         N := N@.A;
      ORIF N@.KIND = N_INDEX ! N@.KIND = N_SUBSTR THEN
         P := NAME_REF (MKN ('*'), 0, NIL, P);
         N := N@.A;
      ORIF N@.KIND = N_APPLY THEN                    % V (I) read as a call
         P := NAME_REF (MKN ('*'), 0, NIL, P);
         RETURN P;
      ORIF N@.KIND = N_PAREN THEN
         N := N@.A;
      ELSE
         RETURN P;
      END IF;
   END LOOP;
   RETURN P;
END FUNCTION PATH_OF;

% two components of one variable that cannot overlap: different fields at some
% level (decision 33)
FUNCTION DISJOINT_PATHS (A, B: NODE) RETURNS (BOOLEAN);
   VAR P: NODE := A;
   VAR Q: NODE := B;
   LOOP UNTIL P = NIL ! Q = NIL DO
      IF NOT TEQS (P@.NAME, '*') & NOT TEQS (Q@.NAME, '*') & NOT TEQ (P@.NAME, Q@.NAME) THEN
         RETURN TRUE;
      END IF;
      P := P@.NEXT;
      Q := Q@.NEXT;
   END LOOP;
   RETURN FALSE;
END FUNCTION DISJOINT_PATHS;

% the arguments of explicit generic parameters -- inputs the returns-clause uses --
% invoke only pure functions (5; decision 35: variables are allowed)
PROCEDURE EXPLICIT_GENERIC_ARGS (Y: SYM, ARGS: ARG, LINE: INTEGER);
   VAR USED: NODE := NIL;
   VAR P: PARM := Y@.PARAMS;
   VAR A: ARG := ARGS;
   IF Y@.DECL = NIL THEN
      RETURN;
   END IF;
   IF Y@.DECL@.KIND <> N_ROUTINE ! Y@.DECL@.B = NIL THEN
      RETURN;
   END IF;
   NAMES_IN (Y@.DECL@.B # USED);
   LOOP UNTIL P = NIL ! A = NIL DO
      IF P@.MODE = M_IN & IN_IDENTS (USED, P@.NAME) & A@.E <> NIL THEN
         IF NOT CONSTANT_EXPR (A@.E) THEN
            FAILT (LINE, 'the argument of an explicit generic parameter invokes only pure functions (5): ',
                   P@.NAME);
         END IF;
      END IF;
      P := P@.NEXT;
      A := A@.NEXT;
   END LOOP;
END PROCEDURE EXPLICIT_GENERIC_ARGS;

PROCEDURE NAMES_IN (L: NODE # HEAD: NODE);
   VAR N: NODE := L;
   LOOP UNTIL N = NIL DO
      IF N@.KIND = N_NAME ! (N@.KIND = TS_NAME & N@.A = NIL) THEN
         HEAD := NAME_REF (N@.NAME, 0, NIL, HEAD);
      END IF;
      NAMES_IN (N@.A # HEAD);
      NAMES_IN (N@.B # HEAD);
      NAMES_IN (N@.C # HEAD);
      N := N@.NEXT;
   END LOOP;
END PROCEDURE NAMES_IN;

FUNCTION CONSTANT_EXPR (E: NODE) RETURNS (BOOLEAN);
   IF E = NIL THEN
      RETURN TRUE;
   END IF;
   IF E@.KIND = N_NAME ! E@.KIND = N_APPLY THEN
      BLOCK
         CONST Y: SYM := LOOKUP (E@.NAME);
         IF Y <> NIL THEN
            IF Y@.KIND = Y_ROUTINE THEN
               IF ORIGINAL (Y)@.USES <> NIL THEN
                  RETURN FALSE;
               END IF;
            END IF;
         END IF;
      END BLOCK;
   END IF;
   IF E@.KIND = N_FIELD THEN
      RETURN CONSTANT_EXPR (E@.A);
   END IF;
   RETURN CONSTANT_LIST (E@.A) & CONSTANT_LIST (E@.B) & CONSTANT_LIST (E@.C);
END FUNCTION CONSTANT_EXPR;

FUNCTION CONSTANT_LIST (L: NODE) RETURNS (BOOLEAN);
   VAR N: NODE := L;
   LOOP UNTIL N = NIL DO
      IF NOT CONSTANT_EXPR (N) THEN
         RETURN FALSE;
      END IF;
      N := N@.NEXT;
   END LOOP;
   RETURN TRUE;
END FUNCTION CONSTANT_LIST;

% is E an element of an array that is not UNPACKED?
FUNCTION PACKED_ELEMENT (E: NODE) RETURNS (BOOLEAN);
   VAR AT: TYP := NIL;
   IF E@.KIND = N_APPLY THEN
      BLOCK
         CONST Y: SYM := LOOKUP (E@.NAME);
         IF Y = NIL THEN
            RETURN FALSE;
         END IF;
         IF Y@.KIND <> Y_VAR ! Y@.T = NIL THEN
            RETURN FALSE;
         END IF;
         AT := REAL_TYPE (Y@.T);
      END BLOCK;
   ORIF E@.KIND = N_INDEX THEN
      BLOCK
         CONST SAVED_CODE: BUF := W@.CODE;
         AT := REAL_TYPE (EXPR (E@.A, NIL).T);
         W@.CODE := SAVED_CODE;
      END BLOCK;
   ELSE
      RETURN FALSE;
   END IF;
   IF AT@.KIND <> T_ARR THEN
      RETURN FALSE;
   END IF;
   RETURN PACKING_OF (AT) <> 2;
END FUNCTION PACKED_ELEMENT;

% aliasing (4.3.3): a variable or its components is not more than one inout
% argument, not more than one output argument, and not an inout argument of a
% procedure that imports it
PROCEDURE NO_ALIASING (Y: SYM, ARGS: ARG, LINE: INTEGER);
   VAR A: ARG := ARGS;
   LOOP UNTIL A = NIL DO
      IF A@.MODE = M_INOUT & A@.E <> NIL THEN         % only elements of ARRAY_STD arrays
         IF PACKED_ELEMENT (A@.E) THEN                % are inout arguments (3.8.3)
            FAIL (LINE, 'only elements of ARRAY_STD arrays are inout arguments (3.8.3)');
         END IF;
      END IF;
      A := A@.NEXT;
   END LOOP;
   A := ARGS;
   LOOP UNTIL A = NIL DO
      IF (A@.MODE = M_INOUT ! A@.MODE = M_OUT) & A@.E <> NIL THEN
         BLOCK
            CONST V: SYM := ARG_ROOT (A@.E);
            VAR B: ARG := A@.NEXT;
            IF V <> NIL THEN
               LOOP UNTIL B = NIL DO
                  IF B@.MODE = A@.MODE & B@.E <> NIL THEN
                     IF ARG_ROOT (B@.E) = V & NOT DISJOINT_PATHS (PATH_OF (A@.E), PATH_OF (B@.E)) THEN
                        FAILT (LINE, 'a variable is more than one inout or output argument (4.3.3): ',
                               V@.NAME);
                     END IF;
                  END IF;
                  B := B@.NEXT;
               END LOOP;
               IF A@.MODE = M_INOUT & Y@.USES <> NIL THEN
                  BLOCK
                     VAR U: NODE := Y@.USES;
                     LOOP UNTIL U = NIL DO
                        IF TEQ (U@.NAME, V@.NAME) & U@.IV = V@.OWNER THEN
                           FAILT (LINE, 'an inout argument the procedure also imports (4.3.3): ', V@.NAME);
                        END IF;
                        U := U@.NEXT;
                     END LOOP;
                  END BLOCK;
               END IF;
            END IF;
         END BLOCK;
      END IF;
      A := A@.NEXT;
   END LOOP;
END PROCEDURE NO_ALIASING;

% the body of an INLINE routine G itself, translated with the pending instances
PROCEDURE NEED_BODY (G: SYM);
   IF G@.LAZY <> 2 & G@.DECL@.FL = 1 THEN
      G@.LAZY := 2;
      G@.MEMBERS := W@.PENDING;
      W@.PENDING := G;
   END IF;
END PROCEDURE NEED_BODY;

% an INLINE routine invoked with manifest input arguments: its body expanded for
% them, the formals manifest there, so that its conditions select their arms when
% translated (4.3.1, 3.1.4.1: conditional compilation)
FUNCTION INLINE_INSTANCE (G: SYM, ARGS: ARG, LINE: INTEGER) RETURNS (SYM);
   CONST BS: BIND := NEW_BINDS ();
   VAR P: PARM := G@.PARAMS;
   VAR A: ARG := ARGS;
   VAR SOME_M: BOOLEAN := FALSE;
   VAR N: INTEGER := 0;
   LOOP UNTIL P = NIL ! A = NIL DO
      IF P@.MODE = M_IN & A@.E <> NIL & P@.T <> NIL THEN
         BLOCK
            CONST RT: TYP := REAL_TYPE (P@.T);
            VAR M: MVAL := NO_MVAL ();
            IF RT@.KIND = T_INT & RT@.SCALE = 0 THEN
               IF MANIFEST_INT (A@.E) THEN
                  M := MANIFEST (A@.E);
               END IF;
            ORIF RT@.KIND = T_BOOL THEN
               M := MANIFEST (A@.E);
            ORIF RT@.KIND = T_ENUM THEN
               M := ENUM_MANIFEST (A@.E, RT);
            END IF;
            IF M.OK THEN
               ADD_BIND (QMKN ('=', P@.NAME), NIL, M, NIL, BS);
               SOME_M := TRUE;
            END IF;
         END BLOCK;
      END IF;
      P := P@.NEXT;
      A := A@.NEXT;
   END LOOP;
   IF NOT SOME_M THEN
      NEED_BODY (G);
      RETURN G;
   END IF;
   BLOCK
      VAR I: SYM := G@.INSTANCES;
      LOOP UNTIL I = NIL DO
         IF SAME_STATIC_BINDS (I@.BINDINGS, BS@.NEXT) THEN
            RETURN I;
         END IF;
         N := N + 1;
         I := I@.INSTANCES;
      END LOOP;
   END BLOCK;
   IF N > 256 THEN
      FAILT (LINE, 'the INLINE expansions of the routine do not end (4.3.1): ', G@.NAME);
   END IF;
   RETURN NEW_INSTANCE (G, BS@.NEXT, ARGS);
END FUNCTION INLINE_INSTANCE;

% the invocation of R with ARGS: inputs by value after the conversions of assignment,
% inouts and outputs by reference (4.3.2)
FUNCTION CALL_SYM (Y0: SYM, ARGS: ARG, LINE: INTEGER) RETURNS (ET);
   CONST VISIBLE: BOOLEAN := SEG_VISIBLE (Y0, LINE);  % USES (4.2)
   VAR Y: SYM := ORIGINAL (Y0);
   VAR P: PARM;
   VAR A: ARG := ARGS;
   VAR C: TEXT := MK ('');
   VAR SEP: TEXT := MK ('');
   VAR PRE: TEXT := MK ('');                         % temporaries of output arguments
   VAR POST: TEXT := MK ('');                        % ... copied into them afterwards
   VAR SHARED: BOOLEAN := FALSE;                     % may an input share an inout?
   VAR PT: TYP;                                      % the formal's type, seen from here
   IF W@.CS@.R <> NIL THEN                           % a recursive invocation (4.3.1)
      IF W@.CS@.R@.DECL = Y@.DECL & Y@.DECL <> NIL THEN
         IF Y@.DECL@.FL = 1 THEN
            FAILT (LINE, 'an INLINE routine cannot be recursive (4.3.1): ', Y@.NAME);
         END IF;
      END IF;
   END IF;
   IF Y@.GENERIC THEN
      Y := INSTANCE (Y, ARGS, LINE);
   ORIF Y@.DECL <> NIL & Y@.BINDINGS = NIL THEN
      IF Y@.DECL@.KIND = N_ROUTINE & Y@.DECL@.FL = 1 THEN
         Y := INLINE_INSTANCE (Y, ARGS, LINE);
      END IF;
   END IF;
   CHECK_CALL_IMPORTS (Y, LINE);
   NO_ALIASING (Y, ARGS, LINE);
   EXPLICIT_GENERIC_ARGS (Y, ARGS, LINE);
   IF W@.CS@.R <> NIL THEN                           % a recursive invocation (4.3.1)
      IF W@.CS@.R@.DECL = Y@.DECL & Y@.DECL <> NIL THEN
         IF Y@.DECL@.FL = 1 THEN
            FAILT (LINE, 'an INLINE routine cannot be recursive (4.3.1): ', Y@.NAME);
         END IF;
         BLOCK
            VAR U: NODE := Y@.USES;
            LOOP UNTIL U = NIL DO
               IF LOOKUP (U@.NAME) <> NIL THEN
                  IF LOOKUP (U@.NAME)@.LEVEL > 0 THEN
                     FAILT (LINE, 'a recursive routine imports only static data (4.3.1): ', U@.NAME);
                  END IF;
               END IF;
               U := U@.NEXT;
            END LOOP;
         END BLOCK;
      END IF;
   END IF;
   IF CUR_GENERIC () <> NIL THEN                     % objects of a TYPE parameter go to
      BLOCK                                          % WHERE routines and generics (5.2)
         VAR Q: ARG := ARGS;
         VAR GEN_ARG: BOOLEAN := FALSE;
         LOOP UNTIL Q = NIL DO
            IF Q@.HAVE THEN
               IF Q@.V.T <> NIL THEN
                  IF Q@.V.T@.GENP.LEN > 0 THEN
                     GEN_ARG := TRUE;
                  END IF;
               END IF;
            END IF;
            Q := Q@.NEXT;
         END LOOP;
         IF GEN_ARG THEN
            IF Y@.BINDINGS <> NIL THEN
               REQUIRE_WHERE_SUBSET (Y, LINE);
            ELSE
               REQUIRE_WHERE (BASE_NAME (Y), LINE);
            END IF;
         END IF;
      END BLOCK;
   END IF;
   BLOCK                                             % not a variable a NAMING hides
      VAR U: NODE := Y@.USES;                        % (4.5.4)
      LOOP UNTIL U = NIL DO
         BLOCK
            CONST H: SYM := LOOKUP (U@.NAME);
            IF H <> NIL THEN
               IF H@.WITHV = 2 & H@.OWNER = U@.IV THEN
                  FAIL2 (LINE, 'the routine ', Y@.NAME, ' imports ', U@.NAME,
                         ', which a WITH NAMING hides (4.5.4)');
               END IF;
            END IF;
         END BLOCK;
         U := U@.NEXT;
      END LOOP;
   END BLOCK;
   IF (W@.IN_RECORD > 0 ! W@.IN_TYPEDECL > 0) & Y@.USES <> NIL THEN
      FAILT (LINE, 'a record-spec is a closed scope: no function importing a variable (3.9.1): ',
             Y@.NAME);
   END IF;
   IF Y@.LEVEL >= 1 THEN                             % the frame of its parent
      C := FRAME_OF (Y@.LEVEL);
      SEP := MK (', ');
   END IF;
   BLOCK
      VAR Q: ARG := ARGS;
      LOOP UNTIL Q = NIL DO
         IF Q@.MODE <> M_IN THEN
            SHARED := TRUE;
         END IF;
         Q := Q@.NEXT;
      END LOOP;
      IF Y@.USES <> NIL THEN
         SHARED := TRUE;
      END IF;
   END BLOCK;
   P := Y@.PARAMS;
   LOOP UNTIL P = NIL DO
      IF A = NIL THEN
         FAIL (LINE, 'too few arguments');
      END IF;
      PT := FORMAL_VIEW (Y, P);
      IF PT = NIL THEN                              % a TYPE argument: nothing at run time
         ;
      ORIF P@.MODE = M_IN THEN
         IF REAL_TYPE (PT)@.KIND = T_VOID THEN      % a routine argument
            ;
         ELSE
            BLOCK
               VAR V: ET;
               VAR CV: TEXT;
               IF A@.HAVE & NOT WANT_SENSITIVE (A) THEN
                  V := A@.V;
               ELSE
                  V := EXPR (A@.E, PT);
               END IF;
               CV := CONVERT (V, PT, LINE, NO_TEXT ());
               % an input is a copy: when the variable may also be reached as an inout
               % (argument or import), it is copied at the invocation (4.3.2, p.4-18)
               IF SHARED & V.LVAL & IS_STRUCTURED (PT) THEN
                  CV := COPY_OF (PT, CV);
               END IF;
               C := FMT3 ('@@@', C, SEP, CV);
               SEP := MK (', ');
            END BLOCK;
         END IF;
      ELSE
         BLOCK
            VAR V: ET;
            IF A@.HAVE THEN
               V := A@.V;
            ELSE
               V := EXPR (A@.E, PT);
            END IF;
            IF A@.E <> NIL & NOT V.LVAL THEN
               IF A@.E@.KIND = N_SUBSTR THEN
                  % the substring of a variable (Appendix C passes them, C-8 and C-31;
                  % [4-41] says variable): the formal is a view of the variable's
                  % characters, so what the routine stores lands there
                  IF NOT EXPR (A@.E@.A, NIL).LVAL THEN
                     FAIL (LINE, 'an inout or output argument must be a variable (4.3.2)');
                  END IF;
                  V := MKET (FMT1 ('(rstr[]){@}[0]', V.C), V.T);
                  V.LVAL := TRUE;
               END IF;
            END IF;
            IF NOT V.LVAL THEN
               FAIL (LINE, 'an inout or output argument must be a variable (4.3.2)');
            END IF;
            IF NOT SAME_CLASS (PT, V.T) THEN
               FAILT (LINE, 'the inout or output argument is not of the type of the parameter: ',
                      TYPE_NAME (PT));
            END IF;
            IF P@.MODE = M_INOUT & NOT (SAME_TYPE (PT, V.T) & SAME_RANGE (PT, V.T)) THEN
               FAIL (LINE, 'an inout argument must match the parameter exactly (4.3.2)');
            END IF;
            IF P@.MODE = M_OUT & NOT (SAME_TYPE (PT, V.T) & SAME_RANGE (PT, V.T)) THEN
               % the output is stored into the argument as by assignment: a temporary
               % of the formal's type, then STORE_ with its conversions and checks
               BLOCK
                  CONST TMP: TEXT := NEW_NAME ('oa');
                  CONST AP: TEXT := NEW_NAME ('op');
                  PRE := FMT4 ('@ @ *@ = &@;', PRE, CTYPE (V.T), AP, V.C);
                  PRE := FMT4 ('@ @ @ = @;', PRE, CTYPE (PT), TMP,
                               COPY_OF (V.T, FMT1 ('(*@)', AP)));
                  POST := FMT2 ('@ @', POST, STORE_CODE (V.T, FMT1 ('(*@)', AP),
                                                        MKET (TMP, PT), LINE, NO_TEXT ()));
                  C := FMT3 ('@@&@', C, SEP, TMP);
               END BLOCK;
            ELSE
               C := FMT3 ('@@&@', C, SEP, V.C);
            END IF;
            SEP := MK (', ');
         END BLOCK;
      END IF;
      A := A@.NEXT;
      P := P@.NEXT;
   END LOOP;
   IF A <> NIL THEN
      FAIL (LINE, 'too many arguments');
   END IF;
   IF PRE.LEN > 0 THEN
      RETURN MKET (FMT4 ('({ @ @(@); @ })', PRE, Y@.ACCESS, C, POST), RESULT_VIEW (Y));
   END IF;
   RETURN MKET (FMT2 ('@(@)', Y@.ACCESS, C), RESULT_VIEW (Y));
END FUNCTION CALL_SYM;

% the type of the formal P of the routine R seen where R is invoked: outside the
% module that declares R, a type the module exports is abstract (4.4), so the
% operations of two abstract types with the same underlying type stay apart
FUNCTION FORMAL_VIEW (R: SYM, P: PARM) RETURNS (TYP);
   IF P@.T = NIL ! P@.TS = NIL THEN
      RETURN P@.T;
   END IF;
   RETURN OUTSIDE_VIEW (R, P@.TS, P@.T);
END FUNCTION FORMAL_VIEW;

FUNCTION RESULT_VIEW (R: SYM) RETURNS (TYP);
   IF R@.DECL = NIL ! R@.RESULT = NIL THEN
      RETURN R@.RESULT;
   END IF;
   IF R@.DECL@.KIND <> N_ROUTINE ! R@.DECL@.B = NIL THEN
      RETURN R@.RESULT;
   END IF;
   RETURN OUTSIDE_VIEW (R, R@.DECL@.B, R@.RESULT);
END FUNCTION RESULT_VIEW;

FUNCTION OUTSIDE_VIEW (R: SYM, TS: NODE, T: TYP) RETURNS (TYP);
   IF R@.MODL = NIL ! T@.KIND = T_ABS ! TS@.KIND <> TS_NAME THEN
      RETURN T;
   END IF;
   IF IN_MODULE (R@.MODL) THEN
      RETURN T;
   END IF;
   BLOCK
      VAR M: SYM := R@.MODL;
      LOOP UNTIL M = NIL DO                          % the module or one around it
         BLOCK
            CONST Y: SYM := MEMBER_TYPE (M, TS@.NAME);
            IF Y <> NIL THEN
               IF Y@.EXPORTED THEN
                  RETURN ABSTRACT_VIEW (Y, T);
               END IF;
               RETURN T;
            END IF;
         END BLOCK;
         IF IN_MODULE (M@.MODL) THEN
            EXIT;
         END IF;
         M := M@.MODL;
      END LOOP;
   END BLOCK;
   RETURN T;
END FUNCTION OUTSIDE_VIEW;

% the type NAME declared in the module M, if any
FUNCTION MEMBER_TYPE (M: SYM, NAME: TEXT) RETURNS (SYM);
   VAR Y: SYM := M@.MEMBERS;
   IF M@.BUSY THEN                                    % entered: its names are visible
      BLOCK
         VAR Z: SYM := LOOKUP (NAME);
         LOOP UNTIL Z = NIL DO
            IF Z@.KIND = Y_TYPE & Z@.MODL = M & Z@.ORIG = NIL THEN
               RETURN Z;
            END IF;
            Z := LOOKUP_NEXT (Z);
         END LOOP;
      END BLOCK;
      RETURN NIL;
   END IF;
   LOOP UNTIL Y = NIL DO
      IF Y@.KIND = Y_TYPE & TEQ (Y@.NAME, NAME) THEN
         RETURN Y;
      END IF;
      Y := Y@.SNEXT;
   END LOOP;
   RETURN NIL;
END FUNCTION MEMBER_TYPE;

% a value that holds storage of its own: a copy shares none of it
FUNCTION IS_STRUCTURED (T: TYP) RETURNS (BOOLEAN);
   CONST K: INTEGER := REAL_TYPE (T)@.KIND;
   RETURN K = T_STR ! K = T_BITS ! K = T_ARR ! K = T_REC;
END FUNCTION IS_STRUCTURED;

% the same range, where the types have one (an inout must match it exactly, 4.3.2)
FUNCTION SAME_RANGE (A, B: TYP) RETURNS (BOOLEAN);
   CONST RA: TYP := REAL_TYPE (A);
   CONST RB: TYP := REAL_TYPE (B);
   IF NOT IS_NUMERIC_OR_ENUM (RA) THEN
      RETURN TRUE;
   END IF;
   IF IS_GEN_TEXT (RA@.LO_C) ! IS_GEN_TEXT (RA@.HI_C) ! IS_GEN_TEXT (RB@.LO_C)
      ! IS_GEN_TEXT (RB@.HI_C) THEN
      RETURN TRUE;                                    % [?L : ?U]: any range
   END IF;
   IF RA@.LO_C.LEN = 0 ! RB@.LO_C.LEN = 0 THEN
      RETURN RA@.LO_C.LEN = RB@.LO_C.LEN;
   END IF;
   IF RA@.MLO.OK & RB@.MLO.OK & RA@.MHI.OK & RB@.MHI.OK THEN
      RETURN RA@.MLO.V = RB@.MLO.V & RA@.MHI.V = RB@.MHI.V;
   END IF;
   RETURN TEQ (RA@.LO_C, RB@.LO_C) & TEQ (RA@.HI_C, RB@.HI_C);
END FUNCTION SAME_RANGE;

