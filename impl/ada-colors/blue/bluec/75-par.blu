
% ==== parallel processing (4.6, D.7) =========================================================
% A path activation is a task of rt/: the scheduler runs the highest priority first and
% FIFO within a priority (4.6.1), and its clock is virtual, so every run prints the same.
% A path is a closed scope; its frame holds its objects, the value of its loop
% identifier and the frame of the scope around the parallel block. The activations of
% the paths of a block are kept where the block is, for TERMINATE, PRIORITY and CLOCK.

FUNCTION PATHS_TYPE () RETURNS (TYP);
   VAR T: TYP := NEW_TYP (T_PATHS);
   T@.NAME := MK ('PATH');
   RETURN T;
END FUNCTION PATHS_TYPE;

% PAR_BLOCK path... END PAR_BLOCK [4-85]
PROCEDURE PARALLEL_BLOCK (S: NODE);
   CONST TD: TEXT := NEW_NAME ('td');
   VAR P: NODE := S@.A;
   IF W@.CS@.R <> NIL THEN
      FAIL (S@.LINE, 'a parallel block may not be in a routine (4.6.1)');
   END IF;
   CODES ('{');
   OPEN_SCOPE;
   % the path names are known in all the paths of the block (4.6.1)
   LOOP UNTIL P = NIL DO
      BLOCK
         VAR Y: SYM := NEW_SYM (Y_PATH, P@.NAME);
         Y@.T := PATHS_TYPE ();
         Y@.DECL := P;
         CODE (FMT1 ('@ = rt_b_paths_new();', NEW_OBJECT (Y, '_path')));
         Y@.INPUT := TRUE;
         DEFINE (Y, P@.LINE);
      END BLOCK;
      P := P@.NEXT;
   END LOOP;
   CODE (FMT1 ('rt_b_par @ = {0};', TD));
   CODES ('rt_b_par_begin();');
   % an exception while the paths are activated leaves none of them (4.6.1)
   CODE (FMT2 ('{ rt_frame @a; if (RT_TRY(@a)) {', TD, TD));
   P := S@.A;
   BLOCK
      VAR K: INTEGER := 0;
      LOOP UNTIL P = NIL DO
         K := K + 1;
         ACTIVATE_PATH (P, TD, K);
         P := P@.NEXT;
      END LOOP;
   END BLOCK;
   CODE (FMT3 ('RT_POP(@a); } else { RT_POP(@a); rt_b_par_abandon(&@);', TD, TD, TD));
   CODES ('rt_raise(rt_xcur); } }');
   IF HAS_USER_ROUTINE (MKN ('PAR_BLOCK_')) THEN    % the program's PAR_BLOCK_ (D.7): it
      BLOCK                                          % gets the list of the activations,
         VAR C: NODE := NEW_NODE (N_CALL, S@.LINE);  % and RUN_PATHS runs those it gives
         VAR A: NODE := NEW_NODE (N_APPLY, S@.LINE);
         C@.NAME := MKN ('PAR_BLOCK_');
         A@.NAME := MKN ('$PATH_LIST');
         C@.A := A;
         CODE (FMT1 ('rt_b_par_dispatch_push(&@);', TD));
         STMT (C);
         CODES ('rt_b_par_dispatch_pop();');
      END BLOCK;
   ELSE
      CODE (FMT1 ('rt_b_par_end(&@);', TD));
   END IF;
   CLOSE_SCOPE;
   CODES ('}');
END PROCEDURE PARALLEL_BLOCK;

% the list of the activations of the block being dispatched, an ARRAY [1:N] OF
% PATH_ENTRY (D.7; PATH_ENTRY of the library segment PARALLEL_SUPPORT)
FUNCTION PATH_LIST (LINE: INTEGER) RETURNS (ET);
   CONST PE: TYP := RESOLVE_USER_NAME (MK ('PATH_ENTRY'), LINE);
   CONST R: TYP := REAL_TYPE (PE);
   CONST AT: TYP := ARRAY_OF (PE, 1);
   CONST C: TEXT := CTYPE (AT);
   VAR CODE_: TEXT;
   IF R@.KIND <> T_REC THEN
      FAIL (LINE, 'PATH_ENTRY is the record type of PARALLEL_SUPPORT (D.7)');
   END IF;
   CODE_ := FMT2 ('({ @ a; rt_int n = rt_b_par_count(); a.lo[0] = 1; a.hi[0] = n; a.p = rt_b_array_alloc(n, sizeof *a.p); memset(a.p, 0, sizeof *a.p * (size_t)(n ? n : 1)); for (rt_int i = 0; i < n; i++) { a.p[i].@ = rt_b_bits_of_int(i + 1, 64);',
                  C, FIND_FIELD (R, MKN ('PATH_ADDR'))@.CNAME);
   CODE_ := FMT3 ('@ a.p[i].@ = rt_b_par_id(i); a.p[i].@ = rt_b_par_prio(i);', CODE_,
                  FIND_FIELD (R, MKN ('ACTIVATION_ID'))@.CNAME, FIND_FIELD (R, MKN ('PRIORITY_LEVEL'))@.CNAME);
   CODE_ := FMT3 ('@ a.p[i].@ = rt_b_par_connect(i, @); } a; })', CODE_,
                  FIND_FIELD (R, MKN ('CONNECT_NAME'))@.CNAME, NUM (STATIC_SIZE_OR_LEN (FIND_FIELD (R, MKN ('CONNECT_NAME'))@.T)));
   RETURN MKET (CODE_, AT);
END FUNCTION PATH_LIST;

FUNCTION STATIC_SIZE_OR_LEN (T: TYP) RETURNS (INTEGER);
   IF REAL_TYPE (T)@.MLEN.OK THEN
      RETURN REAL_TYPE (T)@.MLEN.V;
   END IF;
   RETURN 32;
END FUNCTION STATIC_SIZE_OR_LEN;

% RUN_PATHS (PATH_LIST): the implementation's PAR_BLOCK_ (D.7): the activations the
% list names are run, with its priorities; the others never run; it returns when
% they have completed
FUNCTION RUN_PATHS (E: NODE) RETURNS (ET);
   CONST V: ET := EXPR (E@.A, NIL);
   CONST T: TYP := REAL_TYPE (V.T);
   VAR R: TYP;
   IF T@.KIND <> T_ARR ! E@.A@.NEXT <> NIL THEN
      FAIL (E@.LINE, 'RUN_PATHS takes the ARRAY OF PATH_ENTRY its PAR_BLOCK_ was given (D.7)');
   END IF;
   R := REAL_TYPE (T@.ELEM);
   IF R@.KIND <> T_REC THEN
      FAIL (E@.LINE, 'RUN_PATHS takes the ARRAY OF PATH_ENTRY its PAR_BLOCK_ was given (D.7)');
   END IF;
   RETURN MKET (FMT4 ('({ @ l = @; rt_int n = rt_b_extent(1, l.lo, l.hi); for (rt_int k = 0; k < n; k++) rt_b_par_select(rt_b_int_of_bits(l.p[k].@), l.p[k].@); rt_b_par_run(); })',
                      CTYPE (T), V.C, FIND_FIELD (R, MKN ('PATH_ADDR'))@.CNAME,
                      FIND_FIELD (R, MKN ('PRIORITY_LEVEL'))@.CNAME), W@.TY_VOID);
END FUNCTION RUN_PATHS;

% the activations of a path [4-86]: one, or one for each value of its loop identifier
PROCEDURE ACTIVATE_PATH (P: NODE, TD: TEXT, K: INTEGER);
   CONST FN: TEXT := NEW_NAME ('path_');
   CONST FT: TEXT := NEW_NAME ('fr_path');
   CONST Y: SYM := LOOKUP (P@.NAME);
   CONST H: TEXT := OBJ_ACCESS (Y);
   CONST IT: TEXT := NEW_NAME ('pi');
   VAR PRIO: TEXT := MK ('0');
   VAR START: TEXT;
   VAR LT: TYP := W@.TY_INT;                         % the type of the loop identifier
   EMIT (O_TYPEDEFS, FMT2 ('typedef struct @ @;', FT, FT));
   IF P@.C <> NIL THEN                               % PRIORITY priority-expr
      PRIO := FMT1 ('rt_b_check_priority(@)', INT_EXPR (P@.C));
   END IF;
   IF P@.FL = 1 THEN                                  % FOR I IN range
      BLOCK
         CONST R: NODE := P@.A;
         CONST LV: ET := EXPR (R@.A, NIL);
         VAR LO: TEXT := LV.C;
         VAR HI: TEXT := EXPR (R@.B, LV.T).C;
         CONST RT: TYP := REAL_TYPE (LV.T);
         IF RT@.KIND = T_ENUM THEN                    % an integer or ordered enumerated
            IF IS_UNORDERED (RT) THEN                 % range, as for a loop (4.5.6.3)
               FAIL (P@.LINE, 'a loop prefix over an UNORDERED type (4.6.1)');
            END IF;
            LT := RT@.BASE;
            HI := EXPR (R@.B, LT).C;
         ORIF RT@.KIND <> T_INT ! RT@.SCALE <> 0 THEN
            FAIL (P@.LINE, 'the range of a loop prefix is integer or enumerated (4.6.1)');
         END IF;
         IF R@.IV = 1 ! R@.IV = 3 THEN
            LO := FMT1 ('(@) + 1', LO);
         END IF;
         IF R@.IV >= 2 THEN
            HI := FMT1 ('(@) - 1', HI);
         END IF;
         CODE (FMT3 ('rt_b_paths_range(&@, @, @);', H, LO, HI));
         CODE (FMT2 ('@@++) {', FMT4 ('for (rt_int @ = @.lo; @ <= @.hi; ', IT, H, IT, H), IT));
      END BLOCK;
   ELSE
      CODE (FMT1 ('{ rt_int @ = 0;', IT));
   END IF;
   CODE (FMT2 ('@ *f = rt_alloc(sizeof *f); f->up = @;', FT, UP_FRAME ()));
   IF P@.FL = 1 THEN
      CODE (FMT2 ('f->l_@ = @;', CID (P@.E@.NAME), IT));
   END IF;
   IF P@.D <> NIL THEN                                % CONNECT (interrupt)
      BLOCK
         VAR V: ET;
         % the loop identifier is known in the path header (4.6.1): Appendix C connects
         % each LT33_PRINTERS(I) to LT33_PS(I) ([4-93] says semaphore-name)
         OPEN_SCOPE;
         IF P@.FL = 1 THEN
            BLOCK
               VAR I: SYM := NEW_SYM (Y_CONST, P@.E@.NAME);
               I@.T := LT;
               I@.INPUT := TRUE;
               I@.ACCESS := IT;
               I@.LEVEL := -1;
               DEFINE (I, P@.LINE);
            END BLOCK;
         END IF;
         V := EXPR (P@.D, NIL);
         CLOSE_SCOPE;
         IF REAL_TYPE (V.T)@.KIND <> T_SEM THEN
            FAIL (P@.LINE, 'CONNECT names a semaphore (4.6.1)');
         END IF;
         IF NOT IMPLEMENTATION_SEMAPHORE (P@.D) THEN
            FAIL (P@.LINE, 'CONNECT names an implementation-defined semaphore, of the machine''s '
                           !! 'library segment (4.6.1)');
         END IF;
         CODE (FMT1 ('rt_b_connect(@);', V.C));
      END BLOCK;
   END IF;
   START := FMT4 ('rt_b_path_start(&@, @, @, f, &', H, IT, FN, TD);
   PRIO := CAT (PRIO, FMT4 ('); rt_b_path_info(&@, @, @, @', TD, NUM (K), IT, CONNECT_NAME (P)));
   IF P@.FL = 1 THEN                                  % the last value may be INTEGER.MAX
      CODE (FMT4 ('@@, @); if (@ == ', START, TD, PRIO, IT));
      CODE (FMT1 ('@.hi) break; }', H));
   ELSE
      CODE (FMT3 ('@@, @); }', START, TD, PRIO));
   END IF;
   PATH_BODY (P, FN, FT, LT);
END PROCEDURE ACTIVATE_PATH;

% the interrupt of a CONNECT clause is an implementation-defined semaphore (4.6.1):
% a variable of a segment of bluec's library (PDP_11_LT33)
FUNCTION IMPLEMENTATION_SEMAPHORE (E: NODE) RETURNS (BOOLEAN);
   VAR R: NODE := E;
   LOOP UNTIL R@.KIND = N_NAME ! R@.KIND = N_APPLY DO
      IF R@.KIND <> N_INDEX & R@.KIND <> N_FIELD THEN
         RETURN FALSE;
      END IF;
      R := R@.A;
   END LOOP;
   BLOCK
      CONST Y: SYM := ORIG_LOOKUP (R@.NAME);
      IF Y = NIL THEN
         RETURN FALSE;
      END IF;
      IF Y@.HOME = NIL THEN
         RETURN FALSE;
      END IF;
      RETURN IN_IDENTS (W@.LIBSEGS, Y@.HOME@.NAME);
   END BLOCK;
END FUNCTION IMPLEMENTATION_SEMAPHORE;

% the name of the interrupt of a path's CONNECT clause, for PAR_BLOCK_ (D.7)
FUNCTION CONNECT_NAME (P: NODE) RETURNS (TEXT);
   VAR R: NODE := P@.D;
   IF R = NIL THEN
      RETURN MK ('""');
   END IF;
   LOOP UNTIL R@.KIND = N_NAME ! R@.KIND = N_APPLY DO
      IF R@.KIND <> N_INDEX & R@.KIND <> N_FIELD THEN
         RETURN MK ('""');
      END IF;
      R := R@.A;
   END LOOP;
   RETURN CSTRING (R@.NAME);
END FUNCTION CONNECT_NAME;

% the C of the frame a path's frame points up to
FUNCTION UP_FRAME () RETURNS (TEXT);
   IF W@.CS@.LEVEL = 0 THEN
      RETURN MK ('NULL');
   END IF;
   RETURN MK ('F');
END FUNCTION UP_FRAME;

% the C function of a path: its closed scope at the next level [4-88]
PROCEDURE PATH_BODY (P: NODE, FN, FT: TEXT, LT: TYP);
   CONST SAVED_CODE: BUF := W@.CODE;
   CONST SAVED_CTXS: CTX := W@.CTXS;
   CONST OUTER: CSCOPE := W@.CS;
   CONST H: NODE := P@.E@.A;
   VAR CS: CSCOPE := NEW (SCOPE_REC);
   VAR UPT: TEXT := MK ('void');
   IF OUTER@.LEVEL > 0 THEN
      UPT := OUTER@.FTYPE;
   END IF;
   CS@ := (LEVEL: OUTER@.LEVEL + 1, R: NIL, FRAMED: TRUE, FTYPE: FT,
           FIELDS: (HEAD: NIL, TAIL: NIL), UP: OUTER, IMPORTS: H@.B, SIGNALS: H@.A,
           RESULT: NIL, IS_PATH: TRUE, COPYOUT: MK (''));
   APPEND (FMT1 (' @ *up;', UPT) # CS@.FIELDS);
   W@.CS := CS;
   W@.CODE := (HEAD: NIL, TAIL: NIL);
   W@.CTXS := NIL;
   PUSH_CTX (1, NO_TEXT ());
   ENTER_ISCOPE (H@.B, H@.A, P@.NAME);
   OPEN_SCOPE;
   IF P@.FL = 1 THEN
      BLOCK
         VAR I: SYM := NEW_SYM (Y_CONST, P@.E@.NAME);
         I@.T := LT;
         I@.INPUT := TRUE;
         I@.FIELD := FMT1 ('l_@', CID (P@.E@.NAME));
         I@.ACCESS := FMT1 ('F->l_@', CID (P@.E@.NAME));
         APPEND (FMT1 (' rt_int l_@;', CID (P@.E@.NAME)) # CS@.FIELDS);
         DEFINE (I, P@.LINE);
      END BLOCK;
   END IF;
   CLOSED_BODY (P@.B);
   CLOSE_SCOPE;
   LEAVE_ISCOPE;
   EMIT (O_PROTOS, FMT1 ('static void @(void *arg);', FN));
   EMIT (O_FUNCS, FMT2 ('static void @(void *arg) { @ *F = arg; (void)F;', FN, FT));
   EMIT (O_FUNCS, MK ('rt_frame pf; if (RT_TRY(pf)) { rt_b_path_begin();'));
   APPEND_BUF (W@.CODE # W@.OUT(O_FUNCS));
   EMIT (O_FUNCS, MK ('RT_POP(pf); } else { RT_POP(pf); rt_b_path_failed(rt_xcur, '));
   BLOCK                                             % the exceptions it may signal
      VAR L: NODE := H@.A;
      VAR C: TEXT := MK ('0');
      LOOP UNTIL L = NIL DO
         C := FMT2 ('@ || rt_xcur == @', C, EXC_NAME (L@.NAME));
         L := L@.NEXT;
      END LOOP;
      EMIT (O_FUNCS, FMT1 ('@); } }', C));
   END BLOCK;
   EMIT (O_STRUCTS, FMT2 ('struct @ {@ };', FT, JOIN_BUF (CS@.FIELDS)));
   W@.CS := OUTER;
   W@.CODE := SAVED_CODE;
   W@.CTXS := SAVED_CTXS;
END PROCEDURE PATH_BODY;

% the lines of B as one text
FUNCTION JOIN_BUF (B: BUF) RETURNS (TEXT);
   VAR C: CHUNK := B.HEAD;
   VAR R: TEXT := MK ('');
   LOOP UNTIL C = NIL DO
      R := CAT (R, C@.T);
      C := C@.NEXT;
   END LOOP;
   RETURN R;
END FUNCTION JOIN_BUF;

% path-reference [4-98]: the activation of a path, with a subscript for a loop path
FUNCTION PATH_REF (E: NODE) RETURNS (TEXT);
   VAR NAME: TEXT := E@.NAME;
   VAR SUB: TEXT := MK ('0');
   IF E@.KIND = N_APPLY THEN
      IF E@.A = NIL ! E@.A@.NEXT <> NIL THEN
         FAIL (E@.LINE, 'a path reference has one subscript (4.6.3)');
      END IF;
      SUB := INT_EXPR (E@.A);
   ORIF E@.KIND <> N_NAME THEN
      FAIL (E@.LINE, 'a path name expected');
   END IF;
   BLOCK
      CONST Y: SYM := LOOKUP (NAME);
      IF Y = NIL THEN
         FAILT (E@.LINE, 'unknown path ', NAME);
      END IF;
      IF Y@.KIND <> Y_PATH THEN
         FAILT (E@.LINE, 'not a path: ', NAME);
      END IF;
      IF E@.KIND = N_APPLY & Y@.DECL@.FL <> 1 THEN
         FAIL (E@.LINE, 'a subscript only for a path with a loop prefix (4.6.3)');
      END IF;
      RETURN FMT2 ('rt_b_paths_at(&@, @)', OBJ_ACCESS (Y), SUB);
   END BLOCK;
END FUNCTION PATH_REF;

% TERMINATE [(path-reference)] [4-97]
PROCEDURE TERMINATE_STMT (S: NODE);
   IF S@.A = NIL THEN
      CODES ('rt_b_terminate(NULL);');
   ELSE
      CODE (FMT1 ('rt_b_terminate(@);', PATH_REF (S@.A)));
   END IF;
END PROCEDURE TERMINATE_STMT;

% WAIT, PRIORITY, REQUEST, RELEASE, CLOCK and START_IO (4.6.2 - 4.6.7, 4.8.1)
FUNCTION PARALLEL_BUILTIN (E: NODE, WANT: TYP) RETURNS (ET);
   CONST NAME: TEXT := E@.NAME;
   CONST LINE: INTEGER := E@.LINE;
   IF TEQS (NAME, 'WAIT') THEN                      % [4-95]: seconds, any fixed scale
      NEED_ARGS (E, 1, 1);
      BLOCK
         CONST V: ET := EXPR (E@.A, NIL);
         IF REAL_TYPE (V.T)@.KIND <> T_INT THEN
            FAIL (LINE, 'WAIT takes a fixed point time in seconds (4.6.2)');
         END IF;
         RETURN MKET (FMT2 ('rt_b_wait(@, @)', V.C, NUM (V.T@.SCALE)), W@.TY_VOID);
      END BLOCK;
   ORIF TEQS (NAME, 'PRIORITY') THEN                % [4-99]
      NEED_ARGS (E, 1, 2);
      IF E@.A@.NEXT = NIL THEN
         RETURN MKET (FMT1 ('rt_b_priority(NULL, @)', INT_EXPR (E@.A)), W@.TY_VOID);
      END IF;
      RETURN MKET (FMT2 ('rt_b_priority(@, @)', PATH_REF (E@.A@.NEXT), INT_EXPR (E@.A)), W@.TY_VOID);
   ORIF TEQS (NAME, 'CLOCK') THEN                   % [4-100]: scale 20
      NEED_ARGS (E, 0, 1);
      IF E@.A = NIL THEN
         RETURN MKET (MK ('rt_b_clock(NULL)'), INT_TYPE (20));
      END IF;
      RETURN MKET (FMT1 ('rt_b_clock(@)', PATH_REF (E@.A)), INT_TYPE (20));
   ORIF TEQS (NAME, 'REQUEST') ! TEQS (NAME, 'RELEASE') THEN   % [4-101] [4-103]
      IF E@.A <> NIL ! E@.B = NIL ! E@.C <> NIL THEN
         FAILT (LINE, 'the semaphore is passed inout: (# S) (4.6.6): ', NAME);
      END IF;
      BLOCK
         CONST V: ET := EXPR (E@.B, NIL);
         IF REAL_TYPE (V.T)@.KIND <> T_SEM THEN
            FAIL (LINE, 'REQUEST and RELEASE take a semaphore variable');
         END IF;
         IF NOT V.LVAL THEN
            FAIL (LINE, 'the semaphore is passed inout: it must be a variable');
         END IF;
         IF TEQS (NAME, 'REQUEST') THEN
            RETURN MKET (FMT1 ('rt_b_request(@)', V.C), W@.TY_VOID);
         END IF;
         RETURN MKET (FMT1 ('rt_b_release(@)', V.C), W@.TY_VOID);
      END BLOCK;
   ORIF TEQS (NAME, 'START_IO') THEN                % [4-104]
      REQUIRE_MACHINE (LINE);
      RETURN START_IO_CALL (E);
   END IF;
   FAILT (LINE, 'unknown routine ', NAME);
END FUNCTION PARALLEL_BUILTIN;

% START_IO (device-object, device-operation, ...) [4-104]: "the various cases of
% START_IO are built into a given implementation" (C-9). Here they are the routines
% named START_IO of the machine's segment (the corpus driver of Appendix C gives a
% simulated PDP-11 with LT33 teletypes); the statement starts a device, it does not
% invoke a routine, so what the cases import is not the caller's concern (4.1.1)
FUNCTION START_IO_CALL (E: NODE) RETURNS (ET);
   CONST ARGS: ARG := CALL_ARGS (E);
   CONST Y: SYM := FIND_ROUTINE (E@.NAME, ARGS, E@.LINE, TRUE);
   VAR R: ET;
   IF Y = NIL THEN
      FAIL (E@.LINE, 'no START_IO case of this implementation fits these arguments (4.8.1)');
   END IF;
   W@.START_IO := TRUE;
   R := CALL_SYM (Y, ARGS, E@.LINE);
   W@.START_IO := FALSE;
   RETURN R;
END FUNCTION START_IO_CALL;
