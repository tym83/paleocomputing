
% ==== the parser: expressions [3-15] .. [3-41] ===========================================
% Precedence, from the loosest: ! OR XOR ->, then & AND, then the relations and IN,
% then + - !! and the scaled !+s! !-s! with the machine-dependent !+! !-!, then
% * / // MOD and their scaled and machine-dependent forms, then ** and !**s!, then
% the prefix + - NOT (3.1.4.1).

FUNCTION BIN_NODE (OP: TEXT, LINE: INTEGER, A, B: NODE) RETURNS (NODE);
   VAR N: NODE := NEW_NODE (N_BINOP, LINE);
   N@.NAME := OP;
   N@.A := A;
   N@.B := B;
   RETURN N;
END FUNCTION BIN_NODE;

% expression [3-15]: simple-expression [rounding-mode] [WITH PREC n]
FUNCTION PARSE_EXPR () RETURNS (NODE);
   VAR E: NODE := PARSE_SIMPLE ();
   IF IS ('ROUNDED') ! IS ('TRUNCATED') ! IS ('NATIVE_R') ! IS ('NATIVE_T') ! ROUNDING_AHEAD () THEN
      BLOCK
         VAR Q: NODE := NEW_NODE (N_QUAL, LINE_NOW ());
         Q@.NAME := IDENT ();
         Q@.A := E;
         E := Q;
      END BLOCK;
   END IF;
   IF IS ('WITH') & TOK_IS (AHEAD (1), 'PREC') THEN
      BLOCK
         VAR Q: NODE := NEW_NODE (N_QUAL, LINE_NOW ());
         SKIP;
         SKIP;
         IF E@.KIND = N_QUAL THEN
            Q := E;
         ELSE
            Q@.A := E;
         END IF;
         Q@.B := PARSE_SIMPLE ();
         E := Q;
      END BLOCK;
   END IF;
   RETURN E;
END FUNCTION PARSE_EXPR;

% an identifier right after an expression is its rounding mode [3-16]: a value of
% ROUNDINGS, which a program may extend (Appendix D); not the clauses of a path header
FUNCTION ROUNDING_AHEAD () RETURNS (BOOLEAN);
   CONST N: TOKEN := AHEAD (1);
   IF NOT IS_KIND (K_ID) THEN
      RETURN FALSE;
   END IF;
   IF IS ('CONNECT') ! IS ('SIGNALS') ! IS ('IMPORTS') ! IS ('PRIORITY') ! IS ('WHERE')
      ! IS ('NEEDS') ! IS ('AS') ! IS ('PREC') THEN
      RETURN FALSE;
   END IF;
   RETURN NOT (TOK_IS (N, '(') ! TOK_IS (N, '.') ! TOK_IS (N, ':=') ! TOK_IS (N, ':')
               ! TOK_IS (N, '$') ! TOK_IS (N, '@') ! TOK_IS (N, '['));
END FUNCTION ROUNDING_AHEAD;

FUNCTION PARSE_SIMPLE () RETURNS (NODE);
   VAR LEFT: NODE := PARSE_CONJ ();
   LOOP UNTIL NOT (IS ('OR') ! IS ('!') ! IS ('XOR') ! IS ('->')) DO
      BLOCK
         CONST T: TOKEN := CUR ();
         SKIP;
         LEFT := BIN_NODE (T.TX, T.LINE, LEFT, PARSE_CONJ ());
      END BLOCK;
   END LOOP;
   RETURN LEFT;
END FUNCTION PARSE_SIMPLE;

FUNCTION PARSE_CONJ () RETURNS (NODE);
   VAR LEFT: NODE := PARSE_RELATION ();
   LOOP UNTIL NOT (IS ('AND') ! IS ('&')) DO
      BLOCK
         CONST T: TOKEN := CUR ();
         SKIP;
         LEFT := BIN_NODE (T.TX, T.LINE, LEFT, PARSE_RELATION ());
      END BLOCK;
   END LOOP;
   RETURN LEFT;
END FUNCTION PARSE_CONJ;

FUNCTION PARSE_RELATION () RETURNS (NODE);
   VAR LEFT: NODE := PARSE_SUM ();
   LOOP
      BLOCK
         CONST T: TOKEN := CUR ();
         IF IS ('=') ! IS ('<') ! IS ('>') ! IS ('<=') ! IS ('>=') ! IS ('<>') THEN
            SKIP;
            LEFT := BIN_NODE (T.TX, T.LINE, LEFT, PARSE_SUM ());
         ORIF IS ('IN') THEN
            BLOCK
               VAR N: NODE := NEW_NODE (N_IN, T.LINE);
               SKIP;
               N@.A := LEFT;
               N@.B := PARSE_RANGE ();
               LEFT := N;
            END BLOCK;
         ELSE
            RETURN LEFT;
         END IF;
      END BLOCK;
   END LOOP;
END FUNCTION PARSE_RELATION;

% a scaled operator !op s! or a machine-dependent one !op! whose op is one of OPS
% (blank-separated); NIL, with nothing consumed, if there is none
FUNCTION TRY_SCALED (LEFT: NODE, OPS: ASCII_STR(?L)) RETURNS (NODE);
   CONST SAVED: INTEGER := W@.POS;
   CONST LINE: INTEGER := LINE_NOW ();
   VAR N: NODE;
   IF NOT IS ('!') THEN
      RETURN NIL;
   END IF;
   BLOCK
      CONST OP: TOKEN := AHEAD (1);
      CONST T: TEXT := OP.TX;
      VAR FOUND: BOOLEAN := FALSE;
      IF OP.KIND <> K_SYM & OP.KIND <> K_RES THEN
         RETURN NIL;
      END IF;
      LOOP FOR I IN [0 : L - T.LEN] DO
         IF OPS[I : I + T.LEN - 1] = STR (T, T.LEN) THEN
            IF (I = 0 ! OPS[I - 1 : I - 1] = ' ')
               & (I + T.LEN = L ! OPS[I + T.LEN : I + T.LEN] = ' ') THEN
               FOUND := TRUE;
            END IF;
         END IF;
      END LOOP I;
      IF NOT FOUND THEN
         RETURN NIL;
      END IF;
      SKIP;
      SKIP;
      N := BIN_NODE (T, LINE, LEFT, NIL);
      IF ACCEPT ('!') THEN
         N@.FL := 2;
         RETURN N;
      END IF;
      IF IS_KIND (K_NUM) ! IS_KIND (K_ID) ! IS ('(') ! IS ('-') ! IS ('+') THEN
         N@.D := PARSE_SECONDARY ();
         IF ACCEPT ('!') THEN
            N@.FL := 1;
            RETURN N;
         END IF;
      END IF;
      W@.POS := SAVED;
      RETURN NIL;
   END BLOCK;
END FUNCTION TRY_SCALED;

FUNCTION PARSE_SUM () RETURNS (NODE);
   VAR LEFT: NODE := PARSE_TERM ();
   LOOP
      IF IS ('+') ! IS ('-') ! IS ('!!') THEN
         BLOCK
            CONST T: TOKEN := CUR ();
            SKIP;
            LEFT := BIN_NODE (T.TX, T.LINE, LEFT, PARSE_TERM ());
         END BLOCK;
      ELSE
         BLOCK
            CONST N: NODE := TRY_SCALED (LEFT, '+ -');
            IF N = NIL THEN
               RETURN LEFT;
            END IF;
            N@.B := PARSE_TERM ();
            LEFT := N;
         END BLOCK;
      END IF;
   END LOOP;
END FUNCTION PARSE_SUM;

FUNCTION PARSE_TERM () RETURNS (NODE);
   VAR LEFT: NODE := PARSE_FACTOR ();
   LOOP
      IF IS ('*') ! IS ('/') ! IS ('//') ! IS ('MOD') THEN
         BLOCK
            CONST T: TOKEN := CUR ();
            SKIP;
            LEFT := BIN_NODE (T.TX, T.LINE, LEFT, PARSE_FACTOR ());
         END BLOCK;
      ELSE
         BLOCK
            CONST N: NODE := TRY_SCALED (LEFT, '* / // MOD');
            IF N = NIL THEN
               RETURN LEFT;
            END IF;
            N@.B := PARSE_FACTOR ();
            LEFT := N;
         END BLOCK;
      END IF;
   END LOOP;
END FUNCTION PARSE_TERM;

FUNCTION PARSE_FACTOR () RETURNS (NODE);
   VAR LEFT: NODE := PARSE_SECONDARY ();
   LOOP
      IF IS ('**') THEN
         BLOCK
            CONST T: TOKEN := CUR ();
            SKIP;
            LEFT := BIN_NODE (T.TX, T.LINE, LEFT, PARSE_SECONDARY ());
         END BLOCK;
      ELSE
         BLOCK
            CONST N: NODE := TRY_SCALED (LEFT, '**');
            IF N = NIL THEN
               RETURN LEFT;
            END IF;
            N@.B := PARSE_SECONDARY ();
            LEFT := N;
         END BLOCK;
      END IF;
   END LOOP;
END FUNCTION PARSE_FACTOR;

FUNCTION PARSE_SECONDARY () RETURNS (NODE);
   CONST T: TOKEN := CUR ();
   IF IS ('+') ! IS ('-') ! IS ('NOT') THEN
      BLOCK
         VAR N: NODE := NEW_NODE (N_UNOP, T.LINE);
         SKIP;
         N@.NAME := T.TX;
         N@.A := PARSE_POSTFIX ();
         RETURN N;
      END BLOCK;
   END IF;
   RETURN PARSE_POSTFIX ();
END FUNCTION PARSE_SECONDARY;

% input # inout # output argument lists [4-38]; an input argument may be a type
FUNCTION PARSE_ARGS (N: NODE) RETURNS (NODE);
   VAR HEAD, TAIL: NODE := NIL;
   VAR GROUP: INTEGER := 0;
   EXPECT ('(');
   LOOP UNTIL IS (')') DO
      IF ACCEPT ('#') THEN
         SELECT GROUP FROM
            0 --> N@.A := HEAD; END;
            1 --> N@.B := HEAD; END;
            ELSE --> FAIL (N@.LINE, 'too many # in an argument list'); END;
         END SELECT;
         GROUP := GROUP + 1;
         HEAD := NIL;
         TAIL := NIL;
      ELSE
         IF GROUP = 0 THEN
            ADD_LIST (PARSE_TYPE_ARG () # HEAD, TAIL);
         ELSE
            ADD_LIST (PARSE_EXPR () # HEAD, TAIL);
         END IF;
         IF ACCEPT (',') THEN
            ;
         END IF;
      END IF;
   END LOOP;
   EXPECT (')');
   SELECT GROUP FROM
      0 --> N@.A := HEAD; END;
      1 --> N@.B := HEAD; END;
      ELSE --> N@.C := HEAD; END;
   END SELECT;
   RETURN N;
END FUNCTION PARSE_ARGS;

FUNCTION PARSE_POSTFIX () RETURNS (NODE);
   VAR E: NODE := PARSE_ATOM ();
   VAR N: NODE;
   LOOP
      BLOCK
         CONST LINE: INTEGER := LINE_NOW ();
         IF IS ('(') & E@.KIND = N_ENUMLIT THEN        % \P (...): an identifier [2-10]
            E@.KIND := N_NAME;
         END IF;
         IF IS ('(') & E@.KIND = N_NAME THEN          % a call or a subscript
            E@.KIND := N_APPLY;
            E := PARSE_ARGS (E);
         ORIF IS ('(') THEN
            N := NEW_NODE (N_INDEX, LINE);
            N := PARSE_ARGS (N);
            N@.B := N@.A;
            N@.A := E;
            E := N;
         ORIF ACCEPT ('.') THEN                       % [3-191] and attributes [3-2]
            N := NEW_NODE (N_FIELD, LINE);
            N@.A := E;
            N@.NAME := IDENT ();
            E := N;
         ORIF ACCEPT ('@') THEN                       % [3-32]
            N := NEW_NODE (N_DEREF, LINE);
            N@.A := E;
            E := N;
         ORIF IS ('[') & NOT TOK_IS (AHEAD (1), ']') THEN    % [3-34]
            SKIP;
            N := NEW_NODE (N_SUBSTR, LINE);
            N@.A := E;
            N@.B := PARSE_EXPR ();
            EXPECT (':');
            N@.C := PARSE_EXPR ();
            EXPECT (']');
            E := N;
         ELSE
            RETURN E;
         END IF;
      END BLOCK;
   END LOOP;
END FUNCTION PARSE_POSTFIX;

% the quoted strings of a bitstring literal after BIN, OCT or HEX [3-111]
FUNCTION PARSE_BITS (BITS_PER: INTEGER, LINE: INTEGER) RETURNS (NODE);
   CONST AT: INTEGER := W@.TOP;
   VAR N: NODE := NEW_NODE (N_BITS, LINE);
   VAR R: TEXT;
   IF NOT IS_KIND (K_STR) THEN
      FAIL (LINE, 'a quoted bitstring expected');
   END IF;
   LOOP UNTIL NOT IS_KIND (K_STR) DO
      BLOCK
         CONST T: TEXT := CUR ().TX;
         CONST S: ASCII_STR(T.LEN) := STR (T, T.LEN);
         LOOP FOR I IN [0 : T.LEN - 1] DO
            IF S[I:I] <> ' ' THEN
               BLOCK
                  CONST C: INTEGER := CODE_OF (S[I:I]);
                  VAR V: INTEGER := C - 48;
                  VAR P: INTEGER := 1;                % 2 ** BITS_PER, then less
                  IF C >= 65 THEN
                     V := C - 55;
                  END IF;
                  LOOP FOR B IN [1 : BITS_PER] DO
                     P := P * 2;
                  END LOOP B;
                  IF V < 0 ! V >= P THEN
                     FAIL (LINE, 'a bad digit in a bitstring literal');
                  END IF;
                  LOOP FOR B IN [1 : BITS_PER] DO
                     P := P // 2;
                     IF (V // P) MOD 2 = 1 THEN
                        R := MK ('1');
                     ELSE
                        R := MK ('0');
                     END IF;
                  END LOOP B;
               END BLOCK;
            END IF;
         END LOOP I;
      END BLOCK;
      SKIP;
   END LOOP;
   N@.NAME := (AT: AT, LEN: W@.TOP - AT, H: -1);
   RETURN N;
END FUNCTION PARSE_BITS;

FUNCTION PARSE_ATOM () RETURNS (NODE);
   CONST T: TOKEN := CUR ();
   VAR N: NODE;
   IF T.KIND = K_NUM THEN
      N := NEW_NODE (N_INT, T.LINE);
      N@.IV := T.IV;
      N@.NAME := T.TX;
      SKIP;
      RETURN N;
   END IF;
   IF T.KIND = K_REAL ! T.KIND = K_FIX THEN       % [3-50] [3-71]
      N := NEW_NODE (N_REAL, T.LINE);
      N@.NAME := T.TX;
      IF T.KIND = K_FIX THEN
         N@.FL := 1;
         N@.IV := T.IV;
      END IF;
      SKIP;
      RETURN N;
   END IF;
   IF T.KIND = K_GEN THEN                          % ?NAME or ? in a range or bound
      RETURN PARSE_TYPE_ARG ();
   END IF;
   IF IS ('BIN') ! IS ('OCT') ! IS ('HEX') THEN
      SKIP;
      IF TOK_IS (T, 'BIN') THEN
         RETURN PARSE_BITS (1, T.LINE);
      ORIF TOK_IS (T, 'OCT') THEN
         RETURN PARSE_BITS (3, T.LINE);
      END IF;
      RETURN PARSE_BITS (4, T.LINE);
   END IF;
   IF T.KIND = K_STR ! T.KIND = K_ENUM THEN       % [3-135]
      RETURN PARSE_CHARSTRING (NO_TEXT ());
   END IF;
   IF T.KIND = K_ID & (AHEAD (1).KIND = K_STR ! (AHEAD (1).KIND = K_ENUM
         & NOT TOK_IS (AHEAD (2), '(') & NOT TOK_IS (AHEAD (2), ':='))) THEN   % CHARSET 'STRING'
      SKIP;
      RETURN PARSE_CHARSTRING (T.TX);
   END IF;
   IF ACCEPT ('TRUE') THEN
      N := NEW_NODE (N_BOOL, T.LINE);
      N@.IV := 1;
      RETURN N;
   ORIF ACCEPT ('FALSE') THEN
      RETURN NEW_NODE (N_BOOL, T.LINE);
   ORIF ACCEPT ('NIL') THEN
      RETURN NEW_NODE (N_NIL, T.LINE);
   ORIF ACCEPT ('ANY') THEN
      RETURN NEW_NODE (N_ANY, T.LINE);
   END IF;
   IF ACCEPT ('[') THEN                             % [type-spec]$$(...) [3-40] [3-178]
      BLOCK
         CONST TS: NODE := PARSE_TYPE_SPEC ();
         EXPECT (']');
         EXPECT ('$$');
         IF IS ('(') & AHEAD (1).KIND = K_ID & TOK_IS (AHEAD (2), ':') THEN
            N := PARSE_ATOM ();
            N@.B := TS;
            RETURN N;
         END IF;
         N := NEW_NODE (N_TYPESPEC, T.LINE);
         N@.A := TS;
         EXPECT ('(');
         N@.B := PARSE_EXPR ();
         EXPECT (')');
         RETURN N;
      END BLOCK;
   END IF;
   IF IS ('(') THEN
      IF AHEAD (1).KIND = K_ID & TOK_IS (AHEAD (2), ':') THEN
         BLOCK                                   % a record constructor [3-178]
            VAR HEAD, TAIL: NODE := NIL;
            SKIP;
            LOOP
               N := NEW_NODE (N_FINIT, LINE_NOW ());
               N@.NAME := IDENT ();
               EXPECT (':');
               N@.A := PARSE_EXPR ();
               ADD_LIST (N # HEAD, TAIL);
            END LOOP WHEN NOT ACCEPT (',');
            EXPECT (')');
            N := NEW_NODE (N_RECCONS, T.LINE);
            N@.A := HEAD;
            RETURN N;
         END BLOCK;
      END IF;
      SKIP;
      BLOCK
         CONST E: NODE := PARSE_EXPR ();
         IF IS (',') THEN                           % an array constructor [3-151]
            BLOCK
               VAR HEAD, TAIL: NODE := NIL;
               ADD_LIST (E # HEAD, TAIL);
               LOOP UNTIL NOT ACCEPT (',') DO
                  ADD_LIST (PARSE_EXPR () # HEAD, TAIL);
               END LOOP;
               EXPECT (')');
               N := NEW_NODE (N_ARRCONS, T.LINE);
               N@.A := HEAD;
               RETURN N;
            END BLOCK;
         END IF;
         EXPECT (')');
         N := NEW_NODE (N_PAREN, T.LINE);
         N@.A := E;
         RETURN N;
      END BLOCK;
   END IF;
   IF T.KIND = K_ID THEN
      N := NEW_NODE (N_NAME, T.LINE);
      N@.NAME := ROUTINE_NAME_NODE ()@.NAME;
      IF (TEQS (N@.NAME, 'NEW') ! TEQS (N@.NAME, 'PTR$NEW') ! TEQS (N@.NAME, 'SEMAPHORE$NEW'))
         & IS ('(') THEN
         N@.KIND := N_NEW;                          % [3-198] [3-206]
         EXPECT ('(');
         N@.A := PARSE_TYPE_ARG ();
         EXPECT (')');
      END IF;
      RETURN N;
   END IF;
   FAILT (T.LINE, 'an expression expected, not ', T.TX);
END FUNCTION PARSE_ATOM;

% basic-strings and enumerated literals in a row [3-135]; a single enumerated
% literal is not a charstring-literal (3.7.2)
FUNCTION PARSE_CHARSTRING (CHARSET: TEXT) RETURNS (NODE);
   CONST LINE: INTEGER := LINE_NOW ();
   VAR HEAD, TAIL: NODE := NIL;
   VAR STRINGS: INTEGER := 0;
   VAR N: NODE;
   LOOP UNTIL NOT (IS_KIND (K_STR) ! IS_KIND (K_ENUM)) DO
      N := NEW_NODE (N_PART, LINE_NOW ());
      N@.IV := CUR ().KIND;
      N@.NAME := CUR ().TX;
      IF N@.IV = K_STR THEN
         STRINGS := STRINGS + 1;
      END IF;
      SKIP;
      ADD_LIST (N # HEAD, TAIL);
   END LOOP;
   IF STRINGS = 0 & CHARSET.LEN = 0 & HEAD@.NEXT = NIL THEN
      HEAD@.KIND := N_ENUMLIT;                       % \CR alone; \CR \LF is a string
      RETURN HEAD;
   END IF;
   N := NEW_NODE (N_STR, LINE);
   N@.A := HEAD;
   N@.NAME := CHARSET;
   RETURN N;
END FUNCTION PARSE_CHARSTRING;
