
% ==== attribute queries [3-2], constructors [3-11], type-specifiers [3-40] ===============
% The implementation's representation (3.x.3): STD fixed point values have 64 bits,
% floating point values are IEEE doubles (15 digits), characters are stored in bytes.

FUNCTION INT_ET (V: INTEGER) RETURNS (ET);
   RETURN MKET (FMT1 ('((rt_int)@LL)', NUM (V)), W@.TY_INT);
END FUNCTION INT_ET;

% the number of bits for the values 0 .. N - 1 (ENUM_STD, 3.4.3)
FUNCTION BITS_FOR (N: INTEGER) RETURNS (INTEGER);
   VAR B: INTEGER := 0;
   VAR P: INTEGER := 1;
   LOOP UNTIL P >= N DO
      B := B + 1;
      P := P * 2;
   END LOOP;
   RETURN B;
END FUNCTION BITS_FOR;

% the SIZE of an enumerated type: of its ENUM_REP or ENUM_VAL_REP, or ENUM_STD
FUNCTION ENUM_SIZE (T: TYP) RETURNS (INTEGER);
   IF T@.REPS <> NIL THEN
      IF T@.REPS@.A <> NIL THEN
         BLOCK
            CONST M: MVAL := MANIFEST (T@.REPS@.A);
            IF M.OK THEN
               RETURN M.V;
            END IF;
         END BLOCK;
      END IF;
   END IF;
   RETURN BITS_FOR (T@.BASE@.NLITS);
END FUNCTION ENUM_SIZE;

% the packing of strings, arrays and records (3.7.3, 3.8.3, 3.9.3): 0 DENSE, 1 PACKED,
% 2 UNPACKED; strings are PACKED, arrays and records UNPACKED by default
FUNCTION PACKING_OF (T: TYP) RETURNS (INTEGER);
   CONST K: INTEGER := T@.KIND;
   VAR MODE: INTEGER := 2;
   IF K = T_STR THEN
      MODE := 1;
   END IF;
   IF T@.REPS <> NIL THEN
      IF T@.REPS@.KIND = N_REP & T@.REPS@.A <> NIL THEN
         IF T@.REPS@.A@.KIND = N_NAME ! T@.REPS@.A@.KIND = N_ENUMLIT THEN
            BLOCK
               CONST P: INTEGER := PACKING_VALUE (T@.REPS@.A@.NAME);
               IF P >= 0 THEN
                  MODE := P;
               END IF;
            END BLOCK;
         END IF;
      END IF;
   END IF;
   RETURN MODE;
END FUNCTION PACKING_OF;

FUNCTION PACKING_VALUE (NAME: TEXT) RETURNS (INTEGER);
   IF TEQS (NAME, 'DENSE') THEN
      RETURN 0;
   ORIF TEQS (NAME, 'PACKED') THEN
      RETURN 1;
   ORIF TEQS (NAME, 'UNPACKED') THEN
      RETURN 2;
   END IF;
   RETURN -1;
END FUNCTION PACKING_VALUE;

FUNCTION PACKING_LITERAL (MODE: INTEGER, LINE: INTEGER) RETURNS (ET);
   IF MODE = 0 THEN
      RETURN ENUM_LITERAL (LIT_NODE ('DENSE', LINE), NIL);
   ORIF MODE = 1 THEN
      RETURN ENUM_LITERAL (LIT_NODE ('PACKED', LINE), NIL);
   END IF;
   RETURN ENUM_LITERAL (LIT_NODE ('UNPACKED', LINE), NIL);
END FUNCTION PACKING_LITERAL;

% the SIZE of N elements of ES bits laid out by MODE (rt_b_pack_size): a slot each,
% the element itself (DENSE), the unit of 8, 16, 32 or 64 bits that holds it
% (PACKED), or whole words (UNPACKED)
FUNCTION PACK_SLOT (ES, MODE: INTEGER) RETURNS (INTEGER);
   VAR U: INTEGER := 8;
   IF ES <= 0 THEN
      IF MODE = 0 THEN
         RETURN 0;
      END IF;
      RETURN 8;
   END IF;
   IF MODE = 0 THEN
      RETURN ES;
   END IF;
   IF MODE = 1 & ES <= W@.WORD THEN
      LOOP UNTIL U >= ES DO
         U := U * 2;
      END LOOP;
      RETURN U;
   END IF;
   RETURN ((ES + W@.WORD - 1) // W@.WORD) * W@.WORD;
END FUNCTION PACK_SLOT;

% the range of STD fixed point values, as stored integers (3.2.1, 3.2.6.3)
FUNCTION STD_MIN_C () RETURNS (TEXT);
   IF W@.WORD = 64 THEN
      RETURN MK ('INT64_MIN');
   END IF;
   RETURN FMT1 ('((rt_int)@LL)', NUM (-POW2 (W@.WORD - 1)));
END FUNCTION STD_MIN_C;

FUNCTION STD_MAX_C () RETURNS (TEXT);
   IF W@.WORD = 64 THEN
      RETURN MK ('INT64_MAX');
   END IF;
   RETURN FMT1 ('((rt_int)@LL)', NUM (POW2 (W@.WORD - 1) - 1));
END FUNCTION STD_MAX_C;

FUNCTION STD_MIN () RETURNS (INTEGER);
   IF W@.WORD = 64 THEN
      RETURN -INTEGER.MAX - 1;
   END IF;
   RETURN -POW2 (W@.WORD - 1);
END FUNCTION STD_MIN;

FUNCTION STD_MAX () RETURNS (INTEGER);
   IF W@.WORD = 64 THEN
      RETURN INTEGER.MAX;
   END IF;
   RETURN POW2 (W@.WORD - 1) - 1;
END FUNCTION STD_MAX;

% a fixed point result checked against STD precision on a machine of shorter words
% (OVERFLOW, 3.2.1: PRECISION)
FUNCTION STD_CHECK (C: TEXT) RETURNS (TEXT);
   IF W@.WORD = 64 THEN
      RETURN C;
   END IF;
   RETURN FMT1 ('rt_b_std(@)', C);
END FUNCTION STD_CHECK;

FUNCTION PACK_SIZE (N, ES, MODE: INTEGER) RETURNS (INTEGER);
   IF N <= 0 THEN
      RETURN 0;
   END IF;
   RETURN N * PACK_SLOT (ES, MODE);
END FUNCTION PACK_SIZE;

% the number of bits of a character of the string type T: of its character set
FUNCTION CHAR_SIZE (T: TYP) RETURNS (INTEGER);
   RETURN ENUM_SIZE (CHARSET_OF (T));
END FUNCTION CHAR_SIZE;

% the representations of the characters of T's set, for the run time: a table or none
FUNCTION CHAR_REPS (T: TYP) RETURNS (TEXT);
   CONST C: TYP := CHARSET_OF (T);
   IF C@.REPS <> NIL THEN
      IF C@.REPS@.B <> NIL THEN
         RETURN REP_TABLE (C);
      END IF;
   END IF;
   RETURN FMT1 ('NULL, @', NUM (C@.BASE@.NLITS));
END FUNCTION CHAR_REPS;

% ---- the machine (implementation-dependent values, 3.x.1, 3.x.3) -------------------

% the largest length of a string or bitstring: (CHAR_STR.LENGTH).MAX (3.6.1, 3.7.1)
FUNCTION MAX_LENGTH () RETURNS (INTEGER);
   RETURN 100000000;
END FUNCTION MAX_LENGTH;

% the largest nominal precision of a float: MAX_NOM_PREC (3.3.1, D.6)
FUNCTION MAX_FLOAT_PRECISION () RETURNS (INTEGER);
   IF W@.WORD = 16 THEN                              % the D format (-pdp11)
      RETURN 16;
   END IF;
   RETURN 15;
END FUNCTION MAX_FLOAT_PRECISION;

% the implemented precision for a nominal one (3.3.1): single (7 digits) or double
FUNCTION IMP_PRECISION_OF (P: INTEGER) RETURNS (INTEGER);
   IF P <= 7 THEN
      RETURN 7;
   END IF;
   IF W@.WORD = 16 THEN                              % D: a 56-bit mantissa (-pdp11)
      RETURN 16;
   END IF;
   RETURN 15;
END FUNCTION IMP_PRECISION_OF;

% the representation attributes of the floating point format of precision P (3.3.3):
% single and double binary formats; MANTISSA_SIZE counts the sign bit
FUNCTION FLOAT_FORMAT (P: INTEGER, NAME: TEXT) RETURNS (INTEGER);
   CONST SINGLE: BOOLEAN := IMP_PRECISION_OF (P) = 7;
   IF W@.WORD = 16 THEN                              % the PDP-11's F and D formats: an
      IF TEQS (NAME, 'EXPONENT_MIN') THEN            % 8-bit exponent for both (-pdp11)
         RETURN -127;
      ORIF TEQS (NAME, 'EXPONENT_MAX') THEN
         RETURN 127;
      ORIF TEQS (NAME, 'EXPONENT_SIZE') THEN
         RETURN 8;
      ORIF TEQS (NAME, 'MANTISSA_SIZE') & NOT SINGLE THEN
         RETURN 57;                                  % D: 56 bits and the sign
      END IF;
   END IF;
   IF TEQS (NAME, 'EXPONENT_MIN') THEN
      IF SINGLE THEN
         RETURN -125;
      END IF;
      RETURN -1021;
   ORIF TEQS (NAME, 'EXPONENT_MAX') THEN
      IF SINGLE THEN
         RETURN 128;
      END IF;
      RETURN 1024;
   ORIF TEQS (NAME, 'MANTISSA_SIZE') THEN
      IF SINGLE THEN
         RETURN 25;
      END IF;
      RETURN 54;
   ORIF TEQS (NAME, 'EXPONENT_SIZE') THEN
      IF SINGLE THEN
         RETURN 8;
      END IF;
      RETURN 11;
   ORIF TEQS (NAME, 'SIZE') THEN
      IF SINGLE THEN
         RETURN 32;
      END IF;
      RETURN 64;
   END IF;
   RETURN 0;
END FUNCTION FLOAT_FORMAT;

% the SIZE of a value of type T when it is known at translation (3.x.3)
FUNCTION STATIC_SIZE (T: TYP) RETURNS (MVAL);
   CONST K: INTEGER := T@.KIND;
   IF K = T_ABS THEN
      RETURN STATIC_SIZE (T@.BASE);
   ORIF K = T_INT THEN
      IF T@.REPS <> NIL THEN
         IF T@.REPS@.A <> NIL THEN
            RETURN MANIFEST (T@.REPS@.A);
         END IF;
      END IF;
      RETURN SOME (W@.WORD);
   ORIF K = T_FLOAT THEN
      RETURN SOME (FLOAT_FORMAT (T@.SCALE, MK ('SIZE')));
   ORIF K = T_BOOL THEN
      RETURN SOME (1);
   ORIF K = T_ENUM THEN
      RETURN SOME (ENUM_SIZE (T));
   ORIF K = T_BITS THEN
      RETURN T@.MLEN;
   ORIF K = T_STR THEN
      IF T@.MLEN.OK THEN
         RETURN SOME (PACK_SIZE (T@.MLEN.V, CHAR_SIZE (T), PACKING_OF (T)));
      END IF;
   ORIF K = T_PTR ! K = T_SEM THEN
      RETURN SOME (W@.WORD);
   ORIF K = T_ARR THEN                               % 3.8.3: the elements by the packing
      BLOCK
         CONST ES: MVAL := STATIC_SIZE (T@.ELEM);
         VAR N: INTEGER := 1;
         VAR B: BND := T@.BOUNDS;
         IF NOT ES.OK THEN
            RETURN NO_MVAL ();
         END IF;
         LOOP UNTIL B = NIL DO
            IF NOT (B@.MLO.OK & B@.MHI.OK) ! IS_GEN_TEXT (B@.LO) ! IS_GEN_TEXT (B@.HI) THEN
               RETURN NO_MVAL ();
            END IF;
            N := N * MAX_INT (B@.MHI.V - B@.MLO.V + 1, 0);
            B := B@.NEXT;
         END LOOP;
         RETURN SOME (PACK_SIZE (N, ES.V, PACKING_OF (T)));
      END BLOCK;
   END IF;
   RETURN NO_MVAL ();
END FUNCTION STATIC_SIZE;

% the attribute NAME of the value B (3.x.1, 3.x.3)
FUNCTION ATTRIBUTE (B: ET, NAME: TEXT, LINE: INTEGER) RETURNS (ET);
   CONST T: TYP := B.T;
   CONST K: INTEGER := T@.KIND;
   IF TEQS (NAME, 'SIZE') THEN
      RETURN SIZE_OF (T, B.C);
   END IF;
   IF K = T_INT THEN                                 % 3.2.1, 3.2.3
      IF TEQS (NAME, 'SCALE') THEN
         RETURN INT_ET (T@.SCALE);
      ORIF TEQS (NAME, 'RADIX') THEN
         RETURN INT_ET (2);
      ORIF TEQS (NAME, 'PRECISION') THEN
         RETURN ENUM_LITERAL (LIT_NODE ('STD', LINE), NIL);
      ORIF TEQS (NAME, 'SIGNING') THEN               % FIXED_REP (S, U) (3.2.3)
         IF T@.REPS <> NIL THEN
            IF TEQS (T@.REPS@.NAME, 'FIXED_REP') & T@.REPS@.A <> NIL THEN
               IF T@.REPS@.A@.NEXT <> NIL THEN
                  IF TEQS (T@.REPS@.A@.NEXT@.NAME, 'UNSIGNED') THEN
                     RETURN ENUM_LITERAL (LIT_NODE ('UNSIGNED', LINE), NIL);
                  END IF;
               END IF;
            END IF;
         END IF;
         RETURN ENUM_LITERAL (LIT_NODE ('SIGNED', LINE), NIL);
      ORIF TEQS (NAME, 'MIN') THEN
         IF T@.LO_C.LEN > 0 THEN
            RETURN MKET (SUBST_SELF (T@.LO_C, B.SELF), INT_TYPE (T@.SCALE));
         END IF;
         RETURN MKET (STD_MIN_C (), INT_TYPE (T@.SCALE));
      ORIF TEQS (NAME, 'MAX') THEN
         IF T@.HI_C.LEN > 0 THEN
            RETURN MKET (SUBST_SELF (T@.HI_C, B.SELF), INT_TYPE (T@.SCALE));
         END IF;
         RETURN MKET (STD_MAX_C (), INT_TYPE (T@.SCALE));
      END IF;
   ORIF K = T_FLOAT THEN                             % 3.3.1, 3.3.3
      IF TEQS (NAME, 'NOM_PRECISION') THEN
         RETURN INT_ET (T@.SCALE);
      ORIF TEQS (NAME, 'IMP_PRECISION') THEN
         RETURN INT_ET (IMP_PRECISION_OF (T@.SCALE));
      ORIF TEQS (NAME, 'RADIX') THEN
         RETURN INT_ET (2);
      ORIF TEQS (NAME, 'EXPONENT_MIN') ! TEQS (NAME, 'EXPONENT_MAX') ! TEQS (NAME, 'MANTISSA_SIZE')
         ! TEQS (NAME, 'EXPONENT_SIZE') THEN
         RETURN INT_ET (FLOAT_FORMAT (T@.SCALE, NAME));
      ORIF TEQS (NAME, 'MIN') ! TEQS (NAME, 'MAX') THEN      % of FLOAT (IMP_PRECISION)
         BLOCK
            CONST MT: TYP := FLOAT_TYPE (IMP_PRECISION_OF (T@.SCALE));
            IF TEQS (NAME, 'MIN') THEN
               IF T@.LO_C.LEN > 0 THEN
                  RETURN MKET (SUBST_SELF (T@.LO_C, B.SELF), MT);
               END IF;
               RETURN MKET (FLOAT_LIMIT (MT, NAME), MT);
            END IF;
            IF T@.HI_C.LEN > 0 THEN
               RETURN MKET (SUBST_SELF (T@.HI_C, B.SELF), MT);
            END IF;
            RETURN MKET (FLOAT_LIMIT (MT, NAME), MT);
         END BLOCK;
      END IF;
   ORIF K = T_ENUM THEN                              % 3.4.1
      IF TEQS (NAME, 'MIN') THEN
         IF T@.LO_C.LEN > 0 THEN
            RETURN MKET (SUBST_SELF (T@.LO_C, B.SELF), T@.BASE);
         END IF;
         RETURN MKET (MK ('0'), T@.BASE);
      ORIF TEQS (NAME, 'MAX') THEN
         IF T@.HI_C.LEN > 0 THEN
            RETURN MKET (SUBST_SELF (T@.HI_C, B.SELF), T@.BASE);
         END IF;
         RETURN MKET (NUM (T@.BASE@.NLITS - 1), T@.BASE);
      ORIF TEQS (NAME, 'EXTENT') THEN
         IF T@.LO_C.LEN > 0 THEN                    % 0 for an empty range
            RETURN MKET (SUBST_SELF (FMT4 ('((@) >= (@) ? (@) - (@) + 1 : 0)', T@.HI_C, T@.LO_C,
                                           T@.HI_C, T@.LO_C), B.SELF), W@.TY_INT);
         END IF;
         RETURN INT_ET (T@.BASE@.NLITS);
      END IF;
   ORIF K = T_STR ! K = T_BITS THEN                  % 3.6.1, 3.7.1, 3.7.3
      IF TEQS (NAME, 'LENGTH') THEN
         RETURN MKET (FMT1 ('(rt_int)(@).len', B.C), W@.TY_INT);
      ORIF TEQS (NAME, 'PACKING') THEN
         RETURN PACKING_LITERAL (PACKING_OF (T), LINE);
      END IF;
   ORIF K = T_ARR THEN                               % 3.8.1, 3.8.3
      IF TEQS (NAME, 'DIMENSIONS') THEN
         RETURN INT_ET (T@.DIMS);
      ORIF TEQS (NAME, 'EXTENT') ! TEQS (NAME, 'BOUNDS') THEN
         RETURN ARRAY_SHAPE (B, NAME);
      ORIF TEQS (NAME, 'PACKING') THEN
         RETURN PACKING_LITERAL (PACKING_OF (T), LINE);
      END IF;
   ORIF K = T_SEM THEN                               % 3.11.1
      IF TEQS (NAME, 'USAGE') THEN
         IF T@.SCALE = 1 THEN
            RETURN ENUM_LITERAL (LIT_NODE ('REGION', LINE), NIL);
         END IF;
         RETURN ENUM_LITERAL (LIT_NODE ('SYNCH', LINE), NIL);
      END IF;
   ORIF K = T_ABS ! K = T_REC THEN                   % the attributes of an abstract type
      BLOCK                                          % are its formals (3.12.5)
         VAR U: TYP := T;
         IF K = T_ABS THEN
            U := T@.BASE;
         END IF;
         IF U@.KIND = T_REC THEN
            BLOCK
               CONST F: FIELD := FIND_FIELD (U, NAME);
               IF F <> NIL THEN
                  IF F@.KIND <> 0 THEN
                     RETURN MKET (FMT2 ('(@).@', B.C, F@.CNAME), F@.T);
                  END IF;
               END IF;
            END BLOCK;
         END IF;
      END BLOCK;
   END IF;
   FAILT (LINE, 'no such field or attribute: ', NAME);
END FUNCTION ATTRIBUTE;

% A.BOUNDS, an ARRAY [0:n] OF BOUNDS_DEF (STD), and A.EXTENT, an ARRAY [0:n] OF
% INTEGER, as values (3.8.1)
FUNCTION ARRAY_SHAPE (B: ET, NAME: TEXT) RETURNS (ET);
   CONST T: TYP := REAL_TYPE (B.T);
   CONST D: TEXT := NUM (T@.DIMS);
   CONST X: TEXT := NEW_NAME ('sx');
   CONST R: TEXT := NEW_NAME ('sr');
   VAR ELEM: TYP := W@.TY_INT;
   VAR C: TEXT;
   IF TEQS (NAME, 'BOUNDS') THEN
      BLOCK
         VAR TS: NODE := NEW_NODE (TS_NAME, 0);
         TS@.NAME := MKN ('BOUNDS_DEF');
         TS@.A := NEW_NODE (N_NAME, 0);
         TS@.A@.NAME := MKN ('STD');
         ELEM := RESOLVE (TS);
      END BLOCK;
   END IF;
   BLOCK
      CONST A: TYP := ARRAY_OF (ELEM, 1);
      C := FMT4 ('({ @ @ = @; @ ', CTYPE (T), X, B.C, A@.CNAME);
      C := FMT4 ('@@; memset(&@, 0, sizeof @);', C, R, R, R);
      C := FMT4 ('@ @.lo[0] = 0; @.hi[0] = @ - 1;', C, R, R, D);
      C := FMT4 ('@ @.p = rt_alloc(@ * sizeof *@.p);', C, R, D, R);
      C := FMT2 ('@ for (int i = 0; i < @; i++) {', C, D);
      IF TEQS (NAME, 'BOUNDS') THEN
         C := FMT2 ('@ @', C, INIT_CODE (ELEM, FMT1 ('@.p[i]', R)));
         C := FMT4 ('@ @.p[i].f_MIN = @.lo[i]; @.p[i].f_MAX = ', C, R, X, R);
         C := FMT2 ('@@.hi[i]; }', C, X);
      ELSE
         C := FMT4 ('@ @.p[i] = @.hi[i] >= @.lo[i] ? ', C, R, X, X);
         C := FMT4 ('@@.hi[i] - @.lo[i] + 1 : 0; }', C, X, X, X);
      END IF;
      RETURN MKET (FMT2 ('@ @; })', C, R), A);
   END BLOCK;
END FUNCTION ARRAY_SHAPE;

FUNCTION LIT_NODE_T (NAME: TEXT, LINE: INTEGER) RETURNS (NODE);
   RETURN LIT_NODE (STR (NAME, NAME.LEN), LINE);
END FUNCTION LIT_NODE_T;

FUNCTION LIT_NODE (NAME: ASCII_STR(?L), LINE: INTEGER) RETURNS (NODE);
   VAR N: NODE := NEW_NODE (N_ENUMLIT, LINE);
   N@.NAME := MKN (NAME);
   RETURN N;
END FUNCTION LIT_NODE;

% SIZE: the bits of the representation
FUNCTION SIZE_OF (T: TYP, C: TEXT) RETURNS (ET);
   CONST K: INTEGER := T@.KIND;
   IF K = T_INT THEN
      IF T@.REPS <> NIL THEN
         IF T@.REPS@.A <> NIL THEN
            RETURN MKET (EXPR (T@.REPS@.A, W@.TY_INT).C, W@.TY_INT);
         END IF;
      END IF;
      RETURN INT_ET (W@.WORD);
   ORIF K = T_FLOAT THEN
      RETURN INT_ET (FLOAT_FORMAT (T@.SCALE, MK ('SIZE')));
   ORIF K = T_BOOL THEN
      RETURN INT_ET (1);
   ORIF K = T_ENUM THEN
      RETURN INT_ET (ENUM_SIZE (T));
   ORIF K = T_BITS THEN
      IF T@.LEN_C.LEN > 0 THEN                       % the length is the type's
         RETURN MKET (FMT1 ('(rt_int)(@)', T@.LEN_C), W@.TY_INT);
      END IF;
      RETURN MKET (FMT1 ('(rt_int)(@).len', C), W@.TY_INT);
   ORIF K = T_STR THEN                               % 3.7.3: characters by the packing
      IF T@.MLEN.OK THEN
         RETURN INT_ET (STATIC_SIZE (T).V);
      END IF;
      IF T@.LEN_C.LEN > 0 THEN
         RETURN MKET (FMT3 ('rt_b_pack_size(@, @, @)', T@.LEN_C, NUM (CHAR_SIZE (T)),
                            NUM (PACKING_OF (T))), W@.TY_INT);
      END IF;
      RETURN MKET (FMT3 ('rt_b_pack_size((@).len, @, @)', C, NUM (CHAR_SIZE (T)),
                         NUM (PACKING_OF (T))), W@.TY_INT);
   ORIF K = T_PTR ! K = T_SEM THEN
      RETURN INT_ET (W@.WORD);
   ORIF K = T_ABS THEN
      RETURN SIZE_OF (T@.BASE, C);
   ORIF K = T_REC THEN                               % 3.9.3: the fields by the reptype
      RETURN MKET (RECORD_SIZE (T, C), W@.TY_INT);
   ORIF K = T_ARR THEN                               % 3.8.3: elements by the packing
      BLOCK
         CONST ES: MVAL := STATIC_SIZE (T@.ELEM);
         IF ES.OK THEN
            RETURN MKET (CAT (FMT3 ('rt_b_pack_size(rt_b_extent(@, (@).lo, (@).hi), ', NUM (T@.DIMS), C, C),
                              FMT2 ('@, @)', NUM (ES.V), NUM (PACKING_OF (T)))), W@.TY_INT);
         END IF;
      END BLOCK;
      RETURN MKET (FMT4 ('(rt_int)(rt_b_extent(@, (@).lo, (@).hi) * sizeof (@) * 8)',
                         NUM (T@.DIMS), C, C, CTYPE (T@.ELEM)), W@.TY_INT);
   END IF;
   RETURN MKET (FMT1 ('(rt_int)(sizeof (@) * 8)', CTYPE (T)), W@.TY_INT);
END FUNCTION SIZE_OF;

% T.ATTRIBUTE and (T.ATTRIBUTE).MAX for a type name T (3.1.1.1)
FUNCTION TYPE_ATTRIBUTE (TNAME, NAME: TEXT, LINE: INTEGER) RETURNS (ET);
   IF IS_TYPE_WORD (TNAME) THEN
      FAILT (LINE, 'an attribute of a type class needs a member: ', TNAME);
   END IF;
   RETURN ATTRIBUTE (TYPE_VALUE (TNAME, LINE), NAME, LINE);
END FUNCTION TYPE_ATTRIBUTE;

% a stand-in value of the type TNAME for its attribute queries: for an array or
% record type, a value with the bounds and parameters of the type
FUNCTION TYPE_VALUE (TNAME: TEXT, LINE: INTEGER) RETURNS (ET);
   RETURN TYPE_VALUE_OF (RESOLVE_USER_NAME (TNAME, LINE));
END FUNCTION TYPE_VALUE;

FUNCTION TYPE_VALUE_OF (T: TYP) RETURNS (ET);
   CONST RT: TYP := REAL_TYPE (T);
   IF RT@.KIND = T_ARR ! RT@.KIND = T_REC THEN
      BLOCK
         CONST TMP: TEXT := NEW_NAME ('tq');
         VAR C: TEXT := FMT4 ('({ @ @; memset(&@, 0, sizeof @); ', CTYPE (T), TMP, TMP, TMP);
         C := FMT3 ('@@ @; })', C, INIT_CODE (RT, TMP), TMP);
         RETURN MKET (C, T);
      END BLOCK;
   END IF;
   RETURN MKET (FMT1 ('(*(@ *)0)', CTYPE (T)), T);
END FUNCTION TYPE_VALUE_OF;

% is E the name of a type (not of a value)?
FUNCTION IS_TYPE_NAME (E: NODE) RETURNS (BOOLEAN);
   IF E@.KIND <> N_NAME THEN
      RETURN FALSE;
   END IF;
   BLOCK
      CONST Y: SYM := LOOKUP (E@.NAME);
      IF Y = NIL THEN
         RETURN FALSE;
      END IF;
      RETURN Y@.KIND = Y_TYPE;
   END BLOCK;
END FUNCTION IS_TYPE_NAME;

% (A.B).C: the attribute C of the attribute B of A; for the maxima of the
% implementation (3.6.1, 3.7.1, 3.3.1)
FUNCTION ATTRIBUTE_OF_ATTRIBUTE (TNAME, A, B: TEXT, LINE: INTEGER) RETURNS (ET);
   IF TEQS (A, 'LENGTH') & TEQS (B, 'MAX') THEN
      RETURN INT_ET (100000000);
   ORIF TEQS (A, 'NOM_PRECISION') & TEQS (B, 'MAX') THEN
      RETURN INT_ET (15);
   ORIF TEQS (A, 'LENGTH') & TEQS (B, 'MIN') THEN
      RETURN INT_ET (0);
   END IF;
   FAILT (LINE, 'this attribute of an attribute is not implemented: ', B);
END FUNCTION ATTRIBUTE_OF_ATTRIBUTE;

% ---- constructors -------------------------------------------------------------------------

% [type-spec]$$(field: value, ...) or (field: value, ...) where the type is known [3-178]
FUNCTION RECORD_CONSTRUCTOR (E: NODE, WANT: TYP) RETURNS (ET);
   VAR T: TYP := WANT;
   IF E@.B <> NIL THEN
      T := RESOLVE (E@.B);
   END IF;
   IF T = NIL THEN
      FAIL (E@.LINE, 'the type of a record constructor is unknown (3.9.2)');
   END IF;
   T := REAL_TYPE (T);
   IF T@.KIND <> T_REC THEN
      FAIL (E@.LINE, 'a record constructor for something not a record');
   END IF;
   IF HAS_ANY (T) THEN
      FAIL (E@.LINE, 'the constructor of a T(ANY) record needs [T(tag)]$$ (3.9.2)');
   END IF;
   BLOCK
      CONST TMP: TEXT := NEW_NAME ('rc');
      VAR R: TEXT := FMT4 ('({ @ @; memset(&@, 0, sizeof @); ', T@.CNAME, TMP, TMP, TMP);
      VAR F: FIELD := T@.FIELDS;
      R := FMT2 ('@@', R, INIT_CODE (T, TMP));
      LOOP UNTIL F = NIL DO                         % every accessible field is given
         IF F@.KIND = 0 THEN
            IF F@.TAGF.LEN = 0 ! LABELS_HAVE (F@.LABELS, TAG_VALUE (T, F@.TAGF).V,
                                             FIND_FIELD (T, F@.TAGF)@.T) THEN
               BLOCK
                  CONST INIT: NODE := FIND_INIT (E@.A, F@.NAME);
                  IF INIT = NIL THEN
                     FAILT (E@.LINE, 'the constructor must give the field ', F@.NAME);
                  END IF;
                  R := FMT2 ('@ @', R, STORE_CODE (F@.T, FMT2 ('@.@', TMP, F@.CNAME),
                                                   EXPR (INIT@.A, F@.T), INIT@.LINE, TMP));
               END BLOCK;
            END IF;
         END IF;
         F := F@.NEXT;
      END LOOP;
      BLOCK
         VAR P: NODE := E@.A;
         LOOP UNTIL P = NIL DO
            BLOCK
               CONST G: FIELD := FIND_VFIELD (T, P@.NAME);
               IF G = NIL THEN
                  FAILT (P@.LINE, 'no such field: ', P@.NAME);
               END IF;
               IF G@.KIND <> 0 THEN
                  FAILT (P@.LINE, 'a parameter field comes from the type: ', P@.NAME);
               END IF;
               CHECK_VARIANT (G, T, NIL, P@.LINE);
            END BLOCK;
            P := P@.NEXT;
         END LOOP;
      END BLOCK;
      RETURN MKET (FMT2 ('@ @; })', R, TMP), T);
   END BLOCK;
END FUNCTION RECORD_CONSTRUCTOR;

FUNCTION FIND_INIT (L: NODE, NAME: TEXT) RETURNS (NODE);
   VAR P: NODE := L;
   LOOP UNTIL P = NIL DO
      IF TEQ (P@.NAME, NAME) THEN
         RETURN P;
      END IF;
      P := P@.NEXT;
   END LOOP;
   RETURN NIL;
END FUNCTION FIND_INIT;

% (e, e, ...) and ((e, ...), (e, ...)) [3-151]: bounds from zero in each dimension
FUNCTION ARRAY_CONSTRUCTOR (E: NODE, WANT: TYP) RETURNS (ET);
   VAR DIMS: INTEGER := 0;
   VAR P: NODE := E;
   VAR ELEM: TYP := NIL;
   LOOP UNTIL P@.KIND <> N_ARRCONS DO
      DIMS := DIMS + 1;
      P := P@.A;
   END LOOP;
   IF WANT <> NIL THEN
      IF REAL_TYPE (WANT)@.KIND = T_ARR THEN
         ELEM := REAL_TYPE (WANT)@.ELEM;
      END IF;
   END IF;
   IF ELEM = NIL THEN
      ELEM := EXPR (P, NIL).T;
      IF ELEM@.KIND = T_INT & ELEM@.SCALE = 0 THEN
         ELEM := W@.TY_INT;
      END IF;
   END IF;
   CHECK_SHAPE (E, DIMS);
   BLOCK
      VAR A: TYP := ARRAY_OF (ELEM, DIMS);
      CONST TMP: TEXT := NEW_NAME ('ac');
      VAR R: TEXT := FMT3 ('({ @ @; memset(&@, 0, sizeof ', A@.CNAME, TMP, TMP);
      VAR K: INTEGER := 0;
      BLOCK                                          % its bounds: [0:N-1] in each
         VAR Q: NODE := E;                          % dimension (3.8.2)
         VAR TAIL: BND := NIL;
         LOOP FOR D IN [1 : DIMS] DO
            BLOCK
               VAR B: BND := NEW (BND_REC);
               CONST N: INTEGER := LIST_LENGTH (Q@.A);
               B@ := (LO: MK ('0'), HI: NUM (N - 1), MLO: SOME (0), MHI: SOME (N - 1),
                      ANYARG: FALSE, NEXT: NIL);
               IF TAIL = NIL THEN
                  A@.BOUNDS := B;
               ELSE
                  TAIL@.NEXT := B;
               END IF;
               TAIL := B;
            END BLOCK;
            Q := Q@.A;
         END LOOP D;
      END BLOCK;
      R := FMT2 ('@@); ', R, TMP);
      P := E;
      LOOP FOR D IN [0 : DIMS - 1] DO
         R := FMT4 ('@ @.lo[@] = 0; @.hi[', R, TMP, NUM (D), TMP);
         R := FMT3 ('@@] = @;', R, NUM (D), NUM (LIST_LENGTH (P@.A) - 1));
         P := P@.A;
      END LOOP D;
      R := FMT4 ('@ @.p = rt_alloc(sizeof *@.p * (size_t)rt_b_extent(@, ', R, TMP, TMP, NUM (DIMS));
      R := FMT3 ('@@.lo, @.hi) + 1);', R, TMP, TMP);
      ARRAY_ELEMENTS (E, DIMS, A, TMP # R, K);
      RETURN MKET (FMT2 ('@ @; })', R, TMP), A);
   END BLOCK;
END FUNCTION ARRAY_CONSTRUCTOR;

% the components of an array constructor have the same shape (3.8.2)
PROCEDURE CHECK_SHAPE (E: NODE, DIMS: INTEGER);
   VAR P: NODE := E@.A;
   IF DIMS <= 1 THEN
      RETURN;
   END IF;
   LOOP UNTIL P = NIL DO
      IF P@.KIND <> N_ARRCONS ! E@.A@.KIND <> N_ARRCONS THEN
         FAIL (E@.LINE, 'the components of an array constructor must have the same shape (3.8.2)');
      END IF;
      IF NOT SAME_SHAPE (P, E@.A) THEN
         FAIL (E@.LINE, 'the components of an array constructor must have the same shape (3.8.2)');
      END IF;
      CHECK_SHAPE (P, DIMS - 1);
      P := P@.NEXT;
   END LOOP;
END PROCEDURE CHECK_SHAPE;

FUNCTION SAME_SHAPE (A, B: NODE) RETURNS (BOOLEAN);
   IF A@.KIND <> N_ARRCONS ! B@.KIND <> N_ARRCONS THEN
      RETURN A@.KIND <> N_ARRCONS & B@.KIND <> N_ARRCONS;
   END IF;
   IF LIST_LENGTH (A@.A) <> LIST_LENGTH (B@.A) THEN
      RETURN FALSE;
   END IF;
   RETURN SAME_SHAPE (A@.A, B@.A);
END FUNCTION SAME_SHAPE;

% the elements of a constructor, row by row; K counts them
PROCEDURE ARRAY_ELEMENTS (E: NODE, DIMS: INTEGER, A: TYP, TMP: TEXT # R: TEXT, K: INTEGER);
   VAR P: NODE := E@.A;
   IF E@.KIND <> N_ARRCONS THEN
      FAIL (E@.LINE, 'the components of an array constructor must have the same shape');
   END IF;
   LOOP UNTIL P = NIL DO
      IF DIMS > 1 THEN
         ARRAY_ELEMENTS (P, DIMS - 1, A, TMP # R, K);
      ELSE
         IF P@.KIND = N_ARRCONS THEN
            FAIL (P@.LINE, 'the components of an array constructor must have the same shape');
         END IF;
         IF NEEDS_INIT (A@.ELEM) THEN
            R := FMT2 ('@ @', R, INIT_CODE (A@.ELEM, FMT2 ('@.p[@]', TMP, NUM (K))));
         END IF;
         R := FMT2 ('@ @', R, STORE_CODE (A@.ELEM, FMT2 ('@.p[@]', TMP, NUM (K)),
                                          EXPR (P, A@.ELEM), P@.LINE, NO_TEXT ()));
         K := K + 1;
      END IF;
      P := P@.NEXT;
   END LOOP;
END PROCEDURE ARRAY_ELEMENTS;

FUNCTION ARRAY_OF (ELEM: TYP, DIMS: INTEGER) RETURNS (TYP);
   VAR T: TYP := NEW_TYP (T_ARR);
   T@.ELEM := ELEM;
   T@.DIMS := DIMS;
   T@.CNAME := ARRAY_STRUCT (ELEM, DIMS);
   RETURN T;
END FUNCTION ARRAY_OF;

% [type-spec]$$(expression) [3-40]: a literal of that type, or (in a machine-dependent
% part) a bitstring taken as the representation of a value of the type
FUNCTION TYPE_SPECIFIER (E: NODE) RETURNS (ET);
   CONST T: TYP := RESOLVE (E@.A);
   CONST V: ET := EXPR (E@.B, T);
   CONST RT: TYP := REAL_TYPE (T);
   IF V.T@.KIND = T_BITS & RT@.KIND <> T_BITS THEN
      REQUIRE_MACHINE (E@.LINE);
      IF RT@.KIND = T_INT THEN
         RETURN MKET (RANGE_CHECK (RT, FMT1 ('rt_b_int_of_bits(@)', V.C), NO_TEXT ()), T);
      ORIF RT@.KIND = T_BOOL THEN
         RETURN MKET (FMT1 ('rt_b_int_of_bits(@)', V.C), T);
      ORIF RT@.KIND = T_ENUM THEN
         RETURN MKET (ENUM_OF_BITS (RT, V.C), T);
      ORIF IS_D (RT) THEN                         % the PDP-11's D and F (-pdp11)
         RETURN MKET (FMT1 ('rt_b_d_of_bits(@)', V.C), T);
      ORIF RT@.KIND = T_FLOAT & W@.WORD = 16 THEN
         RETURN MKET (FMT1 ('rt_b_f_of_bits(@)', V.C), T);
      ORIF RT@.KIND = T_FLOAT THEN
         RETURN MKET (FMT1 ('rt_b_float_of_bits(@)', V.C), T);
      ORIF RT@.KIND = T_STR THEN                  % the characters by the packing
         RETURN MKET (FMT4 ('rt_b_chars_of_bits(@, @, @, @)', V.C, NUM (CHAR_SIZE (RT)),
                            NUM (PACKING_OF (RT)), CHAR_REPS (RT)), T);
      END IF;
      FAIL (E@.LINE, 'this type-specifier on a bitstring is not implemented');
   END IF;
   % the value must be one of the type (INVALID_TYPE, 3.1.4.1)
   BLOCK
      VAR C: TEXT;
      W@.TYPECHECK := TRUE;
      C := CONVERT (V, T, E@.LINE, NO_TEXT ());
      W@.TYPECHECK := FALSE;
      IF (RT@.KIND = T_STR ! RT@.KIND = T_BITS) & RT@.LEN_C.LEN > 0 & NOT (RT@.MLEN.OK & V.T@.MLEN.OK) THEN
         C := FMT2 ('rt_b_tlen(@, @)', C, RT@.LEN_C);
      END IF;
      RETURN MKET (C, T);
   END BLOCK;
END FUNCTION TYPE_SPECIFIER;

% the position of the literal whose representation is the bitstring C (3.4.3)
FUNCTION ENUM_OF_BITS (T: TYP, C: TEXT) RETURNS (TEXT);
   IF T@.REPS <> NIL THEN
      IF T@.REPS@.B <> NIL THEN                        % ENUM_VAL_REP
         RETURN FMT2 ('rt_b_enum_of_rep(@, @)', C, REP_TABLE (T));
      END IF;
   END IF;
   RETURN FMT1 ('rt_b_int_of_bits(@)', C);
END FUNCTION ENUM_OF_BITS;

% a C array of the representations of the literals of T, in order of the literals
FUNCTION REP_TABLE (T: TYP) RETURNS (TEXT);
   CONST NAME: TEXT := NEW_NAME ('reps');
   VAR L: NODE := T@.BASE@.LITS;
   VAR R: TEXT := MK ('');
   LOOP UNTIL L = NIL DO
      BLOCK
         VAR V: NODE := T@.REPS@.B;
         VAR FOUND: BOOLEAN := FALSE;
         LOOP UNTIL V = NIL DO
            IF TEQ (V@.NAME, L@.NAME) THEN
               R := FMT2 ('@@, ', R, EXPR (V@.A, NIL).C);
               FOUND := TRUE;
            END IF;
            V := V@.NEXT;
         END LOOP;
         IF NOT FOUND THEN
            FAILT (T@.REPS@.LINE, 'VALUES must give every literal (3.4.3): ', L@.NAME);
         END IF;
      END BLOCK;
      L := L@.NEXT;
   END LOOP;
   EMIT (O_GLOBALS, FMT2 ('static rstr @[@];', NAME, NUM (T@.BASE@.NLITS)));
   EMIT (O_STARTUP, FMT3 ('{ rstr t[] = { @ }; memcpy(@, t, sizeof @); }', R, NAME, NAME));
   RETURN FMT2 ('@, @', NAME, NUM (T@.BASE@.NLITS));
END FUNCTION REP_TABLE;

% NEW(T) for a pointer, NEW(n) for a semaphore [3-198] [3-206]
FUNCTION NEW_EXPR (E: NODE, WANT: TYP) RETURNS (ET);
   VAR SEM: BOOLEAN := TEQS (E@.NAME, 'SEMAPHORE$NEW');
   IF TEQS (E@.NAME, 'NEW') & W@.NEW_OK <> E THEN
      FAIL (E@.LINE, 'NEW without PTR$ or SEMAPHORE$ only initializes a declaration or is the source '
                     !! 'of an assignment (3.10.2, 3.11.2)');
   END IF;
   IF TEQS (E@.NAME, 'NEW') & WANT <> NIL THEN
      SEM := REAL_TYPE (WANT)@.KIND = T_SEM;
   END IF;
   IF SEM THEN
      BLOCK
         VAR T: TYP := NEW_TYP (T_SEM);
         IF WANT <> NIL THEN
            IF WANT@.KIND = T_SEM THEN
               T := WANT;
            END IF;
         END IF;
         RETURN MKET (FMT2 ('rt_b_sem_value(@, @)', INT_EXPR (E@.A), NUM (T@.SCALE)), T);
      END BLOCK;
   END IF;
   BLOCK
      CONST T: TYP := RESOLVE (EXPR_TO_TS (E@.A));
      VAR P: TYP := NEW_TYP (T_PTR);
      P@.TARGET := T;
      P@.TARGET_TS := E@.A;
      IF NEEDS_INIT (T) THEN
         RETURN MKET (FMT2 ('({ @ *p = rt_b_new(sizeof *p); @ p; })', CTYPE (T),
                            INIT_CODE (T, MK ('(*p)'))), P);
      END IF;
      RETURN MKET (FMT2 ('((@ *)rt_b_new(sizeof (@)))', CTYPE (T), CTYPE (T)), P);
   END BLOCK;
END FUNCTION NEW_EXPR;
