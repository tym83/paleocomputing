
% ==== the parser: segments, declarations, statements ====================================
% Productions are named as in Appendix A of the specification.

FUNCTION CUR () RETURNS (TOKEN);
   RETURN W@.TOKS(W@.POS);
END FUNCTION CUR;

FUNCTION AHEAD (K: INTEGER) RETURNS (TOKEN);
   IF W@.POS + K >= W@.NTOKS THEN
      RETURN W@.TOKS(W@.NTOKS - 1);
   END IF;
   RETURN W@.TOKS(W@.POS + K);
END FUNCTION AHEAD;

FUNCTION LINE_NOW () RETURNS (INTEGER);
   RETURN W@.TOKS(W@.POS).LINE;
END FUNCTION LINE_NOW;

% is the current token the word or symbol S?
FUNCTION IS (S: ASCII_STR(?L)) RETURNS (BOOLEAN);
   CONST T: TOKEN := W@.TOKS(W@.POS);
   IF T.KIND = K_SYM ! T.KIND = K_RES ! T.KIND = K_ID THEN
      RETURN TEQS (T.TX, S);
   END IF;
   RETURN FALSE;
END FUNCTION IS;

FUNCTION IS_KIND (K: INTEGER) RETURNS (BOOLEAN);
   RETURN W@.TOKS(W@.POS).KIND = K;
END FUNCTION IS_KIND;

PROCEDURE SKIP ();
   IF W@.POS < W@.NTOKS - 1 THEN
      W@.POS := W@.POS + 1;
   END IF;
END PROCEDURE SKIP;

FUNCTION ACCEPT (S: ASCII_STR(?L)) RETURNS (BOOLEAN);
   IF IS (S) THEN
      SKIP;
      RETURN TRUE;
   END IF;
   RETURN FALSE;
END FUNCTION ACCEPT;

PROCEDURE EXPECT (S: ASCII_STR(?L));
   IF NOT ACCEPT (S) THEN
      BLOCK
         CONST T: TEXT := CUR ().TX;
         FAIL (LINE_NOW (), S !! ' expected, not ' !! STR (T, T.LEN));
      END BLOCK;
   END IF;
END PROCEDURE EXPECT;

FUNCTION IDENT () RETURNS (TEXT);
   CONST T: TOKEN := CUR ();
   IF T.KIND <> K_ID THEN
      FAILT (T.LINE, 'an identifier expected, not ', T.TX);
   END IF;
   SKIP;
   RETURN T.TX;
END FUNCTION IDENT;

FUNCTION NEW_NODE (KIND, LINE: INTEGER) RETURNS (NODE);
   VAR N: NODE := NEW (NODE_REC);
   N@ := (KIND: KIND, LINE: LINE, IV: 0, NAME: (AT: 0, LEN: 0, H: 0),
          A: NIL, B: NIL, C: NIL, D: NIL, NEXT: NIL);
   RETURN N;
END FUNCTION NEW_NODE;

% append N to the list HEAD .. TAIL
PROCEDURE ADD_LIST (N: NODE # HEAD, TAIL: NODE);
   IF HEAD = NIL THEN
      HEAD := N;
   ELSE
      TAIL@.NEXT := N;
   END IF;
   TAIL := N;
END PROCEDURE ADD_LIST;

FUNCTION LIST_LENGTH (N: NODE) RETURNS (INTEGER);
   VAR K: INTEGER := 0;
   VAR P: NODE := N;
   LOOP UNTIL P = NIL DO
      K := K + 1;
      P := P@.NEXT;
   END LOOP;
   RETURN K;
END FUNCTION LIST_LENGTH;

FUNCTION IDENT_NODE () RETURNS (NODE);
   VAR N: NODE := NEW_NODE (N_IDENT, LINE_NOW ());
   N@.NAME := IDENT ();
   RETURN N;
END FUNCTION IDENT_NODE;

% identifier,...
FUNCTION IDENT_LIST () RETURNS (NODE);
   VAR HEAD, TAIL: NODE := NIL;
   ADD_LIST (IDENT_NODE () # HEAD, TAIL);
   LOOP UNTIL NOT ACCEPT (',') DO
      ADD_LIST (IDENT_NODE () # HEAD, TAIL);
   END LOOP;
   RETURN HEAD;
END FUNCTION IDENT_LIST;

% ---- segments [4-4] ---------------------------------------------------------------------
FUNCTION PARSE_COMPILATION () RETURNS (NODE);
   VAR HEAD, TAIL: NODE := NIL;
   LOOP UNTIL IS_KIND (K_EOF) DO
      ADD_LIST (PARSE_SEGMENT () # HEAD, TAIL);
   END LOOP;
   RETURN HEAD;
END FUNCTION PARSE_COMPILATION;

PROCEDURE SKIP_PARENS ();
   VAR DEPTH: INTEGER := 0;
   LOOP
      IF IS ('(') THEN
         DEPTH := DEPTH + 1;
      ORIF IS (')') THEN
         DEPTH := DEPTH - 1;
      END IF;
      SKIP;
   END LOOP WHEN DEPTH = 0;
END PROCEDURE SKIP_PARENS;

FUNCTION PARSE_SEGMENT () RETURNS (NODE);
   VAR S: NODE := NEW_NODE (N_SEGMENT, LINE_NOW ());
   VAR HEAD, TAIL: NODE := NIL;
   IF ACCEPT ('MAIN') THEN
      S@.IV := 1;
   END IF;
   EXPECT ('SEGMENT');
   S@.NAME := IDENT ();
   IF ACCEPT ('USES') THEN                         % [4-6]
      EXPECT ('(');
      LOOP
         ADD_LIST (IDENT_NODE () # HEAD, TAIL);
         IF IS ('(') THEN
            SKIP_PARENS;
         END IF;
      END LOOP WHEN NOT ACCEPT (',');
      EXPECT (')');
      S@.A := HEAD;
   END IF;
   IF ACCEPT ('DEFINES') THEN                      % [4-11]
      IF IS ('(') THEN
         SKIP_PARENS;
      ELSE
         SKIP;
      END IF;
   END IF;
   EXPECT (';');
   S@.B := PARSE_BODY ();
   S@.C := PARSE_ROUTINES ();
   EXPECT ('END');
   EXPECT ('SEGMENT');
   IF NOT TEQ (IDENT (), S@.NAME) THEN
      FAILT (LINE_NOW (), 'END SEGMENT expected for ', S@.NAME);
   END IF;
   EXPECT (';');
   RETURN S;
END FUNCTION PARSE_SEGMENT;

% declarations and statements [4-1]
FUNCTION PARSE_BODY () RETURNS (NODE);
   VAR B: NODE := NEW_NODE (N_BODY, LINE_NOW ());
   B@.A := PARSE_DECLARATIONS ();
   B@.B := PARSE_STATEMENTS ();
   RETURN B;
END FUNCTION PARSE_BODY;

FUNCTION PARSE_ROUTINES () RETURNS (NODE);
   VAR HEAD, TAIL: NODE := NIL;
   LOOP UNTIL NOT (IS ('PROCEDURE') ! IS ('FUNCTION') ! IS ('INLINE')) DO
      ADD_LIST (PARSE_ROUTINE () # HEAD, TAIL);
   END LOOP;
   RETURN HEAD;
END FUNCTION PARSE_ROUTINES;

FUNCTION PARSE_DECLARATIONS () RETURNS (NODE);
   VAR HEAD, TAIL: NODE := NIL;
   LOOP
      IF IS ('CONST') ! IS ('VAR') THEN
         ADD_LIST (PARSE_OBJECT_DECL () # HEAD, TAIL);
      ORIF IS ('TYPE') THEN
         ADD_LIST (PARSE_TYPE_DECL () # HEAD, TAIL);
      ELSE
         EXIT;
      END IF;
   END LOOP;
   RETURN HEAD;
END FUNCTION PARSE_DECLARATIONS;

% [3-4] [3-6]
FUNCTION PARSE_OBJECT_DECL () RETURNS (NODE);
   VAR D: NODE := NEW_NODE (N_VAR, LINE_NOW ());
   IF ACCEPT ('CONST') THEN
      D@.KIND := N_CONST;
   ELSE
      EXPECT ('VAR');
   END IF;
   D@.A := IDENT_LIST ();
   EXPECT (':');
   D@.B := PARSE_TYPE_SPEC ();
   IF ACCEPT (':=') THEN
      D@.C := PARSE_EXPR ();
   ORIF D@.KIND = N_CONST THEN
      FAIL (D@.LINE, 'a constant needs a value');
   END IF;
   EXPECT (';');
   RETURN D;
END FUNCTION PARSE_OBJECT_DECL;

% [3-211]
FUNCTION PARSE_TYPE_DECL () RETURNS (NODE);
   VAR D: NODE := NEW_NODE (N_TYPE, LINE_NOW ());
   EXPECT ('TYPE');
   D@.NAME := IDENT ();
   EXPECT ('=');
   D@.B := PARSE_TYPE_SPEC ();
   EXPECT (';');
   RETURN D;
END FUNCTION PARSE_TYPE_DECL;

% [3-8]
FUNCTION PARSE_TYPE_SPEC () RETURNS (NODE);
   VAR N: NODE;
   VAR HEAD, TAIL: NODE := NIL;
   CONST LINE: INTEGER := LINE_NOW ();
   IF ACCEPT ('ARRAY') THEN                        % [3-147]
      N := NEW_NODE (TS_ARRAY, LINE);
      EXPECT ('[');
      N@.A := PARSE_EXPR ();
      EXPECT (':');
      N@.B := PARSE_EXPR ();
      EXPECT (']');
      EXPECT ('OF');
      N@.C := PARSE_TYPE_SPEC ();
      RETURN N;
   END IF;
   IF ACCEPT ('RECORD') THEN                       % [3-160]
      N := NEW_NODE (TS_RECORD, LINE);
      LOOP UNTIL NOT IS ('VAR') DO
         BLOCK
            VAR F: NODE := NEW_NODE (N_VAR, LINE_NOW ());
            SKIP;
            F@.A := IDENT_LIST ();
            EXPECT (':');
            F@.B := PARSE_TYPE_SPEC ();
            EXPECT (';');
            ADD_LIST (F # HEAD, TAIL);
         END BLOCK;
      END LOOP;
      N@.A := HEAD;
      EXPECT ('END');
      EXPECT ('RECORD');
      RETURN N;
   END IF;
   N := NEW_NODE (TS_NAME, LINE);
   N@.NAME := IDENT ();
   IF TEQS (N@.NAME, 'ENUM') THEN                  % [3-83]
      N@.KIND := TS_ENUM;
      EXPECT ('(');
      LOOP
         BLOCK
            VAR L: NODE := NEW_NODE (N_IDENT, LINE_NOW ());
            L@.NAME := CUR ().TX;
            SKIP;
            ADD_LIST (L # HEAD, TAIL);
         END BLOCK;
      END LOOP WHEN NOT ACCEPT (',');
      EXPECT (')');
      N@.A := HEAD;
      RETURN N;
   END IF;
   IF IS ('(') THEN                                 % type arguments [3-216]
      SKIP;
      LOOP
         IF TEQS (N@.NAME, 'PTR') THEN
            ADD_LIST (PARSE_TYPE_SPEC () # HEAD, TAIL);
         ORIF IS_KIND (K_GEN) THEN
            BLOCK
               VAR G: NODE := NEW_NODE (TS_GEN, LINE_NOW ());
               CONST T: TEXT := CUR ().TX;
               G@.NAME := (AT: T.AT + 1, LEN: T.LEN - 1, H: -1);
               SKIP;
               ADD_LIST (G # HEAD, TAIL);
            END BLOCK;
         ELSE
            ADD_LIST (PARSE_EXPR () # HEAD, TAIL);
         END IF;
      END LOOP WHEN NOT ACCEPT (',');
      EXPECT (')');
      N@.A := HEAD;
   END IF;
   IF IS ('[') THEN
      N@.B := PARSE_RANGE ();
   END IF;
   RETURN N;
END FUNCTION PARSE_TYPE_SPEC;

% [3-35]: [L:U], (L:U], [L:U) or (L:U)
FUNCTION PARSE_RANGE () RETURNS (NODE);
   VAR R: NODE := NEW_NODE (N_RANGE, LINE_NOW ());
   IF ACCEPT ('(') THEN
      R@.IV := 1;
   ELSE
      EXPECT ('[');
   END IF;
   R@.A := PARSE_EXPR ();
   EXPECT (':');
   R@.B := PARSE_EXPR ();
   IF ACCEPT (')') THEN
      R@.IV := R@.IV + 2;
   ELSE
      EXPECT (']');
   END IF;
   RETURN R;
END FUNCTION PARSE_RANGE;

% ---- routines [4-17] [4-30] --------------------------------------------------------------
FUNCTION PARSE_ROUTINE () RETURNS (NODE);
   VAR R: NODE := NEW_NODE (N_ROUTINE, LINE_NOW ());
   VAR HEAD, TAIL: NODE := NIL;
   VAR MODE: INTEGER := M_IN;
   IF ACCEPT ('INLINE') THEN
      ;
   END IF;
   IF ACCEPT ('FUNCTION') THEN
      R@.IV := 1;
   ELSE
      EXPECT ('PROCEDURE');
   END IF;
   R@.NAME := IDENT ();
   IF ACCEPT ('(') THEN                            % [4-21]
      LOOP UNTIL IS (')') DO
         IF ACCEPT ('#') THEN
            MODE := MODE + 1;
         ELSE
            BLOCK
               CONST NAMES: NODE := IDENT_LIST ();
               VAR TS: NODE;
               VAR P: NODE := NAMES;
               EXPECT (':');
               TS := PARSE_TYPE_SPEC ();
               LOOP UNTIL P = NIL DO
                  BLOCK
                     VAR PN: NODE := NEW_NODE (N_PARAM, P@.LINE);
                     PN@.NAME := P@.NAME;
                     PN@.IV := MODE;
                     PN@.B := TS;
                     ADD_LIST (PN # HEAD, TAIL);
                  END BLOCK;
                  P := P@.NEXT;
               END LOOP;
               IF ACCEPT (',') THEN
                  ;
               END IF;
            END BLOCK;
         END IF;
      END LOOP;
      EXPECT (')');
   END IF;
   R@.A := HEAD;
   IF R@.IV = 1 THEN                                 % [4-35]
      EXPECT ('RETURNS');
      EXPECT ('(');
      R@.B := PARSE_TYPE_SPEC ();
      EXPECT (')');
   END IF;
   LOOP
      IF ACCEPT ('SIGNALS') THEN                    % [4-29]
         EXPECT ('(');
         R@.D := IDENT_LIST ();
         EXPECT (')');
      ORIF IS ('IMPORTS') THEN                      % [4-28]
         SKIP;
         SKIP_PARENS;
      ELSE
         EXIT;
      END IF;
   END LOOP;
   EXPECT (';');
   R@.C := PARSE_BODY ();
   IF IS ('PROCEDURE') ! IS ('FUNCTION') ! IS ('INLINE') THEN
      FAIL (LINE_NOW (), 'this translator has no nested routines yet');
   END IF;
   EXPECT ('END');
   IF R@.IV = 1 THEN
      EXPECT ('FUNCTION');
   ELSE
      EXPECT ('PROCEDURE');
   END IF;
   IF NOT TEQ (IDENT (), R@.NAME) THEN
      FAILT (LINE_NOW (), 'the trailer must name ', R@.NAME);
   END IF;
   EXPECT (';');
   RETURN R;
END FUNCTION PARSE_ROUTINE;

% ---- statements [4-51] ----------------------------------------------------------------------
FUNCTION AT_BODY_END () RETURNS (BOOLEAN);
   RETURN IS_KIND (K_EOF) ! IS ('END') ! IS ('ELSE') ! IS ('ORIF') ! IS ('EXCEPT')
      ! IS ('PROCEDURE') ! IS ('FUNCTION') ! IS ('INLINE');
END FUNCTION AT_BODY_END;

FUNCTION PARSE_STATEMENTS () RETURNS (NODE);
   VAR HEAD, TAIL: NODE := NIL;
   LOOP UNTIL AT_BODY_END () DO
      ADD_LIST (PARSE_STATEMENT () # HEAD, TAIL);
   END LOOP;
   RETURN HEAD;
END FUNCTION PARSE_STATEMENTS;

% an unlabeled statement and its exceptions clause [4-80]
FUNCTION PARSE_STATEMENT () RETURNS (NODE);
   VAR S: NODE := PARSE_UNLABELED ();
   VAR HEAD, TAIL: NODE := NIL;
   IF IS ('EXCEPT') THEN
      BLOCK
         VAR X: NODE := NEW_NODE (N_EXCEPT, LINE_NOW ());
         SKIP;
         LOOP UNTIL IS ('END') DO
            BLOCK
               VAR H: NODE := NEW_NODE (N_HANDLER, LINE_NOW ());
               H@.A := IDENT_LIST ();
               EXPECT ('-->');
               H@.B := PARSE_BODY ();
               EXPECT ('END');
               EXPECT (';');
               ADD_LIST (H # HEAD, TAIL);
            END BLOCK;
         END LOOP;
         EXPECT ('END');
         EXPECT ('EXCEPT');
         EXPECT (';');
         X@.A := S;
         X@.B := HEAD;
         RETURN X;
      END BLOCK;
   END IF;
   RETURN S;
END FUNCTION PARSE_STATEMENT;

FUNCTION PARSE_UNLABELED () RETURNS (NODE);
   CONST LINE: INTEGER := LINE_NOW ();
   VAR S: NODE;
   VAR T: NODE;
   IF ACCEPT (';') THEN
      RETURN NEW_NODE (N_NULL, LINE);
   ORIF IS ('IF') THEN
      RETURN PARSE_IF ();
   ORIF IS ('SELECT') THEN
      RETURN PARSE_CASE ();
   ORIF IS ('LOOP') THEN
      RETURN PARSE_LOOP ();
   ORIF ACCEPT ('BLOCK') THEN                      % [4-59]
      S := NEW_NODE (N_BLOCK, LINE);
      S@.A := PARSE_BODY ();
      EXPECT ('END');
      EXPECT ('BLOCK');
      EXPECT (';');
      RETURN S;
   ORIF ACCEPT ('EXIT') THEN
      EXPECT (';');
      RETURN NEW_NODE (N_EXIT, LINE);
   ORIF ACCEPT ('RETURN') THEN                     % [4-44]
      S := NEW_NODE (N_RETURN, LINE);
      IF NOT IS (';') THEN
         S@.A := PARSE_EXPR ();
      END IF;
      EXPECT (';');
      RETURN S;
   ORIF ACCEPT ('SIGNAL') THEN                     % [4-83]
      S := NEW_NODE (N_SIGNAL, LINE);
      IF IS_KIND (K_ID) THEN
         S@.NAME := IDENT ();
      END IF;
      EXPECT (';');
      RETURN S;
   ORIF ACCEPT ('ASSERT') THEN                     % [4-84]
      S := NEW_NODE (N_ASSERT, LINE);
      S@.A := PARSE_EXPR ();
      EXPECT (';');
      RETURN S;
   END IF;
   T := PARSE_POSTFIX ();
   IF ACCEPT (':=') THEN                           % [3-43]
      S := NEW_NODE (N_ASSIGN, LINE);
      S@.A := T;
      S@.B := PARSE_EXPR ();
      EXPECT (';');
      RETURN S;
   END IF;
   EXPECT (';');                                   % [4-37]
   IF T@.KIND = N_NAME THEN
      T@.KIND := N_CALL;
   ORIF T@.KIND = N_APPLY THEN
      T@.KIND := N_CALL;
   ELSE
      FAIL (LINE, 'a statement expected');
   END IF;
   RETURN T;
END FUNCTION PARSE_UNLABELED;

% [4-63]
FUNCTION PARSE_IF () RETURNS (NODE);
   VAR S: NODE := NEW_NODE (N_IF, LINE_NOW ());
   VAR HEAD, TAIL: NODE := NIL;
   EXPECT ('IF');
   LOOP
      BLOCK
         VAR ARM: NODE := NEW_NODE (N_ARM, LINE_NOW ());
         ARM@.A := PARSE_EXPR ();
         EXPECT ('THEN');
         ARM@.B := PARSE_BODY ();
         ADD_LIST (ARM # HEAD, TAIL);
      END BLOCK;
   END LOOP WHEN NOT ACCEPT ('ORIF');
   S@.A := HEAD;
   IF ACCEPT ('ELSE') THEN
      S@.B := PARSE_BODY ();
   END IF;
   EXPECT ('END');
   EXPECT ('IF');
   EXPECT (';');
   RETURN S;
END FUNCTION PARSE_IF;

% does a range start here, rather than a parenthesized expression?
FUNCTION RANGE_AHEAD () RETURNS (BOOLEAN);
   VAR DEPTH: INTEGER := 0;
   VAR K: INTEGER := 0;
   LOOP
      BLOCK
         CONST T: TOKEN := AHEAD (K);
         IF T.KIND = K_EOF THEN
            RETURN FALSE;
         END IF;
         IF T.KIND = K_SYM THEN
            IF TEQS (T.TX, '(') ! TEQS (T.TX, '[') THEN
               DEPTH := DEPTH + 1;
            ORIF TEQS (T.TX, ')') ! TEQS (T.TX, ']') THEN
               DEPTH := DEPTH - 1;
               IF DEPTH = 0 THEN
                  RETURN FALSE;
               END IF;
            ORIF DEPTH = 1 & TEQS (T.TX, ':') THEN
               RETURN TRUE;
            END IF;
         END IF;
      END BLOCK;
      K := K + 1;
   END LOOP;
END FUNCTION RANGE_AHEAD;

FUNCTION PARSE_CASE_LABEL () RETURNS (NODE);
   IF IS ('[') ! (IS ('(') & RANGE_AHEAD ()) THEN
      RETURN PARSE_RANGE ();
   END IF;
   RETURN PARSE_EXPR ();
END FUNCTION PARSE_CASE_LABEL;

% [4-67]
FUNCTION PARSE_CASE () RETURNS (NODE);
   VAR S: NODE := NEW_NODE (N_CASE, LINE_NOW ());
   VAR HEAD, TAIL: NODE := NIL;
   EXPECT ('SELECT');
   S@.A := PARSE_EXPR ();
   EXPECT ('FROM');
   LOOP UNTIL IS ('END') DO
      IF ACCEPT ('ELSE') THEN
         EXPECT ('-->');
         S@.C := PARSE_BODY ();
         EXPECT ('END');
         EXPECT (';');
      ELSE
         BLOCK
            VAR ARM: NODE := NEW_NODE (N_ARM, LINE_NOW ());
            VAR LH, LT: NODE := NIL;
            LOOP
               ADD_LIST (PARSE_CASE_LABEL () # LH, LT);
            END LOOP WHEN NOT ACCEPT (',');
            EXPECT ('-->');
            ARM@.A := LH;
            ARM@.B := PARSE_BODY ();
            EXPECT ('END');
            EXPECT (';');
            ADD_LIST (ARM # HEAD, TAIL);
         END BLOCK;
      END IF;
   END LOOP;
   S@.B := HEAD;
   EXPECT ('END');
   EXPECT ('SELECT');
   EXPECT (';');
   RETURN S;
END FUNCTION PARSE_CASE;

% [4-76] [4-79]
FUNCTION PARSE_LOOP () RETURNS (NODE);
   VAR S: NODE := NEW_NODE (N_LOOP, LINE_NOW ());
   EXPECT ('LOOP');
   IF ACCEPT ('FOR') THEN
      S@.KIND := N_FOR;
      IF IS_KIND (K_ID) THEN
         S@.NAME := IDENT ();
         EXPECT ('IN');
      END IF;
      S@.A := PARSE_RANGE ();
      EXPECT ('DO');
      S@.B := PARSE_BODY ();
      EXPECT ('END');
      EXPECT ('LOOP');
      IF IS_KIND (K_ID) THEN
         IF NOT TEQ (IDENT (), S@.NAME) THEN
            FAIL (LINE_NOW (), 'END LOOP must name the loop identifier');
         END IF;
      END IF;
      EXPECT (';');
      RETURN S;
   END IF;
   IF ACCEPT ('UNTIL') THEN
      S@.A := PARSE_EXPR ();
      EXPECT ('DO');
   END IF;
   S@.B := PARSE_BODY ();
   EXPECT ('END');
   EXPECT ('LOOP');
   IF ACCEPT ('WHEN') THEN
      S@.C := PARSE_EXPR ();
   END IF;
   EXPECT (';');
   RETURN S;
END FUNCTION PARSE_LOOP;
