# RED and GREEN, the two finalists of the DoD-1 language competition (1979),
# and BLUE and YELLOW, dropped after its first phase (1978), for one-off jobs:
# a source goes in, the program's output comes out.
#
# All four translators are written in their own languages and translate to C,
# so the image carries a C compiler next to them. The build stage replays the
# bootstrap from the committed seeds and refuses to finish unless each
# translator reproduces itself byte for byte.
FROM docker.io/library/gcc:14-bookworm AS build
WORKDIR /src
COPY ada-colors/ ./
RUN for d in . green blue yellow; do make -C $d clean >/dev/null 2>&1 || true; done; \
    make fixpoint && make -C green fixpoint && \
    make -C blue fixpoint && make -C yellow fixpoint && \
    red/tests/run.sh && make -C green test && \
    blue/tests/run.sh && yellow/tests/run.sh

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/* && useradd -u 10001 -m red
COPY --from=build /src/build/redc /src/green/build/greenc \
     /src/blue/build/bluec /src/yellow/build/yellowc /opt/ada-colors/bin/
COPY --from=build /src/rt/paleo.c /src/rt/paleo.h /opt/ada-colors/rt/
# YELLOW programs are translated after the standard prelude
COPY --from=build /src/yellow/lib/prelude.yel /opt/ada-colors/lib/
# the runtime is compiled once here, not on every run
RUN cc -std=gnu11 -O1 -w -c /opt/ada-colors/rt/paleo.c -o /opt/ada-colors/rt/paleo.o
COPY deploy/ada-colors-run.sh /usr/local/bin/ada-colors-run
RUN chmod +x /usr/local/bin/ada-colors-run && mkdir -p /work && chown 10001 /work
USER 10001
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/ada-colors-run"]
