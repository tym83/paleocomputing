# Toolchain image for the labs that a browser is not enough for: changing the
# processor and changing the compiler. Inside are Verilator, a C++ toolchain,
# Python and Node, i.e. exactly what checks the work on the host.
#
# Why a container. The isa and compiler assignments require rebuilding the
# Verilog and the Oberon compiler, which is impossible in a browser. But it is
# an ordinary batch workload: submit a change, get a verdict. It runs both
# locally and as a cluster job.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      verilator g++ make python3 nodejs ca-certificates \
      libpython3-dev perl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /lab
# Only what the build and checks need is copied: build/ is left out, otherwise
# the image drags in a hundred megabytes of unrelated artifacts and breaks
# reproducibility.
COPY rtl/     rtl/
COPY tb/      tb/
COPY tools/   tools/
COPY tests/   tests/
COPY scripts/ scripts/
COPY ext/     ext/
COPY web/     web/
COPY docs/    docs/
COPY Makefile ./
COPY deploy/lab.sh /usr/local/bin/lab

ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/usr/local/bin/lab"]
CMD ["help"]
