# The static part: nine browser labs and the course book.
# Neither a simulator nor a compiler is needed here: the whole machine is
# already built into WASM, so the image is small and served by plain nginx.
#
# The unprivileged variant is used: it listens on 8080 and runs as user 101,
# so under ordinary cluster restrictions it needs neither root nor a writable
# root filesystem. The configuration lives in the image and must NOT be
# overlaid by a volume, otherwise the wasm MIME type is lost.
# ⚠ The machine is built HERE, not brought in prebuilt.
#
# When this rule appeared, risc5.js, risc5.wasm, prom_sd.mem and oberon.dsk
# were in .gitignore, and the old image, copying web/ as is, came out WITHOUT
# the machine: the page was served, but there was nothing to boot on it. In
# the cluster this looked like success (status 200 and the correct page size),
# and so it went unnoticed. The check looked at the form, not the behavior.
#
# Now the built machine lives in git next to the pages (impl/web/, see
# impl/.gitignore): GitHub Pages serves it, and there is nothing to build wasm
# with when the site is deployed. The image does not take that copy:
# `COPY --from=machine` below lays its own on top, built from rtl/ right here.
#
# ⚠ So there are two machines: the one in git is for Pages (and check.yml and
# the ISA extension cross-check in hardware.yml run it), the one in the image
# is built from source. They match only if someone ran `make web` after
# changing rtl/ or tb/ and committed the result. This is not checked
# automatically: nobody has verified byte-for-byte reproducibility of the wasm
# from emsdk/verilator.
# We use a ready-made emscripten image: installing it from scratch on a clean
# distribution is unreliable, the installer pulls in its own environment and
# fails for reasons that have nothing to do with our build.
# ⚠ The build stage runs on the builder's CPU ($BUILDPLATFORM), not the node's:
# its product is WebAssembly and static files, which do not depend on the node
# architecture. The emsdk image is published only for amd64, and an arm64
# build failed on the very first command ("exec format error"). Only nginx
# below is built for the node architecture.
FROM --platform=$BUILDPLATFORM docker.io/emscripten/emsdk:3.1.74 AS machine
# ⚠ Verilator is built HERE from source, not taken from the distribution.
#
# The verilator headers are compiled together with the model, and the
# distribution's version does not build for wasm: verilated_threads.cpp pulls
# in std::thread, which this toolchain lacks. The version must match the one
# the model was verified with.
ARG VERILATOR_VERSION=v5.052
RUN apt-get update -q && apt-get install -y -q --no-install-recommends \
      make git g++ perl python3 autoconf flex bison ccache \
      libgoogle-perftools-dev numactl zlib1g-dev help2man libfl-dev \
 && git clone --depth 1 -b ${VERILATOR_VERSION} https://github.com/verilator/verilator /v \
 && cd /v && autoconf && ./configure --prefix=/usr/local >/dev/null \
 && make -j"$(nproc)" >/dev/null && make install >/dev/null \
 && cd / && rm -rf /v /var/lib/apt/lists/*
WORKDIR /src
COPY rtl/ ./rtl/
COPY tb/ ./tb/
COPY ext/disk/ ./ext/disk/
COPY Makefile ./
# The workload generator and the assembler: `make web` also builds the
# bounds-check cost benchmark, and without them it fails on the first
# workload target.
COPY tools/ ./tools/
# ⚠ We create the intermediate-files directory ourselves: the verilator
# target does not create it and writes to a nonexistent path. tests/ is where
# the generator writes.
RUN mkdir -p web tests build/obj_wasm && make web \
 && ls -la web/risc5.js web/risc5.wasm web/risc5-chk.js web/risc5-chk.wasm \
           web/oberon.dsk web/prom_sd.mem web/bench_bounds.json

FROM docker.io/nginxinc/nginx-unprivileged:1.29-alpine

COPY --chown=101:101 web/ /usr/share/nginx/html/
# The machine goes on top: the pages come from the repository, the machine from the build.
COPY --from=machine --chown=101:101 /src/web/risc5.js /src/web/risc5.wasm \
     /src/web/risc5-chk.js /src/web/risc5-chk.wasm \
     /src/web/bench_bounds_b.bin /src/web/bench_bounds_e.bin /src/web/bench_bounds.json \
     /src/web/prom_sd.mem /src/web/oberon.dsk /usr/share/nginx/html/

# Without the correct MIME type the browser refuses to stream-compile WASM.
#
# ⚠ We also pin the number of workers. The stock image uses auto, and nginx
# starts a process per core of the NODE, not per the allotted limit: on a
# 96-core node that is 96 processes that do not fit into the allotted memory,
# and the pod goes into an endless restart loop. Found on a live cluster. The
# stock auto-tuning script does not help: it edits the configuration in place,
# and the container's root filesystem is read-only.
USER root
RUN sed -i 's/^worker_processes.*/worker_processes 1;/' /etc/nginx/nginx.conf \
 && printf '%s\n' \
  'types { application/wasm wasm; }' \
  'gzip on;' \
  'gzip_types application/wasm application/javascript text/css text/html;' \
  > /etc/nginx/conf.d/wasm.conf \
 && sed -i 's|index  index.html index.htm;|index lab.html index.html;|' \
      /etc/nginx/conf.d/default.conf
USER 101

EXPOSE 8080
