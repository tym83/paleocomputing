# Oberon language runtime, for one-off jobs and long-running services.
#
# This is NOT the Oberon operating system and not a machine emulator: it is
# Wirth's compiler and its library, run as an ordinary program. The same
# compiler as inside the system, but without windows, mouse or screen. Exactly
# what is needed when you have to compute something and return the answer.
#
# It is based on Norebo (pdewacht): a RISC5 runtime in C that runs the real
# object code of Wirth's compiler.
FROM docker.io/library/gcc:14-bookworm AS build
WORKDIR /src
COPY ext/norebo/ ./norebo/
RUN cc -O2 -o /norebo norebo/Runtime/norebo.c norebo/Runtime/risc-cpu.c
# Wirth's Net and our Kube on the system disk, so machines on an air can talk
# (Net.StartServer, Net.SendMsg) and form a cluster (Kube, KubeNet, with the
# Ticker workloads). The image has SCC compiled but Net only as source; Kube is
# ours. Boot runs the machine's commands at start (-machine commands=...), and
# System, rebuilt from the image's own source, calls it last in its body:
# mods/System.Mod does not exist, install_modules patches the image's.
COPY tools/oberonfs.py tools/install_modules.py ./tools/
COPY ext/po2013-src/Net.Mod kube/Kube.Mod kube/Pods.Mod kube/KubeNet.Mod kube/Ticker.Mod kube/Ticker2.Mod \
     kube/Boot.Mod ./mods/
COPY ext/disk/Oberon-2016-08-02.dsk ./oberon.dsk
RUN python3 tools/install_modules.py oberon.dsk mods/Net.Mod mods/Kube.Mod mods/Pods.Mod mods/KubeNet.Mod \
      mods/Ticker.Mod mods/Ticker2.Mod mods/Boot.Mod mods/System.Mod \
      --norebo ./norebo --norebo-bin /norebo

# The ROM in binary form: in the sources it is hexadecimal text, while QEMU
# expects bytes. We convert it at build time so the repository does not hold
# two copies.
FROM docker.io/library/python:3.12-slim AS payload
WORKDIR /p
# ⚠ We take the SOURCES, not web/: that directory holds build products, and
# they are in .gitignore. They exist locally but not in the build, and COPY
# silently copies nothing. That is exactly how the serving image once shipped
# without the machine.
COPY rtl/prom_sd.mem ./
COPY --from=build /src/oberon.dsk ./oberon.dsk
RUN python3 -c "import struct; \
  ws=[int(x,16) for x in open('prom_sd.mem').read().split()]; \
  open('prom.bin','wb').write(b''.join(struct.pack('<I',w) for w in ws))"

FROM docker.io/library/debian:bookworm-slim
RUN useradd -u 10001 -m oberon
COPY --from=build /norebo /usr/local/bin/norebo
# The library and the boot object files: without them the compiler has nothing to stand on.
COPY ext/norebo/Norebo/  /opt/oberon/Norebo/
COPY ext/norebo/Oberon/  /opt/oberon/Oberon/
COPY ext/norebo/build2/  /opt/oberon/build2/
# The Oberon system and its ROM: the RISC5 machine application takes them
# from here to fill its volume. They also matter on their own: the image
# carries the language together with the system it grew up on.
COPY --from=payload /p/prom.bin /p/oberon.dsk /opt/oberon/payload/
COPY deploy/oberon-run.sh /usr/local/bin/oberon-run
RUN chmod +x /usr/local/bin/oberon-run
USER 10001
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/oberon-run"]
