" start orders (EWD 149, 4.1): lock word, label of the next one, code word
tlock: +0
tnext: +0
tcode: +0
llock: +0
lnext: +0
lcode: +0

" storage that the start fills or that is written before it is read
pcbs:      'skip' 288
stacks:    'skip' 384
bootstack: 'skip' 32
kstack:    'skip' 32
dpt:       'skip' 1024
scb:       'skip' 72
cttab:     'skip' 24
kbring:    'skip' 16
