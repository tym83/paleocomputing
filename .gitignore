# Build artifacts
impl/build/
__pycache__/
*.pyc
.DS_Store

# The site is built by tools/build-site.sh from site/ and impl/web/; the result
# is not committed.
/_site/

# ⚠ site/oberon/ holds only its own index.html. The lab, the book and the
# machine come from impl/web/ at build time. A copy of them used to live here; it
# was not updated after the translation, and /oberon/book/en/ served a live 404.
site/oberon/*
!site/oberon/index.html

# Cell libraries are not committed: Sky130 weighs 12 MB and is fetched by the
# `make lib` target (which `make syn` also calls). The former Nangate45 is not
# committed for another reason: its header explicitly forbids publication, see THIRD-PARTY.md.
impl/syn/lib/*.lib

# QEMU work tree for building the target: 1 GB of third-party sources, not committed
.qemu-work/
