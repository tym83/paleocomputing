<domain type="kvm" xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0">
  <name>default_testvm</name>
  <memory unit="MiB">128</memory>
  <vcpu placement="static" current="1">4</vcpu>
  <vcpus>
    <vcpu id="0" enabled="yes"/>
  </vcpus>
  <sysinfo type="smbios">
    <system><entry name="manufacturer">KubeVirt</entry></system>
  </sysinfo>
  <os>
    <type arch="x86_64" machine="q35">hvm</type>
    <smbios mode="sysinfo"/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode="host-model"><topology sockets="4" cores="1" threads="1"/></cpu>
  <clock offset="utc"/>
  <devices>
    <emulator>/usr/libexec/qemu-kvm</emulator>
    <controller type="usb" index="0" model="piix3-uhci"/>
    <controller type="pci" index="0" model="pcie-root"/>
    <video><model type="vga" heads="1"/></video>
    <memballoon model="virtio"/>
    <disk device="disk" type="file">
      <source file="/var/run/kubevirt/disk.img"/>
      <target bus="virtio" dev="vda"/>
    </disk>
    <interface type="ethernet">
      <model type="virtio"/>
    </interface>
    <serial type="unix"><target port="0"/></serial>
    <graphics type="vnc"><listen type="socket" socket="/var/run/kubevirt-private/0000/virt-vnc"/></graphics>
    <graphics type="spice" autoport="yes"/>
    <console type="unix"><target type="serial" port="0"/></console>
    <channel type="unix">
      <target name="org.qemu.guest_agent.0" type="virtio"/>
    </channel>
    <rng model="virtio"><backend model="random">/dev/urandom</backend></rng>
  </devices>
</domain>
