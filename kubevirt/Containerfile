# virt-launcher image with a libvirt that knows foreign machine architectures.
#
# Which machines it carries is in kubevirt/targets.txt, one line per
# architecture (today one: RISC5). One image for the whole family: a new
# machine is a line there, not a new image.
#
# ONLY libvirt is forked, and the patch in it is six lines in four tables per
# architecture.
# KubeVirt itself is untouched: the OnDefineDomain hook is a supported
# extension point, and the image registry is switched by a setting on the
# KubeVirt resource, so Cozystack needs no fork either.
#
# Built on the same base as the stock image, CentOS Stream 9, and the same
# libvirt version. A build from another base will not do: the libraries would
# diverge. Which libvirt goes with which KubeVirt version is in
# kubevirt/versions.txt, and build.sh passes both versions as a pair.
#
# The build context is the repository root, and the QEMU commit is passed in
# from outside: it is recorded once, in qemu/Makefile. Build through
# kubevirt/build.sh, which reads the commit from the same place the checks do.
#
# ⚠ The bases are pinned by the (multi-arch) index digest; the tag is kept for
# the reader. The `stream9` tag alone brings a different system a month later,
# and `v1.8.4` can technically be moved, so the same commit would build a
# different image. Update the digest together with the tag: for centos here,
# for the launcher in kubevirt/versions.txt, next to its version.
#
# The centos base is our copy of quay.io/centos/centos:stream9
# (.github/workflows/mirror-base.yml): quay rewrites the tag daily and removes
# the old digests within days, so a pin there broke the build twice. To move
# the base, run that workflow and pin the dated tag and digest it prints.
# The launcher digest:
#
#   docker buildx imagetools inspect quay.io/kubevirt/virt-launcher:v1.8.4

# The KubeVirt version the image is built for and the index digest of its
# stock launcher: a line from kubevirt/versions.txt, passed by build.sh.
# Declared before the first FROM so the final image's base can see them.
# The values here are for the default version.
ARG KUBEVIRT_VERSION=v1.8.4
ARG LAUNCHER_DIGEST=sha256:c89f733b1fdcc810d0b4326bbfc652a4cf3d25bc56cc8545f124d5cb71a1ce20

# ── libvirt build ──────────────────────────────────────────────────────────
FROM ghcr.io/tym83/paleocomputing/centos:stream9-20261007@sha256:33346f5fe280763eb78e85f968ad52bc2b2013369de85403f67e802db98ed243 AS libvirt-build

# Dependencies are taken not as a list but as the set the distribution itself
# builds libvirt with: picking them one by one is slow and unreliable.
# CRB is needed separately: meson, ninja and some headers live there.
RUN dnf install -y --setopt=install_weak_deps=False dnf-plugins-core \
 && dnf config-manager --set-enabled crb \
 && dnf install -y --setopt=install_weak_deps=False \
      git meson ninja-build gcc make python3 rpm-build \
 && dnf builddep -y --setopt=install_weak_deps=False libvirt \
 && dnf clean all

# The pair to KUBEVIRT_VERSION from kubevirt/versions.txt; the value here is
# for the default version.
ARG LIBVIRT_VERSION=v11.9.0
RUN git clone --depth 1 -b ${LIBVIRT_VERSION} \
      https://github.com/libvirt/libvirt.git /src

# The architecture list goes next to the script: that is where it looks for it.
COPY qemu/libvirt/patch_libvirt.py kubevirt/targets.txt /src/
WORKDIR /src
RUN python3 patch_libvirt.py

# Build only what is needed: the QEMU driver and the shared library.
RUN meson setup build --prefix=/usr --libdir=/usr/lib64 \
      -Ddriver_qemu=enabled -Dtests=disabled -Ddocs=disabled \
      -Ddriver_libxl=disabled -Ddriver_lxc=disabled -Ddriver_vbox=disabled \
 && ninja -C build \
 && DESTDIR=/out ninja -C build install

# ── Emulator build ─────────────────────────────────────────────────────────
#
# ⚠ It must be built here rather than brought in prebuilt: the virt-launcher
# image is based on CentOS 9, and a binary from Ubuntu does not run in it
# ("GLIBC_2.38 not found").
FROM ghcr.io/tym83/paleocomputing/centos:stream9-20261007@sha256:33346f5fe280763eb78e85f968ad52bc2b2013369de85403f67e802db98ed243 AS qemu-build

RUN dnf install -y --setopt=install_weak_deps=False dnf-plugins-core \
 && dnf config-manager --set-enabled crb \
 && dnf install -y --setopt=install_weak_deps=False \
      git meson ninja-build gcc make \
      python3.12 python3.12-devel \
      glib2-devel pixman-devel zlib-devel flex bison \
      libpng-devel libjpeg-turbo-devel \
 && dnf clean all

# ⚠ Recent QEMU needs Python 3.12, while CentOS 9 ships 3.9. Install it
# alongside and point to it explicitly: the system one cannot be replaced, dnf
# depends on it.
ENV PYTHON=/usr/bin/python3.12

# ⚠ The QEMU tree is at the same commit as the checks use. This used to take
# the latest master: the image was built from a different machine than the one
# verified against the RTL, and a rebuild a week later produced a third one.
ARG QEMU_REF
RUN test -n "${QEMU_REF}" || { echo "QEMU_REF is not set: build through kubevirt/build.sh"; exit 1; } \
 && mkdir -p /src/qemu && cd /src/qemu && git init -q \
 && { git fetch --depth 1 -q https://gitlab.com/qemu-project/qemu.git "${QEMU_REF}" \
   || git fetch --depth 1 -q https://github.com/qemu/qemu.git "${QEMU_REF}"; } \
 && git checkout -q FETCH_HEAD

COPY qemu/graft.sh      /src/qemu-target/
COPY qemu/target        /src/qemu-target/target
COPY qemu/hw            /src/qemu-target/hw
COPY qemu/configs       /src/qemu-target/configs
COPY kubevirt/targets.txt /src/targets.txt
# Targets and binaries come from kubevirt/targets.txt: <arch>-softmmu and
# qemu-system-<arch>. The finished emulators are collected in /out/bin so the
# last stage can take them in one line, however many there are.
RUN /src/qemu-target/graft.sh /src/qemu \
 && archs=$(awk '!/^#/ && NF { print $1 }' /src/targets.txt) \
 && test -n "$archs" \
 && cd /src/qemu \
 && ./configure --target-list=$(printf '%s-softmmu,' $archs | sed 's/,$//') \
      --disable-docs --disable-tools \
      --disable-guest-agent --without-default-features \
      --python=/usr/bin/python3.12 \
      --enable-vnc --enable-pixman --enable-png \
 && ninja -C build $(printf 'qemu-system-%s ' $archs) \
 && mkdir -p /out/bin \
 && for a in $archs; do cp build/qemu-system-$a /out/bin/; done

# ── Final image ────────────────────────────────────────────────────────────
FROM quay.io/kubevirt/virt-launcher:${KUBEVIRT_VERSION}@${LAUNCHER_DIGEST}

# Only the libvirt libraries are replaced: everything else in the image is stock.
COPY --from=libvirt-build /out/usr/lib64/libvirt.so.* /usr/lib64/
COPY --from=libvirt-build /out/usr/lib64/libvirt/connection-driver/libvirt_driver_qemu.so \
                          /usr/lib64/libvirt/connection-driver/

# The emulator goes here too: this way it is present without a shared volume,
# and the volume remains a way to bring a machine the image does not have.
COPY --from=qemu-build /out/bin/ /usr/local/bin/
# Keyboard keymaps for VNC. Without them QEMU with `-vnc` does not start at
# all ("could not find keymap file for language 'en-us'"), and the dashboard
# console goes through VNC. It looks for them in <prefix>/share/qemu/keymaps.
COPY --from=qemu-build /src/qemu/pc-bios/keymaps/ /usr/local/share/qemu/keymaps/

# The hook can come as a script from a ConfigMap, but keep it in the image too.
COPY kubevirt/onDefineDomain.py /usr/bin/onDefineDomain
