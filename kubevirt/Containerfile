# Образ virt-launcher с libvirt, знающим архитектуру RISC5.
#
# Форкается ТОЛЬКО libvirt, и патч в нём — шесть строк в четырёх таблицах.
# Сам KubeVirt не трогаем: перехватчик OnDefineDomain — штатная точка, а
# реестр образов переключается настройкой на ресурсе KubeVirt, так что и
# Cozystack форка не требует.
#
# Собирается под ту же основу, что у штатного образа — CentOS Stream 9 и
# ту же версию libvirt. Взять сборку с другой основы нельзя: разойдутся
# библиотеки. Какой libvirt в какой версии KubeVirt — в kubevirt/versions.txt,
# и build.sh передаёт обе версии парой.
#
# Контекст сборки — корень репозитория, а коммит QEMU передаётся снаружи:
# он записан один раз, в qemu/Makefile. Собирать через kubevirt/build.sh —
# он читает коммит оттуда же, откуда его берут проверки.
#
# ⚠ Основы прибиты дайджестом индекса (многоархитектурного), тег оставлен для
# читателя. По одному тегу `stream9` через месяц приезжает другая система, а
# `v1.8.4` технически можно переставить — и тот же коммит собирал бы другой
# образ. Обновлять дайджест вместе с тегом:
#
#   docker buildx imagetools inspect quay.io/kubevirt/virt-launcher:v1.8.4
#
# Версию KubeVirt для тега образа publish.yml и launcher.yml вырезают до `@`.

# ── Сборка libvirt ─────────────────────────────────────────────────────────
FROM quay.io/centos/centos:stream9@sha256:0996d37c69b3a8c33042932d415ad7bf5a8122270264e835e5c0153615aef0e4 AS libvirt-build

# Зависимости берём не списком, а тем набором, которым libvirt собирается в
# самом дистрибутиве: перебирать их по одной — долго и ненадёжно.
# CRB нужен отдельно: meson, ninja и часть заголовков лежат там.
RUN dnf install -y --setopt=install_weak_deps=False dnf-plugins-core \
 && dnf config-manager --set-enabled crb \
 && dnf install -y --setopt=install_weak_deps=False \
      git meson ninja-build gcc make python3 rpm-build \
 && dnf builddep -y --setopt=install_weak_deps=False libvirt \
 && dnf clean all

# Пара к KUBEVIRT_VERSION из kubevirt/versions.txt; значение здесь — для
# версии по умолчанию.
ARG LIBVIRT_VERSION=v11.9.0
RUN git clone --depth 1 -b ${LIBVIRT_VERSION} \
      https://github.com/libvirt/libvirt.git /src

COPY qemu/libvirt/patch_libvirt.py /src/
WORKDIR /src
RUN python3 patch_libvirt.py

# Собираем только то, что нужно: драйвер QEMU и общую библиотеку.
RUN meson setup build --prefix=/usr --libdir=/usr/lib64 \
      -Ddriver_qemu=enabled -Dtests=disabled -Ddocs=disabled \
      -Ddriver_libxl=disabled -Ddriver_lxc=disabled -Ddriver_vbox=disabled \
 && ninja -C build \
 && DESTDIR=/out ninja -C build install

# ── Сборка эмулятора ───────────────────────────────────────────────────────
#
# ⚠ Собирать надо здесь же, а не приносить готовый: образ virt-launcher стоит
# на CentOS 9, и бинарь с Ubuntu в нём не запускается — «GLIBC_2.38 not found».
FROM quay.io/centos/centos:stream9@sha256:0996d37c69b3a8c33042932d415ad7bf5a8122270264e835e5c0153615aef0e4 AS qemu-build

RUN dnf install -y --setopt=install_weak_deps=False dnf-plugins-core \
 && dnf config-manager --set-enabled crb \
 && dnf install -y --setopt=install_weak_deps=False \
      git meson ninja-build gcc make \
      python3.12 python3.12-devel \
      glib2-devel pixman-devel zlib-devel flex bison \
      libpng-devel libjpeg-turbo-devel \
 && dnf clean all

# ⚠ Свежему QEMU нужен Python 3.12, а базовый в CentOS 9 — 3.9. Ставим рядом
# и указываем явно: подменять системный нельзя, на нём держится dnf.
ENV PYTHON=/usr/bin/python3.12

# ⚠ Дерево QEMU — тем же коммитом, что у проверок. Раньше здесь брался
# свежий master: образ собирался из другой машины, чем та, что сверена с RTL,
# и пересборка через неделю давала третью.
ARG QEMU_REF
RUN test -n "${QEMU_REF}" || { echo "QEMU_REF не задан: собирать через kubevirt/build.sh"; exit 1; } \
 && mkdir -p /src/qemu && cd /src/qemu && git init -q \
 && { git fetch --depth 1 -q https://gitlab.com/qemu-project/qemu.git "${QEMU_REF}" \
   || git fetch --depth 1 -q https://github.com/qemu/qemu.git "${QEMU_REF}"; } \
 && git checkout -q FETCH_HEAD

COPY qemu/graft.sh      /src/qemu-target/
COPY qemu/target        /src/qemu-target/target
COPY qemu/hw            /src/qemu-target/hw
COPY qemu/configs       /src/qemu-target/configs
RUN /src/qemu-target/graft.sh /src/qemu \
 && cd /src/qemu \
 && ./configure --target-list=risc5-softmmu --disable-docs --disable-tools \
      --disable-guest-agent --without-default-features \
      --python=/usr/bin/python3.12 \
      --enable-vnc --enable-pixman --enable-png \
 && ninja -C build qemu-system-risc5

# ── Готовый образ ──────────────────────────────────────────────────────────
FROM quay.io/kubevirt/virt-launcher:v1.8.4@sha256:c89f733b1fdcc810d0b4326bbfc652a4cf3d25bc56cc8545f124d5cb71a1ce20

# Подменяем только библиотеки libvirt: всё остальное в образе штатное.
COPY --from=libvirt-build /out/usr/lib64/libvirt.so.* /usr/lib64/
COPY --from=libvirt-build /out/usr/lib64/libvirt/connection-driver/libvirt_driver_qemu.so \
                          /usr/lib64/libvirt/connection-driver/

# Эмулятор кладём сюда же: так он есть и без общего тома, а том остаётся
# способом принести машину, которой в образе нет.
COPY --from=qemu-build /src/qemu/build/qemu-system-risc5 /usr/local/bin/
# Раскладки клавиатуры для VNC. Без них QEMU с `-vnc` не стартует вовсе
# («could not find keymap file for language 'en-us'»), а консоль в дашборде
# идёт именно через VNC. Ищет он их в <prefix>/share/qemu/keymaps.
COPY --from=qemu-build /src/qemu/pc-bios/keymaps/ /usr/local/share/qemu/keymaps/

# Перехватчик может прийти скриптом из ConfigMap, но пусть будет и в образе.
COPY kubevirt/onDefineDomain.py /usr/bin/onDefineDomain
