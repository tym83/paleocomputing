{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "oberon-lab",
  "type": "object",
  "$comment": "The schema root is intentionally NOT closed: cozystack-engine injects its own keys (_cluster, _namespace) into the values of every tenant application, and with additionalProperties:false Helm rejects the values entirely, so the application does not deploy. No platform chart closes its root. Nested objects are closed: the engine puts nothing there.",
  "properties": {
    "web":      { "type": "boolean" },
    "replicas": { "type": "integer", "minimum": 0 },
    "host":     { "type": "string" },
    "ingressClassName": { "type": "string" },
    "runner":   { "type": "boolean" },
    "task":     { "type": "string", "enum": ["isa", "compiler", "check"] },
    "patch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path":    { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
          "content": { "type": "string" }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "runner"],
      "properties": {
        "web":    { "type": "string" },
        "runner": { "type": "string" }
      }
    },
    "runnerResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu":    { "type": "string" },
        "memory": { "type": "string" }
      }
    }
  }
}
