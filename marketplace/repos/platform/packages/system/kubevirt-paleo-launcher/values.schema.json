{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kubevirt-paleo-launcher",
  "type": "object",
  "$comment": "The schema root is not closed: the Cozystack engine injects its own keys (_cluster, _namespace) into values.",
  "required": ["kubevirtName", "interval", "image"],
  "properties": {
    "kubevirtName": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "interval":     { "type": "integer", "minimum": 10, "maximum": 3600 },
    "allowWorkloadUpdate": { "type": "boolean" },
    "image":        { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" }
  }
}
