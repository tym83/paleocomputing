{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kubevirt-paleo-launcher",
  "type": "object",
  "$comment": "Корень схемы не закрыт: движок Cozystack подмешивает в values свои ключи (_cluster, _namespace).",
  "required": ["kubevirtName", "interval", "image"],
  "properties": {
    "kubevirtName": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "interval":     { "type": "integer", "minimum": 10, "maximum": 3600 },
    "image":        { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" }
  }
}
