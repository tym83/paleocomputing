{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "langpack",
  "type": "object",
  "$comment": "The schema root is intentionally NOT closed: cozystack-engine injects its own keys (_cluster, _namespace) into the values of every tenant application, and with additionalProperties:false Helm rejects the values entirely, so the application does not deploy. No platform chart closes its root. Nested objects are closed: the engine puts nothing there.",
  "required": [
    "language",
    "image",
    "mode"
  ],
  "properties": {
    "language": {
      "type": "string",
      "minLength": 1,
      "default": "Oberon"
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "default": "ghcr.io/tym83/paleocomputing/oberon-run:dev"
    },
    "mode": {
      "type": "string",
      "enum": [
        "service",
        "job"
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "program": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "workdir": {
      "type": "string",
      "pattern": "^/.*"
    },
    "srcdir": {
      "type": "string",
      "pattern": "^/.*"
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "host": {
      "type": "string"
    },
    "ingressClassName": {
      "type": "string"
    },
    "backoffLimit": {
      "type": "integer",
      "minimum": 0
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        }
      }
    }
  }
}
